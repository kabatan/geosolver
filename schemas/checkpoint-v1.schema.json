{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geotarget.dev/checkpoint-v1.schema.json",
  "title": "GeoTarget CheckpointV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_hash", "target_image_status", "state"],
  "properties": {
    "schema_version": {"const": "geotarget.checkpoint/v1"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "target_image_status": {
      "enum": ["unknown", "finite_observed", "likely_continuous"]
    },
    "state": {"$ref": "#/$defs/state"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableId": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "pluginId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "uInt64": {
      "oneOf": [
        {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"}
      ]
    },
    "positiveUInt64": {
      "oneOf": [
        {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        {"type": "string", "pattern": "^[1-9][0-9]{0,19}$"}
      ]
    },
    "pluginLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version", "core_abi", "content_hash"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/pluginId"},
        "version": {"$ref": "#/$defs/semver"},
        "core_abi": {"$ref": "#/$defs/semver"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "environmentLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_hash", "plugin_locks", "policy_hash", "environment_hash"],
      "properties": {
        "problem_hash": {"$ref": "#/$defs/sha256"},
        "plugin_locks": {"type": "array", "items": {"$ref": "#/$defs/pluginLock"}},
        "policy_hash": {"$ref": "#/$defs/sha256"},
        "environment_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "typedInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "decimal"],
      "properties": {
        "kind": {"const": "integer"},
        "type": {
          "enum": [
            "Int8", "UInt8", "Int16", "UInt16", "Int32", "UInt32",
            "Int64", "UInt64", "Int128", "UInt128", "BigInt"
          ]
        },
        "decimal": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"}
      }
    },
    "float16": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "bits"],
      "properties": {
        "kind": {"const": "binary_float"},
        "type": {"const": "Float16"},
        "bits": {"type": "string", "pattern": "^[0-9a-f]{4}$"}
      }
    },
    "float32": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "bits"],
      "properties": {
        "kind": {"const": "binary_float"},
        "type": {"const": "Float32"},
        "bits": {"type": "string", "pattern": "^[0-9a-f]{8}$"}
      }
    },
    "float64": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "bits"],
      "properties": {
        "kind": {"const": "binary_float"},
        "type": {"const": "Float64"},
        "bits": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    },
    "bigfloat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "precision_bits", "decimal"],
      "properties": {
        "kind": {"const": "bigfloat"},
        "precision_bits": {"type": "integer", "minimum": 2},
        "decimal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000000,
          "pattern": "^-?[0-9]+(?:\\.[0-9]+)?(?:e[+-][0-9]+)?$"
        }
      }
    },
    "typedReal": {
      "oneOf": [
        {"$ref": "#/$defs/typedInteger"},
        {"$ref": "#/$defs/float16"},
        {"$ref": "#/$defs/float32"},
        {"$ref": "#/$defs/float64"},
        {"$ref": "#/$defs/bigfloat"}
      ]
    },
    "typedValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "nothing"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "bool"}, "value": {"type": "boolean"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "string"}, "value": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "symbol"}, "value": {"$ref": "#/$defs/stableId"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "version"}, "value": {"$ref": "#/$defs/semver"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {"kind": {"const": "real"}, "value": {"$ref": "#/$defs/typedReal"}}
        }
      ]
    },
    "metadataEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": {
        "key": {"$ref": "#/$defs/stableId"},
        "value": {"$ref": "#/$defs/typedValue"}
      }
    },
    "branchDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_node", "key"],
      "properties": {
        "choice_node": {"$ref": "#/$defs/stableId"},
        "key": {"$ref": "#/$defs/stableId"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "task_id", "shell", "source_configuration"],
      "properties": {
        "lane": {"enum": ["iid", "heuristic", "shell", "pending", "refinement"]},
        "task_id": {"$ref": "#/$defs/uInt64"},
        "shell": {"type": ["integer", "null"], "minimum": 0},
        "source_configuration": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/positiveUInt64"}]
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "configuration_id", "lane", "coordinates", "shell",
        "source_configuration", "metadata"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/positiveUInt64"},
        "configuration_id": {"$ref": "#/$defs/positiveUInt64"},
        "lane": {"enum": ["iid", "heuristic", "shell", "refinement"]},
        "coordinates": {"type": "array", "items": {"$ref": "#/$defs/typedReal"}},
        "shell": {"type": ["integer", "null"], "minimum": 0},
        "source_configuration": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/positiveUInt64"}]
        },
        "metadata": {
          "type": "array",
          "items": {"$ref": "#/$defs/metadataEntry"}
        }
      }
    },
    "typedEnclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/typedReal"},
        "upper": {"$ref": "#/$defs/typedReal"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "media_type", "payload_base64", "digest"],
      "properties": {
        "scheme": {"$ref": "#/$defs/stableId"},
        "media_type": {"type": "string", "minLength": 1},
        "payload_base64": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "validationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_hash", "configuration_hash", "method", "precision_bits",
        "independent", "artifact"
      ],
      "properties": {
        "problem_hash": {"$ref": "#/$defs/sha256"},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "method": {"$ref": "#/$defs/stableId"},
        "precision_bits": {"type": "integer", "minimum": 53},
        "independent": {"const": true},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "guardEnclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "enclosure", "strict"],
      "properties": {
        "node": {"$ref": "#/$defs/stableId"},
        "enclosure": {"$ref": "#/$defs/typedEnclosure"},
        "strict": {"type": "boolean"}
      }
    },
    "provisionalAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target", "canonical_residual_bound", "branch_signature",
        "guard_enclosures", "validation", "exact_failure", "exact_failure_detail"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/typedEnclosure"},
        "canonical_residual_bound": {"$ref": "#/$defs/typedReal"},
        "branch_signature": {
          "type": "array",
          "items": {"$ref": "#/$defs/branchDecision"}
        },
        "guard_enclosures": {
          "type": "array",
          "items": {"$ref": "#/$defs/guardEnclosure"}
        },
        "validation": {"$ref": "#/$defs/validationEvidence"},
        "exact_failure": {
          "enum": [
            "capability_missing", "non_algebraic", "recognition_failed",
            "configuration_certificate_failed", "target_certificate_failed",
            "guard_not_separated", "singular", "budget_exhausted", "unsupported"
          ]
        },
        "exact_failure_detail": {"type": "string"}
      }
    },
    "verifiedPayload": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "provisional_answer"},
            "value": {"$ref": "#/$defs/provisionalAnswer"}
          }
        }
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id", "configuration_id", "canonical_near_feasible", "canonical_valid",
        "target", "target_identity", "branch_signature", "verified",
        "verified_payload", "needs_refinement", "residual_score", "oracle_work",
        "endpoint", "diagnostic"
      ],
      "properties": {
        "task_id": {"$ref": "#/$defs/positiveUInt64"},
        "configuration_id": {"$ref": "#/$defs/positiveUInt64"},
        "canonical_near_feasible": {"type": "boolean"},
        "canonical_valid": {"type": "boolean"},
        "target": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/typedEnclosure"}]
        },
        "target_identity": {"type": ["string", "null"]},
        "branch_signature": {
          "type": "array",
          "items": {"$ref": "#/$defs/branchDecision"}
        },
        "verified": {"type": "boolean"},
        "verified_payload": {"$ref": "#/$defs/verifiedPayload"},
        "needs_refinement": {"type": "boolean"},
        "residual_score": {"$ref": "#/$defs/typedReal"},
        "oracle_work": {"type": "integer", "minimum": 0},
        "endpoint": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"$ref": "#/$defs/typedReal"}}
          ]
        },
        "diagnostic": {"type": ["string", "null"]}
      }
    },
    "candidateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "proposal", "observation"],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "proposal": {"$ref": "#/$defs/proposal"},
        "observation": {"$ref": "#/$defs/observation"}
      }
    },
    "budgetLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposals", "local_attempts", "refinements", "oracle_work"],
      "properties": {
        "proposals": {"type": ["integer", "null"], "minimum": 0},
        "local_attempts": {"type": ["integer", "null"], "minimum": 0},
        "refinements": {"type": ["integer", "null"], "minimum": 0},
        "oracle_work": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "budgetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits", "proposals", "local_attempts", "refinements", "oracle_work"],
      "properties": {
        "limits": {"$ref": "#/$defs/budgetLimits"},
        "proposals": {"type": "integer", "minimum": 0},
        "local_attempts": {"type": "integer", "minimum": 0},
        "refinements": {"type": "integer", "minimum": 0},
        "oracle_work": {"type": "integer", "minimum": 0}
      }
    },
    "budgetCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposals", "local_attempts", "refinements", "oracle_work"],
      "properties": {
        "proposals": {"type": "integer", "minimum": 0},
        "local_attempts": {"type": "integer", "minimum": 0},
        "refinements": {"type": "integer", "minimum": 0},
        "oracle_work": {"type": "integer", "minimum": 0}
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["served", "total_actions", "next_task_id", "shell_ticks"],
      "properties": {
        "served": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {"type": "integer", "minimum": 0}
        },
        "total_actions": {"type": "integer", "minimum": 0},
        "next_task_id": {"$ref": "#/$defs/positiveUInt64"},
        "shell_ticks": {"type": "integer", "minimum": 0}
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["history", "scheduler", "pending", "refinement_queue", "adaptive_unbounded"],
      "properties": {
        "history": {"type": "array", "items": {"$ref": "#/$defs/candidateRecord"}},
        "scheduler": {"$ref": "#/$defs/scheduler"},
        "pending": {"type": "array", "items": {"$ref": "#/$defs/proposal"}},
        "refinement_queue": {"type": "array", "items": {"$ref": "#/$defs/positiveUInt64"}},
        "adaptive_unbounded": {"type": "boolean"}
      }
    },
    "scheduledEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"const": "scheduled"},
        "payload": {"$ref": "#/$defs/decision"}
      }
    },
    "proposedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"const": "proposed"},
        "payload": {"$ref": "#/$defs/proposal"}
      }
    },
    "observedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"const": "observed"},
        "payload": {"$ref": "#/$defs/observation"}
      }
    },
    "budgetEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"const": "budget_charged"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["charge", "snapshot"],
          "properties": {
            "charge": {"$ref": "#/$defs/budgetCharge"},
            "snapshot": {"$ref": "#/$defs/budgetSnapshot"}
          }
        }
      }
    },
    "statusEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"const": "status"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "detail"],
          "properties": {
            "status": {
              "enum": [
                "running", "deadline_reached", "cancelled", "budget_exhausted",
                "paused", "callback_error", "protocol_error"
              ]
            },
            "detail": {"type": ["string", "null"]}
          }
        }
      }
    },
    "failureEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "kind", "payload"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["callback_failed", "protocol_failed"]},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "error_type", "message"],
          "properties": {
            "stage": {"$ref": "#/$defs/stableId"},
            "error_type": {"type": "string"},
            "message": {"type": "string"}
          }
        }
      }
    },
    "event": {
      "oneOf": [
        {"$ref": "#/$defs/scheduledEvent"},
        {"$ref": "#/$defs/proposedEvent"},
        {"$ref": "#/$defs/observedEvent"},
        {"$ref": "#/$defs/budgetEvent"},
        {"$ref": "#/$defs/statusEvent"},
        {"$ref": "#/$defs/failureEvent"}
      ]
    },
    "rngState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "seed"],
      "properties": {
        "kind": {"const": "counter_seed"},
        "seed": {"$ref": "#/$defs/uInt64"}
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resume_identity", "policy_version", "budget", "workspace", "events",
        "rng_state", "precision_bits", "remaining_seconds", "cancelled"
      ],
      "properties": {
        "resume_identity": {"$ref": "#/$defs/environmentLock"},
        "policy_version": {"$ref": "#/$defs/semver"},
        "budget": {"$ref": "#/$defs/budgetSnapshot"},
        "workspace": {"$ref": "#/$defs/workspace"},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "rng_state": {"$ref": "#/$defs/rngState"},
        "precision_bits": {"type": "integer", "minimum": 2},
        "remaining_seconds": {"$ref": "#/$defs/float64"},
        "cancelled": {"type": "boolean"}
      }
    }
  }
}
