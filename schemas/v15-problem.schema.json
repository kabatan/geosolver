{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/schemas/v15-problem.schema.json",
  "title": "GeoTarget V15 Problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "id", "variables", "construction", "constraints", "guards", "answer", "post_process"],
  "properties": {
    "task": {"const": "solve"},
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names"],
      "properties": {"names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}}}
    },
    "construction": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "expr"],
        "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "expr": {"type": "string", "minLength": 1}}
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["def", "value"],
        "properties": {"def": {"type": "string", "minLength": 1}, "value": {"type": ["number", "string"]}}
      }
    },
    "guards": {"type": "array", "items": {"type": "string"}},
    "answer": {"type": "string", "minLength": 1},
    "post_process": {"type": "string"}
  }
}
