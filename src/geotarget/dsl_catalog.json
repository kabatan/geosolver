  "tools": [
    {"id": "Point", "category": "points", "label_ja": "座標で点を作る", "signature": "Point(0, 0)", "authoring_status": "supported"},
    {"id": "PointOnLine", "category": "points", "label_ja": "直線上の点", "signature": "PointOnLine(line, t)", "authoring_status": "supported"},
    {"id": "PointOnSegment", "category": "points", "label_ja": "線分上の点", "signature": "PointOnSegment(A, B, t)", "authoring_status": "supported", "notes_ja": "tの自然範囲はBound(t,(0,1))で明示します。"},
    {"id": "PointOnCircle", "category": "points", "label_ja": "円上の点", "signature": "PointOnCircle(omega, t)", "authoring_status": "supported", "notes_ja": "tは周期1のパラメータです。"},
    {"id": "PointOnArc", "category": "points", "label_ja": "円弧上の点", "signature": "PointOnArc(arc, t)", "authoring_status": "legacy_read_only", "notes_ja": "major/minor arcとbranch cutの意味を完全には保存しないため、新規問題では使用しません。"},
    {"id": "Intersect", "category": "points", "label_ja": "交点", "signature": "Intersect(line1, line2)", "authoring_status": "advanced", "notes_ja": "複数交点ではexclude、near、farなどsourceに根拠のあるselectorを明示します。"},
    {"id": "IntersectLines", "category": "points", "label_ja": "2直線の交点（低水準）", "signature": "IntersectLines(line1, line2)", "authoring_status": "legacy_read_only", "notes_ja": "新規問題ではIntersectへ統一します。"},
    {"id": "IntersectLineCircle", "category": "points", "label_ja": "直線と円の交点リスト", "signature": "IntersectLineCircle(line, omega)", "authoring_status": "legacy_read_only", "notes_ja": "listを返し、その順序にbranch semanticsはありません。"},
    {"id": "IntersectCircles", "category": "points", "label_ja": "2円の交点リスト", "signature": "IntersectCircles(circle1, circle2)", "authoring_status": "legacy_read_only", "notes_ja": "listを返し、その順序にbranch semanticsはありません。"},
    {"id": "Midpoint", "category": "points", "label_ja": "中点", "signature": "Midpoint(A, B)", "authoring_status": "supported"},
    {"id": "ClosestPoint", "category": "points", "label_ja": "最近点", "signature": "ClosestPoint(P, line)", "authoring_status": "supported", "notes_ja": "新規問題では高精度互換なPoint-Line形を使用します。"},

    {"id": "Line", "category": "lines", "label_ja": "2点を通る直線", "signature": "Line(A, B)", "authoring_status": "supported"},
    {"id": "Segment", "category": "lines", "label_ja": "線分", "signature": "Segment(A, B)", "authoring_status": "supported"},
    {"id": "Ray", "category": "lines", "label_ja": "半直線", "signature": "Ray(A, B)", "authoring_status": "advanced", "notes_ja": "AとBは異なる点である必要があります。"},
    {"id": "Vector", "category": "lines", "label_ja": "ベクトル", "signature": "Vector(A, B)", "authoring_status": "supported"},
