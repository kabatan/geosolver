    {"id": "TangentLine", "category": "relations", "label_ja": "接線（旧形式）", "signature": "TangentLine(P, omega, use_first=True)", "authoring_status": "legacy_read_only", "notes_ja": "通常精度と高精度で互換問題があるため、接線はlineのparameterizationとIsTangentで表します。"},
    {"id": "ContactPoint", "category": "relations", "label_ja": "接点", "signature": "ContactPoint(omega, line)", "authoring_status": "advanced", "notes_ja": "垂足を返すだけで接すること自体は検証しないため、IsTangentを別に残します。"},
    {"id": "TangentAtPoint", "category": "relations", "label_ja": "接点における接線", "signature": "Polar(P, omega)", "authoring_status": "supported", "notes_ja": "円周上の点Pにおける接線をPolar(P, omega)として作図します。Pが円周上にない場合は作図しません。"},

    {"id": "Reflect", "category": "transforms", "label_ja": "鏡映", "signature": "Reflect(P, line)", "authoring_status": "supported"},
    {"id": "Rotate", "category": "transforms", "label_ja": "回転（旧形式）", "signature": "Rotate(P, angle, center=O)", "authoring_status": "legacy_read_only", "notes_ja": "通常精度と高精度で引数互換問題があるため、新規問題では明示座標式を使います。"},

    {"id": "Centroid", "category": "centers", "label_ja": "重心", "signature": "Centroid(A, B, C)", "authoring_status": "advanced", "notes_ja": "sourceがこの中心を直接定義する場合だけ使用します。"},
    {"id": "Incenter", "category": "centers", "label_ja": "内心", "signature": "Incenter(A, B, C)", "authoring_status": "advanced", "notes_ja": "sourceがこの中心を直接定義する場合だけ使用します。"},
