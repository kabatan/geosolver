    {"id": "Radius", "category": "measurements", "label_ja": "半径", "signature": "Radius(omega)", "authoring_status": "supported"},
    {"id": "Circumference", "category": "measurements", "label_ja": "円周", "signature": "Circumference(omega)", "authoring_status": "supported"},
