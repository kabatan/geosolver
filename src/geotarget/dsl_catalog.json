    {"id": "Polygon", "category": "polygons", "label_ja": "多角形", "signature": "Polygon([A, B, C])", "authoring_status": "advanced", "notes_ja": "頂点は複数引数ではなく1個のlistとして渡します。"},
    {"id": "RegularPolygon", "category": "polygons", "label_ja": "正多角形", "signature": "RegularPolygon(A, B, 3, ccw=True)", "authoring_status": "advanced", "notes_ja": "ccwは鏡映branchです。sourceが向きを指定しない場合に一方へ固定してはいけません。"},
    {"id": "InscribedPolygonVertices", "category": "polygons", "label_ja": "円に内接する多角形", "signature": "円を選択し、頂点数を指定", "authoring_status": "supported", "notes_ja": "円と頂点数から、基準となる固定頂点、残りの円周上の自由点、その多角形をまとめて作成します。"},
    {"id": "InscribedPolygon", "category": "polygons", "label_ja": "円に内接する多角形（旧形式）", "signature": "InscribedPolygon(omega, t2, t3)", "authoring_status": "legacy_read_only", "notes_ja": "通常精度と高精度でreturn representationが一致しないため、新規問題では使用しません。"},

    {"id": "ParallelLine", "category": "relations", "label_ja": "平行線", "signature": "ParallelLine(line, P)", "authoring_status": "supported"},
