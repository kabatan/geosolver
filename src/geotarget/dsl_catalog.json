    {"id": "Perpendicular", "category": "constraints", "label_ja": "垂直", "signature": "Perpendicular(line1, line2)", "authoring_status": "supported"},

    {"id": "Assume", "category": "guards", "label_ja": "一般条件", "signature": "Assume(P.y > 0)", "authoring_status": "advanced", "notes_ja": "画面では条件式をそのまま入力します。"},
