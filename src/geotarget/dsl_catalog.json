    {"id": "Excircle", "category": "centers", "label_ja": "傍接円", "signature": "Excircle(A, B, C, vertex='A')", "authoring_status": "advanced"},
    {"id": "NinePointCircle", "category": "centers", "label_ja": "九点円", "signature": "NinePointCircle(A, B, C)", "authoring_status": "advanced"},
    {"id": "IncircleContactPoint", "category": "centers", "label_ja": "内接円の接点", "signature": "IncircleContactPoint(A, B, C, side='BC')", "authoring_status": "advanced"},

    {"id": "Distance", "category": "measurements", "label_ja": "距離", "signature": "Distance(A, B)", "authoring_status": "supported", "notes_ja": "新規問題ではPoint-PointまたはPoint-Lineの2引数形を使用します。"},
    {"id": "Ratio", "category": "measurements", "label_ja": "2つの長さの比", "signature": "Distance(A, B) / Distance(C, D)", "authoring_status": "supported", "notes_ja": "4点を順に選び、AB/CDを測定値として作成します。"},
    {"id": "Length", "category": "measurements", "label_ja": "長さ", "signature": "Length(segment)", "authoring_status": "supported"},
