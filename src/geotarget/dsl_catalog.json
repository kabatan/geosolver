    {"id": "AssumeLe", "category": "guards", "label_ja": "以下", "signature": "AssumeLe(lhs, rhs)", "authoring_status": "supported", "notes_ja": "左辺が右辺以下の配置だけを探索対象にします。等号を許さない場合は「未満」を使います。"},
    {"id": "AssumeGt", "category": "guards", "label_ja": "より大きい", "signature": "AssumeGt(lhs, rhs)", "authoring_status": "supported"},
    {"id": "AssumeGe", "category": "guards", "label_ja": "以上", "signature": "AssumeGe(lhs, rhs)", "authoring_status": "supported"},
    {"id": "Bound", "category": "guards", "label_ja": "変数の範囲", "signature": "Bound(t, (0, 1))", "authoring_status": "supported", "notes_ja": "幾何parameterの自然domainだけに使用します。"},
    {"id": "AssumeAcute", "category": "guards", "label_ja": "鋭角三角形", "signature": "AssumeAcute(A, B, C)", "authoring_status": "supported"},
    {"id": "AssumeRight", "category": "guards", "label_ja": "直角三角形", "signature": "AssumeRight(A, B, C)", "authoring_status": "supported"},
    {"id": "AssumeObtuse", "category": "guards", "label_ja": "鈍角三角形", "signature": "AssumeObtuse(A, B, C)", "authoring_status": "supported"},
    {"id": "AssumeConvex", "category": "guards", "label_ja": "凸多角形", "signature": "AssumeConvex([A, B, C, D])", "authoring_status": "advanced"},
    {"id": "AssumeNoSelfIntersecting", "category": "guards", "label_ja": "自己交差しない", "signature": "AssumeNoSelfIntersecting([A, B, C, D])", "authoring_status": "advanced"},
    {"id": "AssumeOrder", "category": "guards", "label_ja": "点の順序（旧形式）", "signature": "AssumeOrder(A, P, B)", "authoring_status": "legacy_read_only", "notes_ja": "高精度guardとの型互換問題があるため、PointOnSegmentとBoundまたはOnSegmentを使います。"},

    {"id": "RadicalAxis", "category": "advanced", "label_ja": "根軸", "signature": "RadicalAxis(circle1, circle2)", "authoring_status": "advanced"},
    {"id": "Polar", "category": "advanced", "label_ja": "極線", "signature": "Polar(P, omega)", "authoring_status": "advanced"},
    {"id": "Pole", "category": "advanced", "label_ja": "極", "signature": "Pole(line, omega)", "authoring_status": "advanced"},
    {"id": "PowerOfPoint", "category": "advanced", "label_ja": "点の冪", "signature": "PowerOfPoint(P, omega)", "authoring_status": "advanced"},
    {"id": "IsodynamicPoint", "category": "advanced", "label_ja": "等力点", "signature": "IsodynamicPoint(A, B, C, first=True)", "authoring_status": "advanced", "notes_ja": "firstはbranchです。sourceとの対応を明示します。"},
    {"id": "FeuerbachPoint", "category": "advanced", "label_ja": "フォイエルバッハ点", "signature": "FeuerbachPoint(A, B, C)", "authoring_status": "advanced"},
    {"id": "Mittenpunkt", "category": "advanced", "label_ja": "ミッテン点", "signature": "Mittenpunkt(A, B, C)", "authoring_status": "advanced"},
    {"id": "SpiekerCenter", "category": "advanced", "label_ja": "シュピーカー中心", "signature": "SpiekerCenter(A, B, C)", "authoring_status": "advanced"}
  ]
}
