option(redSB);
LIB "primdec.lib";
ring r = 0, (x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12), dp;
ideal I = x4^2 - 3,
-x10^2 - x11^2 + 6*x11 + x5^2 - 9,
x0 - x1*x4 + 3*x4,
4*x0^2 - 4*x0*x10 + 4*x1^2 - 4*x1*x11 - 12*x1 + x10^2 + x11^2 + 6*x11 - x5^2 + 9,
3*x2 + 4*x3 - 12,
x10^2 - 4*x10*x2 + x11^2 - 4*x11*x3 + 6*x11 + 4*x2^2 + 4*x3^2 - 12*x3 - x5^2 + 9,
9*x4^2 - x6^2 + 9,
x6 - 6,
-2*x10*x11*x4 + x11^2*x4^2 - x11^2 - 6*x11*x4^2,
24*x10*x11 + 7*x11^2 - 96*x11,
x0^2 + x1^2 - x7^2,
x2^2 + x3^2 - x8^2,
x7^2 - x8^2*x9,
x11*x12*x8 - 1;
int t0 = rtimer; ideal G = std(I);
print("DIM"); print(dim(G)); print("INDEP"); print(indepSet(G));
poly P = 64*x9 - 75;
poly red = reduce(P, G);
print("MEMBER"); print(red == 0);
ideal E = eliminate(I, x0*x1*x2*x3*x4*x5*x6*x7*x8*x10*x11*x12);
print("ELIM"); print(E); print("ENDELIM");
poly Q; if (red == 0) { Q = P; } else { Q = E[1]; }
if (Q == 0) { print("COFACTORS"); print("@END"); quit; }
matrix C = lift(I, Q);
print("CHECK"); poly chk = Q; int i; for (i = 1; i <= ncols(I); i++) { chk = chk - C[i,1]*I[i]; } print(chk == 0);
print("COFACTORS"); for (i = 1; i <= ncols(I); i++) { print("@C"); print(C[i,1]); } print("@END");
print("TIME"); print(rtimer - t0);
quit;
