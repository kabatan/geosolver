option(redSB);
LIB "primdec.lib";
ring r = 0, (x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13), dp;
ideal I = -x0*x10*x11 + x0*x12*x9 + x10^2*x12 + x10*x11*x9 - x10*x12^2 - x11*x12*x9,
-x1*x10*x11 + x1*x12*x9 + x10*x11*x12 - x10*x12*x9 + x11^2*x9 - x11*x9^2,
-x10^2*x12 + x10*x11^2 - 2*x10*x11*x2 + x10*x12^2 + 2*x12*x2*x9 - x12*x9^2,
x10^2*x11 - 2*x10*x11*x3 - x11^2*x9 + x11*x9^2 - x12^2*x9 + 2*x12*x3*x9,
x10^2 - 2*x10*x3 + x2^2 - 2*x2*x9 + x3^2 - x4^2 + x9^2,
x4 - 11,
16*x0^2 - 8*x0*x11 - 16*x0*x2 + 16*x1^2 - 8*x1*x12 - 16*x1*x3 + x11^2 + 4*x11*x2 + x12^2 + 4*x12*x3 + 4*x2^2 + 4*x3^2 - 4*x5^2,
x5 - 11,
x0^2 - 2*x0*x2 + x1^2 - 2*x1*x3 + x2^2 + x3^2 - x6^2,
x6 - 7,
-x11^2 - x12^2 + x7^2,
x7^2 - x8,
-x10*x11*x13 + x12*x13*x9 - 1;
int t0 = rtimer; ideal G = std(I);
print("DIM"); print(dim(G)); print("INDEP"); print(indepSet(G));
poly P = x8 - 288;
poly red = reduce(P, G);
print("MEMBER"); print(red == 0);
ideal E = eliminate(I, x0*x1*x2*x3*x4*x5*x6*x7*x9*x10*x11*x12*x13);
print("ELIM"); print(E); print("ENDELIM");
poly Q; if (red == 0) { Q = P; } else { Q = E[1]; }
matrix C = lift(I, Q);
print("CHECK"); poly chk = Q; int i; for (i = 1; i <= ncols(I); i++) { chk = chk - C[i,1]*I[i]; } print(chk == 0);
print("COFACTORS"); for (i = 1; i <= ncols(I); i++) { print("@C"); print(C[i,1]); } print("@END");
print("TIME"); print(rtimer - t0);
quit;
