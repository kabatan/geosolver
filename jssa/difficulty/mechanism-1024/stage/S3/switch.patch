diff --git a/src/geosolver/engine/standard/refinement/s3_tangency.py b/src/geosolver/engine/standard/refinement/s3_tangency.py
new file mode 100644
--- /dev/null
+++ b/src/geosolver/engine/standard/refinement/s3_tangency.py
@@ -0,0 +1,71 @@
+"""S3 refinement-only tangency switch; the absent switch is frozen T2."""
+
+import ast
+import os
+from functools import lru_cache
+
+
+def tangency_mode():
+    mode = os.environ.get("GEOSOLVER_S3_TANGENCY_MODE", "T2")
+    if mode not in {"T0", "T1", "T2"}:
+        raise ValueError("GEOSOLVER_S3_TANGENCY_MODE must be T0, T1 or T2")
+    return mode
+
+
+@lru_cache(maxsize=256)
+def distance_radius_sources(constructions, equalities):
+    """Match the frozen Distance/Line/Circle syntax, without requiring contact.
+
+    T1 uses the normalized line coefficients, not a contact point.  Resolve
+    aliases exactly as distance_contact_sources does; do not infer incidence.
+    """
+    from geosolver.engine.standard.problem.tangency_contacts import _parse
+    from geosolver.problem.expression_source import source_expression
+
+    definitions = {name: _parse(source) for name, source in constructions}
+
+    def resolve(node):
+        seen = set()
+        while isinstance(node, ast.Name) and node.id in definitions:
+            if node.id in seen:
+                raise ValueError("cyclic construction")
+            seen.add(node.id)
+            node = definitions[node.id]
+        return node
+
+    def call(node, name):
+        return (
+            isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Name)
+            and node.func.id == name
+            and len(node.args) == 2
+            and not node.keywords
+        )
+
+    def same(a, b):
+        return source_expression(resolve(a)) == source_expression(resolve(b))
+
+    result = {}
+    try:
+        circles = [(name, resolve(node)) for name, node in definitions.items()]
+        circles = [(name, node) for name, node in circles if call(node, "Circle")]
+        for index, (lhs, rhs) in enumerate(equalities):
+            a, b = _parse(lhs), _parse(str(rhs))
+            for distance, radius in ((resolve(a), b), (resolve(b), a)):
+                if not call(distance, "Distance"):
+                    continue
+                for point, line in (distance.args, distance.args[::-1]):
+                    if not call(resolve(line), "Line"):
+                        continue
+                    for name, circle in circles:
+                        if not same(point, circle.args[0]) or not same(radius, circle.args[1]):
+                            continue
+                        line_source = f"({source_expression(line)})"
+                        delta = (
+                            f"({line_source}.a*Center({name}).x"
+                            f"+{line_source}.b*Center({name}).y+{line_source}.c)"
+                        )
+                        result[index] = f"{delta}**2-Radius({name})**2"
+        return result
+    except (ValueError, TypeError, RecursionError):
+        return {}
