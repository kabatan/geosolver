diff --git a/src/geosolver/engine/standard/search/residual_selection.py b/src/geosolver/engine/standard/search/residual_selection.py
new file mode 100644
index 0000000..63be34b
--- /dev/null
+++ b/src/geosolver/engine/standard/search/residual_selection.py
@@ -0,0 +1,34 @@
+"""Residual-only selection at the search-to-refinement handoff."""
+
+import math
+
+from geosolver.engine.standard.evaluation.classify_evaluation_failure import EvaluationStatus
+
+
+def eligible_selection_pool(records, fallback):
+    """Keep the ordinary backend's admission and its original fallback pool."""
+    feasible = tuple(
+        record for record in records
+        if record.evaluation_status is EvaluationStatus.OK
+        and record.guard_ok and record.hard_feasible
+    )
+    return feasible or tuple(fallback)
+
+
+def refinement_selection_pool(result):
+    # Direct algebraic/finite/integer producers already apply their own admission.
+    pool = result.refinement_selection_pool
+    return result.candidates if pool is None else pool
+
+
+def select_residual_candidates(records):
+    """Stable raw-norm top 20; no coordinate deduplication or seed allocation."""
+    unique = {}
+    for index, record in enumerate(records):
+        if math.isfinite(record.residual_norm_float):
+            unique.setdefault(record.candidate_uid, (index, record))
+    ordered = sorted(
+        unique.values(),
+        key=lambda item: (item[1].residual_norm_float, item[1].candidate_uid, item[0]),
+    )
+    return tuple(record for _index, record in ordered[:20])
