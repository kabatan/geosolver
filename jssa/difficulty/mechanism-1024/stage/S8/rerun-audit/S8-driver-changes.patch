+        error = data.get('error')
+        result_stderr_tail = str(data.get('diagnostics', {}).get('stderr', ''))[-8000:]
+        del data  # No status, answers, reference, or correctness inspection.
+    outer_tails = {}
+    for p in (raw / '0578').glob('stderr.log.*'):
