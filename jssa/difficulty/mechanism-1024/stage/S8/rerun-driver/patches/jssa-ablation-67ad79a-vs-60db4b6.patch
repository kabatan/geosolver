diff --git a/src/geosolver/runtime/ablation.py b/src/geosolver/runtime/ablation.py
new file mode 100644
index 0000000..f939875
--- /dev/null
+++ b/src/geosolver/runtime/ablation.py
@@ -0,0 +1,20 @@
+"""Research-only ablation switches read from GEOSOLVER_ABLATE_* environment variables."""
+
+import os
+
+ABLATIONS = (
+    "NO_ALGEBRAIC",
+    "NO_NOMAD",
+    "NO_ANALYTIC_JAC",
+    "NO_RESCUE",
+    "NO_SCALE_CHART",
+    "NO_SECOND_ATTEMPT",
+)
+
+
+def ablated(name: str) -> bool:
+    return os.environ.get(f"GEOSOLVER_ABLATE_{name}") == "1"
+
+
+def active_ablations() -> list[str]:
+    return [name for name in ABLATIONS if ablated(name)]
