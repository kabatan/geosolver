LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1^2 - x5^2 - x6^2,
x1 - 7,
x2^2 - 3,
x3^2 - x6^2*x8^2 + 12*x6^2*x8 - 36*x6^2,
x2*x5*x8 - 6*x2*x5 - x2*x8^2 + 6*x2*x8 + x3,
x5^2*x7 - x5^2 - x5*x7*x8 + 6*x5 + x6^2*x7 - x6^2,
x4^2 - x5^2*x7^2 + 2*x5^2*x7 - x5^2 + 2*x5*x7^2*x8 - 2*x5*x7*x8 - 12*x5*x7 + 12*x5 - x6^2*x7^2 + 2*x6^2*x7 - x6^2 - x7^2*x8^2 + 12*x7*x8 - 36,
x4 - 4;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
