LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x5^2 - 3,
8*x1*x5 - 16*x10*x5^2 - x10 - 3,
4*x2*x5 - 4*x5^2 - 1,
16*x1^2*x3 - 24*x1^2 - 32*x1*x2*x3 + 72*x1*x2 + 16*x2^2*x3 - 48*x2^2 + 9*x3,
16*x1^2*x4 - 32*x1*x2*x4 + 18*x1 + 16*x2^2*x4 - 36*x2 + 9*x4,
16*x5^2 - x6^2 + 16,
x6 - 8,
16*x5^2 - x7^2 + 1,
x7 - 7,
16*x10^2*x5^2 + x10^2 + 6*x10 - x8^2 + 9,
16*x10^2*x5^2 + x10^2 - 32*x10*x5^2 - 2*x10 + 16*x5^2 - x9^2 + 1,
x8 - x9,
x10*x11*x5 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
