LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22),dp;
short=0;
ideal J=-x1^2 + 7*x1 - x2^2 + 2*x2*x7,
x18^2 - x3^2 - x4^2,
-x1^2 + x19^2 - x2^2,
-x1^2 + 2*x1*x3 - x2^2 + 2*x2*x4 + x20^2 - x3^2 - x4^2,
-x1*x18 + x18*x8 - x19*x3 + x19*x8 + x20*x8,
-x18*x2 + x18*x9 - x19*x4 + x19*x9 + x20*x9,
x1*x10*x4 - x1*x10*x9 + x1*x3*x9 - x1*x4*x8 - x10*x2*x3 + x10*x2*x8 - 7*x10*x4 + 7*x10*x9 + 7*x2*x3 - 7*x2*x8 - 7*x3*x9 + 7*x4*x8,
x1*x11*x4 - x1*x11*x9 - x11*x2*x3 + x11*x2*x8 - 7*x11*x4 + 7*x11*x9 + x2*x3*x9 - x2*x4*x8 + 7*x2*x4 - 7*x2*x9,
-x1^2 + 14*x1 - x2^2 + x21^2 - 49,
x21 - 18,
x10^2 - 14*x10 + x11^2 - x12^2 + 49,
x12 - 5,
x13^2 - x3^2 + 2*x3*x5 - x4^2 + 2*x4*x6 - x5^2 - x6^2,
x10^2 - 2*x10*x5 + x11^2 - 2*x11*x6 - x14^2 + x5^2 + x6^2,
x10^2 - 2*x10*x3 + x11^2 - 2*x11*x4 - x15^2 + x3^2 + x4^2,
x13 + x14 - x15,
x10*x4 - x10*x6 - x11*x3 + x11*x5 + x3*x6 - x4*x5,
-x1*x11 + x10*x2 + 7*x11 - 7*x2,
-x3^2 + 7*x3 - x4^2 + 2*x4*x7,
-x1^2*x4^2 + 2*x1^2*x4*x6 - x1^2*x6^2 + 2*x1*x2*x3*x4 - 2*x1*x2*x3*x6 - 2*x1*x2*x4*x5 + 2*x1*x2*x5*x6 - 2*x1*x3*x4*x6 + 2*x1*x3*x6^2 + 2*x1*x4^2*x5 - 2*x1*x4*x5*x6 + x16^2 - x2^2*x3^2 + 2*x2^2*x3*x5 - x2^2*x5^2 + 2*x2*x3^2*x6 - 2*x2*x3*x4*x5 - 2*x2*x3*x5*x6 + 2*x2*x4*x5^2 - x3^2*x6^2 + 2*x3*x4*x5*x6 - x4^2*x5^2,
x10^2*x4^2 - 2*x10*x11*x3*x4 + x11^2*x3^2 - x17^2,
-x1^2*x17 + x1*x17*x3 + x1*x17*x5 + x10^2*x16 - x10*x16*x3 + x11^2*x16 - x11*x16*x4 - x17*x2^2 + x17*x2*x4 + x17*x2*x6 - x17*x3*x5 - x17*x4*x6,
x14 - 3,
x13 - x22;
J=sat(J,ideal(x18 + x19 + x20));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x4));
print("SAT_FACTOR=3");
J=sat(J,ideal(x6));
print("SAT_FACTOR=4");
J=sat(J,ideal(4*x7^2 + 49));
print("SAT_FACTOR=5");
J=sat(J,ideal(x3^2 - 2*x3*x8 + x4^2 - 2*x4*x9 + x8^2 + x9^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1*x4 - x1*x9 - x2*x3 + x2*x8 - 7*x4 + 7*x9));
print("SAT_FACTOR=7");
J=sat(J,ideal(x10^2 + x11^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x10^2 - 2*x10*x3 + x11^2 - 2*x11*x4 + x3^2 + x4^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 - 14*x1 + x2^2 + 49));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1^2 - 2*x1*x5 + x2^2 - 2*x2*x6 + x5^2 + x6^2));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=14");
J=sat(J,ideal(x1*x4 - x2*x3 + 7*x2 - 7*x4));
print("SAT_FACTOR=15");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=16");
J=sat(J,ideal(x3^2 - 14*x3 + x4^2 + 49));
print("SAT_FACTOR=17");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
