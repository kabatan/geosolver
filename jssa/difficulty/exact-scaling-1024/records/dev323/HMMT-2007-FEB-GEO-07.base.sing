LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x1^2 - 3,
49*x1^2 - 4*x2^2 + 49,
x2 - 7,
2401*x1^2 - 4*x3^2,
49*x1 - 2*x3,
x4^2 - x6^2 + 14*x6 - x7^2 - 49,
x4 - 5,
49*x1^2 - 28*x1*x7 - 4*x5^2 + 4*x6^2 - 28*x6 + 4*x7^2 + 49,
x5 - 3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
