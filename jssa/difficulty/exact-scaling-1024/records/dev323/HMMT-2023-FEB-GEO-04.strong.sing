LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=2*x4^2 - 1,
-9*x1^2*x3^4 + 12*x1*x3^4 - 4*x3^4 + 4*x5^2,
5*x1^2*x3^2*x4 - 6*x1*x3^2*x4 + 4*x4*x5,
-9*x2^2*x3^4 + 12*x2*x3^4 - 4*x3^4 + 4*x6^2,
5*x2^2*x3^2*x4 - 6*x2*x3^2*x4 + 4*x4*x6,
-5*x2^2*x3^2 + 4*x7^2,
-5*x1^2*x3^2 + 4*x8^2,
x7 - x8*x9;
J=sat(J,ideal(x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1 - x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2 - 1));
print("SAT_FACTOR=5");
J=sat(J,ideal(x3));
print("SAT_FACTOR=6");
J=sat(J,ideal(5*x1^2 - 4*x1 + 4));
print("SAT_FACTOR=7");
J=sat(J,ideal(5*x1^2 - 8*x1 + 4));
print("SAT_FACTOR=8");
J=sat(J,ideal(5*x2^2 - 4*x2 + 4));
print("SAT_FACTOR=9");
J=sat(J,ideal(5*x2^2 - 8*x2 + 4));
print("SAT_FACTOR=10");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
