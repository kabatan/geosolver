LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x6^2 - 3,
-x1*x6^2 + x2*x6^2 + x2 - 20,
-x1*x6 + x3*x6^2 + x3 + 20*x6,
-x1*x6^2 + x4*x6^2 + x4 + 11*x6^2 - 11,
-x1*x6 + x5*x6^2 + x5 - 11*x6^3 + 11*x6,
121*x6^2 - x7^2 + 121,
x7 - 22,
-x1^2 + x8^2,
x1^2*x6^2 + x1^2 - 4*x9^2,
x8 - x9,
-x10^2 + x2^2 - 2*x2*x4 + x3^2 - 2*x3*x5 + x4^2 + x5^2,
x10 - x11;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 20));
print("SAT_FACTOR=2");
J=sat(J,ideal(x6^2 + 1));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
