LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=x3^2 - 5,
16*x1^4 - 20*x1^2 + 5,
x1^2 + x2^2 - 1,
4*x1^2 + 4*x2^2 - x4^2,
x4 - 2,
x3^2 + 2*x3 - x5^2 + 1,
x3 - x5 + 1,
x3^2 - 2*x3 - x6^2 + 1,
x3 - x6 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
