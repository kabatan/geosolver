LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21),dp;
short=0;
ideal J=x1*x2 - x2^2 - x3^2 + 2*x3*x5,
-x1^2 + x19^2,
-x2^2 + x20^2 - x3^2,
-x1*x20 + x10*x19 + x10*x20 - x19*x2,
x11*x19 + x11*x20 - x19*x3,
x1*x10^2 - x10^2*x12 + 2*x10*x11*x5 - x11^2*x12,
x1*x10*x11 - x10^2*x13 - x11^2*x13 + 2*x11^2*x5,
-x1^2*x14 + x1*x14*x2 - 2*x1*x3*x5 + 2*x14*x3*x5,
-x1^2*x15 + x1^2*x3 + x1*x15*x2 + 2*x15*x3*x5,
-2*x12^2*x15 + 2*x12*x15*x6 - 2*x13^2*x15 + x13*x14^2 - 2*x13*x14*x6 + x13*x15^2,
2*x12^2*x14 - x12*x14^2 - x12*x15^2 + 2*x12*x15*x7 + 2*x13^2*x14 - 2*x13*x14*x7,
-x1*x3 + x1*x9 - x2*x9 + x3*x8,
2*x6*x8 + 2*x7*x9 - x8^2 - x9^2,
4*x4^2 - 3,
-x1^2*x3^2 + x16^2,
2*x1*x2*x4 + x16,
x19 - 3,
x1*x12 - x12^2 - x13^2 + 2*x13*x5,
x1*x11 - x1*x3 + x10*x3 - x11*x2,
x10^2 + x11^2 - x17^2,
x17 - 4,
-x18^2 + 4*x2^2 - 4*x2*x8 + 4*x3^2 - 4*x3*x9 + x8^2 + x9^2,
x18 - x21;
J=sat(J,ideal(x18));
print("SAT_FACTOR=1");
J=sat(J,ideal(x19 + x20));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 + 4*x5^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1*x10 + 2*x11*x5));
print("SAT_FACTOR=6");
J=sat(J,ideal(-x1^2 + x1*x2 + 2*x3*x5));
print("SAT_FACTOR=7");
J=sat(J,ideal(x6^2 + x7^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x14^2 - 2*x14*x8 + x15^2 - 2*x15*x9 + x8^2 + x9^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x10^2 + x11^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x12*x15 - x13*x14));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1^2*x20^2 + 2*x1*x19*x2*x20 + x19^2*x2^2 + x19^2*x3^2));
print("SAT_FACTOR=14");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
