LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=-x1^2 + 2*x1*x3 - x2^2 - x3^2 + x5^2,
-x2^2 + 2*x2*x4 - x3^2 - x4^2 + x9^2,
-x1^2 + x10^2 - x4^2,
x10 + x5 + x9 - 12,
3*x2 + 8*x3 - 24,
x11^2 - 9*x2^2 - 6*x2*x3*x4 + 18*x2*x4 - x3^2*x4^2 + 6*x3*x4^2 - 9*x4^2,
-x1^2*x4^2 + 6*x1*x4^2 + x12^2 - 9*x4^2,
3*x1*x11 + x11*x4^2 + x12*x2*x4 - 3*x12*x3 - x12*x4^2,
-x1^2*x2^2 + 6*x1*x2^2 - 9*x2^2 + x6^2,
-x1^2*x4^2 + x7^2,
x1^2*x6 - x1^2*x7 + x1*x3*x7 + 3*x1*x7 - 3*x3*x7,
-x2^2 + x8^2,
-x13 + x8;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2 - 8));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3));
print("SAT_FACTOR=5");
J=sat(J,ideal(x4));
print("SAT_FACTOR=6");
J=sat(J,ideal(x4 - 8));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 + x4^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 + x3^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x4^2 + 9));
print("SAT_FACTOR=11");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
