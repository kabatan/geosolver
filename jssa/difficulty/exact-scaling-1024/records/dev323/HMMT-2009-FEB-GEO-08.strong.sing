LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=-x1^2 - x2^2 + x5^2,
x5 - 231,
-x1^2 + 562*x1 - x2^2 + x6^2 - 78961,
x6 - 160,
-x3^2 - x4^2 + x7^2,
x7 - 178,
-x3^2 + 562*x3 - x4^2 + x8^2 - 78961,
x8 - 153,
-4*x1^2 + 4*x1*x3 - 4*x2^2 + 4*x2*x4 - x3^2 - x4^2 + 4*x9^2,
-x10 + x9;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x4));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
