LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=x9^2 - 3,
8*x3^3 - 6*x3 + 1,
x3^2 + x4^2 - 1,
8*x5^3 - 6*x5 - 1,
x5^2 + x6^2 - 1,
64*x7^6 - 96*x7^4 + 36*x7^2 - 3,
x7^2 + x8^2 - 1,
-4*x12^2 + x9^2 + 1,
x12 - 1,
-x13^2 + x3^2 + x4^2,
x13 - 1,
-x10^2 + x5^2 + x6^2,
x10 - 1,
x3*x7 + x4*x8,
64*x1^6 - 96*x1^4 + 36*x1^2 - 3,
x1^2 + x2^2 - 1,
-x11^2 + x3^2*x8^2 - 2*x3*x4*x7*x8 - 2*x3*x5*x8^2 + 2*x3*x6*x7*x8 + x4^2*x7^2 + 2*x4*x5*x7*x8 - 2*x4*x6*x7^2 + x5^2*x8^2 - 2*x5*x6*x7*x8 + x6^2*x7^2,
x1*x11 - x2*x3*x7 - x2*x4*x8 + x2*x5*x7 + x2*x6*x8,
x4 - x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
