LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=x8^2 - 3,
4*x1*x8 - 3*x8^2 + 7,
2*x1*x13*x14 - 10*x1*x14 - x13^2*x2 + 10*x13*x2 - x14^2*x2 + 5*x14^2 - 25*x2,
2*x1*x14^2 - x13^2*x3 - 5*x13*x14 + 10*x13*x3 - x14^2*x3 + 25*x14 - 25*x3,
-16*x1*x13*x14 + 24*x1*x13*x8 + 24*x1*x14 - 36*x1*x8 + 8*x13^2*x4 - 28*x13^2 + 24*x13*x14*x8 - 24*x13*x4 - 36*x13*x8^2 + 84*x13 + 8*x14^2*x4 - 12*x14^2 - 24*x14*x4*x8 + 18*x4*x8^2 + 18*x4 + 27*x8^2 - 63,
16*x1*x14^2 - 48*x1*x14*x8 + 36*x1*x8^2 - 8*x13^2*x5 + 12*x13^2*x8 + 16*x13*x14 + 24*x13*x5 - 60*x13*x8 - 8*x14^2*x5 - 12*x14^2*x8 + 24*x14*x5*x8 + 36*x14*x8^2 - 24*x14 - 18*x5*x8^2 - 18*x5 - 27*x8^3 + 63*x8,
3*x2*x4*x8 - 2*x2*x5*x6 + 10*x2*x5 - 15*x2*x8 + 2*x3*x4*x6 - 3*x3*x4 - 10*x3*x6 + 15*x3 - 3*x4*x6*x8 + 3*x5*x6 - 15*x5 + 15*x6*x8,
2*x2*x5*x7 - 3*x2*x5*x8 - 2*x3*x4*x7 - 7*x3*x5 + 10*x3*x7 + 3*x4*x7*x8 - 3*x5*x7 + 15*x5*x8 - 15*x7*x8,
-x10^2 + 16*x8^2 + 16,
x10 - 8,
9*x8^2 - 4*x9^2 + 9,
x9 - 3,
x11*x14 - x12*x13,
3*x11*x8 + 13*x12 - 24*x8,
4*x11*x8 + x12 - 20*x8,
x13*x8 + x14 - 8*x8,
2*x15*x2*x5*x8 - 2*x15*x3*x4*x8 + 10*x15*x3*x8 + 3*x15*x4*x8^2 - 3*x15*x5*x8 - 15*x15*x8^2 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
