LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x5^2 - 3,
x1*x5 - x2,
x1^2 - 2*x1*x12 + x10^2 - 2*x10*x2 - x11^2 + x12^2 + x2^2,
x3*x5 + x4 - 10*x5,
x10^2 - 2*x10*x4 - x11^2 + x12^2 - 2*x12*x3 + x3^2 + x4^2,
x10^2 - 10*x10*x5 + x12^2 - 10*x12 + 25*x5^2 - x6^2 + 25,
-x11 + x6,
-x10^2 + x7^2,
-x11 + x7,
x1^2 - 10*x1 + x2^2 - 10*x2*x5 + 25*x5^2 - x8^2 + 25,
x3^2 - 10*x3 + x4^2 - 10*x4*x5 + 25*x5^2 - x9^2 + 25,
x8 + x9 - 13;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
