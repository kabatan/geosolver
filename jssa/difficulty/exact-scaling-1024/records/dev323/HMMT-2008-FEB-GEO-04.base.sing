LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=2*x1*x7 - x6^2 + 14*x6 - x7^2,
2*x2*x7 - x6^2 + 32*x6 - x7^2 - 252,
x3^2 - x6^2 + 28*x6 - x7^2 - 196,
x3 - 13,
x1^2 - 2*x1*x7 - x4^2 + x6^2 - 14*x6 + x7^2 + 49,
x2^2 - 2*x2*x7 - x5^2 + x6^2 - 32*x6 + x7^2 + 256,
x4 - x5,
x7*x8 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
