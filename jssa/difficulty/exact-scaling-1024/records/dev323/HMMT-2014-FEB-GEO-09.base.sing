LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1^2 - 2,
x2^2 - x7^2 - x8^2,
x2 - x6 - 10,
x3^2 - x7^2 + 46*x7 - x8^2 - 529,
x3 - x6 - 13,
4*x1^2 - 4*x1*x8 - x4^2 + x7^2 - 20*x7 + x8^2 + 100,
x5^2 - x6^2 - 8,
x4 - x5;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
