LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20),dp;
short=0;
ideal J=2*x1*x19 + x17*x18 - x18^2 - x19^2,
x15^2 - x17^2,
x16^2 - x18^2 - x19^2,
-x15*x18 + x15*x6 - x16*x17 + x16*x6,
-x15*x19 + x15*x7 + x16*x7,
2*x1*x6*x7 + x17*x6^2 - x6^2*x8 - x7^2*x8,
2*x1*x7^2 + x17*x6*x7 - x6^2*x9 - x7^2*x9,
2*x1*x10*x19 - 2*x1*x17*x19 - x10*x17^2 + x10*x17*x18,
2*x1*x11*x19 - x11*x17^2 + x11*x17*x18 + x17^2*x19,
x10^2*x9 - 2*x10*x2*x9 + x11^2*x9 + 2*x11*x2*x8 - 2*x11*x8^2 - 2*x11*x9^2,
-x10^2*x8 - 2*x10*x3*x9 + 2*x10*x8^2 + 2*x10*x9^2 - x11^2*x8 + 2*x11*x3*x8,
-x17*x19 + x17*x5 - x18*x5 + x19*x4,
2*x2*x4 + 2*x3*x5 - x4^2 - x5^2,
x12^2 - 3,
x13^2 - x17^2*x19^2,
x12*x17*x18 - x13,
x15 - 3,
2*x1*x9 + x17*x8 - x8^2 - x9^2,
-x17*x19 + x17*x7 - x18*x7 + x19*x6,
-x14^2 + x6^2 + x7^2,
x14 - 4,
-2*x1*x10*x15*x17*x19^2*x20*x9 - 2*x1*x10*x16*x17*x19^2*x20*x9 + 2*x1*x11*x15*x17*x19^2*x20*x8 + 2*x1*x11*x16*x17*x19^2*x20*x8 + x10*x15*x17^3*x19*x20*x9 - x10*x15*x17^2*x18*x19*x20*x9 + x10*x16*x17^3*x19*x20*x9 - x10*x16*x17^2*x18*x19*x20*x9 - x11*x15*x17^3*x19*x20*x8 + x11*x15*x17^2*x18*x19*x20*x8 - x11*x16*x17^3*x19*x20*x8 + x11*x16*x17^2*x18*x19*x20*x8 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
