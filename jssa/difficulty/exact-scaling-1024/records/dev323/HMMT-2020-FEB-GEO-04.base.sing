LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=-x13^2 + x9^2 - 4,
x12^2 - x13^2,
x12*x2 - 2*x12 + x2*x9 + 2*x2,
x12*x3 - 2*x13 + x3*x9 + 2*x3,
x12*x4 - 2*x12 + x4*x9 + 2*x4,
x12*x5 - 2*x13 + x5*x9 + 2*x5,
x13^2*x6 - 2*x13^2 + 2*x13*x14 - 2*x13 + 4*x6 - 4,
-x13^2*x14 + x13^2*x7 + x13^2 - 2*x13 + 4*x7,
-x13^2*x8 + 2*x13^2 - 2*x13*x5 + 4*x4 - 4*x8,
x1*x13^2 + 4*x1 - x13^2*x5 + 2*x13*x4 - 4*x13,
x10^2*x13^2 + 4*x10^2 - x13^2 + 4*x13*x14 - 4*x13 - 4*x14^2 + 8*x14 - 4,
x10 - 1,
x1^2 - 2*x1*x7 - x11^2 + x6^2 - 2*x6*x8 + x7^2 + x8^2,
x11,
x13*x6 - 2*x13 + 2*x7,
x12*x15 + x15*x9 + 2*x15 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
