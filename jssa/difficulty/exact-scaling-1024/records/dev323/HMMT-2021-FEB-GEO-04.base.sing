LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=2*x1*x7 - x7^2 + x8^2 + 5*x8,
2*x2*x7 - x7^2 + x8^2 + 5*x8,
x1^2*x3 - x1^2*x8 - 2*x1*x2*x3 + 2*x1*x2*x8 + 10*x1*x2 - 10*x1*x7 + x2^2*x3 - x2^2*x8 - 10*x2^2 + 10*x2*x7 + 25*x3 - 25*x8 - 125,
x1^2*x4 - x1^2*x7 - 2*x1*x2*x4 + 2*x1*x2*x7 - 25*x1 + x2^2*x4 - x2^2*x7 - 25*x2 + 25*x4 + 25*x7,
x5^2 - x7^2 - x8^2,
x5 - 7,
x6^2 - x7^2 - x8^2 - 10*x8 - 25,
x6 - 9,
x7*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
