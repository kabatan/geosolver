LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=-4*x1^2 + 4*x5^2 - 49,
-196*x1^2*x3^2*x4^2 + 196*x1*x2*x3^2*x4 + 196*x1*x2*x3*x4^2 - 1372*x1*x3^2*x4 - 49*x2^2*x3^2 - 98*x2^2*x3*x4 - 49*x2^2*x4^2 + 686*x2*x3^2 + 686*x2*x3*x4 - 2401*x3^2 + 16*x6^2,
x6,
-16*x1^4*x3^2 + 32*x1^4*x3*x4 - 16*x1^4*x4^2 + 224*x1^3*x3^2*x4 - 224*x1^3*x3*x4^2 + 224*x1^3*x3 - 224*x1^3*x4 - 784*x1^2*x3^2*x4^2 + 16*x1^2*x3^2*x5^2 + 392*x1^2*x3^2 - 32*x1^2*x3*x4*x5^2 - 2352*x1^2*x3*x4 + 16*x1^2*x4^2*x5^2 + 392*x1^2*x4^2 - 784*x1^2 - 2744*x1*x3^2*x4 + 2744*x1*x3*x4^2 - 224*x1*x3*x5^2 - 2744*x1*x3 + 224*x1*x4*x5^2 + 2744*x1*x4 + 196*x3^2*x5^2 - 2401*x3^2 + 392*x3*x4*x5^2 + 4802*x3*x4 + 196*x4^2*x5^2 - 2401*x4^2 + 784*x5^2,
-4*x1^2*x4^2 - 49*x4^2 + 4*x7^2,
x7 - 2,
-4*x1^2*x3^2 - 49*x3^2 + 4*x8^2,
x8 - 3,
-x2^2 + 14*x2 + x9^2 - 49,
-x10 + x9;
J=sat(J,ideal(x5));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2 - 7));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(4*x1^2 + 49));
print("SAT_FACTOR=6");
J=sat(J,ideal(4*x1^2*x3^2 - 8*x1^2*x3*x4 + 4*x1^2*x4^2 - 56*x1*x3 + 56*x1*x4 + 49*x3^2 + 98*x3*x4 + 49*x4^2 + 196));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
