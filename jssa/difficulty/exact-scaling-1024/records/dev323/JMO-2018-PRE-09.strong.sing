LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23,x24,x25,x26,x27,x28,x29,x30,x31,x32,x33,x34,x35,x36),dp;
short=0;
ideal J=-x1^2 + 2*x1*x2 - x2^2 + x28^2 - x3^2,
-x2^2 + x29^2 - x3^2,
-x1^2 + x32^2,
-x1*x29 - x2*x32 + x22*x28 + x22*x29 + x22*x32,
x23*x28 + x23*x29 + x23*x32 - x3*x32,
-x1*x29 - x2*x32 + x24*x28 + x24*x29 + x24*x32,
x25*x28 + x25*x29 + x25*x32 - x3*x32,
-x1*x29 - x2*x32 + x26*x28 + x26*x29 + x26*x32,
x27*x28 + x27*x29 + x27*x32 - x3*x32,
-x1^2*x26 + x1^2*x4 + 2*x1*x2*x26 - 2*x1*x2*x4 + x1*x27*x3 - x1*x3^2 - x2^2*x26 + x2^2*x4 - x2*x27*x3 + x3^2*x4,
-x1^2*x3 + x1^2*x5 + x1*x2*x3 - 2*x1*x2*x5 + x1*x26*x3 + x2^2*x5 - x2*x26*x3 - x27*x3^2 + x3^2*x5,
-x1*x29 - x2*x32 + x28*x6 + x29*x6 + x32*x6,
x28*x7 + x29*x7 - x3*x32 + x32*x7,
x2^2*x6 - x2^2*x8 + x2*x3*x7 - x3^2*x8,
-x2^2*x9 + x2*x3*x6 + x3^2*x7 - x3^2*x9,
-x1*x29 + x10*x28 + x10*x29 + x10*x32 - x2*x32,
x11*x28 + x11*x29 + x11*x32 - x3*x32,
x1*x29 + x12*x28 - x12*x29 - x12*x32 + x2*x32,
x13*x28 - x13*x29 - x13*x32 + x3*x32,
x1^2*x12 - x1^2*x14 - 2*x1*x12*x2 - x1*x13*x3 + 2*x1*x14*x2 + x1*x3^2 + x12*x2^2 + x13*x2*x3 - x14*x2^2 - x14*x3^2,
x1^2*x15 - x1^2*x3 + x1*x12*x3 - 2*x1*x15*x2 + x1*x2*x3 - x12*x2*x3 - x13*x3^2 + x15*x2^2 + x15*x3^2,
x12*x2^2 + x13*x2*x3 - x16*x2^2 - x16*x3^2,
x12*x2*x3 + x13*x3^2 - x17*x2^2 - x17*x3^2,
-x14*x17*x4 + x14*x17*x8 + x14*x18*x5 - x14*x18*x9 + x14*x4*x9 - x14*x5*x8 + x15*x16*x4 - x15*x16*x8 - x15*x18*x4 + x15*x18*x8 - x16*x18*x5 + x16*x18*x9 - x16*x4*x9 + x16*x5*x8 + x17*x18*x4 - x17*x18*x8,
-x14*x17*x5 + x14*x17*x9 + x14*x19*x5 - x14*x19*x9 + x15*x16*x5 - x15*x16*x9 - x15*x19*x4 + x15*x19*x8 + x15*x4*x9 - x15*x5*x8 - x16*x19*x5 + x16*x19*x9 + x17*x19*x4 - x17*x19*x8 - x17*x4*x9 + x17*x5*x8,
-x10*x12*x15 + x10*x12*x5 - x10*x14*x5 + x10*x15*x20 + x12*x15*x4 - x12*x20*x5 + x14*x20*x5 - x15*x20*x4,
-x10*x15*x21 + x10*x15*x5 - x12*x15*x5 + x12*x21*x5 - x14*x21*x5 + x15*x21*x4,
x24^2 + x25^2 - x30^2,
x30 - 3,
x24^2 - 2*x24*x4 + x25^2 - 2*x25*x5 - x31^2 + x4^2 + x5^2,
x31 - 1,
x14^2 - 2*x14*x4 + x15^2 - 2*x15*x5 - x33^2 + x4^2 + x5^2,
x33 - 2,
-x1^2*x3^2 + 4*x34^2,
x18^2 - 2*x18*x20 + x19^2 - 2*x19*x21 + x20^2 + x21^2 - x35^2,
x35 - x36;
J=sat(J,ideal(x28 + x29 + x32));
print("SAT_FACTOR=1");
J=sat(J,ideal(x28 - x29 - x32));
print("SAT_FACTOR=2");
J=sat(J,ideal(x34));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3));
print("SAT_FACTOR=5");
J=sat(J,ideal(x4^2 - 2*x4*x8 + x5^2 - 2*x5*x9 + x8^2 + x9^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x10^2 - 2*x10*x4 + x4^2 + x5^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(-x10*x15 + x12*x5 - x14*x5 + x15*x4));
print("SAT_FACTOR=8");
J=sat(J,ideal(-x14*x5 + x14*x9 + x15*x4 - x15*x8 + x16*x5 - x16*x9 - x17*x4 + x17*x8));
print("SAT_FACTOR=9");
J=sat(J,ideal(x12^2 - 2*x12*x14 + x14^2 + x15^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1*x13 - x1*x3 + x12*x3 - x13*x2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x14^2 - 2*x14*x16 + x15^2 - 2*x15*x17 + x16^2 + x17^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=13");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=14");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
