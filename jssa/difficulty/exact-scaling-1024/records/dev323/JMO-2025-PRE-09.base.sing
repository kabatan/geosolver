LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=2*x1*x13 + x11*x12 - x12^2 - x13^2,
x11^2*x2 - 2*x11*x12*x2 - x11*x13^2 + x12^2*x2 + x13^2*x2,
-x11^2*x13 + x11^2*x3 + x11*x12*x13 - 2*x11*x12*x3 + x12^2*x3 + x13^2*x3,
x12^2*x2 - x12^2*x4 + x12*x13*x3 - x13^2*x4,
-x12^2*x5 + x12*x13*x2 + x13^2*x3 - x13^2*x5,
2*x1*x2*x6 - 2*x1*x4*x6 - x11*x2*x5 + x11*x5*x6,
2*x1*x2*x5 - 2*x1*x2*x7 + 2*x1*x4*x7 - x11*x5*x7,
4*x1^2 - 4*x1*x3 + x11^2 - 2*x11*x2,
4*x1^2 - 8*x1*x3 + x11^2 - 4*x11*x2 + 4*x2^2 + 4*x3^2 - 4*x8^2,
x9^2 - 7,
x8 - 4*x9,
-x10^2 + x6^2 + x7^2,
x10 - 11,
2*x1*x6 - x11*x7,
x2*x5 - x2*x7 + x4*x7 - x5*x6,
2*x1*x11*x13*x14*x2 - 2*x1*x11*x13*x14*x4 + x11^2*x13*x14*x5 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
