LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=x1^2 - x4^2 + 4*x4 - x5^2 + 2*x5 - 5,
x1 - 1,
x2^2 - x4^2 + 4*x4 - x6^2 + 2*x6 - 5,
x2 - 1,
x3^2 - 2*x4^2 + 2*x4*x5 + 2*x4*x6 + 4*x4 - x5^2 - 2*x5 - x6^2 - 2*x6 - 2,
x3 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
