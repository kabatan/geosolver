LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=4*x1^2 - x6^2 - 16*x6 - x7^2 - 64,
x1 - 7,
4*x2^2 - x6^2 + 28*x6 - x7^2 - 196,
x2 - 7,
4*x3^2 - 4*x4^2 + 4*x4*x6 + 32*x4 - 4*x5^2 + 4*x5*x7 - x6^2 - 16*x6 - x7^2 - 64,
x3 - 7,
x4*x7 - x5*x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
