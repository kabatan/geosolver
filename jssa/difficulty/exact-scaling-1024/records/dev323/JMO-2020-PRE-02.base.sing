LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=x1^2 - 3,
x1^2 - 16*x2^2 + 25,
x1^2 - 8*x1*x6 - 16*x3^2 + 16*x5^2 - 24*x5 + 16*x6^2 + 9,
x2 - x3,
x1^2 - 4*x1*x6 - 4*x4^2 + 4*x5^2 + 4*x5 + 4*x6^2 + 1,
x3 - x4;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
