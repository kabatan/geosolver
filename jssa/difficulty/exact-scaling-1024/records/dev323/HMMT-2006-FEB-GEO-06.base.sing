LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x4^2 - 2,
8*x1^4 - 8*x1^2 + 1,
x1^2 + x2^2 - 1,
x2*x4 - x3*x4 + x3 - x4^2*x6 + x4 + x6,
2*x2^2 - 2*x2*x3 - 2*x2*x6 + 4*x2 + x3^2 - 2*x3 - x5^2 + x6^2 - 2*x6 + 2,
x2 - x5 + x6 + 1,
x4^2*x7 - x4*x7 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
