LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18),dp;
short=0;
ideal J=x12^2 - 2,
x12*x4 + 3,
x12*x5 - 3,
x12*x6 - 5,
x12*x7 - 5,
x12*x8 - 4,
x12*x9 + 4,
x10*x12 + x17,
x11*x12 + x17,
2*x1*x5 - 2*x1*x7 - x16*x4 + x16*x6 + 2*x4*x7 - 2*x5*x6,
-x16*x7 + x16*x9 + 2*x2*x6 - 2*x2*x8 - 2*x6*x9 + 2*x7*x8,
-x10*x16 - 2*x10*x9 - 2*x11*x3 + 2*x11*x8 + x16*x8 + 2*x3*x9,
-x13^2 + x4^2 + x5^2,
x13 - 3,
-x14^2 + x6^2 + x7^2,
x14 - 5,
-x15^2 + x8^2 + x9^2,
x15 - 4,
x1*x16 + 2*x1*x2 - x16^2 + x16*x3 - 2*x2*x3,
x16*x4 + x16*x5,
x16*x6 - x16*x7,
x16*x8 + x16*x9,
x10*x16 - x11*x16,
-x11*x12*x16*x18*x5*x6 + x11*x12*x16*x18*x5*x8 + x11*x12*x16*x18*x6*x7 - x11*x12*x16*x18*x7*x8 + x12*x16*x18*x5*x6*x9 - x12*x16*x18*x5*x8*x9 - x12*x16*x18*x6*x7*x9 + x12*x16*x18*x7*x8*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
