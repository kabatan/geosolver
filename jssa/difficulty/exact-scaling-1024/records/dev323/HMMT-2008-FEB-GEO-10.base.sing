LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=-x11^2 + 4014*x11 - x12^2 + x9^2 - 4028049,
x10^2 - x11^2 - x12^2,
x10*x2 - 2007*x10 + 2007*x11 + x2*x9 - 2007*x2,
x10*x3 + 2007*x12 + x3*x9 - 2007*x3,
x11^2*x2 - x11^2*x4 + x11*x12*x3 - 4014*x11*x2 + 4014*x11*x4 - x12^2*x4 + 2007*x12^2 - 2007*x12*x3 + 4028049*x2 - 4028049*x4,
-x11^2*x5 + x11*x12*x2 - 2007*x11*x12 + 4014*x11*x5 + x12^2*x3 - x12^2*x5 - 2007*x12*x2 + 4028049*x12 - 4028049*x5,
x11^2*x2 - x11^2*x6 + x11*x12*x3 - x12^2*x6,
-x11^2*x7 + x11*x12*x2 + x12^2*x3 - x12^2*x7,
x11*x2*x4 - x11*x2*x6 - x11*x4*x8 + x11*x6*x8 + x12*x3*x4 - x12*x3*x6 - x12*x4*x7 + x12*x5*x6 - x12*x5*x8 + x12*x7*x8 - 1003*x2*x4 + 1003*x2*x6 + 1003*x4*x8 - 1003*x6*x8,
x1*x11*x4 - x1*x11*x6 + x1*x12*x5 - x1*x12*x7 - 1003*x1*x4 + 1003*x1*x6 - x11*x2*x5 + x11*x2*x7 - x11*x4*x7 + x11*x5*x6 - x12*x3*x5 + x12*x3*x7 + 1003*x2*x5 - 1003*x2*x7 + 1003*x4*x7 - 1003*x5*x6,
x10 - 2009,
x9 - 2008,
x2^2 - 2006*x2 + 1006009,
-x11*x5 + x12*x4 - 2007*x12 + 2007*x5,
-x11*x7 + x12*x6,
x2 - 1003,
x10*x11*x13*x4 - x10*x11*x13*x6 + x10*x12*x13*x5 - x10*x12*x13*x7 - 1003*x10*x13*x4 + 1003*x10*x13*x6 + x11*x13*x4*x9 - 2007*x11*x13*x4 - x11*x13*x6*x9 + 2007*x11*x13*x6 + x12*x13*x5*x9 - 2007*x12*x13*x5 - x12*x13*x7*x9 + 2007*x12*x13*x7 - 1003*x13*x4*x9 + 2013021*x13*x4 + 1003*x13*x6*x9 - 2013021*x13*x6 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
