LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=4*x1^2 - 4*x4^2 + 504*x4 - x5^2 - 2*x5*x6 + 2*x5*x7 + 2*x5*x8 - x6^2 + 2*x6*x7 + 2*x6*x8 - x7^2 - 2*x7*x8 - x8^2 - 15876,
x1,
x2^2 - x5^2 + 2*x5*x6 - x6^2 - 400,
x3^2 - x7^2 + 2*x7*x8 - x8^2 - 576,
x2 - x3,
x5*x7 - x5*x8 - x6*x7 + x6*x8 - 480;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
