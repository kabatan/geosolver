LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=x1^2 - 2,
4*x2^2 - 9*x4^2*x6^4 + 12*x4*x6^4 - 4*x6^4,
4*x1*x2 + 5*x1*x4^2*x6^2 - 6*x1*x4*x6^2,
4*x3^2 - 9*x5^2*x6^4 + 12*x5*x6^4 - 4*x6^4,
4*x1*x3 + 5*x1*x5^2*x6^2 - 6*x1*x5*x6^2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
