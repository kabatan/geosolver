LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=-x1^2 - x2^2 + x6^2,
x6 - 7,
4*x5^2 - 3,
-x2^2*x4^2 + 12*x2^2*x4 - 36*x2^2 + x7^2,
2*x1*x4*x5 - 12*x1*x5 - 2*x4^2*x5 + 12*x4*x5 - x7,
x1^2*x3 - x1^2 - x1*x3*x4 + 6*x1 + x2^2*x3 - x2^2,
-x1^2*x3^2 + 2*x1^2*x3 - x1^2 + 2*x1*x3^2*x4 - 2*x1*x3*x4 - 12*x1*x3 + 12*x1 - x2^2*x3^2 + 2*x2^2*x3 - x2^2 - x3^2*x4^2 + 12*x3*x4 + x8^2 - 36,
x8 - 4,
-x1^2*x3^2 + 2*x1*x3^2*x4 - x2^2*x3^2 - x3^2*x4^2 + x9^2,
-x10 + x9;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3 - 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4 - 6));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x4 + x2^2 + x4^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2*x3^2 - 2*x1^2*x3 + x1^2 - 2*x1*x3^2*x4 + 2*x1*x3*x4 + 12*x1*x3 - 12*x1 + x2^2*x3^2 - 2*x2^2*x3 + x2^2 + x3^2*x4^2 - 12*x3*x4 + 36));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
