LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=x1^2 - x17^2 + 28*x17 - 196,
x1 - 15,
-x14^2 + 2*x14*x17 - x17^2 + x4^2,
x4 - 16,
-x12^2 - x13^2 + x5^2,
-x14^2 + x6^2,
x5 - x6,
-x12^2 + 2*x12*x14 - x13^2 - x14^2 + x7^2,
x5 - x7,
-x15^2 + 28*x15 - x16^2 + x8^2 - 196,
x1 - x8,
-x15^2 + 2*x15*x17 - x16^2 - x17^2 + x9^2,
x1 - x9,
4*x10^2 - x12^2*x16^2 + 2*x12*x13*x15*x16 - x13^2*x15^2,
4*x11^2 - x14^2*x16^2,
-x12^2*x16^2 - 2*x12*x13*x14*x16 + 2*x12*x13*x15*x16 + 2*x12*x14*x16^2 - x13^2*x14^2 + 2*x13^2*x14*x15 - x13^2*x15^2 + 2*x13*x14^2*x16 - 2*x13*x14*x15*x16 - x14^2*x16^2 + 4*x2^2,
-x13^2*x14^2 + 4*x3^2,
x10 + x11 + x2 - x3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
