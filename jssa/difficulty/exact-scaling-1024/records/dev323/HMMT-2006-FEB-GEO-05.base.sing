LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=2*x1*x7 + 11*x1*x8 - 2*x1 - 10*x7 - 11*x8 + 10,
2*x2*x7 + 11*x2*x8 - 2*x2 - 8*x8,
x3^2 - 20,
x4^2 - 5,
x3 - 2*x4,
5*x5^2 - 5*x7^2 + 6*x7 - 5*x8^2 + 8*x8 - 5,
x5 - 2,
x6^2 - x7^2 - x8^2,
x6 - 3,
2*x7*x9 + 11*x8*x9 - 2*x9 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
