LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=-x1^2 + 14*x1 - x2^2 + 2*x2*x3,
-x1^2 + 32*x1 - x2^2 + 2*x2*x4 - 252,
-x1^2 + 28*x1 - x2^2 + x5^2 - 196,
x5 - 13,
x1^2 - 14*x1 + x2^2 - 2*x2*x3 + x3^2 - x6^2 + 49,
x1^2 - 32*x1 + x2^2 - 2*x2*x4 + x4^2 - x7^2 + 256,
x6 - x7,
-81*x2^2 + x8^2,
x8 - x9;
J=sat(J,ideal(x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 - 14*x1 + x2^2 - 2*x2*x3 + x3^2 + 49));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 - 32*x1 + x2^2 - 2*x2*x4 + x4^2 + 256));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
