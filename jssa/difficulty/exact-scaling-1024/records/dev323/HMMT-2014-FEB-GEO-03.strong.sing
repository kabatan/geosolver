LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=-x1^2 - x2^2 + x3^2,
-x1^2 + 20*x1 - x2^2 + x4^2 - 100,
x4 - 12,
x1^2*x3 + x1^2*x4 + 10*x1*x4 + x2^2*x3 + x2^2*x4 - 100*x3,
-25*x2^2 + x5^2,
x5 - x6;
J=sat(J,ideal(x5));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 + 20*x1 + x2^2 + 100));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 20*x1 + x2^2 + 100));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2*x3^2 + 2*x1^2*x3*x4 + x1^2*x4^2 - 20*x1*x3^2 - 20*x1*x3*x4 + x2^2*x3^2 + 2*x2^2*x3*x4 + x2^2*x4^2 + 100*x3^2));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
