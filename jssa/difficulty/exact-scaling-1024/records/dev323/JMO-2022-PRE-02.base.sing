LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1^2 - x5^2 - 36,
x1 - 7,
x2^2 - x6^2 + 2*x6*x7 - x7^2 - 36,
x2 - 8,
x3^2*x5^2 + 36*x3^2 - 9*x5^2 + 36*x5*x8 - 36*x8^2,
x3 - 3,
x4^2*x6^2 - 2*x4^2*x6*x7 + x4^2*x7^2 + 36*x4^2 - 9*x6^2 - 18*x6*x7 + 36*x6*x8 - 9*x7^2 + 36*x7*x8 - 36*x8^2,
x4 - 3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
