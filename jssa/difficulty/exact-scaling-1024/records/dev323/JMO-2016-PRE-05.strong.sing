LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=-x3^2 - x4^2 + x7^2,
x7 - 20,
-x1^2 - x2^2 + x8^2,
x7 - x8,
-x5^2 - x6^2 + x9^2,
x9 - 16,
-x1^2 + 2*x1*x5 + x10^2 - x2^2 + 2*x2*x6 - x5^2 - x6^2,
x11^2 - x3^2 + 32*x3 - x4^2 - 256,
x10 - x11,
x3*x6 - x4*x5 + 16*x4 - 16*x6,
x12^2 - 64*x6^2,
x12 - 28,
-x1^2*x4^2 + 2*x1^2*x4*x6 - x1^2*x6^2 + 2*x1*x2*x3*x4 - 2*x1*x2*x3*x6 - 2*x1*x2*x4*x5 + 2*x1*x2*x5*x6 - 2*x1*x3*x4*x6 + 2*x1*x3*x6^2 + 2*x1*x4^2*x5 - 2*x1*x4*x5*x6 + 4*x13^2 - x2^2*x3^2 + 2*x2^2*x3*x5 - x2^2*x5^2 + 2*x2*x3^2*x6 - 2*x2*x3*x4*x5 - 2*x2*x3*x5*x6 + 2*x2*x4*x5^2 - x3^2*x6^2 + 2*x3*x4*x5*x6 - x4^2*x5^2,
x13 - x14;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x4));
print("SAT_FACTOR=2");
J=sat(J,ideal(x6));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 32*x1 + x2^2 + 256));
print("SAT_FACTOR=6");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x3^2 - 32*x3 + x4^2 + 256));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
