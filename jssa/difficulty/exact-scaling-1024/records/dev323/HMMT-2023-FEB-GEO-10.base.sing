LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=-x14^2 + x6^2,
-x12^2 + 2*x12*x14 - x13^2 - x14^2 + x9^2,
x10^2 - x12^2 - x13^2,
x1*x10 + x1*x6 + x1*x9 - x10*x14 - x12*x6,
x10*x2 - x13*x6 + x2*x6 + x2*x9,
-x12^2 + x12*x14 - x13^2 + 2*x13*x3,
-x10*x14 + x10*x4 - x12*x6 + x4*x6 + x4*x9,
x10*x5 - x13*x6 + x5*x6 + x5*x9,
x1^2 - 2*x1*x12 - x11^2 + x12^2 + x2^2,
x11 - 2,
x1^2 - 2*x1*x12 + x12^2 + x13^2 - 2*x13*x2 + x2^2 - x7^2,
x7 - 3,
x1^2 + 2*x1*x12 - 2*x1*x14 + x12^2 - 2*x12*x14 + x13^2 + 2*x13*x2 - 4*x13*x3 + x14^2 + x2^2 - 4*x2*x3 + 4*x3^2 - x8^2,
x8 - 4,
x10*x13*x14*x15 + x13*x14*x15*x6 + x13*x14*x15*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
