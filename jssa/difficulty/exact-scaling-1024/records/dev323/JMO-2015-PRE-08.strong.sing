LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=-x1^2 - x2^2 + 2*x2*x3 + 36,
-x1^2 + 12*x1 - x2^2 + 2*x2*x4,
x1*x3^2 - 2*x1*x3*x4 + x1*x4^2 - 36*x1 + 12*x2*x3 - 12*x2*x4 + x3^2*x5 - 12*x3^2 - 2*x3*x4*x5 + 12*x3*x4 + x4^2*x5 + 36*x5,
12*x1*x3 - 12*x1*x4 - x2*x3^2 + 2*x2*x3*x4 - x2*x4^2 + 36*x2 + x3^2*x6 - 2*x3*x4*x6 - 72*x3 + x4^2*x6 + 36*x6,
-x1^2 - x2^2 + x7^2,
x7 - 5,
-x1^2 + 12*x1 - x2^2 + x8^2 - 36,
x8 - 7,
x1^2 - 2*x1*x5 + x2^2 - 2*x2*x6 + x5^2 + x6^2 - x9^2,
-x10 + x9;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3^2 - 2*x3*x4 + x4^2 + 36));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 + x2^2 - 2*x2*x3 + x3^2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1*x3 - x1*x4 + 6*x2 - 6*x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 12*x1 + x2^2 - 2*x2*x4 + x4^2 + 36));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
