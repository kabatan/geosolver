LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1*x8^2 - 30*x1*x8 + 801*x1 - 8640,
x2*x8^2 - 30*x2*x8 + 801*x2 + 360*x8 - 5400,
x3*x8^2 + 576*x3 - 15*x8^2,
x4*x8^2 + 576*x4 - 360*x8,
x1^2*x5 - x1^2*x8 + x1*x2*x4 - 24*x1*x2 - 2*x1*x3*x5 + 2*x1*x3*x8 - x1*x4^2 + 24*x1*x4 - x2^2*x3 + x2^2*x5 + x2*x3*x4 + 24*x2*x3 - 2*x2*x4*x5 + x3^2*x5 - x3^2*x8 - 24*x3*x4 + x4^2*x5,
x1^2*x4 - x1^2*x6 - x1*x2*x3 + x1*x2*x8 - x1*x3*x4 + 2*x1*x3*x6 - x1*x4*x8 - x2^2*x6 + 24*x2^2 + x2*x3^2 - x2*x3*x8 + 2*x2*x4*x6 - 48*x2*x4 - x3^2*x6 + x3*x4*x8 - x4^2*x6 + 24*x4^2,
x5^2 - 2*x5*x8 + x6^2 - 48*x6 - x7^2 + x8^2 + 576,
x7 - 20;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
