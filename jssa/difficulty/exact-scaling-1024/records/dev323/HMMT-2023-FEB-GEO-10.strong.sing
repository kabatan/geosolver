LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x3^2 + x9^2,
-x1^2 + 2*x1*x3 + x14^2 - x2^2 - x3^2,
-x1^2 + x15^2 - x2^2,
-x1*x9 + x14*x4 - x15*x3 + x15*x4 + x4*x9,
x14*x5 + x15*x5 - x2*x9 + x5*x9,
-x1^2 + x1*x3 - x2^2 + 2*x2*x6,
-x1*x9 + x14*x7 - x15*x3 + x15*x7 + x7*x9,
x14*x8 + x15*x8 - x2*x9 + x8*x9,
x1^2 - 2*x1*x4 - x16^2 + x4^2 + x5^2,
x16 - 2,
x1^2 - 2*x1*x4 - x10^2 + x2^2 - 2*x2*x5 + x4^2 + x5^2,
x10 - 3,
x1^2 - 2*x1*x3 + 2*x1*x4 - x11^2 + x2^2 + 2*x2*x5 - 4*x2*x6 + x3^2 - 2*x3*x4 + x4^2 + x5^2 - 4*x5*x6 + 4*x6^2,
x11 - 4,
4*x12^2 - x2^2*x3^2,
x13^2*x14^2 + 2*x13^2*x14*x15 + 2*x13^2*x14*x9 + x13^2*x15^2 + 2*x13^2*x15*x9 + x13^2*x9^2 - x2^2*x3^2,
x13 - x17;
J=sat(J,ideal(x14 + x15 + x9));
print("SAT_FACTOR=1");
J=sat(J,ideal(x12));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
