LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x3^2 - 3,
36*x3^2 - x4^2,
9*x3^2 - x5^2 + 81,
x2*x4 + 2*x2*x5 - 18*x5,
2916*x3^2 - x4^2*x6^2 - 4*x4*x5*x6^2 - 4*x5^2*x6^2,
x4 - x5,
4*x1^2 - 4*x1*x2 + x2^2 - x7^2,
x1 + x6 - x7,
-x1*x8 + x6;
J=sat(J,ideal(x3));
print("SAT_FACTOR=1");
J=sat(J,ideal(x4 + 2*x5));
print("SAT_FACTOR=2");
J=sat(J,ideal(-x1 + x6));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
