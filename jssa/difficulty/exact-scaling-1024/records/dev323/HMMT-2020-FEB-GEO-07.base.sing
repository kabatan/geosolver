LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x11^2 - 4*x11 + x5^2 - 96,
x11^2 + 6*x11 + x7^2 - 72,
x2,
x1^2 + x11^2 - 2*x11*x2 + x2^2 - 144,
x4,
x11^2 - 2*x11*x4 + x3^2 + x4^2 - 144,
x11^2 - 4*x11 + x5^2 - x8^2 + 4,
x8 - 10,
x11^2 + 6*x11 + x7^2 - x9^2 + 9,
x9 - 9,
-25*x10^2 + x11^2 - 24*x11 + x5^2 + 144,
-x11^2 - 24*x11 + 9*x6^2 - x7^2 - 144,
-2*x10 + x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
