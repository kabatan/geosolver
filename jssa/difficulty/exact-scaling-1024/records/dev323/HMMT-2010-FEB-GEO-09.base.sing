LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16),dp;
short=0;
ideal J=64*x1^6 - 96*x1^4 + 36*x1^2 - 3,
x1^2 + x4^2 - 1,
x12^2 - 3,
4096*x5^12 - 12288*x5^10 + 13824*x5^8 - 7168*x5^6 + 1680*x5^4 - 144*x5^2 + 1,
x5^2 + x6^2 - 1,
x12*x6*x8 + x5*x8 - x5,
x12*x6*x9 + x5*x9 - x6,
-x13^2 + x9^2,
x1*x10*x9 - x1*x9 - x10*x4*x8 + x10*x4,
x1*x7*x9 - x4*x7*x8 + x4*x7 - x4*x9,
-x1^2*x13^2*x14^2 + x1^2*x14^2*x9^2 - 2*x1*x14^2*x4*x8*x9 - x13^2*x14^2*x4^2 + x14^2*x4^2*x8^2,
-x12^2*x13^2*x15^2 + x12^2*x15^2*x8^2 - 2*x12^2*x15^2*x8 + x12^2*x15^2 + 2*x12*x15^2*x8*x9 - 2*x12*x15^2*x9 - x13^2*x15^2 + x15^2*x9^2,
x1^2*x12^2*x14^2*x15^2 - 4*x1^2*x12*x14^2*x15*x9 - 4*x1^2*x13^2*x14^2 + 4*x1^2*x14^2*x9^2 - 2*x1*x12^2*x14*x15^2*x8 + 2*x1*x12*x14^2*x15^2*x4 + 4*x1*x12*x14^2*x15*x4*x8 - 4*x1*x12*x14^2*x15*x4 - 2*x1*x12*x14*x15^2*x9 + 4*x1*x12*x14*x15*x8*x9 + 4*x1*x12*x14*x15*x9 - 4*x1*x13^2*x14*x15 + 8*x1*x13^2*x14 - 4*x1*x14^2*x15*x4*x9 - 8*x1*x14^2*x4*x8*x9 + 8*x1*x14^2*x4*x9 + 4*x1*x14*x15*x9^2 - 8*x1*x14*x9^2 - x12^2*x13^2*x15^2 + x12^2*x15^2*x8^2 + 4*x12*x13^2*x14*x15*x4 - 2*x12*x14*x15^2*x4*x8 - 4*x12*x14*x15*x4*x8^2 + 4*x12*x14*x15*x4*x8 + 2*x12*x15^2*x8*x9 - 4*x12*x15*x8*x9 - 4*x13^2*x14^2*x4^2 - x13^2*x15^2 + 4*x13^2*x15 - 4*x13^2 + x14^2*x15^2*x4^2 + 4*x14^2*x15*x4^2*x8 - 4*x14^2*x15*x4^2 + 4*x14^2*x4^2*x8^2 - 8*x14^2*x4^2*x8 + 4*x14^2*x4^2 - 2*x14*x15^2*x4*x9 - 4*x14*x15*x4*x8*x9 + 8*x14*x15*x4*x9 + 8*x14*x4*x8*x9 - 8*x14*x4*x9 + x15^2*x9^2 - 4*x15*x9^2 + 4*x9^2,
4096*x2^12 - 12288*x2^10 + 13824*x2^8 - 7168*x2^6 + 1680*x2^4 - 144*x2^2 + 1,
x2^2 + x3^2 - 1,
x10^2*x12^2*x15^2 - 4*x10^2*x12*x15*x9 + 4*x10^2*x9^2 - 2*x10*x12^2*x15^2*x8 + 2*x10*x12*x15^2*x7 - 2*x10*x12*x15^2*x9 + 4*x10*x12*x15*x7*x8 - 4*x10*x12*x15*x7 + 4*x10*x12*x15*x8*x9 + 4*x10*x12*x15*x9 - 4*x10*x15*x7*x9 + 4*x10*x15*x9^2 - 8*x10*x7*x8*x9 + 8*x10*x7*x9 - 8*x10*x9^2 - 4*x11^2 + x12^2*x15^2*x8^2 - 2*x12*x15^2*x7*x8 + 2*x12*x15^2*x8*x9 - 4*x12*x15*x7*x8^2 + 4*x12*x15*x7*x8 - 4*x12*x15*x8*x9 + x15^2*x7^2 - 2*x15^2*x7*x9 + x15^2*x9^2 + 4*x15*x7^2*x8 - 4*x15*x7^2 - 4*x15*x7*x8*x9 + 8*x15*x7*x9 - 4*x15*x9^2 + 4*x7^2*x8^2 - 8*x7^2*x8 + 4*x7^2 + 8*x7*x8*x9 - 8*x7*x9 + 4*x9^2,
2*x10*x15*x3 + 4*x10*x3*x8 - 4*x10*x3 + 4*x11*x2 + x12^2*x15^2*x3 - 2*x12*x15*x3*x7 - 2*x12*x15*x3*x9 + x15^2*x3 + 2*x15*x3*x8 - 4*x15*x3 + 4*x3*x7*x9 - 4*x3*x8 + 4*x3,
x1*x12*x14*x16*x6*x9 + x1*x14*x16*x5*x9 - x12*x14*x16*x4*x6*x8 + x12*x14*x16*x4*x6 - x14*x16*x4*x5*x8 + x14*x16*x4*x5 - 1;
