LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1^2 + x3^2 - 15129,
9*x2^2 + x3^2 - 9*x4^2,
x4 - 61,
x1^2 + x3^2 - x5^2,
x5 - 123,
9*x1^2 - 18*x1*x2 + 9*x2^2 + x3^2 - 9*x6^2,
x6 - 61,
x3^2 - 9*x7^2,
x3 - 3*x7,
4*x3^2 - 9*x8^2,
2*x3 - 3*x8,
x3^2 - x9^2,
x3 - x9,
-x10^2 + 4*x3^2,
x10 - x11;
J=sat(J,ideal(x3));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
