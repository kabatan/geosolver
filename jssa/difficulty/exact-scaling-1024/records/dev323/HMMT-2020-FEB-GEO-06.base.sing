LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=17570*x1*x5 - 1729*x4^3 + 4174*x4^2 - 1729*x4*x5^2 + 115805*x4 - 1286*x5^2 - 186450,
x2^2 - x4^2 - x5^2,
x2 - 5,
x3^2 - x4^2 + 12*x4 - x5^2 - 36,
x3 - 7,
x5*x6 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
