LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x3^2 - 3,
16*x3^2 - x4^2 + 16,
x4 - 8,
4*x2^2 - 3,
400*x3^2 - x5^2,
40*x2 + x5,
441*x1^2*x3^2 - 1680*x1*x3^2 + 1600*x3^2 - 16*x6^2,
x6,
21*x1*x3 - 40*x3,
-x1 + x7;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(2*x1 - 5));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 8));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3^2 + 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(16*x3^2 + 1));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
