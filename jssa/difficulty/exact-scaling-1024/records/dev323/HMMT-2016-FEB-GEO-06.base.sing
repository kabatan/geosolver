LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=x11^2 - 3,
16*x11^2 - x13^2 + 1,
16*x11^2 - x14^2 + 16,
x13*x5 + x14*x5 - 5*x14 + 5*x5 - 20,
-20*x11 + x13*x6 + x14*x6 + 5*x6,
x13*x7 + x14*x7 - 5*x14 + 5*x7 - 20,
-20*x11 + x13*x8 + x14*x8 + 5*x8,
-4*x11^2 + 2*x11*x9 + 1,
-x10*x11^2 - x10 + x11*x8 + x7,
x1*x11^2 + x1 - x11^2*x8 - x11*x7,
x1*x2 - x1*x7 - 2*x10*x11 + 2*x11*x7,
2*x1*x3 - 2*x1*x7 - 2*x10*x11*x3 + 5*x10*x11 + 2*x11*x3*x7 - 5*x11*x7,
-2*x1*x11*x7 + 5*x1*x11 + 2*x1*x4 - 2*x10*x11*x4 + 2*x11*x4*x7,
x14 - 8,
400*x11^2 - x12^2,
20*x11 - x12,
x1^2*x11*x13*x15 + x1^2*x11*x14*x15 + 5*x1^2*x11*x15 - x1*x10*x11^2*x13*x15 - x1*x10*x11^2*x14*x15 - 5*x1*x10*x11^2*x15 + x1*x11^2*x13*x15*x7 + x1*x11^2*x14*x15*x7 + 5*x1*x11^2*x15*x7 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
