LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1*x7 + x6^2 - x6,
2*x2*x7 - x6^2 + x6 - x7^2,
x3^2 - x6^2 - x7^2,
x4^2 - x6^2 + 2*x6 - x7^2 - 1,
x3 + x4 - 5,
x1^2 + 2*x1*x2 + x2^2 - 16*x5^2,
x5,
x7*x8 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
