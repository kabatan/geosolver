LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1^2 - x5^2 - x6^2,
x1 - 231,
x2^2 - x5^2 + 562*x5 - x6^2 - 78961,
x2 - 160,
x3^2 - x7^2 - x8^2,
x3 - 178,
x4^2 - x7^2 + 562*x7 - x8^2 - 78961,
x4 - 153;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
