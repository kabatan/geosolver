LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21),dp;
short=0;
ideal J=-x2*x5 + x3*x4 + x5*x6,
-x1*x2*x5 + x1*x3*x4 - x1*x4*x5 + x1*x5*x7 + x2*x4*x5 - x3*x4^2,
-x1*x5 + x1*x8 + x2*x5 - x3*x4,
x1*x3 - x1*x5 - x3*x4 + x5*x9,
x10*x5 - x3*x4,
x1*x11*x5 - x1*x3*x4 + x1*x4*x5 - x2*x4*x5 + x3*x4^2,
x1*x12 - x1*x3 + x1*x5 - x2*x5 + x3*x4,
-x1*x3 + x1*x5 + x13*x5 - x2*x5 + x3*x4,
-x1^2 + x20^2,
-x1^2 + 2*x1*x4 + x14^2 - x4^2 - x5^2,
x15^2 - x4^2 - x5^2,
x12^2*x13^2 - 4*x16^2,
x16 - 1,
x13^2*x3^2 - 2*x13^2*x3*x5 + x13^2*x5^2 - 2*x13*x3^2*x6 + 4*x13*x3*x5*x6 - 2*x13*x5^2*x6 - 4*x17^2 + x3^2*x6^2 - 2*x3*x5*x6^2 + x5^2*x6^2,
x17 - 4,
x1^2*x8^2 - 2*x1*x6*x8^2 - 4*x18^2 + x6^2*x8^2,
x18 - 9,
-x2*x5 + x3*x4 - x4*x8 + x5*x7,
-x1*x5 + x1*x8 - x4*x8 + x5*x7,
x11*x5 - x12*x4,
x1*x12 - x1*x3 + x1*x5 + x11*x5 - x12*x4 - x2*x5 + x3*x4,
x10^2*x12^2 - 2*x10^2*x12*x3 + x10^2*x3^2 - 2*x10*x11*x12*x3 + 2*x10*x11*x3^2 - 2*x10*x12^2*x13 + 2*x10*x12*x13*x3 + 2*x10*x12*x3*x7 + 2*x10*x12*x3*x9 + 2*x10*x12*x6*x8 - 2*x10*x12*x8*x9 - 2*x10*x3^2*x7 - 2*x10*x3^2*x9 - 2*x10*x3*x6*x8 + 2*x10*x3*x8*x9 + x11^2*x3^2 + 2*x11*x12*x13*x3 - 2*x11*x3^2*x7 - 2*x11*x3^2*x9 - 2*x11*x3*x6*x8 + 2*x11*x3*x8*x9 + x12^2*x13^2 - 2*x12*x13*x3*x7 - 2*x12*x13*x3*x9 - 2*x12*x13*x6*x8 + 2*x12*x13*x8*x9 - 4*x19^2 + x3^2*x7^2 + 2*x3^2*x7*x9 + x3^2*x9^2 + 2*x3*x6*x7*x8 + 2*x3*x6*x8*x9 - 2*x3*x7*x8*x9 - 2*x3*x8*x9^2 + x6^2*x8^2 - 2*x6*x8^2*x9 + x8^2*x9^2,
x19 - x21;
J=sat(J,ideal(x19));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3 - x5));
print("SAT_FACTOR=3");
J=sat(J,ideal(x5));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 2*x1*x2 + 2*x1*x4 + x2^2 - 2*x2*x4 + x3^2 - 2*x3*x5 + x4^2 + x5^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x4 + x4^2 + x5^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(4*x1^2 - 4*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1*x3 - x1*x5 + x2*x5 - x3*x4));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1*x5 - x2*x5 + x3*x4));
print("SAT_FACTOR=10");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x2^2 - 2*x2*x4 + x3^2 - 2*x3*x5 + x4^2 + x5^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x2^2 - 4*x2*x4 + x3^2 - 4*x3*x5 + 4*x4^2 + 4*x5^2));
print("SAT_FACTOR=13");
J=sat(J,ideal(x4^2 + x5^2));
print("SAT_FACTOR=14");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
