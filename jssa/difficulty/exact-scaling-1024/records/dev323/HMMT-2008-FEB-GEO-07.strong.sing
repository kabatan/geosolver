J=sat(J,ideal(x4^2 - 2*x4*x6 + x5^2 - 2*x5*x7 + x6^2 + x7^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1^2 - 10*x1*x4 + 20*x1 + 25*x4^2 - 100*x4 + 25*x5^2 - 50*x5*x8 + 25*x8^2 + 100));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1^2 + 20*x1 + 25*x8^2 + 100));
print("SAT_FACTOR=14");
J=sat(J,ideal(x1^2 - 30*x1 + 25*x8^2 + 225));
print("SAT_FACTOR=15");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
