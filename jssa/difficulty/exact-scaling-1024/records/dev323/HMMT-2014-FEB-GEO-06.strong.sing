LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=6*x1*x3 - 5*x2*x3 + 25*x2 - 30*x3,
6*x1*x4 - 5*x2*x4 + 30*x2 - 30*x4,
-x1^2 + 10*x1 - x2^2 + 12*x2 + x5^2 - 61,
x5 - 5,
-x1^2 - x2^2 + x6^2,
x6 - 4,
x3^2 - 10*x3 + x4^2 - x7^2 + 25,
x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2 - x8^2,
x7 - x8*x9;
J=sat(J,ideal(x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 5));
print("SAT_FACTOR=3");
J=sat(J,ideal(6*x1 - 5*x2 - 30));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x2 - 6));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 10*x1 + x2^2 + 25));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
