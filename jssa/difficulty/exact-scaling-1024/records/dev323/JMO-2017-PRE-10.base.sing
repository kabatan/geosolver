LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1^2 - x10^2 + 2*x10*x8 - x8^2 - x9^2,
-x10^2 - x11^2 + 2*x11*x9 + x4^2 - x9^2,
-x11^2 + x5^2 - x8^2,
x1 + x4 + x5 - 12,
8*x10 + 3*x9 - 24,
-x10^2*x11^2 + 6*x10*x11^2 - 6*x10*x11*x9 - 9*x11^2 + 18*x11*x9 + x6^2 - 9*x9^2,
-x11^2*x8^2 + 6*x11^2*x8 - 9*x11^2 + x7^2,
-3*x10*x7 + x11^2*x6 - x11^2*x7 + x11*x7*x9 + 3*x6*x8,
x2^2 - x8^2*x9^2 + 6*x8*x9^2 - 9*x9^2,
-x11^2*x8^2 + x3^2,
x10*x3*x8 - 3*x10*x3 + x2*x8^2 - x3*x8^2 + 3*x3*x8;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
