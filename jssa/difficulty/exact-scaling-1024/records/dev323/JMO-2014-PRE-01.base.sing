LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x4^2 + x5^2 + 2*x5*x8 - 18*x5 - 18*x8 + 81,
x1^2*x4^2 + x1^2*x5^2 - x4^2*x8^2 + 18*x4^2*x8 - 81*x4^2,
x1 - x8,
x6^2 + x7^2 - 81,
x4*x7 - x5*x6,
9*x4 - x5*x9,
x2^2 - x4^2 + 2*x4*x6 - x5^2 + 2*x5*x7 - x6^2 - x7^2,
x3^2 - x6^2 + 2*x6*x9 - x7^2 + 18*x7 - x9^2 - 81,
x2 - x3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
