LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16),dp;
short=0;
ideal J=-x1^2 + x1*x4 - x2^2 + 2*x2*x5,
-x1^2 + x1*x3 + 11*x1 - x2^2 + 2*x2*x6 - 11*x3,
-x1*x3^2 + 2*x1*x3*x4 - 22*x1*x3 - x1*x4^2 + 22*x1*x4 + 4*x1*x5^2 - 8*x1*x5*x6 + 4*x1*x6^2 - 121*x1 + 4*x2*x3*x5 - 4*x2*x3*x6 - 4*x2*x4*x5 + 4*x2*x4*x6 + 44*x2*x5 - 44*x2*x6 + x3^2*x7 - 2*x3*x4*x7 - 4*x3*x5^2 + 4*x3*x5*x6 + 22*x3*x7 + x4^2*x7 + 4*x4*x5*x6 - 4*x4*x6^2 - 22*x4*x7 + 4*x5^2*x7 - 44*x5^2 - 8*x5*x6*x7 + 44*x5*x6 + 4*x6^2*x7 + 121*x7,
4*x1*x3*x5 - 4*x1*x3*x6 - 4*x1*x4*x5 + 4*x1*x4*x6 + 44*x1*x5 - 44*x1*x6 + x2*x3^2 - 2*x2*x3*x4 + 22*x2*x3 + x2*x4^2 - 22*x2*x4 - 4*x2*x5^2 + 8*x2*x5*x6 - 4*x2*x6^2 + 121*x2 - 2*x3^2*x5 + x3^2*x8 + 2*x3*x4*x5 + 2*x3*x4*x6 - 2*x3*x4*x8 - 44*x3*x5 + 22*x3*x8 - 2*x4^2*x6 + x4^2*x8 + 22*x4*x5 + 22*x4*x6 - 22*x4*x8 + 4*x5^2*x8 - 8*x5*x6*x8 - 242*x5 + 4*x6^2*x8 + 121*x8,
-x1*x8 + x2*x7 - x2*x9 + x8*x9,
x10^2 - x2^2*x4^2 + 22*x2^2*x4 - 121*x2^2,
x11^2 - x2^2*x3^2,
x1^2*x10 - x1*x10*x3 - x1*x11*x4 + 11*x1*x11 + x10*x2^2 + 11*x11*x4 - 121*x11,
-x1^2*x11 + x1*x10*x3 + x1*x11*x4 + 11*x1*x11 - x11*x2^2 - 11*x11*x4,
-x12^2 + x9^2,
x12 - 5,
-x13^2 + x9^2 - 22*x9 + 121,
x13 - 6,
-x14^2 + x3^2 - 2*x3*x7 + x7^2 + x8^2,
x14 - 3,
-x15^2 + x4^2 - 2*x4*x7 + x7^2 + x8^2,
x15 - x16;
J=sat(J,ideal(-x2 + x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3 - 11));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3 - x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(x4));
print("SAT_FACTOR=6");
J=sat(J,ideal(x4 - 11));
print("SAT_FACTOR=7");
J=sat(J,ideal(x3^2 - 2*x3*x4 + 22*x3 + x4^2 - 22*x4 + 4*x5^2 - 8*x5*x6 + 4*x6^2 + 121));
print("SAT_FACTOR=8");
J=sat(J,ideal(4*x1^2 - 4*x1*x4 + 4*x2^2 - 8*x2*x5 + x4^2 + 4*x5^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(2*x1*x5 - 2*x1*x6 + x2*x3 - x2*x4 + 11*x2 - x3*x5 + x4*x6 - 11*x5));
print("SAT_FACTOR=10");
J=sat(J,ideal(4*x1^2 - 4*x1*x3 - 44*x1 + 4*x2^2 - 8*x2*x6 + x3^2 + 22*x3 + 4*x6^2 + 121));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 2*x1*x7 + x2^2 - 2*x2*x8 + x7^2 + x8^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 + x3^2));
print("SAT_FACTOR=14");
J=sat(J,ideal(x1^2 - 2*x1*x4 + x2^2 + x4^2));
print("SAT_FACTOR=15");
J=sat(J,ideal(x1^2 - 22*x1 + x2^2 + 121));
print("SAT_FACTOR=16");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
