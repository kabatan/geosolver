LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=2*x1*x8 + x7^2 - 3*x7 - x8^2 - 88,
2*x2*x8 + x7^2 + 19*x7 - x8^2,
2*x3*x8 - x7^2 + 11*x7 - x8^2,
2*x4*x8 - x7^2 - 27*x7 - x8^2 - 152,
x5^2 - x7^2 - 16*x7 - x8^2 - 64,
x5 - 8,
x6^2 - x7^2 - x8^2,
x6 - 4,
x8*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
