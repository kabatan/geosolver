LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23),dp;
short=0;
ideal J=64*x3^6 - 96*x3^4 + 36*x3^2 - 3,
x3^2 + x4^2 - 1,
x15^2 - x16^2*x20^2,
x15*x3 + x16*x19*x4,
64*x5^6 - 96*x5^4 + 36*x5^2 - 3,
x5^2 + x6^2 - 1,
-x16^2*x18^2 + x7^2,
x16^2*x6 - x16*x17*x6 + x5*x7,
64*x1^6 - 96*x1^4 + 36*x1^2 - 3,
x1^2 + x2^2 - 1,
-x16^2*x18^2 + 2*x16^2*x18*x20 - x16^2*x20^2 - 2*x16*x17*x18*x20 + 2*x16*x17*x20^2 + 2*x16*x18^2*x19 - 2*x16*x18*x19*x20 - x17^2*x20^2 + 2*x17*x18*x19*x20 - x18^2*x19^2 + x8^2,
x1*x8 - x16*x17*x2 + x16*x19*x2 + x17^2*x2 - x17*x19*x2 + x18^2*x2 - x18*x2*x20,
-x21^2 - x22^2 + x9^2,
x10^2 - x17^2 + 2*x17*x21 - x18^2 + 2*x18*x22 - x21^2 - x22^2,
-x10 + x9,
4*x11^2 - x16^2 + 4*x16*x21 - 4*x21^2 - 4*x22^2,
4*x12^2 - x17^2 - 2*x17*x19 + 4*x17*x21 - x18^2 - 2*x18*x20 + 4*x18*x22 - x19^2 + 4*x19*x21 - x20^2 + 4*x20*x22 - 4*x21^2 - 4*x22^2,
4*x13^2 - x16^2,
4*x14^2 - x17^2 + 2*x17*x19 - x18^2 + 2*x18*x20 - x19^2 - x20^2,
x11*x14 - x12*x13,
x16*x18 + x16*x20 - 2*x16*x22 + 2*x17*x22 - 2*x18*x21 + 2*x19*x22 - 2*x20*x21,
x12*x14*x23 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
