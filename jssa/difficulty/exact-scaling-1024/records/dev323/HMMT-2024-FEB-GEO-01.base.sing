LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1^2 - 3,
x1*x5 - x6,
x1*x11 + x1*x7 - 6*x1 + x8,
x1*x11 - 2*x10,
x1*x11^2 + x1*x11*x5 - x1*x11*x7 - x11*x6 + x11*x8,
-x1*x11^2 + x1*x11*x7 - x1*x11*x9 - x10*x11 + x11*x8,
x1*x11^2 + 2*x10*x11 - 2*x11*x6,
x1^2*x11^2 - 4*x1*x11*x6 + 4*x1*x11*x8 + x11^2 + 4*x11*x5 - 4*x11*x7 - 4*x2^2 + 4*x5^2 - 8*x5*x7 + 4*x6^2 - 8*x6*x8 + 4*x7^2 + 4*x8^2,
x2 - 1,
-x10^2 + 2*x10*x8 - x11^2 + 2*x11*x7 - 2*x11*x9 + x3^2 - x7^2 + 2*x7*x9 - x8^2 - x9^2,
x3 - 1,
x1^2*x11^2 + 4*x1*x10*x11 - 4*x1*x11*x6 + 4*x10^2 - 8*x10*x6 + x11^2 - 4*x11*x5 + 4*x11*x9 - 4*x4^2 + 4*x5^2 - 8*x5*x9 + 4*x6^2 + 4*x9^2,
x4 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
