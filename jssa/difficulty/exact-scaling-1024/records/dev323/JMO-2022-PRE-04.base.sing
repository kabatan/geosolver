LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1^2 - x8^2 - x9^2,
x1 - 7,
x2^2 - x8^2 + 6*x8 - x9^2 - 9,
x2 - 6,
-x10^2 - x11^2 + 10*x11 + x3^2 - 25,
x3 - 10,
x10*x8 - 3*x10 + x11*x9 - 5*x9,
4*x4^2 - 9*x9^2,
-x10^2*x9^2 + 2*x10*x11*x8*x9 - 6*x10*x11*x9 + 6*x10*x9^2 - x11^2*x8^2 + 6*x11^2*x8 - 9*x11^2 - 6*x11*x8*x9 + 18*x11*x9 + 4*x5^2 - 9*x9^2,
-25*x10^2 - 30*x10*x11 + 150*x10 - 9*x11^2 + 90*x11 + 4*x6^2 - 225,
-x10^2*x9^2 + 10*x10^2*x9 - 25*x10^2 + 2*x10*x11*x8*x9 - 10*x10*x11*x8 - x11^2*x8^2 + 4*x7^2,
2*x4 + 2*x5 + 2*x6 - 2*x7 + 15;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
