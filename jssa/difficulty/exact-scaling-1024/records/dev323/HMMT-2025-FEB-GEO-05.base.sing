LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x4^2 - 3,
2*x1*x4 - 3*x4^2 + 3,
9*x10^2*x4^2 + 9*x10^2 + 36*x10*x9 - x6^2 + 36*x9^2,
2*x1*x3 - x2^2 + 6*x2 - x3^2,
9*x10^2*x4^2 + 9*x10^2 - 12*x10*x2 - 12*x10*x3*x4 + 36*x10*x9 + 4*x2^2 - 24*x2*x9 + 4*x3^2 - x6^2 + 36*x9^2,
9*x4^2 - x7^2 + 9,
x7 - 6,
324*x10^2*x4^2 + 648*x10*x4^2*x9 - 648*x10*x4^2 + 324*x4^2*x9^2 - 648*x4^2*x9 + 324*x4^2 - x8^2,
9*x10^2*x4^3 + 9*x10^2*x4 - 9*x10*x4^3 + 36*x10*x4*x9 - 27*x10*x4 + 36*x4*x9^2 - 54*x4*x9 + 18*x4 + x8,
x2^2 + x3^2 - x5^2,
x5 - 5,
x11*x4 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
