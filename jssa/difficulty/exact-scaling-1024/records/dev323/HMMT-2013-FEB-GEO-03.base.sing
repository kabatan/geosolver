LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20),dp;
short=0;
ideal J=x1*x19 - x16*x19 + x17*x18,
-x15*x16*x19 + x15*x17*x18 - x15*x18*x19 + x15*x19*x2 + x16*x18*x19 - x17*x18^2,
-x15*x19 + x15*x3 + x16*x19 - x17*x18,
x15*x17 - x15*x19 - x17*x18 + x19*x4,
-x17*x18 + x19*x5,
-x15*x17*x18 + x15*x18*x19 + x15*x19*x6 - x16*x18*x19 + x17*x18^2,
-x15*x17 + x15*x19 + x15*x7 - x16*x19 + x17*x18,
-x15*x17 + x15*x19 - x16*x19 + x17*x18 + x19*x8,
x14^2 - x15^2,
-x15^2 + 2*x15*x18 - x18^2 - x19^2 + x9^2,
x10^2 - x18^2 - x19^2,
-4*x11^2 + x7^2*x8^2,
x11 - 1,
x1^2*x17^2 - 2*x1^2*x17*x19 + x1^2*x19^2 - 2*x1*x17^2*x8 + 4*x1*x17*x19*x8 - 2*x1*x19^2*x8 - 4*x12^2 + x17^2*x8^2 - 2*x17*x19*x8^2 + x19^2*x8^2,
x12 - 4,
x1^2*x3^2 - 2*x1*x15*x3^2 - 4*x13^2 + x15^2*x3^2,
x13 - 9,
-x16*x19 + x17*x18 - x18*x3 + x19*x2,
-x15*x19 + x15*x3 - x18*x3 + x19*x2,
-x18*x7 + x19*x6,
-x15*x17 + x15*x19 + x15*x7 - x16*x19 + x17*x18 - x18*x7 + x19*x6,
x15*x19*x20 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
