LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=-x3^2 + 98*x3 - x4^2 + x9^2 - 2401,
x11^2 - x3^2 - x4^2,
x11*x5 - 49*x11 - 49*x3 + x5*x9 + 49*x5,
x11*x6 - 49*x4 + x6*x9 + 49*x6,
-x1^2 + 2*x1*x3 + x12^2 - x2^2 + 2*x2*x4 - x3^2 - x4^2,
-x1^2 + 98*x1 + x13^2 - x2^2 - 2401,
-x1*x9 + x12*x7 - 49*x12 - x13*x3 + x13*x7 + x7*x9,
x12*x8 - x13*x4 + x13*x8 - x2*x9 + x8*x9,
x11 - 49,
-x1^2 + x14^2 - x2^2,
x14 - 73,
x1^2*x4 - 49*x1*x4 + x2^2*x4 - x2*x3^2 + 49*x2*x3 - x2*x4^2,
-x3*x6 - x3*x8 + x4*x5 + x4*x7 - 98*x4 + 49*x6 + 49*x8,
-x10^2 + x5^2 - 2*x5*x7 + x6^2 - 2*x6*x8 + x7^2 + x8^2,
x10 - x15;
J=sat(J,ideal(x11 + x9 + 49));
print("SAT_FACTOR=1");
J=sat(J,ideal(x12 + x13 + x9));
print("SAT_FACTOR=2");
J=sat(J,ideal(x10));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 - 98*x1 + x2^2 + 2401));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1*x4 - x2*x3 + 49*x2 - 49*x4));
print("SAT_FACTOR=10");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x3^2 - 98*x3 + x4^2 + 2401));
print("SAT_FACTOR=12");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
