LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x1*x6^2 + 25*x1 - 50*x6,
x2*x6^2 + 25*x2 + 5*x6^2 - 125,
x3*x7^2 - 16*x3*x7 + 89*x3 - 8*x7^2 + 78*x7 - 312,
x4*x7^2 - 16*x4*x7 + 89*x4 + 5*x7^2 - 80*x7 + 195,
x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2 - x5^2,
x5;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
