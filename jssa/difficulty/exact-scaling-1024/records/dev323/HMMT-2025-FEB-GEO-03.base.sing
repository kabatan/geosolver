LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=4*x1^2 - x10^2*x11^2,
x1 - x5,
-x11^4 + 2*x11^3*x9 - x11^2*x9^2 + 4*x2^2,
x2 - x6,
-x10^2*x11^2 + 2*x10*x11^3 - x11^4 + 4*x3^2,
x3 - x7,
-x11^2*x9^2 + 4*x4^2,
x4 - x8,
x5 + x6 + x7 + x8 - 10,
x5*x6 + x5*x7 + x5*x8 + x6*x7 + x6*x8 + x7*x8 - 35,
x5*x6*x7 + x5*x6*x8 + x5*x7*x8 + x6*x7*x8 - 50,
x5*x6*x7*x8 - 24;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
