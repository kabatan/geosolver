LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=-x1^2 - x2^2 + 6*x2 + x6^2 - 9,
x6 - 7,
-x1^2 + 4*x1 - x2^2 + x7^2 - 4,
x7 - 6,
-x4^2 + x8^2,
-x5 + x8,
-x3^2 + x9^2,
-x5 + x9,
x1^2*x10^2 - x1^2*x4^2 + 6*x1^2*x4 - 9*x1^2 + 2*x1*x2*x3*x4 - 6*x1*x2*x3 - 6*x1*x3*x4 + 18*x1*x3 + x10^2*x2^2 - 6*x10^2*x2 + 9*x10^2 - x2^2*x3^2 + 6*x2*x3^2 - 9*x3^2,
x10 - x5,
x1^2*x11^2 - x1^2*x4^2 - 4*x1*x11^2 + 2*x1*x2*x3*x4 - 4*x1*x2*x4 + 4*x1*x4^2 + x11^2*x2^2 + 4*x11^2 - x2^2*x3^2 + 4*x2^2*x3 - 4*x2^2 - 4*x2*x3*x4 + 8*x2*x4 - 4*x4^2,
x11 - x5,
x12 - x5;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(3*x1 + 2*x2 - 6));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x5));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 + x2^2 - 6*x2 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 4*x1 + x2^2 + 4));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
