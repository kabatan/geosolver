LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19),dp;
short=0;
ideal J=x1*x2 - x2^2 - x3^2 + 2*x3*x4,
x1*x2 - x2^2 - x3^2 + 2*x3*x6,
-x1^2 + x17^2,
x18^2 - x2^2 - x3^2,
-x1*x18 - x17*x2 + x17*x7 + x18*x7,
-x17*x3 + x17*x8 + x18*x8,
x1^3*x18^2 + 2*x1^2*x17*x18*x2 - x1^2*x18^2*x9 + x1*x17^2*x2^2 - 2*x1*x17*x18*x2*x9 + 2*x1*x17*x18*x3*x6 - x17^2*x2^2*x9 + 2*x17^2*x2*x3*x6 - x17^2*x3^2*x9,
-x1^2*x10*x18^2 + x1^2*x17*x18*x3 - 2*x1*x10*x17*x18*x2 + x1*x17^2*x2*x3 - x10*x17^2*x2^2 - x10*x17^2*x3^2 + 2*x17^2*x3^2*x6,
-x1^2*x3 + x1*x11*x3 + 2*x1*x11*x4 - 2*x11*x2*x4,
-2*x1*x3*x4 + x1*x3*x5 + 2*x1*x4*x5 - 2*x2*x4*x5,
x11^2 - 2*x11*x7 - x12^2 + x5^2 - 2*x5*x8 + x7^2 + x8^2,
x12 - 6,
x1^2 - 2*x1*x11 + x11^2 - x13^2 + 4*x4^2 - 4*x4*x5 + x5^2,
x13 - 7,
x1^2 - 2*x1*x9 + x10^2 - 4*x10*x4 - x14^2 + 4*x4^2 + x9^2,
x14 - 9,
-x1^2*x3^2 + 4*x15^2,
x1^2 - 4*x16^2 + 4*x6^2,
x16 - x19;
J=sat(J,ideal(x15));
print("SAT_FACTOR=1");
J=sat(J,ideal(x17 + x18));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1 - x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x3));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 + 4*x4^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1*x3 + 2*x1*x4 - 2*x2*x4));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 + 4*x6^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1*x2 - x2^2 - x3^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1^2*x18 + x1*x17*x2 + 2*x17*x3*x6));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1^2*x18^2 + 2*x1*x17*x18*x2 + x17^2*x2^2 + x17^2*x3^2));
print("SAT_FACTOR=14");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
