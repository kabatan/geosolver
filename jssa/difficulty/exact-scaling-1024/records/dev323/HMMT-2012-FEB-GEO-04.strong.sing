LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x7^2 - 3,
64*x1*x7^2 + 169*x1 - 608*x7^2,
64*x2*x7^2 + 169*x2 - 988*x7,
2*x1^2*x3 - 19*x1^2 + 2*x2^2*x3,
2*x1^2*x4 - 19*x1*x2 + 2*x2^2*x4,
x1*x6 - x2*x5 + 3*x2 - 3*x6,
13*x5^2 + 13*x6^2 - 76*x6*x7,
13*x1^2 + 13*x2^2 - 76*x2*x7,
x1^2 - 19*x1 + x2^2 + 48,
4*x3^2 - 76*x3 + 4*x4^2 - 4*x9^2 + 361,
2*x9 - 13,
-x10^2 + x5^2 + x6^2,
x5^2 - 6*x5 + x6^2 - x8^2 + 9,
-x10 + x11*x8;
J=sat(J,ideal(x7));
print("SAT_FACTOR=1");
J=sat(J,ideal(x8));
print("SAT_FACTOR=2");
J=sat(J,ideal(x10));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 2*x1*x5 + x2^2 - 2*x2*x6 + x5^2 + x6^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 6*x1 + x2^2 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(64*x7^2 + 169));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
