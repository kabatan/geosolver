LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x2^2 - 3,
9*x1^4*x2^2 - 4*x3^2,
x3 - 1,
9*x1^4*x2^2 - 784*x4^2,
x1^4*x2^2 - 144*x5^2,
625*x1^4*x2^2 - 7056*x6^2,
2*x4 + x5 - x6 - x7;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(9*x2^2 + 25));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2^2 + 49));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2^2 + 9));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
