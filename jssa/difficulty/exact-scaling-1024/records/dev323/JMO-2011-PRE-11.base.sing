LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
x3^2 + x4^2 - 1,
x5^2 + x6^2 - 1,
-x10*x6 + x21*x5^2 - x21*x5 + x21*x6^2,
x1^2*x21 - x1*x21 - x11*x2 + x2^2*x21,
x1^2*x21*x4 - x1*x12*x4 + x12*x2*x3 + x2^2*x21*x4 - x2*x21*x3^2 - x2*x21*x4^2,
x1^2*x21*x3 - x1*x21*x3^2 - x1*x21*x4^2 + x1*x4*x7 + x2^2*x21*x3 - x2*x3*x7,
x21*x3^2*x6 + x21*x4^2*x6 - x21*x4*x5^2 - x21*x4*x6^2 - x3*x6*x8 + x4*x5*x8,
x21*x3^2*x5 - x21*x3*x5^2 - x21*x3*x6^2 + x21*x4^2*x5 + x3*x6*x9 - x4*x5*x9,
x10^2 - x13^2 + x21^2,
x13 - 5,
x11^2 - x14^2 + x21^2,
x14 - 6,
x12^2 - x15^2 + x7^2,
x15 - 7,
-x16^2 + x8^2 + x9^2,
x16 - 8,
x17^2 - x21^2,
x17 - x21,
-x11^2*x12^2 + x11^2*x18^2 + 2*x11*x12*x21*x7 - 2*x11*x18^2*x7 + x12^2*x18^2 - 2*x12*x18^2*x21 + x18^2*x21^2 + x18^2*x7^2 - x21^2*x7^2,
x18 - x21,
-x12^2*x19^2 + x12^2*x9^2 + 2*x12*x19^2*x8 - 2*x12*x7*x8*x9 - x19^2*x7^2 + 2*x19^2*x7*x9 - x19^2*x8^2 - x19^2*x9^2 + x7^2*x8^2,
x19 - x21,
-x10^2*x20^2 + x10^2*x8^2 + 2*x10*x20^2*x9 - 2*x10*x21*x8*x9 - x20^2*x21^2 + 2*x20^2*x21*x8 - x20^2*x8^2 - x20^2*x9^2 + x21^2*x9^2,
x20 - x21,
x1*x2*x21*x22*x3*x4*x6^2 - x1*x2*x21*x22*x4^2*x5*x6 - x2^2*x21*x22*x3^2*x6^2 + x2^2*x21*x22*x3*x4*x5*x6 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
