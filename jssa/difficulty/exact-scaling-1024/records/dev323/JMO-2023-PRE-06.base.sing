LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
x3^2 - 3,
x10*x2*x7 - x6*x7 + x7*x9,
x1*x10*x6 - x10*x2*x3*x6 + 2*x6*x7 - 2*x6*x8,
x10*x2*x7 - x7*x9,
x1*x10*x6 - x10*x2*x3*x6 + 2*x6*x8,
x1^4*x10^4*x3^2 + 2*x1^3*x10^3*x3^2*x8 - 2*x1^3*x10^3*x3*x6 + 2*x1^3*x10^3*x3*x9 + 2*x1^2*x10^4*x2^2*x3^2 - 2*x1^2*x10^3*x2*x3^2*x6 + 2*x1^2*x10^3*x2*x3^2*x9 - 2*x1^2*x10^3*x2*x3*x8 + x1^2*x10^2*x3^2*x8^2 - 2*x1^2*x10^2*x3*x6*x8 + 2*x1^2*x10^2*x3*x8*x9 + x1^2*x10^2*x6^2 - 2*x1^2*x10^2*x6*x9 + x1^2*x10^2*x9^2 + 2*x1*x10^3*x2^2*x3^2*x8 - 2*x1*x10^3*x2^2*x3*x6 + 2*x1*x10^3*x2^2*x3*x9 - 2*x1*x10^2*x2*x3^2*x6*x8 + 2*x1*x10^2*x2*x3^2*x8*x9 + 2*x1*x10^2*x2*x3*x6^2 - 4*x1*x10^2*x2*x3*x6*x9 - 2*x1*x10^2*x2*x3*x8^2 + 2*x1*x10^2*x2*x3*x9^2 + 2*x1*x10^2*x2*x6*x8 - 2*x1*x10^2*x2*x8*x9 + x10^4*x2^4*x3^2 - 2*x10^3*x2^3*x3^2*x6 + 2*x10^3*x2^3*x3^2*x9 - 2*x10^3*x2^3*x3*x8 + x10^2*x2^2*x3^2*x6^2 - 2*x10^2*x2^2*x3^2*x6*x9 + x10^2*x2^2*x3^2*x9^2 + 2*x10^2*x2^2*x3*x6*x8 - 2*x10^2*x2^2*x3*x8*x9 + x10^2*x2^2*x8^2 - 16*x4^2,
x4 - 20,
4*x1^4*x10^4*x3^2 - 4*x1^3*x10^3*x3^2*x8 + 12*x1^3*x10^3*x3*x9 + 8*x1^2*x10^4*x2^2*x3^2 - 4*x1^2*x10^3*x2*x3^2*x9 - 12*x1^2*x10^3*x2*x3*x8 + x1^2*x10^2*x3^2*x8^2 - 6*x1^2*x10^2*x3*x8*x9 + 9*x1^2*x10^2*x9^2 - 4*x1*x10^3*x2^2*x3^2*x8 + 12*x1*x10^3*x2^2*x3*x9 + 2*x1*x10^2*x2*x3^2*x8*x9 + 6*x1*x10^2*x2*x3*x8^2 - 6*x1*x10^2*x2*x3*x9^2 - 18*x1*x10^2*x2*x8*x9 + 4*x10^4*x2^4*x3^2 - 4*x10^3*x2^3*x3^2*x9 - 12*x10^3*x2^3*x3*x8 + x10^2*x2^2*x3^2*x9^2 + 6*x10^2*x2^2*x3*x8*x9 + 9*x10^2*x2^2*x8^2 - 16*x5^2,
x5 - 23;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
