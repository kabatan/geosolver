LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16),dp;
short=0;
ideal J=2*x1*x13 - x12^2 + 6*x12 - x13^2,
x1^2*x13 - x1*x12^2 + x1*x12*x2 + 3*x1*x12 - x1*x13^2 - 6*x1*x2 + 18*x1 + 3*x13*x2 - 18*x13,
x1*x12*x3 + 3*x1*x13 - 6*x1*x3 - 3*x12^2 + 27*x12 - 3*x13^2 + 3*x13*x3 - 54,
x12^2*x2 - x12^2*x4 - x12*x13*x15 + x12*x13*x3 - 2*x12*x14*x2 + 2*x12*x14*x4 + x12*x15^2 - x12*x15*x3 + x13^2*x14 - x13^2*x4 - x13*x14*x15 - x13*x14*x3 + 2*x13*x15*x4 + x14^2*x2 - x14^2*x4 + x14*x15*x3 - x15^2*x4,
x12^2*x15 - x12^2*x5 - x12*x13*x14 + x12*x13*x2 - x12*x14*x15 + 2*x12*x14*x5 - x12*x15*x2 + x13^2*x3 - x13^2*x5 + x13*x14^2 - x13*x14*x2 - 2*x13*x15*x3 + 2*x13*x15*x5 - x14^2*x5 + x14*x15*x2 + x15^2*x3 - x15^2*x5,
-x12^2*x5 + 2*x12*x5*x6 - x13^2*x5 + x13*x4^2 - 2*x13*x4*x6 + x13*x5^2 + 12*x13*x6 - 36*x13 - 12*x5*x6 + 36*x5,
-x12^2*x4 + 6*x12^2 + x12*x4^2 + x12*x5^2 - 2*x12*x5*x7 - 36*x12 - x13^2*x4 + 6*x13^2 + 2*x13*x4*x7 - 12*x13*x7 - 6*x4^2 + 36*x4 - 6*x5^2 + 12*x5*x7,
x10^2 - x12^2 + 12*x12 - x13^2 - 36,
x10 - 5,
x11^2 - x12^2 - x13^2,
x11 - 7,
2*x1*x15 - x14^2 + 6*x14 - x15^2,
x14^2 - 2*x14*x4 + x15^2 - 2*x15*x5 + x4^2 + x5^2 - x8^2,
x12^2 - 2*x12*x4 + x13^2 - 2*x13*x5 + x4^2 + x5^2 - x9^2,
x8 - 3*x9,
x12*x15 - x12*x5 - x13*x14 + x13*x4 + x14*x5 - x15*x4,
-x1*x12^2*x13*x16*x5 + x1*x12*x13^2*x16*x4 - 6*x1*x12*x13^2*x16 + 12*x1*x12*x13*x16*x5 - 6*x1*x13^2*x16*x4 + 36*x1*x13^2*x16 - 36*x1*x13*x16*x5 - 3*x12*x13^2*x16*x5 + 3*x13^3*x16*x4 - 18*x13^3*x16 + 18*x13^2*x16*x5 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
