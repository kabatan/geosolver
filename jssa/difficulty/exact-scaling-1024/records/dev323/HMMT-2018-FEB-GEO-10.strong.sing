LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x1^2 + 6*x1 - x2^2 + 2*x2*x5,
-x1^2*x5 + x1*x5*x6 + 3*x1*x5 - x2^2*x5 + x2*x5^2 + 3*x2*x6 - 18*x2 - 6*x5*x6 + 18*x5,
-3*x1^2 + x1*x5*x7 + 27*x1 - 3*x2^2 + 3*x2*x5 + 3*x2*x7 - 6*x5*x7 - 54,
x1^2*x6 - x1^2*x8 - x1*x2*x4 + x1*x2*x7 - 2*x1*x3*x6 + 2*x1*x3*x8 + x1*x4^2 - x1*x4*x7 + x2^2*x3 - x2^2*x8 - x2*x3*x4 - x2*x3*x7 + 2*x2*x4*x8 + x3^2*x6 - x3^2*x8 + x3*x4*x7 - x4^2*x8,
x1^2*x4 - x1^2*x9 - x1*x2*x3 + x1*x2*x6 - x1*x3*x4 + 2*x1*x3*x9 - x1*x4*x6 + x2^2*x7 - x2^2*x9 + x2*x3^2 - x2*x3*x6 - 2*x2*x4*x7 + 2*x2*x4*x9 - x3^2*x9 + x3*x4*x6 + x4^2*x7 - x4^2*x9,
-x1^2*x9 + 2*x1*x10*x9 - 2*x10*x2*x8 + 12*x10*x2 - 12*x10*x9 - x2^2*x9 + x2*x8^2 + x2*x9^2 - 36*x2 + 36*x9,
-x1^2*x8 + 6*x1^2 - 2*x1*x11*x9 + x1*x8^2 + x1*x9^2 - 36*x1 + 2*x11*x2*x8 - 12*x11*x2 + 12*x11*x9 - x2^2*x8 + 6*x2^2 - 6*x8^2 + 36*x8 - 6*x9^2,
-x1^2 + 12*x1 + x15^2 - x2^2 - 36,
x15 - 5,
-x1^2 + x16^2 - x2^2,
x16 - 7,
-x3^2 + 6*x3 - x4^2 + 2*x4*x5,
-x12^2 + x3^2 - 2*x3*x8 + x4^2 - 2*x4*x9 + x8^2 + x9^2,
x1^2 - 2*x1*x8 - x13^2 + x2^2 - 2*x2*x9 + x8^2 + x9^2,
x12 - 3*x13,
x1*x4 - x1*x9 - x2*x3 + x2*x8 + x3*x9 - x4*x8,
4*x10^2 - 24*x10 - x14^2 + 36,
x14 - x17;
J=sat(J,ideal(x10 - 6));
print("SAT_FACTOR=1");
J=sat(J,ideal(x13));
print("SAT_FACTOR=2");
J=sat(J,ideal(x14));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x5^2 + 9));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 6*x1 + x2^2 - 2*x2*x5 + x5^2 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1*x5 + 3*x2 - 6*x5));
print("SAT_FACTOR=7");
J=sat(J,ideal(-x1*x9 + x2*x8 - 6*x2 + 6*x9));
print("SAT_FACTOR=8");
J=sat(J,ideal(x10^2 - 12*x10 + x11^2 + 36));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=10");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
