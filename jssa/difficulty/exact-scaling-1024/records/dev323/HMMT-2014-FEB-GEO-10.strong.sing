LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=-2925*x1^2 + 71112*x1*x3 - 434512*x3^2 + 2925*x4^2,
-x1 + x4,
-33424*x3^2 + 88320*x3 + 225*x5^2 - 58500,
-x2 + x5,
-x1^2 + 32*x1 + x6^2 - 260,
-x1 - x2 + x6,
-x2 + x7;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
