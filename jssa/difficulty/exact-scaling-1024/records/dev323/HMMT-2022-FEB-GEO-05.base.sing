LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=4*x1^2 - 1815,
4*x1^2 - 4*x2^2 + 121,
x2 - 22,
x1^2 - 2*x1*x7 - x3^2 + x6^2 + x7^2,
x3 - 19,
4*x1^2*x6^2 - 44*x1^2*x6 + 121*x1^2 + 44*x1*x6*x7 - 242*x1*x7 - 4*x4^2 + 121*x7^2,
4*x1^2*x6^2 + 44*x1^2*x6 + 121*x1^2 - 44*x1*x6*x7 - 242*x1*x7 - 4*x5^2 + 121*x7^2,
16*x1^2*x7^2 + 968*x1*x7 - 16*x4*x5 - 484*x6^2 + 14641;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
