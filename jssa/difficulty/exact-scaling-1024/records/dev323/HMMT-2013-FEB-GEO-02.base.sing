LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5),dp;
short=0;
ideal J=4*x1^2 - 4*x5^2 - 25,
4*x2^2 - 4*x3^2 + 44*x3 - 4*x4^2 + 8*x4*x5 - 4*x5^2 - 121,
x1 - x2,
2*x3^2 - 11*x3 + 2*x4^2 - 2*x4*x5;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
