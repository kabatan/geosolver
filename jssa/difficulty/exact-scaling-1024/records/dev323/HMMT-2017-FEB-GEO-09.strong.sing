LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x1^2 + 2*x1*x2 - x2^2 - x3^2 + 2*x4^2,
-x1^2 + 2*x1*x2 - x2^2 - x3^2 + 4*x9^2,
-x1^2 + 2*x1*x2 + x10^2 - x2^2 - x3^2,
-x10 + 2*x9,
2*x11^2 - x2^2 - x3^2,
4*x12^2 - x2^2 - x3^2,
x13^2 - x2^2 - x3^2,
2*x12 - x13,
-x1^2 + 2*x14^2,
-x1^2 + 4*x15^2,
-x1^2 + x16^2,
2*x15 - x16,
-x1^2 - 2*x1*x3 - x2^2 - x3^2 + 2*x5^2,
x5 - 6,
-2*x1^2 + 2*x1*x2 - 2*x1*x3 - x2^2 - x3^2 + 2*x6^2,
x6 - 7,
-x1^2 + 2*x1*x2 - 2*x1*x3 - 2*x2^2 - 2*x3^2 + 2*x7^2,
x7 - 8,
-x1^4 + 2*x1^3*x2 - 4*x1^3*x3 - 3*x1^2*x2^2 + 4*x1^2*x2*x3 - 6*x1^2*x3^2 + 2*x1*x2^3 - 4*x1*x2^2*x3 + 2*x1*x2*x3^2 - 4*x1*x3^3 - x2^4 - 2*x2^2*x3^2 - x3^4 + 16*x8^2,
-x17 + x8;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
