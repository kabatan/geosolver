LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=-4*x3^2 + 4*x4^2 - 25,
-4*x1^2 + 44*x1 - 4*x2^2 + 8*x2*x3 - 4*x3^2 + 4*x5^2 - 121,
x4 - x5,
2*x1^2 - 11*x1 + 2*x2^2 - 2*x2*x3,
-x1^2 - x2^2 + x6^2,
x6 - x7;
J=sat(J,ideal(x6));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=3");
J=sat(J,ideal(4*x1^2 - 44*x1 + 4*x2^2 - 8*x2*x3 + 4*x3^2 + 121));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
