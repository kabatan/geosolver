LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
3*x1^2 - 2*x1 + 3*x2^2 - x2*x4,
9*x1^2 - 6*x1 + 9*x2^2 - 2*x2*x5,
3*x1*x7 - 3*x2*x6 + 18*x2 - 2*x7,
2*x4*x7 - x6^2 + 4*x6 - x7^2,
3*x1*x9 - 3*x2*x8 + 18*x2 - 2*x9,
2*x4*x9 - x8^2 + 4*x8 - x9^2,
-6*x1*x10*x7 + 6*x1*x6*x9 + 24*x1*x7 - 24*x1*x9 + 6*x10*x2*x6 - 24*x10*x2 - x10*x6*x9 + x10*x7*x8 + 4*x10*x9 - 6*x2*x6*x8 + 24*x2*x8 - 4*x7*x8,
6*x1*x3*x7 - 6*x1*x7*x9 - 6*x2*x3*x6 + 24*x2*x3 + 6*x2*x7*x8 - 24*x2*x7 + x3*x6*x9 - x3*x7*x8 - 4*x3*x9 + 4*x7*x9,
81*x1^2 - x11^2 + 81*x2^2,
x11 - 9,
36*x1^2 - x12^2 + 36*x2^2,
x12 - 6,
x10^2 - 6*x10 + x3^2 - 2*x3*x5,
6*x1*x13*x2*x7 - 6*x13*x2^2*x6 + 24*x13*x2^2 + x13*x2*x6*x9 - x13*x2*x7*x8 - 4*x13*x2*x9 - 6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
