LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=-x1^2 + 2*x1*x2 - x2^2 - x3^2 + x8^2,
-x2^2 - x3^2 + x9^2,
-x1^2 + x10^2,
-x1*x9 - x10*x2 + x10*x6 + x6*x8 + x6*x9,
-x10*x3 + x10*x7 + x7*x8 + x7*x9,
x2*x5 - x3*x4,
x11^2 - x4^2 - x5^2,
-9*x11 + x9,
-x1^2 + 18*x1*x4 + 81*x12^2 - 81*x4^2 - 81*x5^2,
x12 - 1,
x1^2 - 18*x1*x6 - 81*x13^2 + 81*x6^2 + 81*x7^2,
x13 - 1,
-x14^2 + x4^2 - 2*x4*x6 + x5^2 - 2*x5*x7 + x6^2 + x7^2,
x14 - 1,
x10 - x15;
J=sat(J,ideal(x10 + x8 + x9));
print("SAT_FACTOR=1");
J=sat(J,ideal(-x1 + x9));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
