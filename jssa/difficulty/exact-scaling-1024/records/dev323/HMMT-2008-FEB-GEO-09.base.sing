LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x5^2 - 3,
x6^2 - x8^2 - x9^2 + 6*x9 - 9,
x1 - x2*x5 + 3*x5,
4*x1^2 - 4*x1*x8 + 4*x2^2 - 4*x2*x9 - 12*x2 - x6^2 + x8^2 + x9^2 + 6*x9 + 9,
3*x3 + 4*x4 - 12,
4*x3^2 - 4*x3*x8 + 4*x4^2 - 4*x4*x9 - 12*x4 - x6^2 + x8^2 + x9^2 + 6*x9 + 9,
9*x5^2 - x7^2 + 9,
x7 - 6,
x5^2*x9^2 - 6*x5^2*x9 - 2*x5*x8*x9 - x9^2,
24*x8*x9 + 7*x9^2 - 96*x9;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
