LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=-x1^2*x2^2 + 4*x1^2*x3^2 + x2^2*x3^2,
x3 - 4,
-x1^2*x2^2 + 4*x1^2*x4^2 + 2*x1*x2^3 - x2^4 + x2^2*x4^2,
x4 - 7,
-x2^4 + x5^2,
x5 - x6;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(4*x1^2 + x2^2));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
