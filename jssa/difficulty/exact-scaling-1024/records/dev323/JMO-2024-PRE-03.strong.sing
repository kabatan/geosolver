LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=x8^2 - 3,
x4*x8 - x5,
x1^2 - 2*x1*x5 - x2^2 + x3^2 - 2*x3*x4 + x4^2 + x5^2,
x6*x8 + x7 - 10*x8,
x1^2 - 2*x1*x7 - x2^2 + x3^2 - 2*x3*x6 + x6^2 + x7^2,
x1^2 - 10*x1*x8 - x10^2 + x3^2 - 10*x3 + 25*x8^2 + 25,
x10 - x2,
-x1^2 + x11^2,
x11 - x2,
-x12^2 + x4^2 - 10*x4 + x5^2 - 10*x5*x8 + 25*x8^2 + 25,
-x13^2 + x6^2 - 10*x6 + x7^2 - 10*x7*x8 + 25*x8^2 + 25,
x12 + x13 - 13,
-x3^2 + x9^2,
-x14 + x9;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3 - 10));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3 - 5));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4^2 - 10*x4 + x5^2 - 10*x5*x8 + 25*x8^2 + 25));
print("SAT_FACTOR=5");
J=sat(J,ideal(x6^2 - 10*x6 + x7^2 - 10*x7*x8 + 25*x8^2 + 25));
print("SAT_FACTOR=6");
J=sat(J,ideal(x8^2 + 1));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
