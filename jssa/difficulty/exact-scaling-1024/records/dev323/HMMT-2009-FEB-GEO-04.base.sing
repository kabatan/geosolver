LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x1*x11^2 + x1 - x11^3 + x11,
x11^2*x2 - 2*x11^2 + x2,
x10*x3 - x11,
x10*x4 - x11,
x10*x5 - 1,
-x11*x3^2 + 2*x11*x3*x4 - x11*x4^2 + x3^2*x6 - 2*x3*x4*x6 - x3*x5^2 + x3*x5 + x4^2*x6 - x4*x5 + x5^2*x6,
-x11*x3*x5 + x11*x4*x5 + x3^2*x5 - x3^2*x7 - x3*x4*x5 + 2*x3*x4*x7 - x4^2*x7 - x5^2*x7 + x5^2,
-x10^2 + x8^2,
-x10^2*x11^2 + 2*x10*x11^2 - x11^2 + x9^2,
x8 - x9,
-x10*x11 - x11*x7 + x6,
x10*x12 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
