LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=x3^2 + x4^2 - 1,
-2*x1*x3 + x1 + 72*x3^2 - 36*x3 + 72*x4^2 - 4*x4*x5,
x1^2 - 36*x1 - 4*x13^2 + 4*x5^2 + 324,
-x1^2 + 36*x1 + x14^2 - 324,
-x15^2 + 1296*x2^2*x3^2 + 1296*x2^2*x4^2 - 2592*x2*x3^2 - 2592*x2*x4^2 + 1296*x3^2 + 1296*x4^2,
x1*x15 + 36*x14*x2*x3 + 36*x14*x3 - 2*x14*x6 - 2*x15*x6 + 18*x15,
18*x14*x2*x4 + 18*x14*x4 - x14*x7 - x15*x7,
-x16^2 + 1296*x3^2 + 1296*x4^2,
x16 - 36,
x1^2 - 144*x1*x3 + 36*x1 + 5184*x3^2 - 2592*x3 + 5184*x4^2 - 288*x4*x5 + 4*x5^2 - 4*x8^2 + 324,
-x13 + x8,
x1^2 - 144*x1*x2*x3 + 36*x1 + 5184*x2^2*x3^2 + 5184*x2^2*x4^2 - 2592*x2*x3 - 288*x2*x4*x5 + 4*x5^2 - 4*x9^2 + 324,
-x13 + x9,
-x10^2 + x6^2 + x7^2,
x10 - 12,
x1^2 - 4*x1*x6 + 36*x1 - x14^2 + 4*x6^2 - 72*x6 + 4*x7^2 + 324,
-x15^2 + 1296*x2^2*x3^2 + 1296*x2^2*x4^2 + 2592*x2*x3^2 - 144*x2*x3*x6 + 2592*x2*x4^2 - 144*x2*x4*x7 + 1296*x3^2 - 144*x3*x6 + 1296*x4^2 - 144*x4*x7 + 4*x6^2 + 4*x7^2,
x1^2 - 72*x1*x2*x3 - 72*x1*x3 + 36*x1 - 4*x11^2 + 1296*x2^2*x3^2 + 1296*x2^2*x4^2 + 2592*x2*x3^2 - 1296*x2*x3 + 2592*x2*x4^2 + 1296*x3^2 - 1296*x3 + 1296*x4^2 + 324,
2*x11 - x14 - x15,
x1^2 + 36*x1 - 4*x12^2 + 4*x5^2 + 324,
x12 - x17;
J=sat(J,ideal(x4));
print("SAT_FACTOR=1");
J=sat(J,ideal(x13));
print("SAT_FACTOR=2");
J=sat(J,ideal(x14));
print("SAT_FACTOR=3");
J=sat(J,ideal(x14 + x15));
print("SAT_FACTOR=4");
J=sat(J,ideal(x15));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1 - 18));
print("SAT_FACTOR=7");
J=sat(J,ideal(x2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x2 - 1));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 - 36*x1 + 4*x5^2 + 324));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 - 72*x1*x2*x3 - 72*x1*x3 + 36*x1 + 1296*x2^2*x3^2 + 1296*x2^2*x4^2 + 2592*x2*x3^2 - 1296*x2*x3 + 2592*x2*x4^2 + 1296*x3^2 - 1296*x3 + 1296*x4^2 + 324));
print("SAT_FACTOR=11");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
