LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=-x1^2 - x2^2 + x5^2,
x5 - 8,
-x1^2 + 12*x1 - x2^2 + x9^2 - 36,
x9 - 7,
x10^2 - 36*x2^2*x3^2,
x11^2 - 36*x2^2*x4^2,
-x1^2*x11*x4 + x1^2*x11 + 6*x1*x10*x4 - 6*x1*x11*x3 + 36*x10*x3 - 36*x10 - x11*x2^2*x4 + x11*x2^2,
-x1^2*x4^2 - 12*x1*x3*x4 + 12*x1*x4 + x12^2 - x2^2*x4^2 - 36*x3^2 + 72*x3 - 36,
-x1^2*x4^2 + 2*x1^2*x4 - x1^2 - 12*x1*x3*x4 + 12*x1*x3 - x2^2*x4^2 + 2*x2^2*x4 - x2^2 - 36*x3^2 + x6^2,
-2*x12 + x6,
-9*x2^2*x3^2 - 18*x2^2*x3*x4 + 18*x2^2*x3 - 9*x2^2*x4^2 + 18*x2^2*x4 - 9*x2^2 + x7^2,
-9*x2^2 + x8^2,
-x13*x8 + x7;
J=sat(J,ideal(x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3 + x4 - 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2*x4^2 + 12*x1*x3*x4 - 12*x1*x4 + x2^2*x4^2 + 36*x3^2 - 72*x3 + 36));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2*x4^2 - 2*x1^2*x4 + x1^2 + 12*x1*x3*x4 - 12*x1*x3 + x2^2*x4^2 - 2*x2^2*x4 + x2^2 + 36*x3^2));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
