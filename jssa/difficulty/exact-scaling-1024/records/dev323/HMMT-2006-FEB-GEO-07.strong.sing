LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=16*x1^2*x2 - 28*x1^2 - 25*x1 + 25*x2,
-16*x1^3 + 16*x1^2*x3 - 20*x1^2 + 10*x1 + 25*x3,
16*x1^2*x4 + 28*x1^2 + 25*x1 + 25*x4,
-16*x1^3 + 16*x1^2*x5 - 20*x1^2 + 10*x1 + 25*x5,
-4*x1^2 + x6^2,
-2*x1 + x6,
2*x1^2 - 2*x1*x2 - 2*x1*x3 + x2^2 + x3^2 - x7^2,
-x1 + x7,
2*x1^2 + 2*x1*x4 - 2*x1*x5 + x4^2 + x5^2 - x8^2,
-x1 + x8,
-x1 + x9;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(16*x1^2 + 25));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
