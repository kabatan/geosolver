LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=2*x1*x5 - x4^2 + 2*x4 - x5^2 + 15,
x2^2 - 2,
x3^2 - 64*x5^2,
x2*x3 - x2*x4^2 + 2*x2*x4 - x2*x5^2 + 15*x2,
x5*x6 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
