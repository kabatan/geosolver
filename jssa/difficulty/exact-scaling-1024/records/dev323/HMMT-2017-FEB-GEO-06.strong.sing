LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18),dp;
short=0;
ideal J=-x3^2 + 15*x3 - x4^2 + 2*x4*x5,
-x3^2 + 15*x3 - x4^2 + 2*x4*x6,
-x1^2*x7 + 2*x1*x2*x5 + 30*x1*x7 - x2^2*x7 + 15*x2^2 - 30*x2*x5 - 225*x7,
-x1^2*x8 - 15*x1*x2 + 30*x1*x8 + 2*x2^2*x5 - x2^2*x8 + 225*x2 - 225*x8,
-2*x1*x6*x7 + 2*x1*x8*x9 - 2*x2*x7*x9 + 15*x2*x7 + 2*x6*x7*x9 - 15*x8*x9,
2*x1*x10*x8 - 2*x1*x6*x8 - 2*x10*x2*x7 + 2*x10*x6*x7 - 15*x10*x8 + 15*x2*x8,
-x10^2*x11 + x10^2*x3 + 2*x10*x11*x4 - 2*x10*x3*x5 - 2*x10*x4*x9 + 2*x10*x5*x9 - x11*x3^2 + 2*x11*x3*x9 - x11*x4^2 - x11*x9^2 - x3^3 + 2*x3^2*x9 + 15*x3^2 - x3*x4^2 + 2*x3*x4*x5 - x3*x9^2 - 30*x3*x9 + 2*x4^2*x9 - 2*x4*x5*x9 + 15*x9^2,
-x10^2*x12 - x10^2*x4 + 2*x10^2*x5 + 2*x10*x12*x4 + 2*x10*x3^2 - 2*x10*x3*x9 - 15*x10*x3 + 2*x10*x4^2 - 4*x10*x4*x5 + 15*x10*x9 - x12*x3^2 + 2*x12*x3*x9 - x12*x4^2 - x12*x9^2 - x3^2*x4 + 15*x3*x4 - x4^3 + 2*x4^2*x5 + x4*x9^2 - 15*x4*x9,
-x1^2 + 30*x1 + x17^2 - x2^2 - 225,
x17 - 16,
-x1^2 + 2*x1*x3 + x13^2 - x2^2 + 2*x2*x4 - x3^2 - x4^2,
x13 - 12,
x14^2 - x3^2 - x4^2,
x14 - 25,
x15^2 - x3^2 + 30*x3 - x4^2 - 225,
x15 - 20,
x1^2*x4^2 - 2*x1*x11*x4^2 + 2*x1*x12*x3*x4 - 2*x1*x2*x3*x4 + 30*x1*x2*x4 + x11^2*x4^2 - 2*x11*x12*x3*x4 + 2*x11*x2*x3*x4 - 30*x11*x2*x4 + x12^2*x3^2 - 2*x12*x2*x3^2 + 30*x12*x2*x3 - 4*x16^2 + x2^2*x3^2 - 30*x2^2*x3 + 225*x2^2,
x16 - x18;
J=sat(J,ideal(x16));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x4));
print("SAT_FACTOR=3");
J=sat(J,ideal(4*x5^2 + 225));
print("SAT_FACTOR=4");
J=sat(J,ideal(-2*x10*x4 + 2*x10*x5 + 2*x3^2 - 2*x3*x9 - 15*x3 + 2*x4^2 - 2*x4*x5 + 15*x9));
print("SAT_FACTOR=5");
J=sat(J,ideal(-15*x1 + 2*x2*x5 + 225));
print("SAT_FACTOR=6");
J=sat(J,ideal(4*x1^2 - 60*x1 + 4*x2^2 - 8*x2*x6 + 4*x6^2 + 225));
print("SAT_FACTOR=7");
J=sat(J,ideal(2*x1*x8 - 2*x2*x7 + 2*x6*x7 - 15*x8));
print("SAT_FACTOR=8");
J=sat(J,ideal(x7^2 + x8^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x10^2 - 2*x10*x4 + x3^2 - 2*x3*x9 + x4^2 + x9^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1^2 - 30*x1 + x2^2 + 225));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=14");
J=sat(J,ideal(x1*x4 - x2*x3 + 15*x2 - 15*x4));
print("SAT_FACTOR=15");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=16");
J=sat(J,ideal(x3^2 - 30*x3 + x4^2 + 225));
print("SAT_FACTOR=17");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
