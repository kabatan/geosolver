LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x3^2 + 3*x3 - x4^2 + 2*x4*x8,
-x10*x3 + x4*x9,
x10^2 - 2*x10*x6 + x5^2 - 2*x5*x9 + x6^2 - x7^2 + x9^2,
-x1^2 + x11^2 - x2^2,
x11 - 5,
x1*x4 - x2*x3 + 5*x2 - 5*x4,
x12^2 - x5^2 + 10*x5 - x6^2 - 25,
x12 - x7,
x3^2 - 2*x3*x5 + x4^2 - 2*x4*x6 + x5^2 + x6^2 - x7^2,
x6^2 - x7^2,
x5^4 - 6*x5^3 + 2*x5^2*x6^2 - 4*x5^2*x6*x8 - 2*x5^2*x7^2 + 9*x5^2 - 6*x5*x6^2 + 12*x5*x6*x8 + 6*x5*x7^2 + x6^4 - 4*x6^3*x8 - 2*x6^2*x7^2 + 4*x6^2*x8^2 + 4*x6*x7^2*x8 + x7^4 - 4*x7^2*x8^2 - 9*x7^2,
x1^2 - 2*x1*x9 + x10^2 - 2*x10*x2 - x13^2 + x2^2 + x9^2,
x13 - 10,
x14^2 - x3^2 + 10*x3 - x4^2 - 25,
-x1^2 + 2*x1*x3 + x15^2 - x2^2 + 2*x2*x4 - x3^2 - x4^2,
-x1^2 + 10*x1 + x16^2 - x2^2 - 25,
x16 - x17;
J=sat(J,ideal(x14));
print("SAT_FACTOR=1");
J=sat(J,ideal(x15));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4));
print("SAT_FACTOR=4");
J=sat(J,ideal(x7));
print("SAT_FACTOR=5");
J=sat(J,ideal(4*x8^2 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(x10^2 - 2*x10*x4 + x3^2 - 2*x3*x9 + x4^2 + x9^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 - 10*x1 + x2^2 + 25));
print("SAT_FACTOR=8");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=9");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
