LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=x7^2 - 3,
2*x4*x7 - 3*x7^2 + 3,
36*x1^2 + 36*x1*x2 - x11^2 + 9*x2^2*x7^2 + 9*x2^2,
2*x4*x6 - x5^2 + 6*x5 - x6^2,
36*x1^2 + 36*x1*x2 - 24*x1*x5 - x11^2 + 9*x2^2*x7^2 + 9*x2^2 - 12*x2*x5 - 12*x2*x6*x7 + 4*x5^2 + 4*x6^2,
-x12^2 + 9*x7^2 + 9,
x12 - 6,
4*x3^2 - 3,
324*x1^2*x7^2 + 648*x1*x2*x7^2 - 648*x1*x7^2 + 324*x2^2*x7^2 - 648*x2*x7^2 + 324*x7^2 - x8^2,
72*x1^2*x3 + 72*x1*x2*x3 - 108*x1*x3 + 18*x2^2*x3*x7^2 + 18*x2^2*x3 - 18*x2*x3*x7^2 - 54*x2*x3 + 36*x3 - x8,
x5^2 + x6^2 - x9^2,
x9 - 5,
36*x1^2 + 36*x1*x2 - 12*x1*x5 - x10^2 + 9*x2^2*x7^2 + 9*x2^2 - 6*x2*x5 - 6*x2*x6*x7 + x5^2 + x6^2,
x10 - x13;
J=sat(J,ideal(x7));
print("SAT_FACTOR=1");
J=sat(J,ideal(x11));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1 + x2 - 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x4^2 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(x5^2 + x6^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(36*x1^2 + 36*x1*x2 - 72*x1 + 9*x2^2*x7^2 + 9*x2^2 - 12*x2*x4*x7 - 36*x2 + 4*x4^2 + 36));
print("SAT_FACTOR=8");
J=sat(J,ideal(4*x1^2 + 4*x1*x2 - 8*x1 + x2^2*x7^2 + x2^2 - 4*x2 + 4));
print("SAT_FACTOR=9");
J=sat(J,ideal(4*x1^2 + 4*x1*x2 - 4*x1 + x2^2*x7^2 + x2^2 - 2*x2*x7^2 - 2*x2 + x7^2 + 1));
print("SAT_FACTOR=10");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
