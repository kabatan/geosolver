LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19),dp;
short=0;
ideal J=16*x6^4 - 20*x6^2 + 5,
4*x7^2 + 2*x7 - 1,
16*x8^4 - 20*x8^2 + 5,
4*x9^2 + 2*x9 - 1,
16*x10^4 - 20*x10^2 + 5,
16*x11^4 - 20*x11^2 + 5,
-x12*x9 + x12 + x5*x7*x8 - x5*x8,
-x1*x5*x7 + x1*x5 + x2*x5*x6 - x5^2*x6,
x10*x4*x5 - x10*x5^2*x9 - x4*x5*x8 + x5^2*x8*x9,
-x1*x4 + x1*x5*x7 - x12*x2 + x12*x4 + x2*x3 - x3*x5*x7,
x1^2 - 2*x1*x5*x6 - x17^2 + x2^2 - 2*x2*x5*x7 + x5^2*x6^2 + x5^2*x7^2,
x17 - 4,
-x18^2 + x3^2 - 2*x3*x5*x8 + x4^2 - 2*x4*x5*x9 + x5^2*x8^2 + x5^2*x9^2,
x18 - 5,
-x1^2 + x13^2 - x2^2 + 2*x2*x5 - x5^2,
-x14^2 + x5^2*x6^2 + x5^2*x7^2 - 2*x5^2*x7 + x5^2,
x13 - x14 + x17,
x10^2*x5^2 - 2*x10*x3*x5 - x15^2 + x3^2 + x4^2 - 2*x4*x5*x9 + x5^2*x9^2,
x10^2*x5^2 - 2*x10*x5^2*x8 - x16^2 + x5^2*x8^2,
x15 - x16 + x18,
x13 - x19;
J=sat(J,ideal(-x11 + x6));
print("SAT_FACTOR=1");
J=sat(J,ideal(x9 - 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x5));
print("SAT_FACTOR=3");
J=sat(J,ideal(x8^2 + x9^2 - 2*x9 + 1));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
