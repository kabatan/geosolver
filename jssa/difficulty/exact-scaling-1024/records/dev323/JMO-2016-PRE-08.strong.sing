LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19),dp;
short=0;
ideal J=-x1^2 + 2*x1*x2 + x12^2 - x2^2 - x3^2,
x17^2 - x2^2 - x3^2,
-x1^2 + x18^2,
-x1*x17 + x12*x6 + x17*x6 - x18*x2 + x18*x6,
x12*x7 + x17*x7 - x18*x3 + x18*x7,
-x1*x17 + x12*x8 + x17*x8 - x18*x2 + x18*x8,
x12*x9 + x17*x9 - x18*x3 + x18*x9,
-x1^2*x10 + x1^2*x8 + 2*x1*x10*x2 - 2*x1*x2*x8 + x1*x3^2 - x1*x3*x9 - x10*x2^2 - x10*x3^2 + x2^2*x8 + x2*x3*x9,
x1^2*x11 - x1^2*x3 - 2*x1*x11*x2 + x1*x2*x3 + x1*x3*x8 + x11*x2^2 + x11*x3^2 - x2*x3*x8 - x3^2*x9,
-x10*x5 + x11*x4,
-x1^2*x3^2 + x12^2*x4^2 - 2*x12^2*x4*x6 + x12^2*x5^2 - 2*x12^2*x5*x7 + x12^2*x6^2 + x12^2*x7^2 + 2*x12*x17*x4^2 - 4*x12*x17*x4*x6 + 2*x12*x17*x5^2 - 4*x12*x17*x5*x7 + 2*x12*x17*x6^2 + 2*x12*x17*x7^2 + 2*x12*x18*x4^2 - 4*x12*x18*x4*x6 + 2*x12*x18*x5^2 - 4*x12*x18*x5*x7 + 2*x12*x18*x6^2 + 2*x12*x18*x7^2 + x17^2*x4^2 - 2*x17^2*x4*x6 + x17^2*x5^2 - 2*x17^2*x5*x7 + x17^2*x6^2 + x17^2*x7^2 + 2*x17*x18*x4^2 - 4*x17*x18*x4*x6 + 2*x17*x18*x5^2 - 4*x17*x18*x5*x7 + 2*x17*x18*x6^2 + 2*x17*x18*x7^2 + x18^2*x4^2 - 2*x18^2*x4*x6 + x18^2*x5^2 - 2*x18^2*x5*x7 + x18^2*x6^2 + x18^2*x7^2,
-x13^2 + x4^2 + x5^2,
x10^2 - 2*x10*x4 + x11^2 - 2*x11*x5 - x14^2 + x4^2 + x5^2,
3*x13 - x14,
-x1^2*x3^2 + 4*x15^2,
-x1^2*x3^2 + x12^2*x16^2 + 2*x12*x16^2*x17 + 2*x12*x16^2*x18 + x16^2*x17^2 + 2*x16^2*x17*x18 + x16^2*x18^2,
x16 - 1,
x12 - 10*x13,
x14 - x19;
J=sat(J,ideal(x12 + x17 + x18));
print("SAT_FACTOR=1");
J=sat(J,ideal(x15));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x10^2 - 2*x10*x4 + x11^2 - 2*x11*x5 + x4^2 + x5^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x10^2 + x11^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
