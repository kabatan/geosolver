LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x7^2 - 3,
64*x1*x7^2 + 169*x1 - 608*x7^2,
64*x2*x7^2 + 169*x2 - 988*x7,
2*x1^2*x3 - 19*x1^2 + 2*x2^2*x3,
2*x1^2*x4 - 19*x1*x2 + 2*x2^2*x4,
x1*x6 - x2*x5 + 3*x2 - 3*x6,
13*x5^2 + 13*x6^2 - 76*x6*x7,
13*x1^2 + 13*x2^2 - 76*x2*x7,
x1^2 - 19*x1 + x2^2 + 48,
4*x3^2 - 76*x3 + 4*x4^2 - 4*x8^2 + 361,
2*x8 - 13,
64*x7^3*x9 + 169*x7*x9 - 64;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
