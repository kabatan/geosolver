LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=12*x10^2*x9 - 12*x10*x9^2 - 72*x10*x9 + x5^2*x9^2 + 36*x5^2 + 36*x9^2,
x7^2 - x9^2 - 36,
x1*x7*x9^2 + 36*x1*x7 + 6*x10*x7*x9 - 36*x10*x7 + 6*x5*x9^2 + 216*x5 - 6*x7*x9^2,
-x10*x7*x9^2 + 6*x10*x7*x9 + x2*x7*x9^2 + 36*x2*x7 - x5*x9^3 - 36*x5*x9 - 36*x7*x9,
6*x10*x7*x9 - 36*x10*x7 + x3*x7*x9^2 + 36*x3*x7 - 6*x5*x9^2 - 216*x5 - 6*x7*x9^2,
-x10*x7*x9^2 + 6*x10*x7*x9 + x4*x7*x9^2 + 36*x4*x7 + x5*x9^3 + 36*x5*x9 - 36*x7*x9,
-x10^2*x9^2 - 6*x10^2*x9 - 9*x10^2 + 6*x10*x9^2 + 18*x10*x9 + x8^2 - 9*x9^2,
x8,
-x10^2*x9^2 - 24*x10^2*x9 - 144*x10^2 + 12*x10*x9^2 + 144*x10*x9 + 4*x6^2 - 36*x9^2,
x6,
x10*x9 + 3*x10 - 3*x9,
x10*x9 + 12*x10 - 6*x9,
x11*x7*x9^2 + 36*x11*x7 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
