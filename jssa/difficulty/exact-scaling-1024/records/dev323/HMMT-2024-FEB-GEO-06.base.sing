LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
72*x1^2 - 2*x1*x14 - 36*x1 + x14 + 72*x2^2 - 4*x2*x3,
-4*x10^2 + x14^2 - 36*x14 + 4*x3^2 + 324,
x11^2 - x14^2 + 36*x14 - 324,
1296*x1^2*x15^2 - 2592*x1^2*x15 + 1296*x1^2 - x12^2 + 1296*x15^2*x2^2 - 2592*x15*x2^2 + 1296*x2^2,
36*x1*x11*x15 + 36*x1*x11 - 2*x11*x4 + x12*x14 - 2*x12*x4 + 18*x12,
18*x11*x15*x2 + 18*x11*x2 - x11*x5 - x12*x5,
1296*x1^2 - x13^2 + 1296*x2^2,
x13 - 36,
5184*x1^2 - 144*x1*x14 - 2592*x1 + x14^2 + 36*x14 + 5184*x2^2 - 288*x2*x3 + 4*x3^2 - 4*x6^2 + 324,
-x10 + x6,
5184*x1^2*x15^2 - 144*x1*x14*x15 - 2592*x1*x15 + x14^2 + 36*x14 + 5184*x15^2*x2^2 - 288*x15*x2*x3 + 4*x3^2 - 4*x7^2 + 324,
-x10 + x7,
x4^2 + x5^2 - x8^2,
x8 - 12,
-x11^2 + x14^2 - 4*x14*x4 + 36*x14 + 4*x4^2 - 72*x4 + 4*x5^2 + 324,
1296*x1^2*x15^2 + 2592*x1^2*x15 + 1296*x1^2 - 144*x1*x15*x4 - 144*x1*x4 - x12^2 + 1296*x15^2*x2^2 + 2592*x15*x2^2 - 144*x15*x2*x5 + 1296*x2^2 - 144*x2*x5 + 4*x4^2 + 4*x5^2,
1296*x1^2*x15^2 + 2592*x1^2*x15 + 1296*x1^2 - 72*x1*x14*x15 - 72*x1*x14 - 1296*x1*x15 - 1296*x1 + x14^2 + 36*x14 + 1296*x15^2*x2^2 + 2592*x15*x2^2 + 1296*x2^2 - 4*x9^2 + 324,
-x11 - x12 + 2*x9,
x11*x14*x16*x2 - 18*x11*x16*x2 + x12*x14*x16*x2 - 18*x12*x16*x2 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
