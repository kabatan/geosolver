LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1*x10^2 - 2*x1*x10*x8 + x1*x11^2 - 2*x1*x11*x9 + x1*x8^2 + x1*x9^2 + x10*x11*x9 - x10*x9^2 - x11^2*x8 + x11*x8*x9,
x10^2*x2 - x10^2*x9 + x10*x11*x8 - 2*x10*x2*x8 + x10*x8*x9 + x11^2*x2 - 2*x11*x2*x9 - x11*x8^2 + x2*x8^2 + x2*x9^2,
x10^2*x3 - 2*x10^2 + x10*x11*x9 - 2*x10*x3*x8 + 4*x10*x8 - x10*x9^2 + x11^2*x3 - x11^2*x8 - 2*x11*x3*x9 + x11*x8*x9 + x3*x8^2 + x3*x9^2 - 2*x8^2,
x10^2*x4 - x10^2*x9 + x10*x11*x8 - 2*x10*x11 - 2*x10*x4*x8 + x10*x8*x9 + 2*x10*x9 + x11^2*x4 - 2*x11*x4*x9 - x11*x8^2 + 2*x11*x8 + x4*x8^2 + x4*x9^2 - 2*x8*x9,
x5^2 - x8^2 - x9^2,
x5 - 3,
-x10^2 + 4*x10 - x11^2 + x6^2 - 4,
x6 - 2,
-x10^2 + 2*x10*x8 - x11^2 + 2*x11*x9 + x7^2 - x8^2 - x9^2,
x7 - 4,
-x10^2*x9 + 2*x10*x9 - x11^2*x9 + x11*x8^2 - 2*x11*x8 + x11*x9^2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
