LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x1^2 - 3,
x1^2 - x3^2 + 9,
2*x1 - x3,
x4^2 - 16*x7^2,
x1*x4 - 4*x6,
16*x1^2 - x5^2,
x1*x5 - 12,
x1^2*x6^2 - 8*x1^2*x6 + 16*x1^2 + 6*x1*x6*x7 - 24*x1*x7 - x2^2 + 9*x7^2,
x1^2 - x1*x2 - x1*x7 + 3*x6 - 3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
