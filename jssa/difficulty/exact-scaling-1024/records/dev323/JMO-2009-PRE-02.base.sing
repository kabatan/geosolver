LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
x1^2*x3 + 2*x1^2 + x2^2*x3 - 2*x2^2,
x1^2*x4 - 4*x1*x2 + x2^2*x4,
x1^2*x5 - 10*x1^2 + x2^2*x5 - 2*x2^2,
x1^2*x6 + 8*x1*x2 + x2^2*x6,
x3^2 - 2*x3*x5 + x4^2 - 2*x4*x6 + x5^2 + x6^2 - x7^2,
x7 - 4;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
