LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=4*x3^2 - 1815,
4*x3^2 - 4*x6^2 + 121,
x6 - 22,
x1^2 + x2^2 - 2*x2*x3 + x3^2 - x7^2,
x7 - 19,
4*x1^2*x3^2 + 44*x1*x2*x3 - 44*x1*x3^2 + 121*x2^2 - 242*x2*x3 + 121*x3^2 - 4*x8^2,
4*x1^2*x3^2 - 44*x1*x2*x3 + 44*x1*x3^2 + 121*x2^2 - 242*x2*x3 + 121*x3^2 - 4*x9^2,
-484*x1^2 + 16*x2^2*x3^2 + 968*x2*x3 - 16*x8*x9 + 14641,
-4*x1^2 - 44*x1 - 4*x2^2 + 4*x4^2 - 121,
-4*x1^2 + 44*x1 - 4*x2^2 + 4*x5^2 - 121,
-x10 + x4^2 + x5^2;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(4*x3^2 + 121));
print("SAT_FACTOR=2");
J=sat(J,ideal(2*x1*x3 - 11*x2 + 11*x3));
print("SAT_FACTOR=3");
J=sat(J,ideal(2*x1*x3 + 11*x2 - 11*x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(4*x1^2 + 44*x1 + 4*x2^2 + 121));
print("SAT_FACTOR=5");
J=sat(J,ideal(4*x1^2 - 44*x1 + 4*x2^2 + 121));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
