LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5),dp;
short=0;
ideal J=-x1^2 - 2*x1 + x2^2 - 1,
-x1^2 + 2*x1 + x3^2 - 1,
x2 - 2*x3,
-8*x1^2 + 12*x1 + x4^2 - 5,
x4 - x5;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 1));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
