LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x3^2 - 3,
x1*x3^2 + 9*x1 + 18,
x2*x3^2 + 9*x2 - 6*x3,
x3^2 - 4*x4^2 + 1,
x4 - 1,
x3^2 - x5^2 + 1,
x5 - 2,
x1^2*x3^2 + 2*x1*x2*x3 - 2*x1*x3^2 + x2^2 - 2*x2*x3 + x3^2 - x6^2,
x6 - x7;
J=sat(J,ideal(x3^2 + 9));
print("SAT_FACTOR=1");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
