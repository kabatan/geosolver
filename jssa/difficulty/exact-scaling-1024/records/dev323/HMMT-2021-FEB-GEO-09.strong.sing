LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x1^2 - 2*x1*x3 - 25*x1 - x2^2 + 2*x2*x4 + x3^2 + 25*x3,
-x2^2*x3 - x2^2*x5 - 25*x2^2 + 2*x2*x3*x4 + 50*x2*x4 + x3^3 - x3^2*x5 + 50*x3^2 - 50*x3*x5 + 625*x3 - 625*x5,
-x2^3 + 2*x2^2*x4 - x2^2*x6 + x2*x3^2 + 25*x2*x3 - x3^2*x6 - 50*x3*x6 - 625*x6,
-x1^2 + 2*x1*x3 + 50*x1 - x2^2 - x3^2 - 50*x3 + x7^2 - 625,
x7 - 27,
-x2^2 - x3^2 + x8^2,
-x1^2 + 2*x1*x3 - x2^2 - x3^2 + x9^2,
x8 - x9,
-x10^2 + x5^2 + x6^2,
x10 - 10,
x2*x5 - x3*x6 - 25*x6,
x1^2 - 4*x1*x5 - 4*x11^2 + 4*x5^2 + 4*x6^2,
x11 - x12;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3));
print("SAT_FACTOR=3");
J=sat(J,ideal(4*x1^2 - 8*x1*x3 - 100*x1 + 4*x3^2 + 100*x3 + 4*x4^2 + 625));
print("SAT_FACTOR=4");
J=sat(J,ideal(-2*x2^2 + 2*x2*x4 - 25*x3 - 625));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 + x3^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x3 - 50*x1 + x2^2 + x3^2 + 50*x3 + 625));
print("SAT_FACTOR=7");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x2^2 + x3^2 + 50*x3 + 625));
print("SAT_FACTOR=9");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
