LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=16*x1*x8^2 + 25*x1 - 28*x8^2 - 25*x8,
16*x2*x8^2 + 25*x2 - 16*x8^3 - 20*x8^2 + 10*x8,
16*x3*x8^2 + 25*x3 + 28*x8^2 + 25*x8,
16*x4*x8^2 + 25*x4 - 16*x8^3 - 20*x8^2 + 10*x8,
x5^2 - 4*x8^2,
x5 - 2*x8,
x1^2 - 2*x1*x8 + x2^2 - 2*x2*x8 - x6^2 + 2*x8^2,
x6 - x8,
x3^2 + 2*x3*x8 + x4^2 - 2*x4*x8 - x7^2 + 2*x8^2,
x7 - x8;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
