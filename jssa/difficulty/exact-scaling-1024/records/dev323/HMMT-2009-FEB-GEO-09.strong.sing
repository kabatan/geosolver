LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=-x1^2 + 32*x1 - x2^2 + x5^2 - 256,
-x1^2 - x2^2 + x6^2,
-16*x1 + x3*x5 + x3*x6 + 16*x3 - 16*x6,
-16*x2 + x4*x5 + x4*x6 + 16*x4,
x6 - 5,
x3^2 + x4^2 - x7^2,
x7 - 4,
x5 - x8;
J=sat(J,ideal(x5 + x6 + 16));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
