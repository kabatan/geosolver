LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=-x1^2*x4 + 2*x1*x4*x5 - x2^2*x4 + x2*x3^2 - 2*x2*x3*x5 + x2*x4^2 + 8*x2*x5 - 16*x2 - 8*x4*x5 + 16*x4,
x1^2*x3 - 4*x1^2 - x1*x3^2 - x1*x4^2 + 2*x1*x4*x6 + 16*x1 + x2^2*x3 - 4*x2^2 - 2*x2*x3*x6 + 8*x2*x6 + 4*x3^2 - 16*x3 + 4*x4^2 - 8*x4*x6,
-x3^2 - x4^2 + x7^2,
x7 - 4,
-x1^2 + 8*x1 - x2^2 + x8^2 - 16,
x8 - 3,
x1^2 - 2*x1*x5 + x2^2 - 2*x2*x6 + x5^2,
x1^2*x3^2 + x1^2*x4^2 - 2*x1*x3^2*x5 - 2*x1*x4^2*x5 + x2^2*x3^2 + x2^2*x4^2 - 2*x2*x3^2*x6 - 2*x2*x4^2*x6 + x3^2*x5^2 + 2*x3*x4*x5*x6 + x4^2*x6^2,
x1*x4 - x2*x3 - 4*x4,
-x3^2 + 8*x3 - x4^2 + x9^2 - 16,
-x10 + x9;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x4));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 - 2*x1*x5 + x2^2 - 2*x2*x6 + x5^2 + x6^2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 - 8*x1 + x2^2 + 16));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1*x4 - x2*x3 + 4*x2 - 4*x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
