LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=-x2^2 - 10*x2 - x3^2 + x5^2 - 25,
-x4 + x5 + 5,
-x2^2 - x3^2 + 12*x3 + x6^2 - 36,
-x4 + x6 + 6,
-x2^2 + 40*x2 - x3^2 + x7^2 - 400,
-x4 + x7 + 20,
-x1^2 - 2*x1*x3 - x2^2 - x3^2 + x8^2,
x1 - x4 + x8,
-x1^2 + x9^2,
-x10 + x9;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x4));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
