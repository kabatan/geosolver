LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=-x1^2 - x2^2 + 2*x2*x6 + x3^2,
-x1^3 - x1^2*x7 - x1*x2^2 + 2*x1*x2*x6 - x2^2*x7,
-x1^2*x2 - x1^2*x8 - x2^3 + 2*x2^2*x6 - x2^2*x8,
-x1^2 - x2^2 + 2*x2*x9 + x3^2,
2*x4^2 - 1,
2*x5^2 - 1,
x13^2 - 4*x2^2*x3^2,
x1^2*x5 + x13*x4 + x2^2*x5 - x3^2*x5,
-x1^2 + x10^2 - x2^2,
-x11^2 + x7^2 + x8^2,
x10 - 2*x11,
x1^2*x7^2 + x1^2*x8^2 - 2*x1^2*x8*x9 + x1^2*x9^2 - x12^2 + x2^2*x7^2 + x2^2*x8^2 - 2*x2^2*x8*x9 + x2^2*x9^2 - 2*x2*x7^2*x9 - 2*x2*x8^2*x9 + 4*x2*x8*x9^2 - 2*x2*x9^3 + x7^2*x9^2 + x8^2*x9^2 - 2*x8*x9^3 + x9^4,
x1*x7 - x12*x14 + x2*x8 - x2*x9 - x8*x9 + x9^2;
J=sat(J,ideal(x10));
print("SAT_FACTOR=1");
J=sat(J,ideal(x12));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 + x2^2 - 2*x2*x6 + x6^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(-x1^2 - x2^2 + x2*x6));
print("SAT_FACTOR=6");
J=sat(J,ideal(x7^2 + x8^2 - 2*x8*x9 + x9^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 + x2^2 - 2*x2*x9 + x9^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 + 2*x1*x3 + x2^2 + x3^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 + x3^2));
print("SAT_FACTOR=11");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
