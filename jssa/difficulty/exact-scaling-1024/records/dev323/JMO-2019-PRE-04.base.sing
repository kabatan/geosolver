LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23),dp;
short=0;
ideal J=x11^2 - 5,
16*x1^4 - 20*x1^2 + 5,
x1^2 + x2^2 - 1,
16*x3^4 - 20*x3^2 + 5,
x3^2 + x4^2 - 1,
16*x5^4 - 20*x5^2 + 5,
x5^2 + x6^2 - 1,
16*x7^4 - 20*x7^2 + 5,
x7^2 + x8^2 - 1,
x1*x22*x3*x8 - x1*x22*x3 - x1*x4*x9 + x1*x9 - x2*x22*x3*x7 + x2*x3*x9 + x22*x3*x7 - x3*x8*x9 + x4*x7*x9 - x7*x9,
-x1*x10*x4 + x1*x10 + x1*x22*x4*x8 - x1*x22*x8 + x10*x2*x3 - x10*x3*x8 + x10*x4*x7 - x10*x7 - x2*x22*x3 - x2*x22*x4*x7 + x2*x22*x7 + x22*x3*x8,
x1*x19*x22 - x1*x22^2 - x18*x2*x22 + x18*x22,
x20*x22*x4 - x20*x22*x6 - x21*x22*x3 + x21*x22*x5 + x22^2*x3*x6 - x22^2*x4*x5,
-x10*x18 + x10*x20 + x18*x21 - x19*x20 + x19*x9 - x21*x9,
x1^2*x22^2 - 2*x1*x18*x22 - x12^2 + x18^2 + x19^2 - 2*x19*x2*x22 + x2^2*x22^2,
x12 - 4,
-x13^2 + x20^2 - 2*x20*x22*x3 + x21^2 - 2*x21*x22*x4 + x22^2*x3^2 + x22^2*x4^2,
x13 - 5,
x14^2 - x18^2 - x19^2 + 2*x19*x22 - x22^2,
x1^2*x22^2 - x15^2 + x2^2*x22^2 - 2*x2*x22^2 + x22^2,
x12 + x14 - x15,
-x16^2 + x20^2 - 2*x20*x22*x5 + x21^2 - 2*x21*x22*x6 + x22^2*x5^2 + x22^2*x6^2,
-x17^2 + x22^2*x3^2 - 2*x22^2*x3*x5 + x22^2*x4^2 - 2*x22^2*x4*x6 + x22^2*x5^2 + x22^2*x6^2,
x13 + x16 - x17,
x1*x22*x23*x4 - x1*x22*x23 - x2*x22*x23*x3 + x22*x23*x3*x8 - x22*x23*x4*x7 + x22*x23*x7 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
