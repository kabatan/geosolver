LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=2*x1*x10 - x10^2 - x9^2 + 3*x9,
x10*x2 - x3*x9,
x11^2 - 2*x11*x2 + x12^2 - 2*x12*x3 - x13^2 + x2^2 + x3^2,
x4^2 - x7^2 - x8^2,
x4 - 5,
x10*x7 - 5*x10 - x8*x9 + 5*x8,
-x11^2 + 10*x11 - x12^2 + x5^2 - 25,
-x13 + x5,
x10^2 - 2*x10*x12 + x11^2 - 2*x11*x9 + x12^2 - x13^2 + x9^2,
x12^2 - x13^2,
4*x1^2*x12^2 - 4*x1^2*x13^2 - 4*x1*x11^2*x12 + 12*x1*x11*x12 - 4*x1*x12^3 + 4*x1*x12*x13^2 + x11^4 - 6*x11^3 + 2*x11^2*x12^2 - 2*x11^2*x13^2 + 9*x11^2 - 6*x11*x12^2 + 6*x11*x13^2 + x12^4 - 2*x12^2*x13^2 + x13^4 - 9*x13^2,
x2^2 - 2*x2*x7 + x3^2 - 2*x3*x8 - x6^2 + x7^2 + x8^2,
x6 - 10,
x10*x14 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
