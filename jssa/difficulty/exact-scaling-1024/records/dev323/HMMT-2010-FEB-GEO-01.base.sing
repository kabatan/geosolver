LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=8*x1^3 + 4*x1^2 - 4*x1 - 1,
x1^2 + x5^2 - 1,
8*x6^3 + 4*x6^2 - 4*x6 - 1,
x6^2 + x7^2 - 1,
8*x8^3 + 4*x8^2 - 4*x8 - 1,
x8^2 + x9^2 - 1,
8*x10^3 + 4*x10^2 - 4*x10 - 1,
x10^2 + x11^2 - 1,
8*x12^3 + 4*x12^2 - 4*x12 - 1,
x12^2 + x2^2 - 1,
8*x3^3 + 4*x3^2 - 4*x3 - 1,
x3^2 + x4^2 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
