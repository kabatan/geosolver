LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1*x8 + x7^2 - 11*x7,
x1*x8 + 2*x2*x7 - 22*x2 - x7^2 + 121,
x4^2 - x7^2 - x8^2,
x4 - 10,
x1*x10 - x10^2 + x10*x8 + 2*x2*x9 - 22*x2 - x9^2 + 121,
-x10^2*x7^2 + 22*x10^2*x7 - 121*x10^2 + 2*x10*x7*x8*x9 - 22*x10*x7*x8 - 22*x10*x8*x9 + 242*x10*x8 + 4*x5^2 - x8^2*x9^2 + 22*x8^2*x9 - 121*x8^2,
-121*x10^2 + x6^2,
2*x10^2*x6 - 3*x10*x6*x8 + 22*x5*x9 - 242*x5 + x6*x7^2 - 3*x6*x7*x9 + 11*x6*x7 + x6*x8^2 + 2*x6*x9^2 - 11*x6*x9,
-4*x10^2 + 4*x10*x8 + 4*x3^2 - x7^2 + 4*x7*x9 - 22*x7 - x8^2 - 4*x9^2 + 44*x9 - 121,
x3 - 3,
x1*x11*x7*x8 - 11*x1*x11*x8 - x11*x7*x8^2 + 11*x11*x8^2 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
