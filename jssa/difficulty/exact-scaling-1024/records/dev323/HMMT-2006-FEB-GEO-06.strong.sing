LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=8*x2^4 - 8*x2^2 + 1,
8*x3^4 - 8*x3^2 + 1,
x5^2 - 2,
-x1*x5^2 + x1 + x3*x5 - x4*x5 + x4 + x5,
x1^2 - 2*x1*x3 - 2*x1 + 2*x3^2 - 2*x3*x4 + 4*x3 + x4^2 - 2*x4 - x6^2 + 2,
x1 + x3 - x6 + 1,
x1*x3 + x1 - x7;
J=sat(J,ideal(x3 + 1));
print("SAT_FACTOR=1");
J=sat(J,ideal(-x1 + x3 + 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x5));
print("SAT_FACTOR=3");
J=sat(J,ideal(x5 - 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1));
print("SAT_FACTOR=5");
J=sat(J,ideal(-x1*x5^2 + x1 + x3*x5 + x5));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
