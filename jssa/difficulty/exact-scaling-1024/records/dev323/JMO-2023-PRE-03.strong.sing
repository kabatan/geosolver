LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x6^2 - 3,
x1*x6 + x2 - 3*x6,
x3*x6 - x4,
4*x5^2 - 3,
9*x1^2*x6^2 - 6*x1*x2*x6 - 18*x1*x6^2 + x2^2 + 6*x2*x6 + 9*x6^2 - 4*x7^2,
x1*x5 + 3*x2*x5*x6 - x5 + x7,
-x1^2*x4^2 + 2*x1*x2*x3*x4 - 2*x1*x2*x4 + 2*x1*x4^2 - x2^2*x3^2 + 2*x2^2*x3 - x2^2 - 2*x2*x3*x4 + 2*x2*x4 - x4^2 + x8^2,
2*x1^2*x5 - 2*x1*x3*x5 - 2*x1*x5 + 2*x2^2*x5 - 2*x2*x4*x5 + 2*x3*x5 + x8,
4*x3^2 - 12*x3 + 4*x4^2 - 12*x4*x6 + 9*x6^2 - 4*x9^2 + 9,
-x10 + x9;
J=sat(J,ideal(x1 - 3));
print("SAT_FACTOR=1");
J=sat(J,ideal(2*x1 - 3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(2*x3 - 3));
print("SAT_FACTOR=5");
J=sat(J,ideal(x4));
print("SAT_FACTOR=6");
J=sat(J,ideal(9*x6^2 + 1));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 - 2*x1 + x2^2 + 1));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=9");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
