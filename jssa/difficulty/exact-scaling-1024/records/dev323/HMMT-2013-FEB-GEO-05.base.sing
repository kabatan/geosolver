LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=2*x1*x10 - x10^2 + x11^2 - x9^2,
2*x1*x10*x9 - x10^2*x2 - x10^2*x9 - x2*x9^2 - x9^3,
2*x1*x10^2 - x10^3 - x10^2*x3 - x10*x9^2 - x3*x9^2,
-x10^2 + 2*x10*x4 + x11^2 - x9^2,
x6^2 - 2,
-4*x10^2*x11^2 + x7^2,
-x10^2*x6 + x11^2*x6 + x6*x7 - x6*x9^2,
-x10^2 + x8^2 - x9^2,
x2^2 + x3^2 - x5^2,
2*x5 - x8,
x10*x11*x12 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
