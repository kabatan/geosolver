LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x7^2 - 3,
-x1^2 - x2^2 + 6*x2 + x8^2 - 9,
x3 - x4*x7 + 3*x7,
x1^2 - 4*x1*x3 + x2^2 - 4*x2*x4 + 6*x2 + 4*x3^2 + 4*x4^2 - 12*x4 - x8^2 + 9,
3*x5 + 4*x6 - 12,
x1^2 - 4*x1*x5 + x2^2 - 4*x2*x6 + 6*x2 + 4*x5^2 + 4*x6^2 - 12*x6 - x8^2 + 9,
9*x7^2 - x9^2 + 9,
x9 - 6,
-2*x1*x2*x7 + x2^2*x7^2 - x2^2 - 6*x2*x7^2,
24*x1*x2 + 7*x2^2 - 96*x2,
-x10^2 + x3^2 + x4^2,
-x11^2 + x5^2 + x6^2,
x10^2 - x11^2*x12;
J=sat(J,ideal(x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x10));
print("SAT_FACTOR=2");
J=sat(J,ideal(x11));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3^2 + x4^2 - 6*x4 + 9));
print("SAT_FACTOR=5");
J=sat(J,ideal(x5^2 + x6^2 - 6*x6 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(x7^2 + 1));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 + 6*x1*x7 + x2^2 + 9*x7^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 - 8*x1 + x2^2 + 16));
print("SAT_FACTOR=9");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
