LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=x12^2 - 3,
16*x1^4 - 16*x1^2 + 1,
16*x2^4 - 16*x2^2 + 1,
4*x3^2 - 3,
x1*x7 + x12*x2*x7 - 2*x2*x3,
x1*x8 + x12*x2*x8 - x2,
x1*x9 + x12*x2*x9 - 2*x2,
x1 - 4*x10*x2 + x12*x2,
x1*x11 + x11*x12*x2 + 2*x2*x3,
x1*x4 + x12*x2*x4 - x2,
x1*x12^2 - x1 + x12^3*x2 - x12*x2 + 16*x2*x5 - 16*x2,
x1*x12^2 + 2*x1*x12 + x1 + x12^3*x2 + 2*x12^2*x2 + x12*x2 - 16*x2*x6,
x1^2*x7^2 + x1^2*x8^2 - 2*x1^2*x8*x9 + x1^2*x9^2 + 2*x1*x12*x2*x7^2 + 2*x1*x12*x2*x8^2 - 4*x1*x12*x2*x8*x9 + 2*x1*x12*x2*x9^2 + x12^2*x2^2*x7^2 + x12^2*x2^2*x8^2 - 2*x12^2*x2^2*x8*x9 + x12^2*x2^2*x9^2 - 4*x2^2,
x1^2 + 2*x1*x12*x2 - 16*x10^2*x2^2 + 32*x10*x2^2*x8 + x12^2*x2^2 - 16*x2^2*x7^2 + 32*x2^2*x7 - 16*x2^2*x8^2 - 16*x2^2,
x11^2 - 2*x11*x7 - x13^2 + x4^2 - 2*x4*x8 + x7^2 + x8^2,
-x14^2 + x5^2 - 2*x5*x7 + x6^2 - 2*x6*x8 + x7^2 + x8^2,
x13 - x14*x15;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(-x12 + 4*x8 - 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x13));
print("SAT_FACTOR=3");
J=sat(J,ideal(x14));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1 + x12*x2));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
