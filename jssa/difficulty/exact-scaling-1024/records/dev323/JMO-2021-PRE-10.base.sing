LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=2*x1*x9 + x10*x8 - 9*x10 - x8^2 + 9*x8 - x9^2,
x5^2 - x8^2 - x9^2,
x5 - 11,
-x11*x9 + x12*x8,
2*x1*x12 + x10*x11 - 9*x10 - x11^2 + 9*x11 - x12^2,
-x10^2*x14^2 + 18*x10*x14^2 - 81*x14^2 + x6^2,
-x13^2*x9^2 + 2*x13*x14*x8*x9 - 18*x13*x14*x9 + 18*x13*x9^2 - x14^2*x8^2 + 18*x14^2*x8 - 81*x14^2 - 18*x14*x8*x9 + 162*x14*x9 + x7^2 - 81*x9^2,
x10^2*x7 - x10*x13*x7 - 9*x10*x7 - x13^2*x6 + x13*x6*x8 + 9*x13*x6 + 9*x13*x7 - x14^2*x6 + x14*x6*x9 - 9*x6*x8,
-x11^2*x14^2 + 2*x11^2*x14*x9 - x11^2*x9^2 + 2*x11*x12*x13*x14 - 2*x11*x12*x13*x9 - 2*x11*x12*x14*x8 + 2*x11*x12*x8*x9 - 2*x11*x13*x14*x9 + 2*x11*x13*x9^2 + 2*x11*x14^2*x8 - 2*x11*x14*x8*x9 - x12^2*x13^2 + 2*x12^2*x13*x8 - x12^2*x8^2 + 2*x12*x13^2*x9 - 2*x12*x13*x14*x8 - 2*x12*x13*x8*x9 + 2*x12*x14*x8^2 - x13^2*x9^2 + 2*x13*x14*x8*x9 - x14^2*x8^2 + x2^2,
x11^2*x7 - x11*x13*x7 - x11*x7*x8 + x12^2*x7 - x12*x14*x7 - x12*x7*x9 - x13^2*x2 + x13*x2*x8 + 9*x13*x2 + x13*x7*x8 - x14^2*x2 + x14*x2*x9 + x14*x7*x9 - 9*x2*x8,
-x10^2 + 2*x10*x13 - x13^2 - x14^2 + x3^2,
x3 - 1,
-x11^2 + 2*x11*x13 - x12^2 + 2*x12*x14 - x13^2 - x14^2 + x4^2,
x4 - 3,
x10*x15*x9 - 9*x15*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
