LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1^2 - x7^2 - x8^2 + 6*x8 - 9,
x1 - 7,
x2^2 - x7^2 + 4*x7 - x8^2 - 4,
x2 - 6,
-x10^2 + x3^2,
-x11 + x3,
x4^2 - x9^2,
-x11 + x4,
-x10^2*x7^2 + 6*x10*x7^2 + 2*x10*x7*x8*x9 - 6*x10*x7*x9 + x5^2*x7^2 + x5^2*x8^2 - 6*x5^2*x8 + 9*x5^2 - 9*x7^2 - 6*x7*x8*x9 + 18*x7*x9 - x8^2*x9^2 + 6*x8*x9^2 - 9*x9^2,
-x11 + x5,
-x10^2*x7^2 + 4*x10^2*x7 - 4*x10^2 + 2*x10*x7*x8*x9 - 4*x10*x7*x8 - 4*x10*x8*x9 + 8*x10*x8 + x6^2*x7^2 - 4*x6^2*x7 + x6^2*x8^2 + 4*x6^2 - x8^2*x9^2 + 4*x8^2*x9 - 4*x8^2,
-x11 + x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
