LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16),dp;
short=0;
ideal J=-x6^2*x7^2 + 4*x8^2,
-x1 + x8,
-x5^2*x7^2 + 2*x5*x7^3 - x7^4 + 4*x9^2,
-x2 + x9,
4*x10^2 - x6^2*x7^2 + 2*x6*x7^3 - x7^4,
x10 - x3,
4*x11^2 - x5^2*x7^2,
x11 - x4,
x1 + x2 + x3 + x4 - 10,
x1*x2 + x1*x3 + x1*x4 + x2*x3 + x2*x4 + x3*x4 - 35,
x1*x2*x3 + x1*x2*x4 + x1*x3*x4 + x2*x3*x4 - 50,
x1*x2*x3*x4 - 24,
x12^2 - x5^2 - x6^2,
x13^2 - x5^2 + 2*x5*x7 - x6^2 - x7^2,
x14^2 - x5^2 + 2*x5*x7 - x6^2 + 2*x6*x7 - 2*x7^2,
x15^2 - x5^2 - x6^2 + 2*x6*x7 - x7^2,
x12*x13*x14*x15 - x16;
J=sat(J,ideal(x5));
print("SAT_FACTOR=1");
J=sat(J,ideal(x5 - x7));
print("SAT_FACTOR=2");
J=sat(J,ideal(x6));
print("SAT_FACTOR=3");
J=sat(J,ideal(x6 - x7));
print("SAT_FACTOR=4");
J=sat(J,ideal(x7));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
