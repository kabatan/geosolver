LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=x1^2*x5 + x1*x2*x4 - 2*x1*x3*x5 - x1*x4^2 - x2^2*x3 + x2^2*x5 + x2*x3*x4 - 2*x2*x4*x5 + x3^2*x5 + x4^2*x5,
-x1^2*x4 + x1^2*x6 + x1*x2*x3 + x1*x3*x4 - 2*x1*x3*x6 + x2^2*x6 - x2*x3^2 - 2*x2*x4*x6 + x3^2*x6 + x4^2*x6,
x1^2*x7 - 2*x1^2 + x1*x2*x4 - 2*x1*x3*x7 + 4*x1*x3 - x1*x4^2 - x2^2*x3 + x2^2*x7 + x2*x3*x4 - 2*x2*x4*x7 + x3^2*x7 - 2*x3^2 + x4^2*x7,
-x1^2*x4 + x1^2*x8 + x1*x2*x3 - 2*x1*x2 + x1*x3*x4 - 2*x1*x3*x8 + 2*x1*x4 + x2^2*x8 - x2*x3^2 + 2*x2*x3 - 2*x2*x4*x8 + x3^2*x8 - 2*x3*x4 + x4^2*x8,
-x1^2 - x2^2 + x9^2,
x9 - 3,
x10^2 - x3^2 + 4*x3 - x4^2 - 4,
x10 - 2,
-x1^2 + 2*x1*x3 + x11^2 - x2^2 + 2*x2*x4 - x3^2 - x4^2,
x11 - 4,
x1^2*x4 - 2*x1*x4 + x2^2*x4 - x2*x3^2 + 2*x2*x3 - x2*x4^2,
-4*x12^2 + x5^2*x8^2 - 2*x5*x6*x7*x8 - 4*x5*x8^2 + x6^2*x7^2 + 4*x6*x7*x8 + 4*x8^2,
-x1^2*x2^2 - 2*x1^2*x2*x4 - x1^2*x4^2 + 2*x1*x2^2*x3 + 4*x1*x2*x3*x4 + 2*x1*x3*x4^2 + 4*x13^2 - x2^2*x3^2 - 2*x2*x3^2*x4 - x3^2*x4^2,
x12 - x13*x14;
J=sat(J,ideal(x12));
print("SAT_FACTOR=1");
J=sat(J,ideal(x13));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 4*x1 + x2^2 + 4));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1*x4 - x2*x3 + 2*x2 - 2*x4));
print("SAT_FACTOR=9");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x3^2 - 4*x3 + x4^2 + 4));
print("SAT_FACTOR=11");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
