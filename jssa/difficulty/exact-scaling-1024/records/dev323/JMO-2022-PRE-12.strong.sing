LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x1^2 - 11*x1 + x2*x5,
-x1^2 + 2*x1*x6 + x2*x5 - 22*x6 + 121,
-x1^2 - x2^2 + x9^2,
x9 - 10,
x2*x4 - x3^2 + 2*x3*x6 - x4^2 + x4*x5 - 22*x6 + 121,
x10^2 - 121*x4^2,
-x1^2*x4^2 + 2*x1*x2*x3*x4 - 22*x1*x2*x4 + 22*x1*x4^2 + 4*x11^2 - x2^2*x3^2 + 22*x2^2*x3 - 121*x2^2 - 22*x2*x3*x4 + 242*x2*x4 - 121*x4^2,
x1^2*x10 - 3*x1*x10*x3 + 11*x1*x10 + x10*x2^2 - 3*x10*x2*x4 + 2*x10*x3^2 - 11*x10*x3 + 2*x10*x4^2 + 22*x11*x3 - 242*x11,
-x1^2 + 4*x1*x3 - 22*x1 - x2^2 + 4*x2*x4 - 4*x3^2 + 44*x3 - 4*x4^2 + 4*x7^2 - 121,
x7 - 3,
-x1^2 + 22*x1 - x2^2 + x8^2 - 121,
-x12 + x8;
J=sat(J,ideal(-x2 + x5));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 11));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(x2^2 + 2*x2*x5 + x5^2 + 4*x6^2 - 88*x6 + 484));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 11*x1 + x2^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 - 4*x1*x3 + 22*x1 + x2^2 - 4*x2*x4 + 4*x3^2 - 44*x3 + 4*x4^2 + 121));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1*x4 - x2*x3 + 11*x2 - 11*x4));
print("SAT_FACTOR=11");
J=sat(J,ideal(x3^2 - 22*x3 + x4^2 + 121));
print("SAT_FACTOR=12");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
