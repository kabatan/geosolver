LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20),dp;
short=0;
ideal J=x9^2 - 3,
-x1^2 + 4*x1 - x2^2 + 2*x2*x6,
-2*x3^2*x9 + 4*x3*x7*x9 - 2*x4^2*x9 - 4*x4*x7 - 5*x4*x9^2 - 5*x4,
2*x3^2 + 4*x3*x8*x9 + 5*x3*x9^2 + 5*x3 + 2*x4^2 - 4*x4*x8,
4*x1^2*x4^2 - 8*x1*x2*x3*x4 + 32*x1*x2*x4 - 20*x1*x3*x4*x9 + 20*x1*x4^2 - 16*x17^2 + 4*x2^2*x3^2 - 32*x2^2*x3 + 64*x2^2 + 20*x2*x3^2*x9 - 20*x2*x3*x4 - 80*x2*x3*x9 + 80*x2*x4 + 25*x3^2*x9^2 - 50*x3*x4*x9 + 25*x4^2,
x17 - 22,
-x1^2 + 8*x1 + x18^2 - x2^2 - 16,
-4*x19^2 + 4*x3^2 + 20*x3 + 4*x4^2 + 20*x4*x9 + 25*x9^2 + 25,
x18 - x19,
x1*x3 + x2*x4,
4*x5^2 - 3,
-x10^2 + 100*x9^2,
x10 + 20*x5,
-4*x11^2 + 25*x9^2 + 25,
x11 - 5,
-x12^2 + x6^2 - 2*x6*x8 + x7^2 - 4*x7 + x8^2 + 4,
-x13^2 + x6^2 + 4,
-x14^2 + x7^2 + x8^2,
x13^2 - 2*x13*x14 + x14^2 - x15^2,
x12 - x15,
-x1^2*x4^2 + 2*x1*x2*x3*x4 + 4*x16^2 - x2^2*x3^2,
x16 - x20;
J=sat(J,ideal(x17));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x6^2 + 4));
print("SAT_FACTOR=3");
J=sat(J,ideal(x7^2 + x8^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x9^2 + 1));
print("SAT_FACTOR=5");
J=sat(J,ideal(25*x9^2 + 169));
print("SAT_FACTOR=6");
J=sat(J,ideal(4*x1^2 + 20*x1 + 4*x2^2 + 20*x2*x9 + 25*x9^2 + 25));
print("SAT_FACTOR=7");
J=sat(J,ideal(4*x3^2 + 20*x3 + 4*x4^2 + 20*x4*x9 + 25*x9^2 + 25));
print("SAT_FACTOR=8");
J=sat(J,ideal(x3*x9 - x4));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 8*x1 + x2^2 + 16));
print("SAT_FACTOR=12");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=13");
J=sat(J,ideal(x3^2 - 8*x3 + x4^2 + 16));
print("SAT_FACTOR=14");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
