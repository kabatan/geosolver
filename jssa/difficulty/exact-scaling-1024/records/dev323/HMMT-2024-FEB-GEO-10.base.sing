LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x1^2 - x7^2 - x8^2,
x1 - 5,
-x10^2 + x4^2 - x9^2,
x4 - 10,
-16*x12^2 + x5^2,
x6^2 - 16*x8^2,
x11^2*x6 - 4*x11*x6 + x12^2*x6 + 4*x5*x7 - 16*x5,
-x10^2*x11^2 + 2*x10*x11*x12*x9 - x12^2*x9^2 + x2^2,
-x10*x12*x5 + x11^2*x5 + 4*x11*x2 - x11*x5*x9 + x12^2*x5 - 16*x2,
-x10^2*x7^2 + 2*x10*x7*x8*x9 + x3^2 - x8^2*x9^2,
-x10^2*x6 + x10*x6*x8 + x3*x7^2 - 4*x3*x7 + x3*x8^2 + x6*x7*x9 - x6*x9^2,
-x10^2*x3 + x10*x12*x3 - x10*x2*x8 + x11*x3*x9 + x2*x7^2 - x2*x7*x9 + x2*x8^2 - x3*x9^2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
