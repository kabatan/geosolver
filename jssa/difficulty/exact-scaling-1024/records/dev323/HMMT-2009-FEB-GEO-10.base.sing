LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=4*x1^2 - 4*x5^2 - 49,
16*x2^2 - 196*x5^2*x7^2*x8^2 + 196*x5*x6*x7^2*x8 + 196*x5*x6*x7*x8^2 - 1372*x5*x7^2*x8 - 49*x6^2*x7^2 - 98*x6^2*x7*x8 - 49*x6^2*x8^2 + 686*x6*x7^2 + 686*x6*x7*x8 - 2401*x7^2,
x2,
16*x1^2*x5^2*x7^2 - 32*x1^2*x5^2*x7*x8 + 16*x1^2*x5^2*x8^2 - 224*x1^2*x5*x7 + 224*x1^2*x5*x8 + 196*x1^2*x7^2 + 392*x1^2*x7*x8 + 196*x1^2*x8^2 + 784*x1^2 - 16*x5^4*x7^2 + 32*x5^4*x7*x8 - 16*x5^4*x8^2 + 224*x5^3*x7^2*x8 - 224*x5^3*x7*x8^2 + 224*x5^3*x7 - 224*x5^3*x8 - 784*x5^2*x7^2*x8^2 + 392*x5^2*x7^2 - 2352*x5^2*x7*x8 + 392*x5^2*x8^2 - 784*x5^2 - 2744*x5*x7^2*x8 + 2744*x5*x7*x8^2 - 2744*x5*x7 + 2744*x5*x8 - 2401*x7^2 + 4802*x7*x8 - 2401*x8^2,
4*x3^2 - 4*x5^2*x8^2 - 49*x8^2,
x3 - 2,
4*x4^2 - 4*x5^2*x7^2 - 49*x7^2,
x4 - 3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
