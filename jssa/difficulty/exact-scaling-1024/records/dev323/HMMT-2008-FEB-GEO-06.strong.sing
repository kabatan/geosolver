LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=-x1^2 + 2*x1 - x2^2 + 2*x2*x5 + 15,
2*x3^2 - 1,
2*x4^2 - 1,
-64*x2^2 + x6^2,
x1^2*x4 - 2*x1*x4 + x2^2*x4 + x3*x6 - 15*x4,
x5^2 - x7^2 + 1,
x7 - x8;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1^2 + 6*x1 + x2^2 + 9));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 - 10*x1 + x2^2 + 25));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
