LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=x1^2 - 4*x1 + x6^2 - 96,
x1^2 + 6*x1 + x10^2 - 72,
x3,
x1^2 - 2*x1*x3 + x2^2 + x3^2 - 144,
x5,
x1^2 - 2*x1*x5 + x4^2 + x5^2 - 144,
x1^2 - 4*x1 - x11^2 + x6^2 + 4,
x11 - 10,
x1^2 + 6*x1 + x10^2 - x12^2 + 9,
x12 - 9,
x1^2 - 24*x1 - 25*x13^2 + x6^2 + 144,
-x1^2 - 24*x1 - x10^2 + 9*x7^2 - 144,
-2*x13 + x7,
x10^2 - 2*x10*x6 + x6^2 - x8^2,
x2^2 - 2*x2*x4 + x3^2 - 2*x3*x5 + x4^2 + x5^2 - x9^2,
-x14 + x9;
J=sat(J,ideal(x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(x9));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1 - 6));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2^2 - 2*x2*x4 + x3^2 - 2*x3*x5 + x4^2 + x5^2));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
