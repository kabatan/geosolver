LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5),dp;
short=0;
ideal J=x1^2 - x4^2 - x5^2,
x1 - 7,
9*x2^2 - 25*x5^2,
x3^2 - 25*x5^2,
45*x2*x4 + 2*x3*x4^2 + 25*x3*x4 + 2*x3*x5^2 + 50*x3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
