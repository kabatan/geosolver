LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4),dp;
short=0;
ideal J=4*x1^2 - 81*x3^2 - 216*x3*x4 + 3024*x3 - 144*x4^2 + 4032*x4 - 28224,
x1,
4*x2^2 - 25*x3^2 - 120*x3*x4 - 144*x4^2,
x2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
