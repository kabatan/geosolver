LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x4^2 - 3,
x4^2 - x9^2 + 9,
2*x4 - x9,
4*x3^2 - 3,
x10^2 - 16*x2^2,
-2*x1 + x10*x3,
-x11^2 + 16*x4^2,
x11*x3 - 6,
x1^2*x4^2 + 6*x1*x2*x4 - 8*x1*x4^2 + 9*x2^2 - 24*x2*x4 + 16*x4^2 - x5^2,
-3*x1 + x2*x4 + 2*x3*x5 - x4^2 + 3,
4*x4^2 - x6^2,
x1^2*x4^2 - 2*x1*x2*x4 + x2^2 - 4*x7^2,
x1^2*x4^2 - 2*x1*x2*x4 - 8*x1*x4^2 + x2^2 + 8*x2*x4 + 16*x4^2 - 4*x8^2,
-x12 + x8;
J=sat(J,ideal(x6));
print("SAT_FACTOR=1");
J=sat(J,ideal(x7));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4^2 + 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4^2 + 9));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 2*x1 + x2^2 - 2*x2*x4 + x4^2 + 1));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 - 8*x1 + x2^2 + 16));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
