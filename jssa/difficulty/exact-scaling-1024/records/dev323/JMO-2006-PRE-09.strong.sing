LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20),dp;
short=0;
ideal J=-x1^2 + 10*x1 + x12^2 - x2^2 - 25,
x12 - 7,
-x1^2 + x16^2 - x2^2,
x16 - 8,
-x3^2 + 5*x3 - x4^2 + 2*x4*x8,
-4*x17^2 + 4*x3^2 - 20*x3 + 4*x4^2 - 8*x4*x8 + 4*x8^2 + 25,
-x1^2*x4 + 2*x1*x4*x9 - x2^2*x4 + x2*x3^2 - 2*x2*x3*x9 + x2*x4^2 + 10*x2*x9 - 25*x2 - 10*x4*x9 + 25*x4,
x1^2*x3 - 5*x1^2 + 2*x1*x10*x4 - x1*x3^2 - x1*x4^2 + 25*x1 - 2*x10*x2*x3 + 10*x10*x2 - 10*x10*x4 + x2^2*x3 - 5*x2^2 + 5*x3^2 - 25*x3 + 5*x4^2,
x10^2 - 2*x10*x4 - x18^2 + x3^2 - 2*x3*x9 + x4^2 + x9^2,
x17 - x18,
2*x11*x4 - x3^2 + 5*x3 - x4^2,
4*x11^2 - 8*x11*x4 - 4*x19^2 + 4*x3^2 - 20*x3 + 4*x4^2 + 25,
-x1^2*x4 + 2*x1*x4*x5 - x2^2*x4 + x2*x3^2 - 2*x2*x3*x5 + x2*x4^2,
x1^2*x3 - x1*x3^2 - x1*x4^2 + 2*x1*x4*x6 + x2^2*x3 - 2*x2*x3*x6,
-x13^2 + x3^2 - 2*x3*x5 + x4^2 - 2*x4*x6 + x5^2 + x6^2,
x13 - x19,
4*x14^2 - 25*x2^2,
-x3^2 + 5*x3 - x4^2 + 2*x4*x7,
-4*x15^2 + 4*x3^2 - 20*x3 + 4*x4^2 - 8*x4*x7 + 4*x7^2 + 25,
x15 - x20;
J=sat(J,ideal(x14));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x4));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3^2 - 2*x3*x5 + x4^2 - 2*x4*x6 + x5^2 + x6^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(4*x3^2 - 20*x3 + 4*x4^2 - 8*x4*x7 + 4*x7^2 + 25));
print("SAT_FACTOR=5");
J=sat(J,ideal(4*x3^2 - 20*x3 + 4*x4^2 - 8*x4*x8 + 4*x8^2 + 25));
print("SAT_FACTOR=6");
J=sat(J,ideal(x10^2 - 2*x10*x4 + x3^2 - 2*x3*x9 + x4^2 + x9^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(4*x11^2 - 8*x11*x4 + 4*x3^2 - 20*x3 + 4*x4^2 + 25));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1*x4 - x2*x3 + 5*x2 - 5*x4));
print("SAT_FACTOR=10");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
