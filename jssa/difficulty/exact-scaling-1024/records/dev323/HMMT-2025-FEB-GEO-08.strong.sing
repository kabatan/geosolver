LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=-x2^2 - x3^2 + x6^2,
-x1^2 - 2*x1*x2 + 8*x1 - x2^2 + 8*x2 - x3^2 + x7^2 - 16,
x6 - x7,
-x4^2 - x5^2 + x8^2,
x8 - 5,
-x4^2 + 8*x4 - x5^2 + x9^2 - 16,
x9 - 5,
-x1^2 - 2*x1*x2 + 2*x1*x4 + x10^2 - x2^2 + 2*x2*x4 - x3^2 + 2*x3*x5 - x4^2 - x5^2,
x10 - 5,
x11^2 - x2^2 + 2*x2*x4 - x3^2 + 2*x3*x5 - x4^2 - x5^2,
x11 - 5,
4*x12^2 - x2^2 + 4*x2*x4 + 4*x2 - x3^2 + 4*x3*x5 - 4*x4^2 - 8*x4 - 4*x5^2 - 4,
x12 - 5,
4*x13^2 - x2^2 - 4*x2 - x3^2 - 4,
x13 - x14;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 + 2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 4));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 + 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 + 2*x1*x2 - 8*x1 + x2^2 - 8*x2 + x3^2 + 16));
print("SAT_FACTOR=6");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x2^2 - 8*x2 + x3^2 + 16));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
