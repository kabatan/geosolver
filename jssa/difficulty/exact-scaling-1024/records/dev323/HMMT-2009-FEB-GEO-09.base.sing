LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x3^2 - x6^2 + 32*x6 - x7^2 - 256,
x4^2 - x6^2 - x7^2,
x1*x3 + x1*x4 + 16*x1 - 16*x4 - 16*x6,
x2*x3 + x2*x4 + 16*x2 - 16*x7,
x4 - 5,
x1^2 + x2^2 - x5^2,
x5 - 4,
x3*x8 + x4*x8 + 16*x8 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
