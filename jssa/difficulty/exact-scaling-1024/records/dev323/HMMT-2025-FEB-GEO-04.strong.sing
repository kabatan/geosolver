LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x1^2 + 20*x1 - x4^2 + x9^2 - 100,
-x1*x9 + x4^2 + x5*x9,
-x1*x4 - x4*x9 + 10*x4 + x6*x9,
-x1*x9 - x4^2 + x7*x9,
x1*x4 - x4*x9 - 10*x4 + x8*x9,
x13^2 - x4^2,
x13 - x4,
-x14^2 + x5^2 - 20*x5 + x6^2 + 100,
x14 - 10,
-x15^2 + x7^2 - 20*x7 + x8^2 + 100,
x15 - 10,
-x16^2 + x5^2 - 2*x5*x7 + x6^2 - 2*x6*x8 + x7^2 + x8^2,
x16 - 2*x4,
x1*x6 - x1*x8 - x4*x5 + x4*x7 + x5*x8 - x6*x7,
x1^2 - 2*x1*x2 + 2*x1 + x2^2 - 2*x2 + x3^2 - 2*x3*x4 + 1,
x1^2 - 2*x1*x2 - 2*x1 + x2^2 + 2*x2 + x3^2 - 2*x3*x4 + 1,
-x10^2*x5^2 + 2*x10^2*x5*x7 - x10^2*x6^2 + 2*x10^2*x6*x8 - x10^2*x7^2 - x10^2*x8^2 + x2^2*x6^2 - 2*x2^2*x6*x8 + x2^2*x8^2 - 2*x2*x3*x5*x6 + 2*x2*x3*x5*x8 + 2*x2*x3*x6*x7 - 2*x2*x3*x7*x8 + 2*x2*x5*x6*x8 - 2*x2*x5*x8^2 - 2*x2*x6^2*x7 + 2*x2*x6*x7*x8 + x3^2*x5^2 - 2*x3^2*x5*x7 + x3^2*x7^2 - 2*x3*x5^2*x8 + 2*x3*x5*x6*x7 + 2*x3*x5*x7*x8 - 2*x3*x6*x7^2 + x5^2*x8^2 - 2*x5*x6*x7*x8 + x6^2*x7^2,
x10 - 1,
-x1^2 + x11^2,
-x1^2 + 40*x1 + x12^2 - 400,
x11*x12 - x17;
J=sat(J,ideal(x9));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 20));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4 - 1));
print("SAT_FACTOR=5");
J=sat(J,ideal(x5^2 - 2*x5*x7 + x6^2 - 2*x6*x8 + x7^2 + x8^2));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
