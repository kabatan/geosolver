LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=64*x1^6 - 96*x1^4 + 36*x1^2 - 3,
x1^2 + x6^2 - 1,
16777216*x7^24 - 100663296*x7^22 + 264241152*x7^20 - 398196736*x7^18 + 379846656*x7^16 - 238436352*x7^14 + 99147776*x7^12 - 26797056*x7^10 + 4485888*x7^8 - 423872*x7^6 + 18912*x7^4 - 288*x7^2 + 1,
x7^2 + x8^2 - 1,
x12^2 - x14^2,
x12*x7 + x13^2*x8 - x13*x8 + x14^2*x8,
16777216*x2^24 - 100663296*x2^22 + 264241152*x2^20 - 398196736*x2^18 + 379846656*x2^16 - 238436352*x2^14 + 99147776*x2^12 - 26797056*x2^10 + 4485888*x2^8 - 423872*x2^6 + 18912*x2^4 - 288*x2^2 + 1,
x2^2 + x3^2 - 1,
x15^2*x6^2 - x9^2,
x1^2*x15^2*x3 - x1*x15*x3 + x15^2*x3*x6^2 + x2*x9,
64*x4^6 - 96*x4^4 + 36*x4^2 - 3,
x4^2 + x5^2 - 1,
x1*x15*x5 + x4*x9,
x1^2*x15^2 - x10^2 + x15^2*x6^2,
x11^2 - x13^2 + 2*x13 - x14^2 - 1,
x10 - x11;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
