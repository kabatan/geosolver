LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=-x10*x11 + x12*x9 + 5*x12,
-x10^2*x9^2 + 4*x7^2,
-x10^2*x11^2 + 2*x10^2*x11*x9 - x10^2*x9^2 - 2*x10*x11*x12*x9 + 10*x10*x11*x12 + 2*x10*x12*x9^2 - 10*x10*x12*x9 - x12^2*x9^2 + 10*x12^2*x9 - 25*x12^2 + 4*x8^2,
x10^2*x7 - x10^2*x8 - x10*x12*x7 + x11*x7*x9 - 5*x11*x7 - 5*x7*x9 + 25*x7 - 5*x8*x9 - 25*x8,
281474976710656*x4^48 - 3377699720527872*x4^46 + 18999560927969280*x4^44 - 66568831992070144*x4^42 + 162828875980603392*x4^40 - 295364007592722432*x4^38 + 411985976135516160*x4^36 - 452180272956309504*x4^34 + 396366279591591936*x4^32 - 280058255978266624*x4^30 + 160303703377575936*x4^28 - 74448984852135936*x4^26 + 28011510450094080*x4^24 - 8500299631165440*x4^22 + 2064791072931840*x4^20 - 397107008634880*x4^18 + 59570604933120*x4^16 - 6832518856704*x4^14 + 583456329728*x4^12 - 35782471680*x4^10 + 1497954816*x4^8 - 39625728*x4^6 + 579456*x4^4 - 3456*x4^2 + 1,
x1^2 + x4^2 - 1,
-x10^2*x11^2 + 10*x10*x11*x12 - 25*x12^2 + x5^2,
x1*x10^2 - x1*x10*x12 - 5*x1*x11 + 25*x1 + x4*x5,
4096*x2^12 - 12288*x2^10 + 13824*x2^8 - 7168*x2^6 + 1680*x2^4 - 144*x2^2 + 1,
x2^2 + x3^2 - 1,
-25*x12^2 + x6^2,
-5*x11*x3 + x2*x6 + 25*x3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
