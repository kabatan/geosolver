LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4),dp;
short=0;
ideal J=-x1^2 + 2*x1*x2 + 8,
-x1^2 + 2*x1*x2 + 12*x1 - 12*x2 - 28,
-x1^2 + x3^2,
x3 - x4;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 3));
print("SAT_FACTOR=2");
J=sat(J,ideal(4*x2^2 + 81));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
