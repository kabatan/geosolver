LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19),dp;
short=0;
ideal J=x14^2 - 2,
x14*x6 + 3,
x14*x7 - 3,
x14*x8 - 5,
x14*x9 - 5,
x10*x14 - 4,
x11*x14 + 4,
x12*x14 + x2,
x13*x14 + x2,
-x1*x6 + x1*x8 + 2*x3*x7 - 2*x3*x9 + 2*x6*x9 - 2*x7*x8,
x1*x11 - x1*x9 - 2*x10*x4 + 2*x10*x9 - 2*x11*x8 + 2*x4*x8,
x1*x10 - x1*x12 + 2*x10*x13 - 2*x11*x12 + 2*x11*x5 - 2*x13*x5,
-x15^2 + x6^2 + x7^2,
x15 - 3,
-x16^2 + x8^2 + x9^2,
x16 - 5,
x10^2 + x11^2 - x17^2,
x17 - 4,
-x1^2 + x1*x3 + x1*x5 + 2*x3*x4 - 2*x4*x5,
x1*x6 + x1*x7,
x1*x8 - x1*x9,
x1*x10 + x1*x11,
x1*x12 - x1*x13,
x12^2 + x13^2 - x18^2,
x18 - x19;
J=sat(J,ideal(x7 - x9));
print("SAT_FACTOR=1");
J=sat(J,ideal(-x10 + x8));
print("SAT_FACTOR=2");
J=sat(J,ideal(x11 - x13));
print("SAT_FACTOR=3");
J=sat(J,ideal(x14));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1));
print("SAT_FACTOR=5");
J=sat(J,ideal(x2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x6^2 - 2*x6*x8 + x7^2 - 2*x7*x9 + x8^2 + x9^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x10^2 - 2*x10*x8 + x11^2 - 2*x11*x9 + x8^2 + x9^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x10^2 - 2*x10*x12 + x11^2 - 2*x11*x13 + x12^2 + x13^2));
print("SAT_FACTOR=9");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
