LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=-81*x1^2 - 216*x1*x2 + 3024*x1 - 144*x2^2 + 4032*x2 + 4*x3^2 - 28224,
x3,
-25*x1^2 - 120*x1*x2 - 144*x2^2 + 4*x4^2,
x4,
-2*x1^2 + x5^2,
x5 - x6;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
