LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=-x11^2 + 20*x11 - x14^2 + x5^2 - 100,
x1*x5 - x11*x5 + x14^2,
-x11*x14 - x14*x5 + 10*x14 + x2*x5,
-x11*x5 - x14^2 + x3*x5,
x11*x14 - x14*x5 - 10*x14 + x4*x5,
-x14^2 + x7^2,
-x14 + x7,
x1^2 - 20*x1 + x2^2 - x8^2 + 100,
x8 - 10,
x3^2 - 20*x3 + x4^2 - x9^2 + 100,
x9 - 10,
x1^2 - 2*x1*x3 - x10^2 + x2^2 - 2*x2*x4 + x3^2 + x4^2,
x10 - 2*x14,
-x1*x14 + x1*x4 + x11*x2 - x11*x4 + x14*x3 - x2*x3,
x11^2 - 2*x11*x12 + 2*x11 + x12^2 - 2*x12 + x13^2 - 2*x13*x14 + 1,
x11^2 - 2*x11*x12 - 2*x11 + x12^2 + 2*x12 + x13^2 - 2*x13*x14 + 1,
x1^2*x13^2 - 2*x1^2*x13*x4 + x1^2*x4^2 - x1^2*x6^2 - 2*x1*x12*x13*x2 + 2*x1*x12*x13*x4 + 2*x1*x12*x2*x4 - 2*x1*x12*x4^2 - 2*x1*x13^2*x3 + 2*x1*x13*x2*x3 + 2*x1*x13*x3*x4 - 2*x1*x2*x3*x4 + 2*x1*x3*x6^2 + x12^2*x2^2 - 2*x12^2*x2*x4 + x12^2*x4^2 + 2*x12*x13*x2*x3 - 2*x12*x13*x3*x4 - 2*x12*x2^2*x3 + 2*x12*x2*x3*x4 + x13^2*x3^2 - 2*x13*x2*x3^2 + x2^2*x3^2 - x2^2*x6^2 + 2*x2*x4*x6^2 - x3^2*x6^2 - x4^2*x6^2,
x6 - 1,
x15*x5 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
