LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x4^2 - 2,
-x2^2 - x3^2 + x5^2,
-x1 + x5 - 10,
-x2^2 + 46*x2 - x3^2 + x6^2 - 529,
-x1 + x6 - 13,
x2^2 - 20*x2 + x3^2 - 4*x3*x4 + 4*x4^2 - x7^2 + 100,
-x1^2 + x8^2 - 8,
x7 - x8,
-x1 + x9;
J=sat(J,ideal(x4));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
