LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x2^2 - 341,
2*x1*x2 - x2^2*x8 - 100*x8,
x2^2 - x3^2 + 100,
x3 - 21,
x2^2*x8^2 - 2*x2*x7*x8 - x4^2 + x6^2 - 20*x6*x8 + x7^2 + 100*x8^2,
x4 - 3,
x2^2*x8^2 - 2*x2*x7*x8 - x5^2 + x6^2 + 20*x6*x8 + x7^2 + 100*x8^2,
x5 - 4,
2*x1*x7 - x6^2 - x7^2,
x2*x8*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
