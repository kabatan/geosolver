LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=-x2^3 + x2^2*x3 + x2 + x3,
x2^2*x4 - 2*x2^2 + x4,
x1*x5 - x2,
x1*x6 - x2,
x1*x7 - 1,
-x2*x5^2 + 2*x2*x5*x6 - x2*x6^2 + x5^2*x8 - 2*x5*x6*x8 - x5*x7^2 + x5*x7 + x6^2*x8 - x6*x7 + x7^2*x8,
-x2*x5*x7 + x2*x6*x7 + x5^2*x7 - x5^2*x9 - x5*x6*x7 + 2*x5*x6*x9 - x6^2*x9 - x7^2*x9 + x7^2,
-x1^2 + x11^2,
-x1^2*x2^2 + 2*x1*x2^2 + x12^2 - x2^2,
x11 - x12,
-x1*x2 - x2*x9 + x8,
x10^2 - x2^2,
x10 - x13;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x5^2 - 2*x5*x6 + x6^2 + x7^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2^2 + 1));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2*x2^2 - 2*x1*x2*x8 + x8^2 + x9^2));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
