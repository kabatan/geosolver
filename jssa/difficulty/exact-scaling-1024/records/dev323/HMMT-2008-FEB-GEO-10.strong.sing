LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=-x1^2 + 4014*x1 + x11^2 - x2^2 - 4028049,
-x1^2 + x13^2 - x2^2,
2007*x1 + x11*x4 + x13*x4 - 2007*x13 - 2007*x4,
x11*x5 + x13*x5 + 2007*x2 - 2007*x5,
x1^2*x4 - x1^2*x6 + x1*x2*x5 - 4014*x1*x4 + 4014*x1*x6 - x2^2*x6 + 2007*x2^2 - 2007*x2*x5 + 4028049*x4 - 4028049*x6,
-x1^2*x7 + x1*x2*x4 - 2007*x1*x2 + 4014*x1*x7 + x2^2*x5 - x2^2*x7 - 2007*x2*x4 + 4028049*x2 - 4028049*x7,
x1^2*x4 - x1^2*x8 + x1*x2*x5 - x2^2*x8,
-x1^2*x9 + x1*x2*x4 + x2^2*x5 - x2^2*x9,
-x1*x10*x6 + x1*x10*x8 + x1*x4*x6 - x1*x4*x8 - x10*x2*x7 + x10*x2*x9 + 1003*x10*x6 - 1003*x10*x8 + x2*x5*x6 - x2*x5*x8 - x2*x6*x9 + x2*x7*x8 - 1003*x4*x6 + 1003*x4*x8,
x1*x3*x6 - x1*x3*x8 - x1*x4*x7 + x1*x4*x9 - x1*x6*x9 + x1*x7*x8 + x2*x3*x7 - x2*x3*x9 - x2*x5*x7 + x2*x5*x9 - 1003*x3*x6 + 1003*x3*x8 + 1003*x4*x7 - 1003*x4*x9 + 1003*x6*x9 - 1003*x7*x8,
x13 - 2009,
x11 - 2008,
x4^2 - 2006*x4 + 1006009,
-x1*x7 + x2*x6 - 2007*x2 + 2007*x7,
-x1*x9 + x2*x8,
x4 - 1003,
x10^2 - 2006*x10 - x12^2 + x3^2 + 1006009,
x12 - x14;
J=sat(J,ideal(x5));
print("SAT_FACTOR=1");
J=sat(J,ideal(x11 + x13 - 2007));
print("SAT_FACTOR=2");
J=sat(J,ideal(x12));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4^2 - 2006*x4 + x5^2 + 1006009));
print("SAT_FACTOR=5");
J=sat(J,ideal(x6^2 - 2*x6*x8 + x7^2 - 2*x7*x9 + x8^2 + x9^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x6 + x2^2 - 2*x2*x7 + x6^2 + x7^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1*x6 - x1*x8 + x2*x7 - x2*x9 - 1003*x6 + 1003*x8));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 - 2*x1*x8 + x2^2 - 2*x2*x9 + x8^2 + x9^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 - 2006*x1 + x2^2 + 1006009));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 4014*x1 + x2^2 + 4028049));
print("SAT_FACTOR=12");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
