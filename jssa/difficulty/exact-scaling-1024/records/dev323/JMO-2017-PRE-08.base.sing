LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=2*x1*x12 - x11^2 + x11*x14 - x12^2,
-x11^2 + x11*x13 + 11*x11 - x12^2 + 2*x12*x2 - 11*x13,
4*x1^2*x11 - 4*x1^2*x13 + 4*x1^2*x3 - 44*x1^2 - 8*x1*x11*x2 + 4*x1*x12*x13 - 4*x1*x12*x14 + 44*x1*x12 + 4*x1*x13*x2 + 4*x1*x14*x2 - 8*x1*x2*x3 + 44*x1*x2 - x11*x13^2 + 2*x11*x13*x14 - 22*x11*x13 - x11*x14^2 + 22*x11*x14 + 4*x11*x2^2 - 121*x11 - 4*x12*x13*x2 + 4*x12*x14*x2 - 44*x12*x2 + x13^2*x3 - 2*x13*x14*x3 + 22*x13*x3 + x14^2*x3 - 4*x14*x2^2 - 22*x14*x3 + 4*x2^2*x3 + 121*x3,
-4*x1^2*x12 + 4*x1^2*x4 + 4*x1*x11*x13 - 4*x1*x11*x14 + 44*x1*x11 + 8*x1*x12*x2 - 2*x1*x13^2 + 2*x1*x13*x14 - 44*x1*x13 + 22*x1*x14 - 8*x1*x2*x4 - 242*x1 - 4*x11*x13*x2 + 4*x11*x14*x2 - 44*x11*x2 + x12*x13^2 - 2*x12*x13*x14 + 22*x12*x13 + x12*x14^2 - 22*x12*x14 - 4*x12*x2^2 + 121*x12 + x13^2*x4 + 2*x13*x14*x2 - 2*x13*x14*x4 + 22*x13*x4 - 2*x14^2*x2 + x14^2*x4 + 22*x14*x2 - 22*x14*x4 + 4*x2^2*x4 + 121*x4,
-x11*x4 + x12*x3 - x12*x5 + x4*x5,
-x12^2*x13^2 + x6^2,
-x12^2*x14^2 + 22*x12^2*x14 - 121*x12^2 + x7^2,
-x11^2*x7 + x11*x13*x7 + x11*x14*x6 - 11*x11*x6 - x12^2*x7 - 11*x14*x6 + 121*x6,
x11^2*x6 - x11*x13*x7 - x11*x14*x6 - 11*x11*x6 + x12^2*x6 + 11*x14*x6,
x5^2 - x8^2,
x8 - 5,
x5^2 - 22*x5 - x9^2 + 121,
x9 - 6,
-x10^2 + x13^2 - 2*x13*x3 + x3^2 + x4^2,
x10 - 3,
-x12^2*x13*x14*x15 + 11*x12^2*x14*x15 + x12*x13*x14*x15*x4 - 11*x12*x14*x15*x4 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
