LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x1^2 - x7^2 - x8^2,
x1 - 8,
x3^2 - x7^2 + 12*x7 - x8^2 - 36,
x3 - 7,
x4^2 - 36*x8^2*x9^2,
-36*x10^2*x8^2 + x5^2,
6*x10*x4*x7 - x10*x5*x7^2 - x10*x5*x8^2 + 36*x4*x9 - 36*x4 + x5*x7^2 - 6*x5*x7*x9 + x5*x8^2,
-x10^2*x7^2 - x10^2*x8^2 - 12*x10*x7*x9 + 12*x10*x7 + x6^2 - 36*x9^2 + 72*x9 - 36,
-x10^2*x7^2 - x10^2*x8^2 + 2*x10*x7^2 - 12*x10*x7*x9 + 2*x10*x8^2 + x2^2 - x7^2 + 12*x7*x9 - x8^2 - 36*x9^2,
x2 - 2*x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
