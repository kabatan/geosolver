LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3),dp;
short=0;
ideal J=-8*x1^2 + 356*x1 + 4*x2^2 - 4225,
2*x1 + 2*x2 - 65,
-x1 + x3;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 33));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
