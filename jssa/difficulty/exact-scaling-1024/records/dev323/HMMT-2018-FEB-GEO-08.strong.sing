LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=x12^2 - 3,
-3*x12^2 + 4*x12*x5 + 7,
-x3^2*x6 + 2*x3*x4*x5 + 10*x3*x6 - x4^2*x6 + 5*x4^2 - 10*x4*x5 - 25*x6,
-x3^2*x7 - 5*x3*x4 + 10*x3*x7 + 2*x4^2*x5 - x4^2*x7 + 25*x4 - 25*x7,
-36*x12^2*x3 + 18*x12^2*x8 + 27*x12^2 + 24*x12*x3*x4 + 24*x12*x3*x5 - 24*x12*x4*x8 - 36*x12*x5 + 8*x3^2*x8 - 28*x3^2 - 16*x3*x4*x5 - 24*x3*x8 + 84*x3 + 8*x4^2*x8 - 12*x4^2 + 24*x4*x5 + 18*x8 - 63,
-27*x12^3 + 36*x12^2*x4 + 36*x12^2*x5 - 18*x12^2*x9 + 12*x12*x3^2 - 60*x12*x3 - 12*x12*x4^2 - 48*x12*x4*x5 + 24*x12*x4*x9 + 63*x12 - 8*x3^2*x9 + 16*x3*x4 + 24*x3*x9 + 16*x4^2*x5 - 8*x4^2*x9 - 24*x4 - 18*x9,
-3*x10*x12*x8 + 15*x10*x12 - 2*x10*x6*x9 + 2*x10*x7*x8 - 10*x10*x7 + 3*x10*x9 + 3*x12*x6*x8 - 15*x12*x6 + 10*x6*x9 - 3*x7*x8 + 15*x7 - 15*x9,
3*x11*x12*x8 - 15*x11*x12 + 2*x11*x6*x9 - 2*x11*x7*x8 + 10*x11*x7 - 3*x11*x9 - 3*x12*x6*x9 + 15*x12*x9 - 7*x7*x9,
16*x12^2 - x16^2 + 16,
x16 - 8,
9*x12^2 - 4*x13^2 + 9,
x13 - 3,
x1*x4 - x2*x3,
3*x1*x12 - 24*x12 + 13*x2,
4*x1*x12 - 20*x12 + x2,
x12*x3 - 8*x12 + x4,
x10^2 - 10*x10 + x11^2 - x14^2 + 25,
x10^2 - 2*x10*x8 + x11^2 - 2*x11*x9 - x15^2 + x8^2 + x9^2,
x14*x15 - x17;
J=sat(J,ideal(x12));
print("SAT_FACTOR=1");
J=sat(J,ideal(4*x12 - x4));
print("SAT_FACTOR=2");
J=sat(J,ideal(x4));
print("SAT_FACTOR=3");
J=sat(J,ideal(4*x5^2 + 25));
print("SAT_FACTOR=4");
J=sat(J,ideal(-9*x12^2 + 6*x12*x4 + 6*x12*x5 - 4*x3 - 4*x4*x5 + 6));
print("SAT_FACTOR=5");
J=sat(J,ideal(-5*x3 + 2*x4*x5 + 25));
print("SAT_FACTOR=6");
J=sat(J,ideal(9*x12^2 - 12*x12*x7 + 4*x6^2 - 12*x6 + 4*x7^2 + 9));
print("SAT_FACTOR=7");
J=sat(J,ideal(3*x12*x8 - 15*x12 + 2*x6*x9 - 2*x7*x8 + 10*x7 - 3*x9));
print("SAT_FACTOR=8");
J=sat(J,ideal(x8^2 - 10*x8 + x9^2 + 25));
print("SAT_FACTOR=9");
J=sat(J,ideal(x12^2 + 1));
print("SAT_FACTOR=10");
J=sat(J,ideal(9*x12^2 - 12*x12*x4 + 4*x3^2 - 12*x3 + 4*x4^2 + 9));
print("SAT_FACTOR=11");
J=sat(J,ideal(x3^2 - 10*x3 + x4^2 + 25));
print("SAT_FACTOR=12");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
