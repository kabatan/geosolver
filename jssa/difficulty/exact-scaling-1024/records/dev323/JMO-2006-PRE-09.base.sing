LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x13^2 + 10*x13 - x14^2 + x7^2 - 25,
x7 - 7,
-x13^2 - x14^2 + x9^2,
x9 - 8,
-x15^2 + 5*x15 - x16^2 + 2*x16*x3,
-4*x10^2 + 4*x15^2 - 20*x15 + 4*x16^2 - 8*x16*x3 + 4*x3^2 + 25,
-x13^2*x16 + 2*x13*x16*x4 - x14^2*x16 + x14*x15^2 - 2*x14*x15*x4 + x14*x16^2 + 10*x14*x4 - 25*x14 - 10*x16*x4 + 25*x16,
x13^2*x15 - 5*x13^2 - x13*x15^2 - x13*x16^2 + 2*x13*x16*x5 + 25*x13 + x14^2*x15 - 5*x14^2 - 2*x14*x15*x5 + 10*x14*x5 + 5*x15^2 - 25*x15 + 5*x16^2 - 10*x16*x5,
-x11^2 + x15^2 - 2*x15*x4 + x16^2 - 2*x16*x5 + x4^2 + x5^2,
x10 - x11,
-x15^2 + 5*x15 - x16^2 + 2*x16*x6,
-4*x12^2 + 4*x15^2 - 20*x15 + 4*x16^2 - 8*x16*x6 + 4*x6^2 + 25,
2*x1*x13*x16 - 2*x1*x14*x15 - x13^2*x16 - x14^2*x16 + x14*x15^2 + x14*x16^2,
x13^2*x15 - x13*x15^2 - x13*x16^2 + 2*x13*x16*x2 + x14^2*x15 - 2*x14*x15*x2,
x1^2 - 2*x1*x15 + x15^2 + x16^2 - 2*x16*x2 + x2^2 - x8^2,
-x12 + x8,
x13^2*x16^3*x17 - 2*x13*x14*x15*x16^2*x17 + 5*x13*x14*x16^2*x17 - 5*x13*x16^3*x17 + x14^2*x15^2*x16*x17 - 5*x14^2*x15*x16*x17 + 5*x14*x15*x16^2*x17 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
