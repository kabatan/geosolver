LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5),dp;
short=0;
ideal J=x1^2 - 3,
16*x1^2 - x2^2 + 16,
x2 - 8,
400*x1^2 - x3^2,
20*x1 - x3,
441*x1^2*x5^2 - 1680*x1^2*x5 + 1600*x1^2 - 16*x4^2,
x4,
21*x1*x5 - 40*x1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
