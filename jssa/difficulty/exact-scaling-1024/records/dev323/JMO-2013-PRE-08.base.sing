LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x1^2 - x6^2 - 10*x6 - x7^2 - 25,
x1 - x8 + 5,
x2^2 - x6^2 - x7^2 + 12*x7 - 36,
x2 - x8 + 6,
x3^2 - x6^2 + 40*x6 - x7^2 - 400,
x3 - x8 + 20,
x4^2 - x5^2 - 2*x5*x7 - x6^2 - x7^2,
x4 + x5 - x8;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
