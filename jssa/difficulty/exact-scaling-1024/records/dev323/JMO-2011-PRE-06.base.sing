LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x1^2 - x5^2 + 2*x5*x7 - x7^2,
9*x2^2 - 4*x5^2 - 4*x6^2,
x1 - x2,
9*x3^2 - x5^2 - x6^2 + 6*x6 - 9,
9*x4^2 - x5^2 + 6*x5*x7 - 4*x6^2 - 9*x7^2,
x3 - x4,
x5^2 - 3*x5*x7 - 2*x6^2 + 6*x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
