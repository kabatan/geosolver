LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=-x10^2 + 2*x10*x11 - x11^2 - x12^2 + x3^2,
-x11^2 - x12^2 + x4^2,
-x10^2 + x5^2,
x1*x3 + x1*x4 + x1*x5 - x10*x4 - x11*x5,
-x12*x5 + x2*x3 + x2*x4 + x2*x5,
x11*x14 - x12*x13,
-x13^2 - x14^2 + x6^2,
x4 - 9*x6,
-x10^2 + 18*x10*x13 - 81*x13^2 - 81*x14^2 + 81*x7^2,
x7 - 1,
81*x1^2 - 18*x1*x10 + x10^2 + 81*x2^2 - 81*x8^2,
x8 - 1,
x1^2 - 2*x1*x13 + x13^2 + x14^2 - 2*x14*x2 + x2^2 - x9^2,
x9 - 1,
x15*x3 + x15*x4 + x15*x5 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
