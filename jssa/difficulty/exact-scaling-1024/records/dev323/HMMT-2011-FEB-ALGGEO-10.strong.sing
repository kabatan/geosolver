LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5),dp;
short=0;
ideal J=-x1^2*x2^2 + 4*x3^2,
x3 - 169,
x1*x2 - 6*x1 - 13*x2,
-x2^2 + 26*x2 + x4^2 - 169,
x4 - x5;
J=sat(J,ideal(x4));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
