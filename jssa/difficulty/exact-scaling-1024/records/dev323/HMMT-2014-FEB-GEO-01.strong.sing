LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=-x2^2 + x3^2 - 1,
x3 - 4,
-x1^2 - x2^2 + x4^2,
x4 - 6,
-4*x1^2 + x5^2,
x5 - x6;
J=sat(J,ideal(x1 - 1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
