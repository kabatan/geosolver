LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x5^2 - 2,
-x2 + x3*x5 + 2*x5^2 + x5,
x1*x5 + x2 + x4*x5 - 2*x5^2 - 3*x5,
x3^2 + x4^2 - x6^2,
x6,
-x1 - x2 + x7 - 14;
J=sat(J,ideal(x5));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
