LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19),dp;
short=0;
ideal J=-x6^2 + 28*x6 + x7^2 - 196,
x7 - 15,
x11^2 - x3^2 + 2*x3*x6 - x6^2,
x11 - 16,
-x1^2 + x12^2 - x2^2,
x13^2 - x3^2,
x12 - x13,
-x1^2 + 2*x1*x3 + x14^2 - x2^2 - x3^2,
x12 - x14,
x15^2 - x4^2 + 28*x4 - x5^2 - 196,
-x15 + x7,
x16^2 - x4^2 + 2*x4*x6 - x5^2 - x6^2,
-x16 + x7,
-x1^2*x5^2 + 2*x1*x2*x4*x5 + 4*x17^2 - x2^2*x4^2,
4*x18^2 - x3^2*x5^2,
-x1^2*x5^2 - 2*x1*x2*x3*x5 + 2*x1*x2*x4*x5 + 2*x1*x3*x5^2 - x2^2*x3^2 + 2*x2^2*x3*x4 - x2^2*x4^2 + 2*x2*x3^2*x5 - 2*x2*x3*x4*x5 - x3^2*x5^2 + 4*x8^2,
-x2^2*x3^2 + 4*x9^2,
x17 + x18 + x8 - x9,
-x1^2 + 2*x1*x4 + x10^2 - x2^2 + 2*x2*x5 - x4^2 - x5^2,
x10 - x19;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3 - x6));
print("SAT_FACTOR=3");
J=sat(J,ideal(x5));
print("SAT_FACTOR=4");
J=sat(J,ideal(x6 - 14));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1*x5 + x2*x3 - x2*x4 - x3*x5));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1*x5 - x2*x4));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
