LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x1*x10^2 - 2*x1*x10*x8 + x1*x7^2 - 2*x1*x7*x9 + x1*x8^2 + x1*x9^2 + x10^2*x11 - 2*x10^2*x7 - 2*x10*x11*x8 + 2*x10*x12*x7 - 2*x10*x12*x9 + 2*x10*x7*x8 + 2*x10*x8*x9 - x11*x7^2 + 2*x11*x7*x9 + x11*x8^2 - x11*x9^2 - 2*x12*x7*x8 + 2*x12*x8*x9 - 2*x8^2*x9,
-x10^2*x12 + x10^2*x2 + 2*x10*x11*x7 - 2*x10*x11*x9 + 2*x10*x12*x8 - 2*x10*x2*x8 - 2*x10*x7^2 + 2*x10*x7*x9 - 2*x11*x7*x8 + 2*x11*x8*x9 + x12*x7^2 - 2*x12*x7*x9 - x12*x8^2 + x12*x9^2 + x2*x7^2 - 2*x2*x7*x9 + x2*x8^2 + x2*x9^2 + 2*x7*x8*x9 - 2*x8*x9^2,
x7^2 + x8^2 - 1,
x10^2 + x9^2 - 1,
x11^2 + x12^2 - 1,
-x10^2 + 2*x10*x8 + x3^2 - x7^2 + 2*x7*x9 - x8^2 - x9^2,
-x11^2 + 2*x11*x7 - x12^2 + 2*x12*x8 + x4^2 - x7^2 - x8^2,
x3 - x4,
x1^2 + x2^2 - x5^2,
x6^2 - 3,
x5 - x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
