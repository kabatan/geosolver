LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=2*x1*x16 + x14*x15 - x15^2 - x16^2,
x14*x15 - x15^2 - x16^2 + 2*x16*x3,
x12^2 - x14^2,
x13^2 - x15^2 - x16^2,
-x12*x15 + x12*x4 - x13*x14 + x13*x4,
-x12*x16 + x12*x5 + x13*x5,
x12^2*x14*x15^2 - x12^2*x15^2*x6 + 2*x12^2*x15*x16*x3 - x12^2*x16^2*x6 + 2*x12*x13*x14^2*x15 - 2*x12*x13*x14*x15*x6 + 2*x12*x13*x14*x16*x3 + x13^2*x14^3 - x13^2*x14^2*x6,
x12^2*x14*x15*x16 - x12^2*x15^2*x7 + 2*x12^2*x16^2*x3 - x12^2*x16^2*x7 + x12*x13*x14^2*x16 - 2*x12*x13*x14*x15*x7 - x13^2*x14^2*x7,
2*x1*x14*x8 - 2*x1*x15*x8 - x14^2*x16 + x14*x16*x8,
-2*x1*x14*x16 + 2*x1*x14*x2 - 2*x1*x15*x2 + x14*x16*x2,
x2^2 - 2*x2*x5 + x4^2 - 2*x4*x8 + x5^2 + x8^2 - x9^2,
x9 - 6,
4*x1^2 - 4*x1*x2 - x10^2 + x14^2 - 2*x14*x8 + x2^2 + x8^2,
x10 - 7,
4*x1^2 - 4*x1*x7 - x11^2 + x14^2 - 2*x14*x6 + x6^2 + x7^2,
x11 - 9,
2*x1*x12*x14^2*x16*x17 - 2*x1*x12*x14*x15*x16*x17 + 2*x1*x13*x14^2*x16*x17 - 2*x1*x13*x14*x15*x16*x17 + x12*x14^2*x16^2*x17 + x13*x14^2*x16^2*x17 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
