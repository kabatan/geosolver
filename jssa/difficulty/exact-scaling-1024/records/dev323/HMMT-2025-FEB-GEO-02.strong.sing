LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=-4*x1^2 + 504*x1 - x2^2 - 2*x2*x3 + 2*x2*x4 + 2*x2*x5 - x3^2 + 2*x3*x4 + 2*x3*x5 - x4^2 - 2*x4*x5 - x5^2 + 4*x6^2 - 15876,
x6,
-x2^2 + 2*x2*x3 - x3^2 + x7^2 - 400,
-x4^2 + 2*x4*x5 - x5^2 + x8^2 - 576,
x7 - x8,
x2*x4 - x2*x5 - x3*x4 + x3*x5 - 480,
-x1 + x9;
J=sat(J,ideal(x7));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 49));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2^2 - 2*x2*x3 + x3^2 + 400));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4^2 - 2*x4*x5 + x5^2 + 576));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
