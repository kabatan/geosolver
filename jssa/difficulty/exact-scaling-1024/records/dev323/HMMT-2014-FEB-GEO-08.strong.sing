LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3),dp;
short=0;
ideal J=5329*x1^2 - 11972*x1 + 6724,
-324*x1^2 + 432*x1 + x2^2 - 144,
x2 - x3;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(73*x1^2 - 128*x1 + 64));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
