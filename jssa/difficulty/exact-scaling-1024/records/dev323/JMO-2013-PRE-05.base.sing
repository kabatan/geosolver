LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
2*x1^2*x8 + 2*x2^2*x8 - 2*x3*x7 + x7^2,
2*x1^3*x8 - x1^2*x7*x8 - 2*x1^2*x7 + 2*x1*x2^2*x8 + x1*x7^2 - x2^2*x7*x8 - 2*x2^2*x7 + 2*x2*x4*x7,
x1^2*x8^2 - x1*x7*x8 - 9*x1*x8 + x2^2*x8^2 - 2*x2*x5*x8 + 9*x7,
4*x1^2 + 4*x2^2 - x6^2,
x6 - 2,
x3^2*x7^2 - 18*x3^2*x7 + 81*x3^2 - 2*x3*x7^3 + 36*x3*x7^2 - 162*x3*x7 + x7^4 - 18*x7^3 + 81*x7^2,
x1^2*x7^2*x8^2 - 4*x1^2*x7^2*x8 + 4*x1^2*x7^2 - 18*x1^2*x7*x8^2 + 72*x1^2*x7*x8 - 72*x1^2*x7 + 81*x1^2*x8^2 - 324*x1^2*x8 + 324*x1^2 + 4*x1*x2*x5*x7*x8^2 - 16*x1*x2*x5*x7*x8 + 16*x1*x2*x5*x7 + 36*x1*x2*x5*x8^2 - 144*x1*x2*x5*x8 + 144*x1*x2*x5 + 4*x2^2*x5^2*x8^2 - 16*x2^2*x5^2*x8 + 16*x2^2*x5^2 - 36*x2^2*x7*x8^2 + 144*x2^2*x7*x8 - 144*x2^2*x7,
x2*x7^2*x8^2*x9 - 2*x2*x7^2*x8*x9 - 9*x2*x7*x8^2*x9 + 18*x2*x7*x8*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
