LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x8^2 - 3,
x1*x8 - x2,
x3*x8 + x4 + x7*x8 - 6*x8,
-2*x6 + x7*x8,
x1*x7*x8 - x2*x7 - x3*x7*x8 + x4*x7 + x7^2*x8,
x3*x7*x8 + x4*x7 - x5*x7*x8 - x6*x7 - x7^2*x8,
-2*x2*x7 + 2*x6*x7 + x7^2*x8,
4*x1^2 - 8*x1*x3 + 4*x1*x7 + 4*x2^2 - 8*x2*x4 - 4*x2*x7*x8 + 4*x3^2 - 4*x3*x7 + 4*x4^2 + 4*x4*x7*x8 + x7^2*x8^2 + x7^2 - 4*x9^2,
x9 - 1,
x10^2 - x3^2 + 2*x3*x5 + 2*x3*x7 - x4^2 + 2*x4*x6 - x5^2 - 2*x5*x7 - x6^2 - x7^2,
x10 - 1,
4*x1^2 - 8*x1*x5 - 4*x1*x7 - 4*x11^2 + 4*x2^2 - 8*x2*x6 - 4*x2*x7*x8 + 4*x5^2 + 4*x5*x7 + 4*x6^2 + 4*x6*x7*x8 + x7^2*x8^2 + x7^2,
x11 - 1,
x12 - x7;
J=sat(J,ideal(-x2 + 3*x8));
print("SAT_FACTOR=1");
J=sat(J,ideal(-x4 + 3*x8));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x4));
print("SAT_FACTOR=4");
J=sat(J,ideal(x5));
print("SAT_FACTOR=5");
J=sat(J,ideal(x5 + x7 - 6));
print("SAT_FACTOR=6");
J=sat(J,ideal(x7));
print("SAT_FACTOR=7");
J=sat(J,ideal(x7 - 6));
print("SAT_FACTOR=8");
J=sat(J,ideal(x8^2 + 1));
print("SAT_FACTOR=9");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
