LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=-x10^2 + x10 - x11^2 + 2*x11*x3,
-2*x10*x3 - 2*x11*x4 + x11 + 2*x3*x4,
x7^2 - 3,
16*x1^4 - 16*x1^2 + 1,
x1^2 + x2^2 - 1,
-x11^2 + x8^2,
x1*x8 + x10*x2,
4*x3^2 + 4*x4^2 - 4*x4 - 4*x9^2 + 1,
4*x3^2 - 4*x5^2 + 1,
x4^2 - 2*x4 - x6^2 + 1,
x5^2 - x5*x6 - x9^2,
-x11^2*x12 + x11*x12*x3 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
