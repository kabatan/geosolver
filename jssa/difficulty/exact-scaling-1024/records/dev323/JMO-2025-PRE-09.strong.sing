LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16),dp;
short=0;
ideal J=x1*x2 - x2^2 - x3^2 + 2*x3*x4,
x1^2*x5 - 2*x1*x2*x5 - x1*x3^2 + x2^2*x5 + x3^2*x5,
-x1^2*x3 + x1^2*x6 + x1*x2*x3 - 2*x1*x2*x6 + x2^2*x6 + x3^2*x6,
x2^2*x5 - x2^2*x7 + x2*x3*x6 - x3^2*x7,
-x2^2*x8 + x2*x3*x5 + x3^2*x6 - x3^2*x8,
-x1*x5*x8 + x1*x8*x9 + 2*x4*x5*x9 - 2*x4*x7*x9,
-x1*x10*x8 - 2*x10*x4*x5 + 2*x10*x4*x7 + 2*x4*x5*x8,
x1^2 - 2*x1*x5 + 4*x4^2 - 4*x4*x6,
x1^2 - 4*x1*x5 - 4*x11^2 + 4*x4^2 - 8*x4*x6 + 4*x5^2 + 4*x6^2,
x12^2 - 7,
x11 - 4*x12,
x10^2 - x13^2 + x9^2,
x13 - 11,
-x1^2*x3^2 + 4*x14^2,
-x1*x10 + 2*x4*x9,
-x10*x5 + x10*x7 + x5*x8 - x8*x9,
-x15^2 + x5^2 - 2*x5*x7 + x7^2 + x8^2,
x15 - x16;
J=sat(J,ideal(x14));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1 - x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 + 4*x4^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 4*x1*x5 + 4*x4^2 - 8*x4*x6 + 4*x5^2 + 4*x6^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1*x8 + 2*x4*x5 - 2*x4*x7));
print("SAT_FACTOR=8");
J=sat(J,ideal(x5^2 - 2*x5*x7 + x7^2 + x8^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 - 2*x1*x2 + x2^2 + x3^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1*x2 - x2^2 - x3^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x2^2 + x3^2));
print("SAT_FACTOR=12");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
