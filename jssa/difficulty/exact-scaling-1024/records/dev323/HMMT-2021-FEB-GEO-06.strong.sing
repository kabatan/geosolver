LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=x1*x2*x3 - x1*x3*x4 + x1*x4*x5 + x2^2*x4 - x2*x3*x5 - x2*x4^2,
-x1^2*x3 - x1*x2*x4 + x1*x3^2 + x1*x4*x6 + x2*x3*x4 - x2*x3*x6,
-x1^2*x4 + 2*x1*x4*x7 - x2^2*x4 + x2*x3^2 - 2*x2*x3*x7 + x2*x4^2,
x1^2*x3 - x1*x3^2 - x1*x4^2 + 2*x1*x4*x8 + x2^2*x3 - 2*x2*x3*x8,
x1^2 - 2*x1*x7 + x2^2 - 2*x2*x8 + x7^2 + x8^2 - x9^2,
x9 - 11,
-4*x10^2 + x3^2 - 8*x3*x5 + 4*x3*x7 + x4^2 - 8*x4*x6 + 4*x4*x8 + 16*x5^2 - 16*x5*x7 + 16*x6^2 - 16*x6*x8 + 4*x7^2 + 4*x8^2,
x10 - 11,
-x11^2 + x5^2 - 2*x5*x7 + x6^2 - 2*x6*x8 + x7^2 + x8^2,
x11 - 7,
-x1^2*x4^2 + 2*x1*x2*x3*x4 + 4*x12^2 - x2^2*x3^2,
x13^2 - x3^2 - x4^2,
x13^2 - x14;
J=sat(J,ideal(x12));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x4));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
