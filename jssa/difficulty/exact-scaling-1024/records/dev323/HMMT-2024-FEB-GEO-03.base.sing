LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x1^2 + x8^2 - 15129,
x1^2 - 9*x2^2 + 9*x9^2,
x2 - 61,
x1^2 - x3^2 + x8^2,
x3 - 123,
x1^2 - 9*x4^2 + 9*x8^2 - 18*x8*x9 + 9*x9^2,
x4 - 61,
x1^2 - 9*x5^2,
x1 - 3*x5,
4*x1^2 - 9*x6^2,
2*x1 - 3*x6,
x1^2 - x7^2,
x1 - x7;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
