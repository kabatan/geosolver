LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x1^2 - x1*x3 - 5*x1 + x2*x4 + 5*x3,
x1^2 - x1*x3 + 6*x1 + x2*x5,
-x1^2 - x2^2 + x6^2,
x6 - 10,
-x1^2 + 2*x1*x3 - x2^2 - x3^2 + x7^2,
x7 - 11,
x4^2 - 2*x4*x5 + x5^2 - x8^2,
x8,
-x3 + x9;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3 - 5));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3 - 6));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
