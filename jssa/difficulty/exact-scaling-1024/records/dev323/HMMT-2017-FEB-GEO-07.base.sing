LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x1^2 + x2^2 - 1,
x4^2 - 20*x4 + x5^2 + 51,
7*x1*x4 - 70*x1 + 7*x2*x5 - x4^2 + 20*x4 - x5^2 - 100,
7*x1*x5 - 7*x1*x7 - 7*x2*x4 + 7*x2*x6 + x4*x7 - x5*x6 + 10*x5 - 10*x7,
x6^2 + x7^2 - 289,
7*x1*x5 - 7*x1*x9 - 7*x2*x4 + 7*x2*x8 + x4*x9 - x5*x8 + 10*x5 - 10*x9,
x8^2 + x9^2 - 289,
x1^2*x10 + 17*x1^2 - 2*x1*x10 - 34*x1 + x10*x2^2 + x10 - 17*x2^2 + 17,
x1^2*x3 + 34*x1*x2 - 2*x1*x3 + x2^2*x3 - 34*x2 + x3,
49*x1^2 - 14*x1*x6 + 140*x1 - x11^2 + 49*x2^2 - 14*x2*x7 + x6^2 - 20*x6 + x7^2 + 100,
49*x1^2 - 14*x1*x8 + 140*x1 - x12^2 + 49*x2^2 - 14*x2*x9 + x8^2 - 20*x8 + x9^2 + 100,
x11 - 3*x12;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
