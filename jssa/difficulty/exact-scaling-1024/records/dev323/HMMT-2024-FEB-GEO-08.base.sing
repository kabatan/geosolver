LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18),dp;
short=0;
ideal J=x4^2 - 3,
2*x1*x15 - x14^2 + 4*x14 - x15^2,
-2*x16^2*x4 + 4*x16*x2*x4 - 2*x17^2*x4 - 4*x17*x2 - 5*x17*x4^2 - 5*x17,
2*x16^2 + 4*x16*x3*x4 + 5*x16*x4^2 + 5*x16 + 2*x17^2 - 4*x17*x3,
-16*x11^2 + 4*x14^2*x17^2 - 8*x14*x15*x16*x17 + 32*x14*x15*x17 - 20*x14*x16*x17*x4 + 20*x14*x17^2 + 4*x15^2*x16^2 - 32*x15^2*x16 + 64*x15^2 + 20*x15*x16^2*x4 - 20*x15*x16*x17 - 80*x15*x16*x4 + 80*x15*x17 + 25*x16^2*x4^2 - 50*x16*x17*x4 + 25*x17^2,
x11 - 22,
x12^2 - x14^2 + 8*x14 - x15^2 - 16,
-4*x13^2 + 4*x16^2 + 20*x16 + 4*x17^2 + 20*x17*x4 + 25*x4^2 + 25,
x12 - x13,
x14*x16 + x15*x17,
100*x4^2 - x5^2,
10*x4 - x5,
25*x4^2 - 4*x6^2 + 25,
x6 - 5,
x1^2 - 2*x1*x3 + x2^2 - 4*x2 + x3^2 - x7^2 + 4,
x1^2 - x8^2 + 4,
x2^2 + x3^2 - x9^2,
-x10^2 + x8^2 - 2*x8*x9 + x9^2,
-x10 + x7,
x15*x16*x18*x4 - x15*x17*x18 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
