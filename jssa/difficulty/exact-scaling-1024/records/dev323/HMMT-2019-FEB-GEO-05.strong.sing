LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=-x1^2*x5 + x1^2*x7 + 2*x1*x2*x4 - 2*x1*x2*x6 + 2*x1*x3*x5 - 2*x1*x3*x7 - 2*x1*x4^2 + 2*x1*x4*x6 - 2*x2^2*x3 + x2^2*x5 + x2^2*x7 + 2*x2*x3*x4 + 2*x2*x3*x6 - 2*x2*x4*x5 - 2*x2*x4*x7 - x3^2*x5 + x3^2*x7 - 2*x3*x4*x6 + x4^2*x5 + x4^2*x7,
-2*x1^2*x4 + x1^2*x6 + x1^2*x8 + 2*x1*x2*x3 - 2*x1*x2*x5 + 2*x1*x3*x4 - 2*x1*x3*x6 - 2*x1*x3*x8 + 2*x1*x4*x5 - x2^2*x6 + x2^2*x8 - 2*x2*x3^2 + 2*x2*x3*x5 + 2*x2*x4*x6 - 2*x2*x4*x8 + x3^2*x6 + x3^2*x8 - 2*x3*x4*x5 - x4^2*x6 + x4^2*x8,
x1^2 + x2^2 - 1,
x3^2 + x4^2 - 1,
x5^2 + x6^2 - 1,
-x1^2 + 2*x1*x3 - x2^2 + 2*x2*x4 - x3^2 - x4^2 + x9^2,
-x1^2 + 2*x1*x5 + x10^2 - x2^2 + 2*x2*x6 - x5^2 - x6^2,
-x10 + x9,
-x11^2 + x7^2 + x8^2,
x12^2 - 3,
x11 - x12,
-x1^2*x4^2 + 2*x1^2*x4*x6 - x1^2*x6^2 + 2*x1*x2*x3*x4 - 2*x1*x2*x3*x6 - 2*x1*x2*x4*x5 + 2*x1*x2*x5*x6 - 2*x1*x3*x4*x6 + 2*x1*x3*x6^2 + 2*x1*x4^2*x5 - 2*x1*x4*x5*x6 + 4*x13^2 - x2^2*x3^2 + 2*x2^2*x3*x5 - x2^2*x5^2 + 2*x2*x3^2*x6 - 2*x2*x3*x4*x5 - 2*x2*x3*x5*x6 + 2*x2*x4*x5^2 - x3^2*x6^2 + 2*x3*x4*x5*x6 - x4^2*x5^2,
x13 - x14;
J=sat(J,ideal(x13));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
