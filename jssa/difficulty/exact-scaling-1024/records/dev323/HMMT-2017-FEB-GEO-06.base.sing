LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=2*x1*x16 - x15^2 + 15*x15 - x16^2,
-x15^2 + 15*x15 - x16^2 + 2*x16*x2,
2*x1*x13*x14 - 30*x1*x14 - x13^2*x3 + 30*x13*x3 - x14^2*x3 + 15*x14^2 - 225*x3,
2*x1*x14^2 - x13^2*x4 - 15*x13*x14 + 30*x13*x4 - x14^2*x4 + 225*x14 - 225*x4,
-2*x13*x2*x3 + 2*x13*x4*x5 - 2*x14*x3*x5 + 15*x14*x3 + 2*x2*x3*x5 - 15*x4*x5,
-2*x13*x2*x4 + 2*x13*x4*x6 - 2*x14*x3*x6 + 15*x14*x4 + 2*x2*x3*x6 - 15*x4*x6,
2*x1*x15*x16 - 2*x1*x15*x6 - 2*x1*x16*x5 + 2*x1*x5*x6 - x15^3 + 2*x15^2*x5 - x15^2*x7 + 15*x15^2 - x15*x16^2 - x15*x5^2 + 2*x15*x5*x7 - 30*x15*x5 + x15*x6^2 + 2*x16^2*x5 - x16^2*x7 - 2*x16*x5*x6 + 2*x16*x6*x7 - x5^2*x7 + 15*x5^2 - x6^2*x7,
2*x1*x16^2 - 4*x1*x16*x6 + 2*x1*x6^2 - x15^2*x16 + 2*x15^2*x6 - x15^2*x8 + 15*x15*x16 - 2*x15*x5*x6 + 2*x15*x5*x8 - 15*x15*x6 - x16^3 + 2*x16^2*x6 - x16^2*x8 + x16*x5^2 - 15*x16*x5 - x16*x6^2 + 2*x16*x6*x8 - x5^2*x8 + 15*x5*x6 - x6^2*x8,
x12^2 - x13^2 + 30*x13 - x14^2 - 225,
x12 - 16,
-x13^2 + 2*x13*x15 - x14^2 + 2*x14*x16 - x15^2 - x16^2 + x9^2,
x9 - 12,
x10^2 - x15^2 - x16^2,
x10 - 25,
x11^2 - x15^2 + 30*x15 - x16^2 - 225,
x11 - 20,
2*x13*x16*x17*x4 - 2*x14*x16*x17*x3 + 2*x16*x17*x2*x3 - 15*x16*x17*x4 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
