LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=x12^2 - 3,
16*x12^2 - x15^2 + 1,
16*x12^2 - x16^2 + 16,
x15*x6 + x16*x6 - 5*x16 + 5*x6 - 20,
-20*x12 + x15*x7 + x16*x7 + 5*x7,
x15*x8 + x16*x8 - 5*x16 + 5*x8 - 20,
-20*x12 + x15*x9 + x16*x9 + 5*x9,
2*x10*x12 - 4*x12^2 + 1,
-x11*x12^2 - x11 + x12*x9 + x8,
x12^2*x2 - x12^2*x9 - x12*x8 + x2,
-2*x11*x12 + 2*x12*x8 + x2*x3 - x2*x8,
-2*x11*x12*x4 + 5*x11*x12 + 2*x12*x4*x8 - 5*x12*x8 + 2*x2*x4 - 2*x2*x8,
-2*x11*x12*x5 - 2*x12*x2*x8 + 5*x12*x2 + 2*x12*x5*x8 + 2*x2*x5,
x16 - 8,
4*x1^2 - 3,
400*x12^2 - x13^2,
40*x1 + x13,
9*x12^2*x3^2 + 6*x12^2*x3*x4 + 36*x12^2*x3 + x12^2*x4^2 + 12*x12^2*x4 + 36*x12^2 - 12*x12*x3^2*x5 - 4*x12*x3*x4*x5 - 42*x12*x3*x5 - 6*x12*x4*x5 - 36*x12*x5 - 16*x14^2 + 4*x3^2*x5^2 + 12*x3*x5^2 + 9*x5^2,
x14 - x17;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x12));
print("SAT_FACTOR=2");
J=sat(J,ideal(x14));
print("SAT_FACTOR=3");
J=sat(J,ideal(x15 + x16 + 5));
print("SAT_FACTOR=4");
J=sat(J,ideal(-x11*x12 + x12*x8 + x2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x11^2 - 2*x11*x8 + x2^2 + x8^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(4*x10^2 + 25));
print("SAT_FACTOR=7");
J=sat(J,ideal(x12^2 + 1));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
