LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=2*x1*x6 - 2*x1*x8 - x6^2 - 2*x6*x8 + 5*x8^2,
2*x1*x2 + 2*x1*x6 - 5*x2*x6 - x6^2,
2*x1*x3 + 4*x1*x6 - 5*x3*x6 - 2*x6^2,
x6*x7 - 2*x6*x8 + x7*x8,
x4^2 - x6^2 + 2*x6*x7 - 2*x7^2,
x5^2 - 2*x7^2 + 6*x7*x8 - 5*x8^2,
x4 - 2*x5,
2*x1*x6^2*x9 - 2*x1*x6*x8*x9 - 5*x6^3*x9 + 5*x6^2*x8*x9 - 2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
