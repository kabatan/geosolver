LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17),dp;
short=0;
ideal J=-x1^2 + x1*x3 + 9*x1 - x2^2 + 2*x2*x8 - 9*x3,
-x1^2 + x14^2 - x2^2,
x14 - 11,
x1*x5 - x2*x4,
x3*x4 - 9*x3 - x4^2 + 9*x4 - x5^2 + 2*x5*x8,
-x1^2*x7^2 + 2*x1*x2*x6*x7 - 18*x1*x2*x7 + 18*x1*x7^2 + x15^2 - x2^2*x6^2 + 18*x2^2*x6 - 81*x2^2 - 18*x2*x6*x7 + 162*x2*x7 - 81*x7^2,
x16^2 - x3^2*x7^2 + 18*x3*x7^2 - 81*x7^2,
x1*x16*x6 - 9*x1*x16 + x15*x3^2 - x15*x3*x6 - 9*x15*x3 + 9*x15*x6 + x16*x2*x7 - x16*x6^2 + 9*x16*x6 - x16*x7^2,
-x1^2*x5^2 + 2*x1^2*x5*x7 - x1^2*x7^2 + 2*x1*x2*x4*x5 - 2*x1*x2*x4*x7 - 2*x1*x2*x5*x6 + 2*x1*x2*x6*x7 - 2*x1*x4*x5*x7 + 2*x1*x4*x7^2 + 2*x1*x5^2*x6 - 2*x1*x5*x6*x7 - x2^2*x4^2 + 2*x2^2*x4*x6 - x2^2*x6^2 + 2*x2*x4^2*x7 - 2*x2*x4*x5*x6 - 2*x2*x4*x6*x7 + 2*x2*x5*x6^2 - x4^2*x7^2 + 2*x4*x5*x6*x7 - x5^2*x6^2 + x9^2,
-x1*x15*x4 + x1*x15*x6 + x1*x6*x9 - 9*x1*x9 - x15*x2*x5 + x15*x2*x7 + x15*x4^2 - x15*x4*x6 + x15*x5^2 - x15*x5*x7 + x2*x7*x9 - x6^2*x9 + 9*x6*x9 - x7^2*x9,
x10^2 - x3^2 + 2*x3*x6 - x6^2 - x7^2,
x10 - 1,
x11^2 - x4^2 + 2*x4*x6 - x5^2 + 2*x5*x7 - x6^2 - x7^2,
x11 - 3,
x12^2 - x6^2 + 18*x6 - x7^2 - 81,
-x1^2 + 2*x1*x6 + x13^2 - x2^2 + 2*x2*x7 - x6^2 - x7^2,
x12 - x13*x17;
J=sat(J,ideal(x13));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x3));
print("SAT_FACTOR=3");
J=sat(J,ideal(x3 - 9));
print("SAT_FACTOR=4");
J=sat(J,ideal(x5));
print("SAT_FACTOR=5");
J=sat(J,ideal(x7));
print("SAT_FACTOR=6");
J=sat(J,ideal(x3^2 - 18*x3 + 4*x8^2 + 81));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 - 18*x1 + x2^2 + 81));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 + x3^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x1^2 - 2*x1*x4 + x2^2 - 2*x2*x5 + x4^2 + x5^2));
print("SAT_FACTOR=11");
J=sat(J,ideal(x1^2 - 2*x1*x6 + x2^2 - 2*x2*x7 + x6^2 + x7^2));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1*x5 + x2*x3 - x2*x4 - x3*x5));
print("SAT_FACTOR=13");
J=sat(J,ideal(x1*x5 - x1*x7 - x2*x4 + x2*x6 + x4*x7 - x5*x6));
print("SAT_FACTOR=14");
J=sat(J,ideal(x1*x5 - x2*x4 + 9*x2 - 9*x5));
print("SAT_FACTOR=15");
J=sat(J,ideal(x1*x7 - x2*x6 + 9*x2 - 9*x7));
print("SAT_FACTOR=16");
J=sat(J,ideal(x3^2 - 2*x3*x4 + x4^2 + x5^2));
print("SAT_FACTOR=17");
J=sat(J,ideal(x3^2 - 2*x3*x6 + x6^2 + x7^2));
print("SAT_FACTOR=18");
J=sat(J,ideal(x3*x5 - x3*x7 + x4*x7 - x5*x6));
print("SAT_FACTOR=19");
J=sat(J,ideal(x4^2 - 18*x4 + x5^2 + 81));
print("SAT_FACTOR=20");
J=sat(J,ideal(x4^2 - 2*x4*x6 + x5^2 - 2*x5*x7 + x6^2 + x7^2));
print("SAT_FACTOR=21");
J=sat(J,ideal(x6^2 - 18*x6 + x7^2 + 81));
print("SAT_FACTOR=22");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
