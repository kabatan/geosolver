LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=2*x1*x9 + x10^2 - 2*x10*x8 + 25*x10 + x8^2 - 25*x8 - x9^2,
2*x1*x10*x9 + 50*x1*x9 + x10^3 - x10^2*x2 + 50*x10^2 - 50*x10*x2 - x10*x9^2 + 625*x10 - x2*x9^2 - 625*x2 - 25*x9^2,
2*x1*x9^2 - x10^2*x3 + x10^2*x9 - 50*x10*x3 + 25*x10*x9 - x3*x9^2 - 625*x3 - x9^3,
-x10^2 + 2*x10*x8 - 50*x10 + x4^2 - x8^2 + 50*x8 - x9^2 - 625,
x4 - 27,
-x10^2 + x5^2 - x9^2,
-x10^2 + 2*x10*x8 + x6^2 - x8^2 - x9^2,
x5 - x6,
x2^2 + x3^2 - x7^2,
x7 - 10,
-x10*x3 + x2*x9 - 25*x3,
x11*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
