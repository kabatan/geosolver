LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=2*x1*x3 - 10*x1 + 11*x2*x3 - 11*x2 - 2*x3 + 10,
2*x1*x4 + 11*x2*x4 - 8*x2 - 2*x4,
x5^2 - 20,
x6^2 - 5,
x5 - 2*x6,
-5*x1^2 + 6*x1 - 5*x2^2 + 8*x2 + 5*x7^2 - 5,
x7 - 2,
-x1^2 - x2^2 + x8^2,
x8 - 3,
4*x3^2 + 4*x3*x4 + x4^2 - 25*x9^2,
-x10 + x9;
J=sat(J,ideal(2*x1 + 11*x2 - 2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 - 2*x1 + x2^2 + 1));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
