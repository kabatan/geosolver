LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=-x1^2 - 2*x1*x3 + 2*x1*x4 + 5*x3^2 - 2*x3*x4,
-x1^2 + 2*x1*x4 - 5*x1*x5 + 2*x4*x5,
-2*x1^2 + 4*x1*x4 - 5*x1*x6 + 2*x4*x6,
x1*x2 - 2*x1*x3 + x2*x3,
-x1^2 + 2*x1*x2 - 2*x2^2 + x7^2,
-2*x2^2 + 6*x2*x3 - 5*x3^2 + x8^2,
x7 - 2*x8,
5*x1^2 - 8*x1*x4 + 4*x4^2 - 2*x9^2,
x1^2 - 4*x1*x4 + 2*x1*x5 + 2*x1*x6 - 2*x10^2 + 4*x4^2 - 4*x4*x5 - 4*x4*x6 + 2*x5^2 + 2*x6^2,
-x10*x11 + x9;
J=sat(J,ideal(-3*x1 + 2*x4));
print("SAT_FACTOR=1");
J=sat(J,ideal(-5*x1 + 2*x4));
print("SAT_FACTOR=2");
J=sat(J,ideal(x10));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1 - x3));
print("SAT_FACTOR=5");
J=sat(J,ideal(5*x1^2 - 8*x1*x4 + 4*x4^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(3*x1^2 - 2*x1*x4 - 3*x1*x5 - x1*x6 + 2*x4*x5 + 2*x4*x6));
print("SAT_FACTOR=7");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
