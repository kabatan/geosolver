LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=-x1^2 + 10*x1 - x2^2 + 12*x2 + x3^2 - 61,
x3 - 7,
-x1^2 - x2^2 + x4^2,
x4 - 8,
-x1^2 - x2^2 - 12*x2 + 4*x5^2 - 36,
-x1^2 + 20*x1 - x2^2 + 12*x2 + 4*x6^2 - 136,
x5^2 - x6^2 - x7;
J=sat(J,ideal(x1 - 5));
print("SAT_FACTOR=1");
J=sat(J,ideal(6*x1 - 5*x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 10*x1 + x2^2 + 25));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 10*x1 + x2^2 - 12*x2 + 61));
print("SAT_FACTOR=6");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
