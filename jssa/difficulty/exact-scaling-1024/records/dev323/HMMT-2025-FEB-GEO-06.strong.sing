LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x1^2 - 3*x1 - x2^2 + 2*x2*x3 - 88,
x1^2 + 19*x1 - x2^2 + 2*x2*x4,
-x1^2 + 11*x1 - x2^2 + 2*x2*x5,
-x1^2 - 27*x1 - x2^2 + 2*x2*x6 - 152,
-x1^2 - 16*x1 - x2^2 + x7^2 - 64,
x7 - 8,
-x1^2 - x2^2 + x8^2,
x8 - 4,
x1^2*x3^2 - 2*x1^2*x3*x4 - 2*x1^2*x3*x5 + 2*x1^2*x3*x6 + x1^2*x4^2 + 2*x1^2*x4*x5 - 2*x1^2*x4*x6 + x1^2*x5^2 - 2*x1^2*x5*x6 + x1^2*x6^2 + 8*x1*x3^2 - 16*x1*x3*x4 - 16*x1*x3*x5 + 16*x1*x3*x6 + 8*x1*x4^2 + 16*x1*x4*x5 - 16*x1*x4*x6 + 8*x1*x5^2 - 16*x1*x5*x6 + 8*x1*x6^2 + 16*x3^2 - 32*x3*x4 - 32*x3*x5 + 32*x3*x6 + 16*x4^2 + 32*x4*x5 - 32*x4*x6 + 16*x5^2 - 32*x5*x6 + 16*x6^2 - 4*x9^2,
-x10 + x9;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1^2 + 16*x1 + x2^2 + 64));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 + 38*x1 + x2^2 + 361));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 - 22*x1 + x2^2 + 121));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
