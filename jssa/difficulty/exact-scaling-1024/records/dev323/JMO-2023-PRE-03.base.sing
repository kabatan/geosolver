LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7),dp;
short=0;
ideal J=x1^2 - 3,
x1*x4 - 3*x1 + x5,
x1*x6 - x7,
9*x1^2*x4^2 - 18*x1^2*x4 + 9*x1^2 - 6*x1*x4*x5 + 6*x1*x5 - 4*x2^2 + x5^2,
3*x1^2*x5 + x1*x4 - x1 - 2*x2,
x3^2 - x4^2*x7^2 + 2*x4*x5*x6*x7 - 2*x4*x5*x7 + 2*x4*x7^2 - x5^2*x6^2 + 2*x5^2*x6 - x5^2 - 2*x5*x6*x7 + 2*x5*x7 - x7^2,
x1*x4^2 - x1*x4*x6 - x1*x4 + x1*x5^2 - x1*x5*x7 + x1*x6 - x3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
