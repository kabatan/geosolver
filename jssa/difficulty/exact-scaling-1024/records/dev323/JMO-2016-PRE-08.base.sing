LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18),dp;
short=0;
ideal J=-x15^2 + 2*x15*x16 - x16^2 - x17^2 + x9^2,
x13^2 - x16^2 - x17^2,
x14^2 - x15^2,
-x13*x15 + x13*x3 - x14*x16 + x14*x3 + x3*x9,
x13*x4 - x14*x17 + x14*x4 + x4*x9,
-x13*x15 + x13*x5 - x14*x16 + x14*x5 + x5*x9,
x13*x6 - x14*x17 + x14*x6 + x6*x9,
x15^2*x5 - x15^2*x7 - 2*x15*x16*x5 + 2*x15*x16*x7 + x15*x17^2 - x15*x17*x6 + x16^2*x5 - x16^2*x7 + x16*x17*x6 - x17^2*x7,
-x15^2*x17 + x15^2*x8 + x15*x16*x17 - 2*x15*x16*x8 + x15*x17*x5 + x16^2*x8 - x16*x17*x5 - x17^2*x6 + x17^2*x8,
x1*x8 - x2*x7,
x1^2*x13^2 + 2*x1^2*x13*x14 + 2*x1^2*x13*x9 + x1^2*x14^2 + 2*x1^2*x14*x9 + x1^2*x9^2 - 2*x1*x13^2*x3 - 4*x1*x13*x14*x3 - 4*x1*x13*x3*x9 - 2*x1*x14^2*x3 - 4*x1*x14*x3*x9 - 2*x1*x3*x9^2 + x13^2*x2^2 - 2*x13^2*x2*x4 + x13^2*x3^2 + x13^2*x4^2 + 2*x13*x14*x2^2 - 4*x13*x14*x2*x4 + 2*x13*x14*x3^2 + 2*x13*x14*x4^2 + 2*x13*x2^2*x9 - 4*x13*x2*x4*x9 + 2*x13*x3^2*x9 + 2*x13*x4^2*x9 + x14^2*x2^2 - 2*x14^2*x2*x4 + x14^2*x3^2 + x14^2*x4^2 + 2*x14*x2^2*x9 - 4*x14*x2*x4*x9 + 2*x14*x3^2*x9 + 2*x14*x4^2*x9 - x15^2*x17^2 + x2^2*x9^2 - 2*x2*x4*x9^2 + x3^2*x9^2 + x4^2*x9^2,
x1^2 - x10^2 + x2^2,
x1^2 - 2*x1*x7 - x11^2 + x2^2 - 2*x2*x8 + x7^2 + x8^2,
3*x10 - x11,
x12^2*x13^2 + 2*x12^2*x13*x14 + 2*x12^2*x13*x9 + x12^2*x14^2 + 2*x12^2*x14*x9 + x12^2*x9^2 - x15^2*x17^2,
x12 - 1,
-10*x10 + x9,
x13*x18 + x14*x18 + x18*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
