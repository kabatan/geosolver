LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9),dp;
short=0;
ideal J=x1*x8 - x5*x8 + x6*x7 - x7,
x2^2 - x5^2 - x6^2,
x2 - 1,
x3^2 - x7^2 - x8^2,
x3 - 1,
x5*x7 + x6*x8,
x1^2*x6^2 - 2*x1^2*x6 + x1^2 - 2*x1*x5*x6 + 2*x1*x5 - 4*x4^2 + x5^2,
2*x4 - 1,
x8*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
