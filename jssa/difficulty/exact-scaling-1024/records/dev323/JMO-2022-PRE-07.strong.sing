LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=-x1^2 - x2^2 + 2*x2*x3 - x3^2 + x5^2,
x5 - 5,
-x1^2 + 2*x1*x4 - x2^2 - x4^2 + x6^2,
x6 - 3,
x1^2 - x1*x4 + x2^2 - x2*x3,
x1 + x2 - 7,
-x1^2 + 14*x1 - x2^2 + x7^2 - 49,
x7 - x8;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 7));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2 - 7));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3));
print("SAT_FACTOR=5");
J=sat(J,ideal(x3 - 7));
print("SAT_FACTOR=6");
J=sat(J,ideal(x4));
print("SAT_FACTOR=7");
J=sat(J,ideal(x4 - 7));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1^2 + x2^2 - 2*x2*x3 + x3^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x1^2 - 2*x1*x4 + x2^2 + x4^2));
print("SAT_FACTOR=10");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
