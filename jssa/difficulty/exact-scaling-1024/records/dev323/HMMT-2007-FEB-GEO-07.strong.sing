LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x4^2 - 3,
49*x4^2 - 4*x5^2 + 49,
x5 - 7,
4*x3^2 - 3,
2401*x4^2 - 4*x6^2,
49*x3 + x6,
-x1^2 + 14*x1 - x2^2 + x7^2 - 49,
x7 - 5,
4*x1^2 - 28*x1 + 4*x2^2 - 28*x2*x4 + 49*x4^2 - 4*x8^2 + 49,
x8 - 3,
-x1^2 - x2^2 + x9^2,
-x10 + x9;
J=sat(J,ideal(x4));
print("SAT_FACTOR=1");
J=sat(J,ideal(x2));
print("SAT_FACTOR=2");
J=sat(J,ideal(x4^2 + 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(4*x1^2 - 28*x1 + 4*x2^2 - 28*x2*x4 + 49*x4^2 + 49));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1*x4 + x2 - 7*x4));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1*x4 - x2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1^2 - 14*x1 + x2^2 + 49));
print("SAT_FACTOR=8");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
