LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4),dp;
short=0;
ideal J=4*x1^2*x2^2 - x1^2 - 8*x1*x2^2 - 2*x1 + 8*x2^2 - 1,
2*x2 - 1,
-x1^2 + 2*x1 + 4*x3^2 - 1,
x3 - x4;
J=sat(J,ideal(x1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x1 - 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1^2 - 2*x1 + 2));
print("SAT_FACTOR=3");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
