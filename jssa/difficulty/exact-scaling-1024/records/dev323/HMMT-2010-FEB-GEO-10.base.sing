LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x11^2 - 3,
16*x1^4 - 16*x1^2 + 1,
x1^2 + x2^2 - 1,
x1*x5 + x11*x2*x5 - x11*x2,
x1*x6 + x11*x2*x6 - x2,
x1*x7 + x11*x2*x7 - 2*x2,
x1 + x11*x2 - 4*x2*x8,
x1*x9 + x11*x2*x9 + x11*x2,
x1*x10 + x10*x11*x2 - x2,
x1*x11^2 - x1 + x11^3*x2 - x11*x2 + 16*x2*x3 - 16*x2,
x1*x11^2 + 2*x1*x11 + x1 + x11^3*x2 + 2*x11^2*x2 + x11*x2 - 16*x2*x4,
x1^2*x5^2 + x1^2*x6^2 - 2*x1^2*x6*x7 + x1^2*x7^2 + 2*x1*x11*x2*x5^2 + 2*x1*x11*x2*x6^2 - 4*x1*x11*x2*x6*x7 + 2*x1*x11*x2*x7^2 + x11^2*x2^2*x5^2 + x11^2*x2^2*x6^2 - 2*x11^2*x2^2*x6*x7 + x11^2*x2^2*x7^2 - 4*x2^2,
x1^2 + 2*x1*x11*x2 + x11^2*x2^2 - 16*x2^2*x5^2 + 32*x2^2*x5 - 16*x2^2*x6^2 + 32*x2^2*x6*x8 - 16*x2^2*x8^2 - 16*x2^2,
x1*x12*x2 + x11*x12*x2^2 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
