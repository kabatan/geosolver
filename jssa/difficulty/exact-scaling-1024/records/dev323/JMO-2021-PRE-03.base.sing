LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
short=0;
ideal J=x1*x9^2 + 49*x1 - 49*x10 + 7*x11*x9 - 14*x9^2,
7*x10*x9 - x11*x9^2 + x2*x9^2 + 49*x2 - 98*x9,
-49*x10 - 7*x11*x9 + x3*x9^2 + 49*x3,
-7*x10*x9 - x11*x9^2 + x4*x9^2 + 49*x4,
-x10^2 + x5^2,
x5 - 9,
-x10^2 + 28*x10 + x6^2 - 196,
x6 - 5,
x1^2 - 2*x1*x10 + x10^2 + x11^2 - 2*x11*x2 + x2^2 - x7^2,
x7 - 2,
x10^2 - 2*x10*x3 + x11^2 - 2*x11*x4 + x3^2 + x4^2 - x8^2,
x8 - 5;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
