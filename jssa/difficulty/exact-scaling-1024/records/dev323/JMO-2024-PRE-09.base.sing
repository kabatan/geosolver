LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22),dp;
short=0;
ideal J=2*x1*x17 - x16^2 + 7*x16 - x17^2,
x12^2 - x18^2 - x19^2,
x13^2 - x16^2 - x17^2,
x14^2 - x16^2 + 2*x16*x18 - x17^2 + 2*x17*x19 - x18^2 - x19^2,
-x12*x16 + x12*x2 - x13*x18 + x13*x2 + x14*x2,
