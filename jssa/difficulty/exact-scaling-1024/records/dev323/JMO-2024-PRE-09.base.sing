x16*x19*x5 - x16*x3*x5 + x17*x18*x3 - x17*x18*x5 - x17*x19*x2 + 7*x17*x19 + x17*x2*x5 - 7*x17*x3 - 7*x19*x5 + 7*x3*x5,
x15^2 - x16^2 + 14*x16 - x17^2 - 49,
x15 - 18,
x4^2 - 14*x4 + x5^2 - x6^2 + 49,
x6 - 5,
-x18^2 + 2*x18*x20 - x19^2 + 2*x19*x21 - x20^2 - x21^2 + x7^2,
x20^2 - 2*x20*x4 + x21^2 - 2*x21*x5 + x4^2 + x5^2 - x8^2,
x18^2 - 2*x18*x4 + x19^2 - 2*x19*x5 + x4^2 + x5^2 - x9^2,
x7 + x8 - x9,
x18*x21 - x18*x5 - x19*x20 + x19*x4 + x20*x5 - x21*x4,
-x16*x5 + x17*x4 - 7*x17 + 7*x5,
2*x1*x19 - x18^2 + 7*x18 - x19^2,
-x10^2 + x18^2*x5^2 - 2*x18*x19*x4*x5 + x19^2*x4^2,
x11^2 - x16^2*x19^2 + 2*x16^2*x19*x21 - x16^2*x21^2 + 2*x16*x17*x18*x19 - 2*x16*x17*x18*x21 - 2*x16*x17*x19*x20 + 2*x16*x17*x20*x21 - 2*x16*x18*x19*x21 + 2*x16*x18*x21^2 + 2*x16*x19^2*x20 - 2*x16*x19*x20*x21 - x17^2*x18^2 + 2*x17^2*x18*x20 - x17^2*x20^2 + 2*x17*x18^2*x21 - 2*x17*x18*x19*x20 - 2*x17*x18*x20*x21 + 2*x17*x19*x20^2 - x18^2*x21^2 + 2*x18*x19*x20*x21 - x19^2*x20^2,
-x10*x16^2 + x10*x16*x18 + x10*x16*x20 - x10*x17^2 + x10*x17*x19 + x10*x17*x21 - x10*x18*x20 - x10*x19*x21 - x11*x18*x4 - x11*x19*x5 + x11*x4^2 + x11*x5^2,
x8 - 3,
x12*x16*x17*x19*x22 - x12*x16*x17*x22*x3 - x12*x17^2*x18*x22 + x12*x17^2*x2*x22 - 7*x12*x17*x19*x22 + 7*x12*x17*x22*x3 + x13*x16*x17*x19*x22 - x13*x16*x17*x22*x3 - x13*x17^2*x18*x22 + x13*x17^2*x2*x22 - 7*x13*x17*x19*x22 + 7*x13*x17*x22*x3 + x14*x16*x17*x19*x22 - x14*x16*x17*x22*x3 - x14*x17^2*x18*x22 + x14*x17^2*x2*x22 - 7*x14*x17*x19*x22 + 7*x14*x17*x22*x3 - 1;
ideal G=std(J);
