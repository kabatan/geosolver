LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21),dp;
short=0;
ideal J=-x1^2 + 10*x1 - x2^2 + 2*x2*x8,
-x3^2*x6 + x3^2*x9 - x3*x4*x7 + x4^2*x9,
x10*x3^2 + x10*x4^2 - x3*x4*x6 - x4^2*x7,
x1^2*x11 - x1^2*x6 - 20*x1*x11 - x1*x2*x7 + 20*x1*x6 + x11*x2^2 + 100*x11 - 10*x2^2 + 10*x2*x7 - 100*x6,
x1^2*x12 - 20*x1*x12 - x1*x2*x6 + 10*x1*x2 + x12*x2^2 + 100*x12 - x2^2*x7 + 10*x2*x6 - 100*x2,
-x1^2 + 20*x1 + x17^2 - x2^2 - 100,
x17 - 8,
-x1^2 + 2*x1*x3 + x18^2 - x2^2 + 2*x2*x4 - x3^2 - x4^2,
x18 - 25,
x19^2 - x3^2 - x4^2,
x19 - 12,
-x20^2 + x3^2 - 10*x3 + x4^2 - 2*x4*x8 + x8^2 + 25,
-x13^2 + x8^2 + 25,
x13 - x20,
x10^2 - 2*x10*x7 - x14^2 + x6^2 - 2*x6*x9 + x7^2 + x9^2,
x14 - x5,
x15^2 - x7^2,
x15 - x5,
x11^2 - 2*x11*x6 + x12^2 - 2*x12*x7 - x16^2 + x6^2 + x7^2,
x16 - x5,
x21 - x5;
J=sat(J,ideal(x2));
print("SAT_FACTOR=1");
J=sat(J,ideal(x4));
print("SAT_FACTOR=2");
J=sat(J,ideal(x5));
print("SAT_FACTOR=3");
J=sat(J,ideal(x8^2 + 25));
print("SAT_FACTOR=4");
J=sat(J,ideal(x1^2 + x2^2));
print("SAT_FACTOR=5");
J=sat(J,ideal(x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 20*x1 + x2^2 + 100));
print("SAT_FACTOR=7");
J=sat(J,ideal(x1*x4 - x2*x3));
print("SAT_FACTOR=8");
J=sat(J,ideal(x1*x4 - x2*x3 + 10*x2 - 10*x4));
print("SAT_FACTOR=9");
J=sat(J,ideal(x3^2 + x4^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(x3^2 - 20*x3 + x4^2 + 100));
print("SAT_FACTOR=11");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
