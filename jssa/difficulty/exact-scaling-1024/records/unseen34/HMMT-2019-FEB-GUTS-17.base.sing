LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22),dp;
short=0;
ideal J=x1^2 - x12^2 - x13^2,
x1 - 3,
-x12^2 + 8*x12 - x13^2 + x4^2 - 16,
x4 - 5,
-x14^2 + 8*x14*x17 - x15^2 - 16*x17^2 + x5^2,
-x16 + x5,
-x14^2 + 8*x14*x18 - x15^2 - 16*x18^2 + x6^2,
-x16 + x6,
-16*x17^2 + 32*x17*x18 - 16*x18^2 + x7^2,
-x16 + x7,
-x12^2*x19^2 + 2*x12*x14*x19 + 8*x12*x19^2 - 8*x12*x19 - x13^2*x19^2 + 2*x13*x15*x19 - x14^2 - 8*x14*x19 + 8*x14 - x15^2 - 16*x19^2 + 32*x19 + x8^2 - 16,
-x16 + x8,
-x12^2*x20^2 + 2*x12*x14*x20 + 8*x12*x20^2 - 8*x12*x20 - x13^2*x20^2 + 2*x13*x15*x20 - x14^2 - 8*x14*x20 + 8*x14 - x15^2 - 16*x20^2 + 32*x20 + x9^2 - 16,
-x16 + x9,
x10^2 - x12^2*x19^2 + 2*x12^2*x19*x20 - x12^2*x20^2 + 8*x12*x19^2 - 16*x12*x19*x20 + 8*x12*x20^2 - x13^2*x19^2 + 2*x13^2*x19*x20 - x13^2*x20^2 - 16*x19^2 + 32*x19*x20 - 16*x20^2,
x10 - x16,
x11^2 - x12^2*x21^2 + 2*x12^2*x21 - x12^2 - 2*x12*x14*x21 + 2*x12*x14 - x13^2*x21^2 + 2*x13^2*x21 - x13^2 - 2*x13*x15*x21 + 2*x13*x15 - x14^2 - x15^2,
x11 - x16,
-x12^2*x22^2 + 2*x12^2*x22 - x12^2 - 2*x12*x14*x22 + 2*x12*x14 - x13^2*x22^2 + 2*x13^2*x22 - x13^2 - 2*x13*x15*x22 + 2*x13*x15 - x14^2 - x15^2 + x2^2,
-x16 + x2,
-x12^2*x21^2 + 2*x12^2*x21*x22 - x12^2*x22^2 - x13^2*x21^2 + 2*x13^2*x21*x22 - x13^2*x22^2 + x3^2,
-x16 + x3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
