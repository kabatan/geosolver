LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x9^2 - 5,
4*x1^2 + 2*x1 - 1,
x1^2 + x2^2 - 1,
4*x3^2 + 2*x3 - 1,
x3^2 + x4^2 - 1,
4*x5^2 + 2*x5 - 1,
x5^2 + x6^2 - 1,
4*x7^2 + 2*x7 - 1,
x7^2 + x8^2 - 1,
x10^2 - 3;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
