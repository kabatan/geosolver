LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21),dp;
short=0;
ideal J=x14^2 - x2^2 - x3^2,
x14*x7 + 2*x2,
x14*x8 + 2*x3,
-x14*x2 + x14*x9 - 16*x2,
x10*x14 - x14*x3 - 16*x3,
-x1^2 + 2*x1*x2 - x2^2 + x20^2 - x3^2,
-x1*x20 - 4*x1 + x11*x20 + 4*x2,
x12*x20 + 4*x3,
12*x1 + x13*x20 - x2*x20 - 12*x2,
-x20*x3 + x20*x4 - 12*x3,
x11^2*x8 - 2*x11*x5*x8 + x12^2*x8 + 2*x12*x5*x7 + 6*x12*x5 - x12*x7^2 - x12*x8^2 + 9*x12 - 6*x5*x8 - 9*x8,
-x11^2*x7 - 3*x11^2 - 2*x11*x6*x8 + x11*x7^2 + x11*x8^2 - 9*x11 - x12^2*x7 - 3*x12^2 + 2*x12*x6*x7 + 6*x12*x6 - 6*x6*x8 + 3*x7^2 + 9*x7 + 3*x8^2,
x1^2 - 2*x1*x5 + 20*x1 - x15^2 + x5^2 - 20*x5 + x6^2 + 100,
-x16^2 + x5^2 + 6*x5 + x6^2 + 9,
x15 - x16,
x10^2 - 2*x10*x6 - x17^2 + x5^2 - 2*x5*x9 + x6^2 + x9^2,
x16 - x17,
x13^2 - 2*x13*x5 - x18^2 + x4^2 - 2*x4*x6 + x5^2 + x6^2,
x16 - x18,
-x1^2 + x19^2,
x14 + x19 + x20 - x21;
J=sat(J,ideal(x14));
print("SAT_FACTOR=1");
J=sat(J,ideal(x20));
print("SAT_FACTOR=2");
J=sat(J,ideal(x1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x1 + 13));
print("SAT_FACTOR=4");
J=sat(J,ideal(x3));
print("SAT_FACTOR=5");
J=sat(J,ideal(x13^2 + 6*x13 + x4^2 + 9));
print("SAT_FACTOR=6");
J=sat(J,ideal(x1^2 - 2*x1*x13 + 20*x1 + x13^2 - 20*x13 + x4^2 + 100));
print("SAT_FACTOR=7");
J=sat(J,ideal(x13^2 - 2*x13*x7 + x4^2 - 2*x4*x8 + x7^2 + x8^2));
print("SAT_FACTOR=8");
J=sat(J,ideal(x10^2 - 2*x10*x4 + x13^2 - 2*x13*x9 + x4^2 + x9^2));
print("SAT_FACTOR=9");
J=sat(J,ideal(x11^2 - 2*x11*x13 + x12^2 - 2*x12*x4 + x13^2 + x4^2));
print("SAT_FACTOR=10");
J=sat(J,ideal(-x13*x8 + x4*x7 + 3*x4 - 3*x8));
print("SAT_FACTOR=11");
J=sat(J,ideal(-x10*x13 - 3*x10 + x4*x9 + 3*x4));
print("SAT_FACTOR=12");
J=sat(J,ideal(x1*x10 - x1*x4 - x10*x13 + 10*x10 + x4*x9 - 10*x4));
print("SAT_FACTOR=13");
J=sat(J,ideal(x5^2 + 6*x5 + x6^2 + 9));
print("SAT_FACTOR=14");
J=sat(J,ideal(x7^2 + 6*x7 + x8^2 + 9));
print("SAT_FACTOR=15");
J=sat(J,ideal(x10^2 - 2*x10*x8 + x7^2 - 2*x7*x9 + x8^2 + x9^2));
print("SAT_FACTOR=16");
J=sat(J,ideal(x11^2 - 2*x11*x7 + x12^2 - 2*x12*x8 + x7^2 + x8^2));
print("SAT_FACTOR=17");
J=sat(J,ideal(x1^2 - 2*x1*x7 + 20*x1 + x7^2 - 20*x7 + x8^2 + 100));
print("SAT_FACTOR=18");
J=sat(J,ideal(-x1*x12 + x1*x8 - x11*x8 + x12*x7 - 10*x12 + 10*x8));
print("SAT_FACTOR=19");
J=sat(J,ideal(-x11*x8 + x12*x7 + 3*x12 - 3*x8));
print("SAT_FACTOR=20");
J=sat(J,ideal(x10^2 + x9^2 + 6*x9 + 9));
print("SAT_FACTOR=21");
J=sat(J,ideal(x10^2 - 2*x10*x12 + x11^2 - 2*x11*x9 + x12^2 + x9^2));
print("SAT_FACTOR=22");
J=sat(J,ideal(x1^2 - 2*x1*x9 + 20*x1 + x10^2 + x9^2 - 20*x9 + 100));
print("SAT_FACTOR=23");
J=sat(J,ideal(x1*x10 - x1*x12 - x10*x11 + 10*x10 + x12*x9 - 10*x12));
print("SAT_FACTOR=24");
J=sat(J,ideal(x11^2 + 6*x11 + x12^2 + 9));
print("SAT_FACTOR=25");
J=sat(J,ideal(x1^2 - 2*x1*x11 + 20*x1 + x11^2 - 20*x11 + x12^2 + 100));
print("SAT_FACTOR=26");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
