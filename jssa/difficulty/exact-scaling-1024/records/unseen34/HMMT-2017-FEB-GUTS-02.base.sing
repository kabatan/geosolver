LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20),dp;
short=0;
ideal J=x11^2 - x18^2 - x19^2,
x11*x4 + 2*x18,
x11*x5 + 2*x19,
-x11*x18 + x11*x6 - 16*x18,
-x11*x19 + x11*x7 - 16*x19,
x16^2 - x17^2 + 2*x17*x18 - x18^2 - x19^2,
-x16*x17 + x16*x8 - 4*x17 + 4*x18,
x16*x9 + 4*x19,
x10*x16 - x16*x18 + 12*x17 - 12*x18,
x1*x16 - x16*x19 - 12*x19,
2*x2*x4*x9 - 2*x2*x5*x8 - 6*x2*x5 + 6*x2*x9 - x4^2*x9 - x5^2*x9 + x5*x8^2 + x5*x9^2 - 9*x5 + 9*x9,
2*x3*x4*x9 - 2*x3*x5*x8 - 6*x3*x5 + 6*x3*x9 + x4^2*x8 + 3*x4^2 - x4*x8^2 - x4*x9^2 + 9*x4 + x5^2*x8 + 3*x5^2 - 3*x8^2 - 9*x8 - 3*x9^2,
-x12^2 + x17^2 - 2*x17*x2 + 20*x17 + x2^2 - 20*x2 + x3^2 + 100,
-x13^2 + x2^2 + 6*x2 + x3^2 + 9,
x12 - x13,
-x14^2 + x2^2 - 2*x2*x6 + x3^2 - 2*x3*x7 + x6^2 + x7^2,
x13 - x14,
x1^2 - 2*x1*x3 + x10^2 - 2*x10*x2 - x15^2 + x2^2 + x3^2,
x13 - x15,
x11*x16*x20*x4*x9 - x11*x16*x20*x5*x8 - 3*x11*x16*x20*x5 + 3*x11*x16*x20*x9 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
