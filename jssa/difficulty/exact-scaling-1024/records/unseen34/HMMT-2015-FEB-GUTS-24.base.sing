LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21),dp;
short=0;
ideal J=2*x1*x15 - x14^2 + 10*x14 - x15^2,
-x16^2*x19 + x16^2*x2 - x16*x17*x20 + x17^2*x2,
x16^2*x3 - x16*x17*x19 - x17^2*x20 + x17^2*x3,
-x14^2*x19 + x14^2*x4 - x14*x15*x20 + 20*x14*x19 - 20*x14*x4 + x15^2*x4 - 10*x15^2 + 10*x15*x20 - 100*x19 + 100*x4,
x14^2*x5 - x14*x15*x19 + 10*x14*x15 - 20*x14*x5 - x15^2*x20 + x15^2*x5 + 10*x15*x19 - 100*x15 + 100*x5,
x10^2 - x14^2 + 20*x14 - x15^2 - 100,
x10 - 8,
x11^2 - x14^2 + 2*x14*x16 - x15^2 + 2*x15*x17 - x16^2 - x17^2,
x11 - 25,
x12^2 - x16^2 - x17^2,
x12 - 12,
x1^2 - 2*x1*x17 - x13^2 + x16^2 - 10*x16 + x17^2 + 25,
x1^2 - x6^2 + 25,
-x13 + x6,
x19^2 - 2*x19*x2 + x2^2 + x20^2 - 2*x20*x3 + x3^2 - x7^2,
-x18 + x7,
-x20^2 + x8^2,
-x18 + x8,
x19^2 - 2*x19*x4 + x20^2 - 2*x20*x5 + x4^2 + x5^2 - x9^2,
-x18 + x9,
x15*x21 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
