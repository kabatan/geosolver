LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=x1^2 - x3^2 - x4^2,
x1 - 5,
x2^2 - x3^2 + 10*x3 - x4^2 - 25,
x2 - 5,
x3*x5 + x3*x6 - 2*x3 - 5*x5 + 2,
x4*x5 + x4*x6 - 2*x4;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
