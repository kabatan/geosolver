LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=64*x3^6 - 96*x3^4 + 36*x3^2 - 3,
x3^2 + x4^2 - 1,
-x15^2 + x8^2,
x14*x4 + x3*x8,
-x10^2*x13^2 - 2*x10^2*x13*x15 - x10^2*x15^2 + 2*x10*x11*x12*x13 + 2*x10*x11*x12*x15 + 2*x10*x11*x13*x14 - 2*x10*x11*x13 + 2*x10*x11*x14*x15 - 2*x10*x11*x15 - x11^2*x12^2 - 2*x11^2*x12*x14 + 2*x11^2*x12 - x11^2*x14^2 + 2*x11^2*x14 - x11^2 + x9^2,
x10*x12*x4 + x10*x14*x4 - x10*x4 + x11*x13*x4 + x11*x15*x4 + x3*x9,
x5^2 - 3,
16*x1^4 - 16*x1^2 + 1,
x1^2 + x2^2 - 1,
-x12^2*x15^2 + 2*x12*x13*x14*x15 + 2*x12*x15^2 - x13^2*x14^2 - 2*x13*x14*x15 - x15^2 + x6^2,
x1*x6 - x12*x14*x2 - x13*x15*x2 + x14*x2,
-x10^2*x15^2 + 2*x10*x11*x14*x15 - 2*x10*x11*x15 + 2*x10*x12*x15^2 - 2*x10*x13*x14*x15 + 2*x10*x13*x15 - x11^2*x14^2 + 2*x11^2*x14 - x11^2 - 2*x11*x12*x14*x15 + 2*x11*x12*x15 + 2*x11*x13*x14^2 - 4*x11*x13*x14 + 2*x11*x13 - x12^2*x15^2 + 2*x12*x13*x14*x15 - 2*x12*x13*x15 - x13^2*x14^2 + 2*x13^2*x14 - x13^2 + x7^2,
x1*x7 + x10*x14*x2 - x10*x2 + x11*x15*x2 - x12*x14*x2 + x12*x2 - x13*x15*x2;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
