LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13),dp;
short=0;
ideal J=x1*x11^2 + x1*x12^2 - 13*x11^2,
x11^2*x2 - 13*x11*x12 + x12^2*x2,
x1^2 - x1*x11 + x2^2 - 2*x2*x3,
2*x1^2*x3 - x1*x11*x3 - 2*x1*x3*x4 + x11*x2*x4 + 2*x2^2*x3 - 2*x2*x3^2,
2*x1^2*x11 - x1*x11^2 + 4*x1*x3*x5 + 2*x11*x2^2 - 2*x11*x2*x3 - 2*x11*x2*x5,
2*x1^2*x3 - x1*x11*x3 - 2*x1*x3*x6 + x11^2*x2 - x11^2*x3 - x11*x2*x6 + 2*x11*x3*x6 + 2*x2^2*x3 - 2*x2*x3^2,
2*x1^2*x11 - 3*x1*x11^2 - 4*x1*x3*x7 + x11^3 + 2*x11*x2^2 - 2*x11*x2*x3 - 2*x11*x2*x7 + 4*x11*x3*x7,
x11^2 + 4*x3*x8,
x10^2 - x11^2 + 26*x11 - x12^2 - 169,
x10 - 14,
-x11^2 - x12^2 + x9^2,
x9 - 15,
4*x1^2*x11*x13*x2*x3^3 - 4*x1*x11^2*x13*x2*x3^3 - x11^3*x13*x2^3*x3 + 2*x11^3*x13*x2^2*x3^2 - 4;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
