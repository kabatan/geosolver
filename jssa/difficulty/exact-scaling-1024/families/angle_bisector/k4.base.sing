LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x5^2 - 2,
x1*x5 + x1 - 1,
x1^2 - x6^2 + 1,
x1 - x2*x6 - x2,
x2^2 - x7^2 + 1,
x2 - x3*x7 - x3,
x3^2 - x8^2 + 1,
x3 - x4*x8 - x4,
x4 - x9,
x10*x5*x6*x7*x8 + x10*x5*x6*x7 + x10*x5*x6*x8 + x10*x5*x6 + x10*x5*x7*x8 + x10*x5*x7 + x10*x5*x8 + x10*x5 + x10*x6*x7*x8 + x10*x6*x7 + x10*x6*x8 + x10*x6 + x10*x7*x8 + x10*x7 + x10*x8 + x10 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
