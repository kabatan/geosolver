LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x6^2 - 2,
x2*x6 + x2 - 1,
x2^2 - x7^2 + 1,
x2 - x3*x7 - x3,
x3^2 - x8^2 + 1,
x3 - x4*x8 - x4,
x4^2 - x9^2 + 1,
x4 - x5*x9 - x5,
-x10^2 + x5^2 + 1,
x1*x10 + x1 - x5,
x1 - x11,
x10*x12*x6*x7*x8*x9 + x10*x12*x6*x7*x8 + x10*x12*x6*x7*x9 + x10*x12*x6*x7 + x10*x12*x6*x8*x9 + x10*x12*x6*x8 + x10*x12*x6*x9 + x10*x12*x6 + x10*x12*x7*x8*x9 + x10*x12*x7*x8 + x10*x12*x7*x9 + x10*x12*x7 + x10*x12*x8*x9 + x10*x12*x8 + x10*x12*x9 + x10*x12 + x12*x6*x7*x8*x9 + x12*x6*x7*x8 + x12*x6*x7*x9 + x12*x6*x7 + x12*x6*x8*x9 + x12*x6*x8 + x12*x6*x9 + x12*x6 + x12*x7*x8*x9 + x12*x7*x8 + x12*x7*x9 + x12*x7 + x12*x8*x9 + x12*x8 + x12*x9 + x12 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
