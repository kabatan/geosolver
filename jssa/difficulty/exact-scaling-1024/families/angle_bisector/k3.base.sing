LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8),dp;
short=0;
ideal J=x4^2 - 2,
x1*x4 + x1 - 1,
x1^2 - x5^2 + 1,
x1 - x2*x5 - x2,
x2^2 - x6^2 + 1,
x2 - x3*x6 - x3,
x3 - x7,
x4*x5*x6*x8 + x4*x5*x8 + x4*x6*x8 + x4*x8 + x5*x6*x8 + x5*x8 + x6*x8 + x8 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
