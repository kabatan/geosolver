LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4),dp;
short=0;
ideal J=x3^2 - 2,
x2*x3 + x2 - 1,
-x1 + x2,
-x1 + x4;
J=sat(J,ideal(x3 + 1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x3^2 + 2*x3 + 2));
print("SAT_FACTOR=2");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
ideal E=eliminate(G,x1*x2*x3);
print("ELIM_BEGIN");
for(int j=1;j<=size(E);j++){print("POLY_BEGIN");print(E[j]);print("POLY_END");}
print("ELIM_END");
quit;
