LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal J=x7^2 - 2,
x3*x7 + x3 - 1,
x3^2 - x9^2 + 1,
x3 - x4*x9 - x4,
-x10^2 + x4^2 + 1,
-x10*x5 + x4 - x5,
-x11^2 + x5^2 + 1,
-x11*x6 + x5 - x6,
-x12^2 + x6^2 + 1,
x1*x12 + x1 - x6,
x1^2 - x8^2 + 1,
x1 - x2*x8 - x2,
-x13 + x2,
x10*x11*x12*x14*x7*x8*x9 + x10*x11*x12*x14*x7*x8 + x10*x11*x12*x14*x7*x9 + x10*x11*x12*x14*x7 + x10*x11*x12*x14*x8*x9 + x10*x11*x12*x14*x8 + x10*x11*x12*x14*x9 + x10*x11*x12*x14 + x10*x11*x14*x7*x8*x9 + x10*x11*x14*x7*x8 + x10*x11*x14*x7*x9 + x10*x11*x14*x7 + x10*x11*x14*x8*x9 + x10*x11*x14*x8 + x10*x11*x14*x9 + x10*x11*x14 + x10*x12*x14*x7*x8*x9 + x10*x12*x14*x7*x8 + x10*x12*x14*x7*x9 + x10*x12*x14*x7 + x10*x12*x14*x8*x9 + x10*x12*x14*x8 + x10*x12*x14*x9 + x10*x12*x14 + x10*x14*x7*x8*x9 + x10*x14*x7*x8 + x10*x14*x7*x9 + x10*x14*x7 + x10*x14*x8*x9 + x10*x14*x8 + x10*x14*x9 + x10*x14 + x11*x12*x14*x7*x8*x9 + x11*x12*x14*x7*x8 + x11*x12*x14*x7*x9 + x11*x12*x14*x7 + x11*x12*x14*x8*x9 + x11*x12*x14*x8 + x11*x12*x14*x9 + x11*x12*x14 + x11*x14*x7*x8*x9 + x11*x14*x7*x8 + x11*x14*x7*x9 + x11*x14*x7 + x11*x14*x8*x9 + x11*x14*x8 + x11*x14*x9 + x11*x14 + x12*x14*x7*x8*x9 + x12*x14*x7*x8 + x12*x14*x7*x9 + x12*x14*x7 + x12*x14*x8*x9 + x12*x14*x8 + x12*x14*x9 + x12*x14 + x14*x7*x8*x9 + x14*x7*x8 + x14*x7*x9 + x14*x7 + x14*x8*x9 + x14*x8 + x14*x9 + x14 - 1;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
