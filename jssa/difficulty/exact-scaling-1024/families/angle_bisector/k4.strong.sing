LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal J=x6^2 - 2,
x2*x6 + x2 - 1,
x2^2 - x7^2 + 1,
x2 - x3*x7 - x3,
x3^2 - x8^2 + 1,
x3 - x4*x8 - x4,
x4^2 - x9^2 + 1,
x4 - x5*x9 - x5,
-x1 + x5,
-x1 + x10;
J=sat(J,ideal(x6 + 1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x7 + 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x8 + 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x9 + 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x2^2 + 1));
print("SAT_FACTOR=5");
J=sat(J,ideal(x2^2 + x7^2 + 2*x7 + 1));
print("SAT_FACTOR=6");
J=sat(J,ideal(x3^2 + 1));
print("SAT_FACTOR=7");
J=sat(J,ideal(x3^2 + x8^2 + 2*x8 + 1));
print("SAT_FACTOR=8");
J=sat(J,ideal(x4^2 + 1));
print("SAT_FACTOR=9");
J=sat(J,ideal(x4^2 + x9^2 + 2*x9 + 1));
print("SAT_FACTOR=10");
J=sat(J,ideal(x6^2 + 2*x6 + 2));
print("SAT_FACTOR=11");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
ideal E=eliminate(G,x1*x2*x3*x4*x5*x6*x7*x8*x9);
print("ELIM_BEGIN");
for(int j=1;j<=size(E);j++){print("POLY_BEGIN");print(E[j]);print("POLY_END");}
print("ELIM_END");
quit;
