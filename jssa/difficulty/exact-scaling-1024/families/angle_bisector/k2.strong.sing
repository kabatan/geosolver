LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6),dp;
short=0;
ideal J=x4^2 - 2,
x2*x4 + x2 - 1,
x2^2 - x5^2 + 1,
x2 - x3*x5 - x3,
-x1 + x3,
-x1 + x6;
J=sat(J,ideal(x4 + 1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x5 + 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x2^2 + 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x2^2 + x5^2 + 2*x5 + 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x4^2 + 2*x4 + 2));
print("SAT_FACTOR=5");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
ideal E=eliminate(G,x1*x2*x3*x4*x5);
print("ELIM_BEGIN");
for(int j=1;j<=size(E);j++){print("POLY_BEGIN");print(E[j]);print("POLY_END");}
print("ELIM_END");
quit;
