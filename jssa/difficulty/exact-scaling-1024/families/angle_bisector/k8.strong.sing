LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18),dp;
short=0;
ideal J=x10^2 - 2,
x10*x6 + x6 - 1,
-x14^2 + x6^2 + 1,
-x14*x7 + x6 - x7,
-x15^2 + x7^2 + 1,
-x15*x8 + x7 - x8,
-x16^2 + x8^2 + 1,
-x16*x9 + x8 - x9,
-x17^2 + x9^2 + 1,
x17*x2 + x2 - x9,
-x11^2 + x2^2 + 1,
-x11*x3 + x2 - x3,
-x12^2 + x3^2 + 1,
-x12*x4 + x3 - x4,
-x13^2 + x4^2 + 1,
-x13*x5 + x4 - x5,
-x1 + x5,
-x1 + x18;
J=sat(J,ideal(x10 + 1));
print("SAT_FACTOR=1");
J=sat(J,ideal(x11 + 1));
print("SAT_FACTOR=2");
J=sat(J,ideal(x12 + 1));
print("SAT_FACTOR=3");
J=sat(J,ideal(x13 + 1));
print("SAT_FACTOR=4");
J=sat(J,ideal(x14 + 1));
print("SAT_FACTOR=5");
J=sat(J,ideal(x15 + 1));
print("SAT_FACTOR=6");
J=sat(J,ideal(x16 + 1));
print("SAT_FACTOR=7");
J=sat(J,ideal(x17 + 1));
print("SAT_FACTOR=8");
J=sat(J,ideal(x2^2 + 1));
print("SAT_FACTOR=9");
J=sat(J,ideal(x11^2 + 2*x11 + x2^2 + 1));
print("SAT_FACTOR=10");
J=sat(J,ideal(x3^2 + 1));
print("SAT_FACTOR=11");
J=sat(J,ideal(x12^2 + 2*x12 + x3^2 + 1));
print("SAT_FACTOR=12");
J=sat(J,ideal(x4^2 + 1));
print("SAT_FACTOR=13");
J=sat(J,ideal(x13^2 + 2*x13 + x4^2 + 1));
print("SAT_FACTOR=14");
J=sat(J,ideal(x6^2 + 1));
print("SAT_FACTOR=15");
J=sat(J,ideal(x14^2 + 2*x14 + x6^2 + 1));
print("SAT_FACTOR=16");
J=sat(J,ideal(x7^2 + 1));
print("SAT_FACTOR=17");
J=sat(J,ideal(x15^2 + 2*x15 + x7^2 + 1));
print("SAT_FACTOR=18");
J=sat(J,ideal(x8^2 + 1));
print("SAT_FACTOR=19");
J=sat(J,ideal(x16^2 + 2*x16 + x8^2 + 1));
print("SAT_FACTOR=20");
J=sat(J,ideal(x9^2 + 1));
print("SAT_FACTOR=21");
J=sat(J,ideal(x17^2 + 2*x17 + x9^2 + 1));
print("SAT_FACTOR=22");
J=sat(J,ideal(x10^2 + 2*x10 + 2));
print("SAT_FACTOR=23");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
ideal E=eliminate(G,x1*x2*x3*x4*x5*x6*x7*x8*x9*x10*x11*x12*x13*x14*x15*x16*x17);
print("ELIM_BEGIN");
for(int j=1;j<=size(E);j++){print("POLY_BEGIN");print(E[j]);print("POLY_END");}
print("ELIM_END");
quit;
