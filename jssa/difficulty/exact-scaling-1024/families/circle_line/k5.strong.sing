LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=x2,
x2^2 - x2 + x4^2 - 2,
x5,
x4*x5 + x4 - x5^2 + x5 - x6^2 + 2,
x7,
x6*x7 + x6 - x7^2 + x7 - x8^2 + 2,
x9,
-x10^2 + x8*x9 + x8 - x9^2 + x9 + 2,
x11,
-x10*x11 - x10 + x11^2 - x11 + x3^2 - 2,
-x1 + x3,
-x1 + x12;
J=sat(J,ideal(x4 + 3));
print("SAT_FACTOR=1");
J=sat(J,ideal(x6 + 3));
print("SAT_FACTOR=2");
J=sat(J,ideal(x8 + 3));
print("SAT_FACTOR=3");
J=sat(J,ideal(x10 + 3));
print("SAT_FACTOR=4");
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
ideal E=eliminate(G,x1*x2*x3*x4*x5*x6*x7*x8*x9*x10*x11);
print("ELIM_BEGIN");
for(int j=1;j<=size(E);j++){print("POLY_BEGIN");print(E[j]);print("POLY_END");}
print("ELIM_END");
quit;
