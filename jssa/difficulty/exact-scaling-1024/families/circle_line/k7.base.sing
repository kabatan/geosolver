LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15),dp;
short=0;
ideal J=x1,
x1^2 - x1 + x7^2 - 2,
x8,
x7*x8 + x7 - x8^2 + x8 - x9^2 + 2,
x10,
-x10^2 + x10*x9 + x10 - x11^2 + x9 + 2,
x12,
x11*x12 + x11 - x12^2 + x12 - x13^2 + 2,
x14,
-x13*x14 - x13 + x14^2 - x14 + x2^2 - 2,
x3,
x2*x3 + x2 - x3^2 + x3 - x4^2 + 2,
x5,
x4*x5 + x4 - x5^2 + x5 - x6^2 + 2,
-x15 + x6;
ideal G=std(J);
print("DIM="+string(dim(G)));
print("DEG="+string(mult(G)));
print("VDIM="+string(vdim(G)));
quit;
