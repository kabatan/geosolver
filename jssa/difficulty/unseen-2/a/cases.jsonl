{"id": "AIME-2004-II-07", "dedupe_key": "AIME-2004-II-07", "dsl_path": "dsl/AIME-2004-II-07.json", "dsl": {"id": "AIME-2004-II-07", "variables": ["h"], "constructions": [{"name": "A", "expression": "Point(0, 0)"}, {"name": "B", "expression": "Point(8+17, 0)"}, {"name": "C", "expression": "Point(8+17, h)"}, {"name": "D", "expression": "Point(0, h)"}, {"name": "E", "expression": "Point(8, 0)"}, {"name": "F", "expression": "Point(8+17-3, h)"}, {"name": "Bp", "expression": "Reflect(B, Line(E, F))"}], "conditions": [{"left": "h", "operator": ">", "right": 0}, {"left": "Bp.x", "operator": "=", "right": 0}, {"left": "Bp.y", "operator": ">=", "right": 0}, {"left": "Bp.y", "operator": "<=", "right": "h"}], "target": "2*(Distance(A, B)+Distance(A, D))"}, "problem_statement": "$ABCD$ is a rectangular sheet of paper that has been folded so that corner $B$ is matched with point $B'$ on edge $AD.$ The crease is $EF,$ where $E$ is on $AB$ and $F$ is on $CD.$ The dimensions $AE=8, BE=17,$ and $CF=3$ are given. The perimeter of rectangle $ABCD$ is $m/n,$ where $m$ and $n$ are relatively prime positive integers. Find $m+n.$\n\n\n[asy] size(200); defaultpen(linewidth(0.7)+fontsize(10)); pair A=origin, B=(25,0), C=(25,70/3), D=(0,70/3), E=(8,0), F=(22,70/3), Bp=reflect(E,F)*B, Cp=reflect(E,F)*C; draw(F--D--A--E); draw(E--B--C--F, linetype(\"4 4\")); filldraw(E--F--Cp--Bp--cycle, white, black); pair point=( 12.5, 35/3 ); label(\"$A$\", A, dir(point--A)); label(\"$B$\", B, dir(point--B)); label(\"$C$\", C, dir(point--C)); label(\"$D$\", D, dir(point--D)); label(\"$E$\", E, dir(point--E)); label(\"$F$\", F, dir(point--F)); label(\"$B^\\prime$\", Bp, dir(point--Bp)); label(\"$C^\\prime$\", Cp, dir(point--Cp));[/asy]", "source": "https://web.archive.org/web/20240725074532/https://artofproblemsolving.com/wiki/index.php/2004_AIME_II_Problems#Problem_7", "answer": ["290/3"], "authoring_status": "runnable", "truth_status": "verified", "truth_basis": "geometric reference verified by hand construction and converted to primary answer key", "source_evidence": {"problem_file": "source-evidence/2004_AIME_II_Problems.html", "problem_sha256": "ad84a8e52c258551463a3c4a403cf7af32f360e470e3fa59bd79e8a369f5e856", "problem_section_line": 523, "answer_file": "source-evidence/2004_AIME_II_Answer_Key.html", "answer_sha256": "17d28adef901751f95597859994ee81e99b654dde90f78b48ea4f28c7971a793"}}
