LIB "elim.lib";
option(redSB);
system("--ticks-per-sec",1000);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14),dp;
short=0;
ideal F=(-x1^2 + 4014*x1 + x11^2 - x2^2 - 4028049)/(1),
(-x1^2 + x13^2 - x2^2)/(1),
(2007*x1 + x11*x4 + x13*x4 - 2007*x13 - 2007*x4)/(1),
(x11*x5 + x13*x5 + 2007*x2 - 2007*x5)/(1),
(x1^2*x4 - x1^2*x6 + x1*x2*x5 - 4014*x1*x4 + 4014*x1*x6 - x2^2*x6 + 2007*x2^2 - 2007*x2*x5 + 4028049*x4 - 4028049*x6)/(1),
(-x1^2*x7 + x1*x2*x4 - 2007*x1*x2 + 4014*x1*x7 + x2^2*x5 - x2^2*x7 - 2007*x2*x4 + 4028049*x2 - 4028049*x7)/(1),
(x1^2*x4 - x1^2*x8 + x1*x2*x5 - x2^2*x8)/(1),
(-x1^2*x9 + x1*x2*x4 + x2^2*x5 - x2^2*x9)/(1),
(-x1*x10*x6 + x1*x10*x8 + x1*x4*x6 - x1*x4*x8 - x10*x2*x7 + x10*x2*x9 + 1003*x10*x6 - 1003*x10*x8 + x2*x5*x6 - x2*x5*x8 - x2*x6*x9 + x2*x7*x8 - 1003*x4*x6 + 1003*x4*x8)/(1),
(x1*x3*x6 - x1*x3*x8 - x1*x4*x7 + x1*x4*x9 - x1*x6*x9 + x1*x7*x8 + x2*x3*x7 - x2*x3*x9 - x2*x5*x7 + x2*x5*x9 - 1003*x3*x6 + 1003*x3*x8 + 1003*x4*x7 - 1003*x4*x9 + 1003*x6*x9 - 1003*x7*x8)/(1),
(x13 - 2009)/(1),
(x11 - 2008)/(1),
(x4^2 - 2006*x4 + 1006009)/(1),
(-x1*x7 + x2*x6 - 2007*x2 + 2007*x7)/(1),
(-x1*x9 + x2*x8)/(1),
(x4 - 1003)/(1),
(x10^2 - 2006*x10 - x12^2 + x3^2 + 1006009)/(1),
(x12 - x14)/(1);
ideal J=F;
int ii;
print("EVENT saturation begin");
int clock0=rtimer;
J=sat(J,ideal((x5)/(1)));
print("EVENT saturation factor 1");
J=sat(J,ideal((x11 + x13 - 2007)/(1)));
print("EVENT saturation factor 2");
J=sat(J,ideal((x12)/(1)));
print("EVENT saturation factor 3");
J=sat(J,ideal((x2)/(1)));
print("EVENT saturation factor 4");
J=sat(J,ideal((x4^2 - 2006*x4 + x5^2 + 1006009)/(1)));
print("EVENT saturation factor 5");
J=sat(J,ideal((x6^2 - 2*x6*x8 + x7^2 - 2*x7*x9 + x8^2 + x9^2)/(1)));
print("EVENT saturation factor 6");
J=sat(J,ideal((x1^2 - 2*x1*x6 + x2^2 - 2*x2*x7 + x6^2 + x7^2)/(1)));
print("EVENT saturation factor 7");
J=sat(J,ideal((x1*x6 - x1*x8 + x2*x7 - x2*x9 - 1003*x6 + 1003*x8)/(1)));
print("EVENT saturation factor 8");
J=sat(J,ideal((x1^2 - 2*x1*x8 + x2^2 - 2*x2*x9 + x8^2 + x9^2)/(1)));
print("EVENT saturation factor 9");
J=sat(J,ideal((x1^2 + x2^2)/(1)));
print("EVENT saturation factor 10");
J=sat(J,ideal((x1^2 - 2006*x1 + x2^2 + 1006009)/(1)));
print("EVENT saturation factor 11");
J=sat(J,ideal((x1^2 - 4014*x1 + x2^2 + 4028049)/(1)));
print("EVENT saturation factor 12");
print("METRIC saturation_ms "+string(rtimer-clock0));
print("EVENT saturation end");
print("BLOCK J BEGIN");
for(ii=1;ii<=size(J);ii++){print(J[ii]);}
print("BLOCK J END");
print("EVENT power begin");
clock0=rtimer;
ideal G=std(J);
print("METRIC power_basis_ms "+string(rtimer-clock0));
print("METRIC power_basis_size "+string(size(G)));
poly unitnf=reduce(1,G);
print("METRIC unit_ideal "+string(unitnf==0));
print("BLOCK G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK G END");
poly p=(x14 - 2014024)/(1);
int firstm=0;
poly rem;
int mm;
clock0=rtimer;
rem=reduce(p^1,G);
print("METRIC nf_1_zero "+string(rem==0));
print("BLOCK NF1 BEGIN");
print(rem);
print("BLOCK NF1 END");
if(rem==0 && firstm==0){firstm=1;}
rem=reduce(p^2,G);
print("METRIC nf_2_zero "+string(rem==0));
print("BLOCK NF2 BEGIN");
print(rem);
print("BLOCK NF2 END");
if(rem==0 && firstm==0){firstm=2;}
rem=reduce(p^3,G);
print("METRIC nf_3_zero "+string(rem==0));
print("BLOCK NF3 BEGIN");
print(rem);
print("BLOCK NF3 END");
if(rem==0 && firstm==0){firstm=3;}
rem=reduce(p^4,G);
print("METRIC nf_4_zero "+string(rem==0));
print("BLOCK NF4 BEGIN");
print(rem);
print("BLOCK NF4 END");
if(rem==0 && firstm==0){firstm=4;}
print("METRIC power_nf_ms "+string(rtimer-clock0));
print("EVENT power end");
ring S=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,yy),dp;
short=0;
ideal J=imap(R,J);
poly p=imap(R,p);
ideal I=J,1-yy*p;
print("EVENT rabinowitsch begin");
clock0=rtimer;
ideal G=std(I);
print("METRIC rab_basis_ms "+string(rtimer-clock0));
print("METRIC rab_basis_size "+string(size(G)));
clock0=rtimer;
poly rem=reduce(1,G);
int rb=(rem==0);
print("METRIC rab_unit "+string(rb));
print("METRIC rab_nf_ms "+string(rtimer-clock0));
print("BLOCK RAB_G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK RAB_G END");
print("BLOCK RAB_NF BEGIN");
print(rem);
print("BLOCK RAB_NF END");
print("EVENT rabinowitsch end");
setring R;
int powm=firstm;
setring S;
int rabok=rb;
if(powm>0 || rabok){
ring C=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,z1,z2,z3,z4,z5,z6,z7,z8,z9,z10,z11,z12,yy),dp;
short=0;
ideal K=(-x1^2 + 4014*x1 + x11^2 - x2^2 - 4028049)/(1),
(-x1^2 + x13^2 - x2^2)/(1),
(2007*x1 + x11*x4 + x13*x4 - 2007*x13 - 2007*x4)/(1),
(x11*x5 + x13*x5 + 2007*x2 - 2007*x5)/(1),
(x1^2*x4 - x1^2*x6 + x1*x2*x5 - 4014*x1*x4 + 4014*x1*x6 - x2^2*x6 + 2007*x2^2 - 2007*x2*x5 + 4028049*x4 - 4028049*x6)/(1),
(-x1^2*x7 + x1*x2*x4 - 2007*x1*x2 + 4014*x1*x7 + x2^2*x5 - x2^2*x7 - 2007*x2*x4 + 4028049*x2 - 4028049*x7)/(1),
(x1^2*x4 - x1^2*x8 + x1*x2*x5 - x2^2*x8)/(1),
(-x1^2*x9 + x1*x2*x4 + x2^2*x5 - x2^2*x9)/(1),
(-x1*x10*x6 + x1*x10*x8 + x1*x4*x6 - x1*x4*x8 - x10*x2*x7 + x10*x2*x9 + 1003*x10*x6 - 1003*x10*x8 + x2*x5*x6 - x2*x5*x8 - x2*x6*x9 + x2*x7*x8 - 1003*x4*x6 + 1003*x4*x8)/(1),
(x1*x3*x6 - x1*x3*x8 - x1*x4*x7 + x1*x4*x9 - x1*x6*x9 + x1*x7*x8 + x2*x3*x7 - x2*x3*x9 - x2*x5*x7 + x2*x5*x9 - 1003*x3*x6 + 1003*x3*x8 + 1003*x4*x7 - 1003*x4*x9 + 1003*x6*x9 - 1003*x7*x8)/(1),
(x13 - 2009)/(1),
(x11 - 2008)/(1),
(x4^2 - 2006*x4 + 1006009)/(1),
(-x1*x7 + x2*x6 - 2007*x2 + 2007*x7)/(1),
(-x1*x9 + x2*x8)/(1),
(x4 - 1003)/(1),
(x10^2 - 2006*x10 - x12^2 + x3^2 + 1006009)/(1),
(x12 - x14)/(1),
(-x5*z1 + 1)/(1),
(-x11*z2 - x13*z2 + 2007*z2 + 1)/(1),
(-x12*z3 + 1)/(1),
(-x2*z4 + 1)/(1),
(-x4^2*z5 + 2006*x4*z5 - x5^2*z5 - 1006009*z5 + 1)/(1),
(-x6^2*z6 + 2*x6*x8*z6 - x7^2*z6 + 2*x7*x9*z6 - x8^2*z6 - x9^2*z6 + 1)/(1),
(-x1^2*z7 + 2*x1*x6*z7 - x2^2*z7 + 2*x2*x7*z7 - x6^2*z7 - x7^2*z7 + 1)/(1),
(-x1*x6*z8 + x1*x8*z8 - x2*x7*z8 + x2*x9*z8 + 1003*x6*z8 - 1003*x8*z8 + 1)/(1),
(-x1^2*z9 + 2*x1*x8*z9 - x2^2*z9 + 2*x2*x9*z9 - x8^2*z9 - x9^2*z9 + 1)/(1),
(-x1^2*z10 - x2^2*z10 + 1)/(1),
(-x1^2*z11 + 2006*x1*z11 - x2^2*z11 - 1006009*z11 + 1)/(1),
(-x1^2*z12 + 4014*x1*z12 - x2^2*z12 - 4028049*z12 + 1)/(1);
poly p=imap(R,p);
matrix A;
int jj;
if(powm>0){
print("EVENT power_certificate begin");
clock0=rtimer;
A=lift(K,ideal(p^powm));
print("BLOCK POWER_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK POWER_COEFF END");
print("METRIC power_certificate_ms "+string(rtimer-clock0));
print("EVENT power_certificate end");
}
if(rabok){
print("EVENT rab_certificate begin");
clock0=rtimer;
ideal L=K,1-yy*p;
A=lift(L,ideal(1));
print("BLOCK RAB_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK RAB_COEFF END");
print("METRIC rab_certificate_ms "+string(rtimer-clock0));
print("EVENT rab_certificate end");
}
}
print("EVENT finished end");
quit;
