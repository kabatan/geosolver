LIB "elim.lib";
option(redSB);
system("--ticks-per-sec",1000);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
short=0;
ideal F=(-4*x1^2 + 4*x5^2 - 49)/(4),
(-196*x1^2*x3^2*x4^2 + 196*x1*x2*x3^2*x4 + 196*x1*x2*x3*x4^2 - 1372*x1*x3^2*x4 - 49*x2^2*x3^2 - 98*x2^2*x3*x4 - 49*x2^2*x4^2 + 686*x2*x3^2 + 686*x2*x3*x4 - 2401*x3^2 + 16*x6^2)/(16),
(x6)/(1),
(-16*x1^4*x3^2 + 32*x1^4*x3*x4 - 16*x1^4*x4^2 + 224*x1^3*x3^2*x4 - 224*x1^3*x3*x4^2 + 224*x1^3*x3 - 224*x1^3*x4 - 784*x1^2*x3^2*x4^2 + 16*x1^2*x3^2*x5^2 + 392*x1^2*x3^2 - 32*x1^2*x3*x4*x5^2 - 2352*x1^2*x3*x4 + 16*x1^2*x4^2*x5^2 + 392*x1^2*x4^2 - 784*x1^2 - 2744*x1*x3^2*x4 + 2744*x1*x3*x4^2 - 224*x1*x3*x5^2 - 2744*x1*x3 + 224*x1*x4*x5^2 + 2744*x1*x4 + 196*x3^2*x5^2 - 2401*x3^2 + 392*x3*x4*x5^2 + 4802*x3*x4 + 196*x4^2*x5^2 - 2401*x4^2 + 784*x5^2)/(16),
(-4*x1^2*x4^2 - 49*x4^2 + 4*x7^2)/(4),
(x7 - 2)/(1),
(-4*x1^2*x3^2 - 49*x3^2 + 4*x8^2)/(4),
(x8 - 3)/(1),
(-x2^2 + 14*x2 + x9^2 - 49)/(1),
(-x10 + x9)/(1);
ideal J=F;
int ii;
print("EVENT saturation begin");
int clock0=rtimer;
J=sat(J,ideal((x5)/(1)));
print("EVENT saturation factor 1");
J=sat(J,ideal((x1)/(1)));
print("EVENT saturation factor 2");
J=sat(J,ideal((x2 - 7)/(1)));
print("EVENT saturation factor 3");
J=sat(J,ideal((x3)/(1)));
print("EVENT saturation factor 4");
J=sat(J,ideal((x4)/(1)));
print("EVENT saturation factor 5");
J=sat(J,ideal((4*x1^2 + 49)/(4)));
print("EVENT saturation factor 6");
J=sat(J,ideal((4*x1^2*x3^2 - 8*x1^2*x3*x4 + 4*x1^2*x4^2 - 56*x1*x3 + 56*x1*x4 + 49*x3^2 + 98*x3*x4 + 49*x4^2 + 196)/(4)));
print("EVENT saturation factor 7");
print("METRIC saturation_ms "+string(rtimer-clock0));
print("EVENT saturation end");
print("BLOCK J BEGIN");
for(ii=1;ii<=size(J);ii++){print(J[ii]);}
print("BLOCK J END");
print("EVENT power begin");
clock0=rtimer;
ideal G=std(J);
print("METRIC power_basis_ms "+string(rtimer-clock0));
print("METRIC power_basis_size "+string(size(G)));
poly unitnf=reduce(1,G);
print("METRIC unit_ideal "+string(unitnf==0));
print("BLOCK G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK G END");
poly p=(x10 - 9)/(1);
int firstm=0;
poly rem;
int mm;
clock0=rtimer;
rem=reduce(p^1,G);
print("METRIC nf_1_zero "+string(rem==0));
print("BLOCK NF1 BEGIN");
print(rem);
print("BLOCK NF1 END");
if(rem==0 && firstm==0){firstm=1;}
rem=reduce(p^2,G);
print("METRIC nf_2_zero "+string(rem==0));
print("BLOCK NF2 BEGIN");
print(rem);
print("BLOCK NF2 END");
if(rem==0 && firstm==0){firstm=2;}
rem=reduce(p^3,G);
print("METRIC nf_3_zero "+string(rem==0));
print("BLOCK NF3 BEGIN");
print(rem);
print("BLOCK NF3 END");
if(rem==0 && firstm==0){firstm=3;}
rem=reduce(p^4,G);
print("METRIC nf_4_zero "+string(rem==0));
print("BLOCK NF4 BEGIN");
print(rem);
print("BLOCK NF4 END");
if(rem==0 && firstm==0){firstm=4;}
print("METRIC power_nf_ms "+string(rtimer-clock0));
print("EVENT power end");
ring S=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,yy),dp;
short=0;
ideal J=imap(R,J);
poly p=imap(R,p);
ideal I=J,1-yy*p;
print("EVENT rabinowitsch begin");
clock0=rtimer;
ideal G=std(I);
print("METRIC rab_basis_ms "+string(rtimer-clock0));
print("METRIC rab_basis_size "+string(size(G)));
clock0=rtimer;
poly rem=reduce(1,G);
int rb=(rem==0);
print("METRIC rab_unit "+string(rb));
print("METRIC rab_nf_ms "+string(rtimer-clock0));
print("BLOCK RAB_G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK RAB_G END");
print("BLOCK RAB_NF BEGIN");
print(rem);
print("BLOCK RAB_NF END");
print("EVENT rabinowitsch end");
setring R;
int powm=firstm;
setring S;
int rabok=rb;
if(powm>0 || rabok){
ring C=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,z1,z2,z3,z4,z5,z6,z7,yy),dp;
short=0;
ideal K=(-4*x1^2 + 4*x5^2 - 49)/(4),
(-196*x1^2*x3^2*x4^2 + 196*x1*x2*x3^2*x4 + 196*x1*x2*x3*x4^2 - 1372*x1*x3^2*x4 - 49*x2^2*x3^2 - 98*x2^2*x3*x4 - 49*x2^2*x4^2 + 686*x2*x3^2 + 686*x2*x3*x4 - 2401*x3^2 + 16*x6^2)/(16),
(x6)/(1),
(-16*x1^4*x3^2 + 32*x1^4*x3*x4 - 16*x1^4*x4^2 + 224*x1^3*x3^2*x4 - 224*x1^3*x3*x4^2 + 224*x1^3*x3 - 224*x1^3*x4 - 784*x1^2*x3^2*x4^2 + 16*x1^2*x3^2*x5^2 + 392*x1^2*x3^2 - 32*x1^2*x3*x4*x5^2 - 2352*x1^2*x3*x4 + 16*x1^2*x4^2*x5^2 + 392*x1^2*x4^2 - 784*x1^2 - 2744*x1*x3^2*x4 + 2744*x1*x3*x4^2 - 224*x1*x3*x5^2 - 2744*x1*x3 + 224*x1*x4*x5^2 + 2744*x1*x4 + 196*x3^2*x5^2 - 2401*x3^2 + 392*x3*x4*x5^2 + 4802*x3*x4 + 196*x4^2*x5^2 - 2401*x4^2 + 784*x5^2)/(16),
(-4*x1^2*x4^2 - 49*x4^2 + 4*x7^2)/(4),
(x7 - 2)/(1),
(-4*x1^2*x3^2 - 49*x3^2 + 4*x8^2)/(4),
(x8 - 3)/(1),
(-x2^2 + 14*x2 + x9^2 - 49)/(1),
(-x10 + x9)/(1),
(-x5*z1 + 1)/(1),
(-x1*z2 + 1)/(1),
(-x2*z3 + 7*z3 + 1)/(1),
(-x3*z4 + 1)/(1),
(-x4*z5 + 1)/(1),
(-4*x1^2*z6 - 49*z6 + 4)/(4),
(-4*x1^2*x3^2*z7 + 8*x1^2*x3*x4*z7 - 4*x1^2*x4^2*z7 + 56*x1*x3*z7 - 56*x1*x4*z7 - 49*x3^2*z7 - 98*x3*x4*z7 - 49*x4^2*z7 - 196*z7 + 4)/(4);
poly p=imap(R,p);
matrix A;
int jj;
if(powm>0){
print("EVENT power_certificate begin");
clock0=rtimer;
A=lift(K,ideal(p^powm));
print("BLOCK POWER_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK POWER_COEFF END");
print("METRIC power_certificate_ms "+string(rtimer-clock0));
print("EVENT power_certificate end");
}
if(rabok){
print("EVENT rab_certificate begin");
clock0=rtimer;
ideal L=K,1-yy*p;
A=lift(L,ideal(1));
print("BLOCK RAB_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK RAB_COEFF END");
print("METRIC rab_certificate_ms "+string(rtimer-clock0));
print("EVENT rab_certificate end");
}
}
print("EVENT finished end");
quit;
