LIB "elim.lib";
option(redSB);
system("--ticks-per-sec",1000);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23,x24,x25,x26,x27,x28,x29,x30,x31,x32,x33,x34,x35,x36),dp;
short=0;
ideal F=(-x1^2 + 2*x1*x2 - x2^2 + x28^2 - x3^2)/(1),
(-x2^2 + x29^2 - x3^2)/(1),
(-x1^2 + x32^2)/(1),
(-x1*x29 - x2*x32 + x22*x28 + x22*x29 + x22*x32)/(1),
(x23*x28 + x23*x29 + x23*x32 - x3*x32)/(1),
(-x1*x29 - x2*x32 + x24*x28 + x24*x29 + x24*x32)/(1),
(x25*x28 + x25*x29 + x25*x32 - x3*x32)/(1),
(-x1*x29 - x2*x32 + x26*x28 + x26*x29 + x26*x32)/(1),
(x27*x28 + x27*x29 + x27*x32 - x3*x32)/(1),
(-x1^2*x26 + x1^2*x4 + 2*x1*x2*x26 - 2*x1*x2*x4 + x1*x27*x3 - x1*x3^2 - x2^2*x26 + x2^2*x4 - x2*x27*x3 + x3^2*x4)/(1),
(-x1^2*x3 + x1^2*x5 + x1*x2*x3 - 2*x1*x2*x5 + x1*x26*x3 + x2^2*x5 - x2*x26*x3 - x27*x3^2 + x3^2*x5)/(1),
(-x1*x29 - x2*x32 + x28*x6 + x29*x6 + x32*x6)/(1),
(x28*x7 + x29*x7 - x3*x32 + x32*x7)/(1),
(x2^2*x6 - x2^2*x8 + x2*x3*x7 - x3^2*x8)/(1),
(-x2^2*x9 + x2*x3*x6 + x3^2*x7 - x3^2*x9)/(1),
(-x1*x29 + x10*x28 + x10*x29 + x10*x32 - x2*x32)/(1),
(x11*x28 + x11*x29 + x11*x32 - x3*x32)/(1),
(x1*x29 + x12*x28 - x12*x29 - x12*x32 + x2*x32)/(1),
(x13*x28 - x13*x29 - x13*x32 + x3*x32)/(1),
(x1^2*x12 - x1^2*x14 - 2*x1*x12*x2 - x1*x13*x3 + 2*x1*x14*x2 + x1*x3^2 + x12*x2^2 + x13*x2*x3 - x14*x2^2 - x14*x3^2)/(1),
(x1^2*x15 - x1^2*x3 + x1*x12*x3 - 2*x1*x15*x2 + x1*x2*x3 - x12*x2*x3 - x13*x3^2 + x15*x2^2 + x15*x3^2)/(1),
(x12*x2^2 + x13*x2*x3 - x16*x2^2 - x16*x3^2)/(1),
(x12*x2*x3 + x13*x3^2 - x17*x2^2 - x17*x3^2)/(1),
(-x14*x17*x4 + x14*x17*x8 + x14*x18*x5 - x14*x18*x9 + x14*x4*x9 - x14*x5*x8 + x15*x16*x4 - x15*x16*x8 - x15*x18*x4 + x15*x18*x8 - x16*x18*x5 + x16*x18*x9 - x16*x4*x9 + x16*x5*x8 + x17*x18*x4 - x17*x18*x8)/(1),
(-x14*x17*x5 + x14*x17*x9 + x14*x19*x5 - x14*x19*x9 + x15*x16*x5 - x15*x16*x9 - x15*x19*x4 + x15*x19*x8 + x15*x4*x9 - x15*x5*x8 - x16*x19*x5 + x16*x19*x9 + x17*x19*x4 - x17*x19*x8 - x17*x4*x9 + x17*x5*x8)/(1),
(-x10*x12*x15 + x10*x12*x5 - x10*x14*x5 + x10*x15*x20 + x12*x15*x4 - x12*x20*x5 + x14*x20*x5 - x15*x20*x4)/(1),
(-x10*x15*x21 + x10*x15*x5 - x12*x15*x5 + x12*x21*x5 - x14*x21*x5 + x15*x21*x4)/(1),
(x24^2 + x25^2 - x30^2)/(1),
(x30 - 3)/(1),
(x24^2 - 2*x24*x4 + x25^2 - 2*x25*x5 - x31^2 + x4^2 + x5^2)/(1),
(x31 - 1)/(1),
(x14^2 - 2*x14*x4 + x15^2 - 2*x15*x5 - x33^2 + x4^2 + x5^2)/(1),
(x33 - 2)/(1),
(-x1^2*x3^2 + 4*x34^2)/(4),
(x18^2 - 2*x18*x20 + x19^2 - 2*x19*x21 + x20^2 + x21^2 - x35^2)/(1),
(x35 - x36)/(1);
ideal J=F;
int ii;
print("EVENT saturation begin");
int clock0=rtimer;
J=sat(J,ideal((x28 + x29 + x32)/(1)));
print("EVENT saturation factor 1");
J=sat(J,ideal((x28 - x29 - x32)/(1)));
print("EVENT saturation factor 2");
J=sat(J,ideal((x34)/(1)));
print("EVENT saturation factor 3");
J=sat(J,ideal((x1)/(1)));
print("EVENT saturation factor 4");
J=sat(J,ideal((x3)/(1)));
print("EVENT saturation factor 5");
J=sat(J,ideal((x4^2 - 2*x4*x8 + x5^2 - 2*x5*x9 + x8^2 + x9^2)/(1)));
print("EVENT saturation factor 6");
J=sat(J,ideal((x10^2 - 2*x10*x4 + x4^2 + x5^2)/(1)));
print("EVENT saturation factor 7");
J=sat(J,ideal((-x10*x15 + x12*x5 - x14*x5 + x15*x4)/(1)));
print("EVENT saturation factor 8");
J=sat(J,ideal((-x14*x5 + x14*x9 + x15*x4 - x15*x8 + x16*x5 - x16*x9 - x17*x4 + x17*x8)/(1)));
print("EVENT saturation factor 9");
J=sat(J,ideal((x12^2 - 2*x12*x14 + x14^2 + x15^2)/(1)));
print("EVENT saturation factor 10");
J=sat(J,ideal((x1*x13 - x1*x3 + x12*x3 - x13*x2)/(1)));
print("EVENT saturation factor 11");
J=sat(J,ideal((x14^2 - 2*x14*x16 + x15^2 - 2*x15*x17 + x16^2 + x17^2)/(1)));
print("EVENT saturation factor 12");
J=sat(J,ideal((x1^2 - 2*x1*x2 + x2^2 + x3^2)/(1)));
print("EVENT saturation factor 13");
J=sat(J,ideal((x2^2 + x3^2)/(1)));
print("EVENT saturation factor 14");
print("METRIC saturation_ms "+string(rtimer-clock0));
print("EVENT saturation end");
print("BLOCK J BEGIN");
for(ii=1;ii<=size(J);ii++){print(J[ii]);}
print("BLOCK J END");
print("EVENT power begin");
clock0=rtimer;
ideal G=std(J);
print("METRIC power_basis_ms "+string(rtimer-clock0));
print("METRIC power_basis_size "+string(size(G)));
poly unitnf=reduce(1,G);
print("METRIC unit_ideal "+string(unitnf==0));
print("BLOCK G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK G END");
poly p=(9*x36^2 - 32)/(1);
int firstm=0;
poly rem;
int mm;
clock0=rtimer;
rem=reduce(p^1,G);
print("METRIC nf_1_zero "+string(rem==0));
print("BLOCK NF1 BEGIN");
print(rem);
print("BLOCK NF1 END");
if(rem==0 && firstm==0){firstm=1;}
rem=reduce(p^2,G);
print("METRIC nf_2_zero "+string(rem==0));
print("BLOCK NF2 BEGIN");
print(rem);
print("BLOCK NF2 END");
if(rem==0 && firstm==0){firstm=2;}
rem=reduce(p^3,G);
print("METRIC nf_3_zero "+string(rem==0));
print("BLOCK NF3 BEGIN");
print(rem);
print("BLOCK NF3 END");
if(rem==0 && firstm==0){firstm=3;}
rem=reduce(p^4,G);
print("METRIC nf_4_zero "+string(rem==0));
print("BLOCK NF4 BEGIN");
print(rem);
print("BLOCK NF4 END");
if(rem==0 && firstm==0){firstm=4;}
print("METRIC power_nf_ms "+string(rtimer-clock0));
print("EVENT power end");
ring S=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23,x24,x25,x26,x27,x28,x29,x30,x31,x32,x33,x34,x35,x36,yy),dp;
short=0;
ideal J=imap(R,J);
poly p=imap(R,p);
ideal I=J,1-yy*p;
print("EVENT rabinowitsch begin");
clock0=rtimer;
ideal G=std(I);
print("METRIC rab_basis_ms "+string(rtimer-clock0));
print("METRIC rab_basis_size "+string(size(G)));
clock0=rtimer;
poly rem=reduce(1,G);
int rb=(rem==0);
print("METRIC rab_unit "+string(rb));
print("METRIC rab_nf_ms "+string(rtimer-clock0));
print("BLOCK RAB_G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK RAB_G END");
print("BLOCK RAB_NF BEGIN");
print(rem);
print("BLOCK RAB_NF END");
print("EVENT rabinowitsch end");
setring R;
int powm=firstm;
setring S;
int rabok=rb;
if(powm>0 || rabok){
ring C=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,x23,x24,x25,x26,x27,x28,x29,x30,x31,x32,x33,x34,x35,x36,z1,z2,z3,z4,z5,z6,z7,z8,z9,z10,z11,z12,z13,z14,yy),dp;
short=0;
ideal K=(-x1^2 + 2*x1*x2 - x2^2 + x28^2 - x3^2)/(1),
(-x2^2 + x29^2 - x3^2)/(1),
(-x1^2 + x32^2)/(1),
(-x1*x29 - x2*x32 + x22*x28 + x22*x29 + x22*x32)/(1),
(x23*x28 + x23*x29 + x23*x32 - x3*x32)/(1),
(-x1*x29 - x2*x32 + x24*x28 + x24*x29 + x24*x32)/(1),
(x25*x28 + x25*x29 + x25*x32 - x3*x32)/(1),
(-x1*x29 - x2*x32 + x26*x28 + x26*x29 + x26*x32)/(1),
(x27*x28 + x27*x29 + x27*x32 - x3*x32)/(1),
(-x1^2*x26 + x1^2*x4 + 2*x1*x2*x26 - 2*x1*x2*x4 + x1*x27*x3 - x1*x3^2 - x2^2*x26 + x2^2*x4 - x2*x27*x3 + x3^2*x4)/(1),
(-x1^2*x3 + x1^2*x5 + x1*x2*x3 - 2*x1*x2*x5 + x1*x26*x3 + x2^2*x5 - x2*x26*x3 - x27*x3^2 + x3^2*x5)/(1),
(-x1*x29 - x2*x32 + x28*x6 + x29*x6 + x32*x6)/(1),
(x28*x7 + x29*x7 - x3*x32 + x32*x7)/(1),
(x2^2*x6 - x2^2*x8 + x2*x3*x7 - x3^2*x8)/(1),
(-x2^2*x9 + x2*x3*x6 + x3^2*x7 - x3^2*x9)/(1),
(-x1*x29 + x10*x28 + x10*x29 + x10*x32 - x2*x32)/(1),
(x11*x28 + x11*x29 + x11*x32 - x3*x32)/(1),
(x1*x29 + x12*x28 - x12*x29 - x12*x32 + x2*x32)/(1),
(x13*x28 - x13*x29 - x13*x32 + x3*x32)/(1),
(x1^2*x12 - x1^2*x14 - 2*x1*x12*x2 - x1*x13*x3 + 2*x1*x14*x2 + x1*x3^2 + x12*x2^2 + x13*x2*x3 - x14*x2^2 - x14*x3^2)/(1),
(x1^2*x15 - x1^2*x3 + x1*x12*x3 - 2*x1*x15*x2 + x1*x2*x3 - x12*x2*x3 - x13*x3^2 + x15*x2^2 + x15*x3^2)/(1),
(x12*x2^2 + x13*x2*x3 - x16*x2^2 - x16*x3^2)/(1),
(x12*x2*x3 + x13*x3^2 - x17*x2^2 - x17*x3^2)/(1),
(-x14*x17*x4 + x14*x17*x8 + x14*x18*x5 - x14*x18*x9 + x14*x4*x9 - x14*x5*x8 + x15*x16*x4 - x15*x16*x8 - x15*x18*x4 + x15*x18*x8 - x16*x18*x5 + x16*x18*x9 - x16*x4*x9 + x16*x5*x8 + x17*x18*x4 - x17*x18*x8)/(1),
(-x14*x17*x5 + x14*x17*x9 + x14*x19*x5 - x14*x19*x9 + x15*x16*x5 - x15*x16*x9 - x15*x19*x4 + x15*x19*x8 + x15*x4*x9 - x15*x5*x8 - x16*x19*x5 + x16*x19*x9 + x17*x19*x4 - x17*x19*x8 - x17*x4*x9 + x17*x5*x8)/(1),
(-x10*x12*x15 + x10*x12*x5 - x10*x14*x5 + x10*x15*x20 + x12*x15*x4 - x12*x20*x5 + x14*x20*x5 - x15*x20*x4)/(1),
(-x10*x15*x21 + x10*x15*x5 - x12*x15*x5 + x12*x21*x5 - x14*x21*x5 + x15*x21*x4)/(1),
(x24^2 + x25^2 - x30^2)/(1),
(x30 - 3)/(1),
(x24^2 - 2*x24*x4 + x25^2 - 2*x25*x5 - x31^2 + x4^2 + x5^2)/(1),
(x31 - 1)/(1),
(x14^2 - 2*x14*x4 + x15^2 - 2*x15*x5 - x33^2 + x4^2 + x5^2)/(1),
(x33 - 2)/(1),
(-x1^2*x3^2 + 4*x34^2)/(4),
(x18^2 - 2*x18*x20 + x19^2 - 2*x19*x21 + x20^2 + x21^2 - x35^2)/(1),
(x35 - x36)/(1),
(-x28*z1 - x29*z1 - x32*z1 + 1)/(1),
(-x28*z2 + x29*z2 + x32*z2 + 1)/(1),
(-x34*z3 + 1)/(1),
(-x1*z4 + 1)/(1),
(-x3*z5 + 1)/(1),
(-x4^2*z6 + 2*x4*x8*z6 - x5^2*z6 + 2*x5*x9*z6 - x8^2*z6 - x9^2*z6 + 1)/(1),
(-x10^2*z7 + 2*x10*x4*z7 - x4^2*z7 - x5^2*z7 + 1)/(1),
(x10*x15*z8 - x12*x5*z8 + x14*x5*z8 - x15*x4*z8 + 1)/(1),
(x14*x5*z9 - x14*x9*z9 - x15*x4*z9 + x15*x8*z9 - x16*x5*z9 + x16*x9*z9 + x17*x4*z9 - x17*x8*z9 + 1)/(1),
(-x12^2*z10 + 2*x12*x14*z10 - x14^2*z10 - x15^2*z10 + 1)/(1),
(-x1*x13*z11 + x1*x3*z11 - x12*x3*z11 + x13*x2*z11 + 1)/(1),
(-x14^2*z12 + 2*x14*x16*z12 - x15^2*z12 + 2*x15*x17*z12 - x16^2*z12 - x17^2*z12 + 1)/(1),
(-x1^2*z13 + 2*x1*x2*z13 - x2^2*z13 - x3^2*z13 + 1)/(1),
(-x2^2*z14 - x3^2*z14 + 1)/(1);
poly p=imap(R,p);
matrix A;
int jj;
if(powm>0){
print("EVENT power_certificate begin");
clock0=rtimer;
A=lift(K,ideal(p^powm));
print("BLOCK POWER_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK POWER_COEFF END");
print("METRIC power_certificate_ms "+string(rtimer-clock0));
print("EVENT power_certificate end");
}
if(rabok){
print("EVENT rab_certificate begin");
clock0=rtimer;
ideal L=K,1-yy*p;
A=lift(L,ideal(1));
print("BLOCK RAB_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK RAB_COEFF END");
print("METRIC rab_certificate_ms "+string(rtimer-clock0));
print("EVENT rab_certificate end");
}
}
print("EVENT finished end");
quit;
