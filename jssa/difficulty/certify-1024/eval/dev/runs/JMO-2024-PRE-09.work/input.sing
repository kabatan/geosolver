LIB "elim.lib";
option(redSB);
system("--ticks-per-sec",1000);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22),dp;
short=0;
ideal F=(-x1^2 + 7*x1 - x2^2 + 2*x2*x7)/(2),
(x18^2 - x3^2 - x4^2)/(1),
(-x1^2 + x19^2 - x2^2)/(1),
(-x1^2 + 2*x1*x3 - x2^2 + 2*x2*x4 + x20^2 - x3^2 - x4^2)/(1),
(-x1*x18 + x18*x8 - x19*x3 + x19*x8 + x20*x8)/(1),
(-x18*x2 + x18*x9 - x19*x4 + x19*x9 + x20*x9)/(1),
(x1*x10*x4 - x1*x10*x9 + x1*x3*x9 - x1*x4*x8 - x10*x2*x3 + x10*x2*x8 - 7*x10*x4 + 7*x10*x9 + 7*x2*x3 - 7*x2*x8 - 7*x3*x9 + 7*x4*x8)/(1),
(x1*x11*x4 - x1*x11*x9 - x11*x2*x3 + x11*x2*x8 - 7*x11*x4 + 7*x11*x9 + x2*x3*x9 - x2*x4*x8 + 7*x2*x4 - 7*x2*x9)/(1),
(-x1^2 + 14*x1 - x2^2 + x21^2 - 49)/(1),
(x21 - 18)/(1),
(x10^2 - 14*x10 + x11^2 - x12^2 + 49)/(1),
(x12 - 5)/(1),
(x13^2 - x3^2 + 2*x3*x5 - x4^2 + 2*x4*x6 - x5^2 - x6^2)/(1),
(x10^2 - 2*x10*x5 + x11^2 - 2*x11*x6 - x14^2 + x5^2 + x6^2)/(1),
(x10^2 - 2*x10*x3 + x11^2 - 2*x11*x4 - x15^2 + x3^2 + x4^2)/(1),
(x13 + x14 - x15)/(1),
(x10*x4 - x10*x6 - x11*x3 + x11*x5 + x3*x6 - x4*x5)/(1),
(-x1*x11 + x10*x2 + 7*x11 - 7*x2)/(1),
(-x3^2 + 7*x3 - x4^2 + 2*x4*x7)/(2),
(-x1^2*x4^2 + 2*x1^2*x4*x6 - x1^2*x6^2 + 2*x1*x2*x3*x4 - 2*x1*x2*x3*x6 - 2*x1*x2*x4*x5 + 2*x1*x2*x5*x6 - 2*x1*x3*x4*x6 + 2*x1*x3*x6^2 + 2*x1*x4^2*x5 - 2*x1*x4*x5*x6 + x16^2 - x2^2*x3^2 + 2*x2^2*x3*x5 - x2^2*x5^2 + 2*x2*x3^2*x6 - 2*x2*x3*x4*x5 - 2*x2*x3*x5*x6 + 2*x2*x4*x5^2 - x3^2*x6^2 + 2*x3*x4*x5*x6 - x4^2*x5^2)/(1),
(x10^2*x4^2 - 2*x10*x11*x3*x4 + x11^2*x3^2 - x17^2)/(1),
(-x1^2*x17 + x1*x17*x3 + x1*x17*x5 + x10^2*x16 - x10*x16*x3 + x11^2*x16 - x11*x16*x4 - x17*x2^2 + x17*x2*x4 + x17*x2*x6 - x17*x3*x5 - x17*x4*x6)/(1),
(x14 - 3)/(1),
(x13 - x22)/(1);
ideal J=F;
int ii;
print("EVENT saturation begin");
int clock0=rtimer;
J=sat(J,ideal((x18 + x19 + x20)/(1)));
print("EVENT saturation factor 1");
J=sat(J,ideal((x2)/(1)));
print("EVENT saturation factor 2");
J=sat(J,ideal((x4)/(1)));
print("EVENT saturation factor 3");
J=sat(J,ideal((x6)/(1)));
print("EVENT saturation factor 4");
J=sat(J,ideal((4*x7^2 + 49)/(4)));
print("EVENT saturation factor 5");
J=sat(J,ideal((x3^2 - 2*x3*x8 + x4^2 - 2*x4*x9 + x8^2 + x9^2)/(1)));
print("EVENT saturation factor 6");
J=sat(J,ideal((x1*x4 - x1*x9 - x2*x3 + x2*x8 - 7*x4 + 7*x9)/(1)));
print("EVENT saturation factor 7");
J=sat(J,ideal((x10^2 + x11^2)/(1)));
print("EVENT saturation factor 8");
J=sat(J,ideal((x10^2 - 2*x10*x3 + x11^2 - 2*x11*x4 + x3^2 + x4^2)/(1)));
print("EVENT saturation factor 9");
J=sat(J,ideal((x1^2 + x2^2)/(1)));
print("EVENT saturation factor 10");
J=sat(J,ideal((x1^2 - 14*x1 + x2^2 + 49)/(1)));
print("EVENT saturation factor 11");
J=sat(J,ideal((x1^2 - 2*x1*x3 + x2^2 - 2*x2*x4 + x3^2 + x4^2)/(1)));
print("EVENT saturation factor 12");
J=sat(J,ideal((x1^2 - 2*x1*x5 + x2^2 - 2*x2*x6 + x5^2 + x6^2)/(1)));
print("EVENT saturation factor 13");
J=sat(J,ideal((x1*x4 - x2*x3)/(1)));
print("EVENT saturation factor 14");
J=sat(J,ideal((x1*x4 - x2*x3 + 7*x2 - 7*x4)/(1)));
print("EVENT saturation factor 15");
J=sat(J,ideal((x3^2 + x4^2)/(1)));
print("EVENT saturation factor 16");
J=sat(J,ideal((x3^2 - 14*x3 + x4^2 + 49)/(1)));
print("EVENT saturation factor 17");
print("METRIC saturation_ms "+string(rtimer-clock0));
print("EVENT saturation end");
print("BLOCK J BEGIN");
for(ii=1;ii<=size(J);ii++){print(J[ii]);}
print("BLOCK J END");
print("EVENT power begin");
clock0=rtimer;
ideal G=std(J);
print("METRIC power_basis_ms "+string(rtimer-clock0));
print("METRIC power_basis_size "+string(size(G)));
poly unitnf=reduce(1,G);
print("METRIC unit_ideal "+string(unitnf==0));
print("BLOCK G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK G END");
poly p=(3*x22 - 17)/(1);
int firstm=0;
poly rem;
int mm;
clock0=rtimer;
rem=reduce(p^1,G);
print("METRIC nf_1_zero "+string(rem==0));
print("BLOCK NF1 BEGIN");
print(rem);
print("BLOCK NF1 END");
if(rem==0 && firstm==0){firstm=1;}
rem=reduce(p^2,G);
print("METRIC nf_2_zero "+string(rem==0));
print("BLOCK NF2 BEGIN");
print(rem);
print("BLOCK NF2 END");
if(rem==0 && firstm==0){firstm=2;}
rem=reduce(p^3,G);
print("METRIC nf_3_zero "+string(rem==0));
print("BLOCK NF3 BEGIN");
print(rem);
print("BLOCK NF3 END");
if(rem==0 && firstm==0){firstm=3;}
rem=reduce(p^4,G);
print("METRIC nf_4_zero "+string(rem==0));
print("BLOCK NF4 BEGIN");
print(rem);
print("BLOCK NF4 END");
if(rem==0 && firstm==0){firstm=4;}
print("METRIC power_nf_ms "+string(rtimer-clock0));
print("EVENT power end");
ring S=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,yy),dp;
short=0;
ideal J=imap(R,J);
poly p=imap(R,p);
ideal I=J,1-yy*p;
print("EVENT rabinowitsch begin");
clock0=rtimer;
ideal G=std(I);
print("METRIC rab_basis_ms "+string(rtimer-clock0));
print("METRIC rab_basis_size "+string(size(G)));
clock0=rtimer;
poly rem=reduce(1,G);
int rb=(rem==0);
print("METRIC rab_unit "+string(rb));
print("METRIC rab_nf_ms "+string(rtimer-clock0));
print("BLOCK RAB_G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK RAB_G END");
print("BLOCK RAB_NF BEGIN");
print(rem);
print("BLOCK RAB_NF END");
print("EVENT rabinowitsch end");
setring R;
int powm=firstm;
setring S;
int rabok=rb;
if(powm>0 || rabok){
ring C=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,x22,z1,z2,z3,z4,z5,z6,z7,z8,z9,z10,z11,z12,z13,z14,z15,z16,z17,yy),dp;
short=0;
ideal K=(-x1^2 + 7*x1 - x2^2 + 2*x2*x7)/(2),
(x18^2 - x3^2 - x4^2)/(1),
(-x1^2 + x19^2 - x2^2)/(1),
(-x1^2 + 2*x1*x3 - x2^2 + 2*x2*x4 + x20^2 - x3^2 - x4^2)/(1),
(-x1*x18 + x18*x8 - x19*x3 + x19*x8 + x20*x8)/(1),
(-x18*x2 + x18*x9 - x19*x4 + x19*x9 + x20*x9)/(1),
(x1*x10*x4 - x1*x10*x9 + x1*x3*x9 - x1*x4*x8 - x10*x2*x3 + x10*x2*x8 - 7*x10*x4 + 7*x10*x9 + 7*x2*x3 - 7*x2*x8 - 7*x3*x9 + 7*x4*x8)/(1),
(x1*x11*x4 - x1*x11*x9 - x11*x2*x3 + x11*x2*x8 - 7*x11*x4 + 7*x11*x9 + x2*x3*x9 - x2*x4*x8 + 7*x2*x4 - 7*x2*x9)/(1),
(-x1^2 + 14*x1 - x2^2 + x21^2 - 49)/(1),
(x21 - 18)/(1),
(x10^2 - 14*x10 + x11^2 - x12^2 + 49)/(1),
(x12 - 5)/(1),
(x13^2 - x3^2 + 2*x3*x5 - x4^2 + 2*x4*x6 - x5^2 - x6^2)/(1),
(x10^2 - 2*x10*x5 + x11^2 - 2*x11*x6 - x14^2 + x5^2 + x6^2)/(1),
(x10^2 - 2*x10*x3 + x11^2 - 2*x11*x4 - x15^2 + x3^2 + x4^2)/(1),
(x13 + x14 - x15)/(1),
(x10*x4 - x10*x6 - x11*x3 + x11*x5 + x3*x6 - x4*x5)/(1),
(-x1*x11 + x10*x2 + 7*x11 - 7*x2)/(1),
(-x3^2 + 7*x3 - x4^2 + 2*x4*x7)/(2),
(-x1^2*x4^2 + 2*x1^2*x4*x6 - x1^2*x6^2 + 2*x1*x2*x3*x4 - 2*x1*x2*x3*x6 - 2*x1*x2*x4*x5 + 2*x1*x2*x5*x6 - 2*x1*x3*x4*x6 + 2*x1*x3*x6^2 + 2*x1*x4^2*x5 - 2*x1*x4*x5*x6 + x16^2 - x2^2*x3^2 + 2*x2^2*x3*x5 - x2^2*x5^2 + 2*x2*x3^2*x6 - 2*x2*x3*x4*x5 - 2*x2*x3*x5*x6 + 2*x2*x4*x5^2 - x3^2*x6^2 + 2*x3*x4*x5*x6 - x4^2*x5^2)/(1),
(x10^2*x4^2 - 2*x10*x11*x3*x4 + x11^2*x3^2 - x17^2)/(1),
(-x1^2*x17 + x1*x17*x3 + x1*x17*x5 + x10^2*x16 - x10*x16*x3 + x11^2*x16 - x11*x16*x4 - x17*x2^2 + x17*x2*x4 + x17*x2*x6 - x17*x3*x5 - x17*x4*x6)/(1),
(x14 - 3)/(1),
(x13 - x22)/(1),
(-x18*z1 - x19*z1 - x20*z1 + 1)/(1),
(-x2*z2 + 1)/(1),
(-x4*z3 + 1)/(1),
(-x6*z4 + 1)/(1),
(-4*x7^2*z5 - 49*z5 + 4)/(4),
(-x3^2*z6 + 2*x3*x8*z6 - x4^2*z6 + 2*x4*x9*z6 - x8^2*z6 - x9^2*z6 + 1)/(1),
(-x1*x4*z7 + x1*x9*z7 + x2*x3*z7 - x2*x8*z7 + 7*x4*z7 - 7*x9*z7 + 1)/(1),
(-x10^2*z8 - x11^2*z8 + 1)/(1),
(-x10^2*z9 + 2*x10*x3*z9 - x11^2*z9 + 2*x11*x4*z9 - x3^2*z9 - x4^2*z9 + 1)/(1),
(-x1^2*z10 - x2^2*z10 + 1)/(1),
(-x1^2*z11 + 14*x1*z11 - x2^2*z11 - 49*z11 + 1)/(1),
(-x1^2*z12 + 2*x1*x3*z12 - x2^2*z12 + 2*x2*x4*z12 - x3^2*z12 - x4^2*z12 + 1)/(1),
(-x1^2*z13 + 2*x1*x5*z13 - x2^2*z13 + 2*x2*x6*z13 - x5^2*z13 - x6^2*z13 + 1)/(1),
(-x1*x4*z14 + x2*x3*z14 + 1)/(1),
(-x1*x4*z15 + x2*x3*z15 - 7*x2*z15 + 7*x4*z15 + 1)/(1),
(-x3^2*z16 - x4^2*z16 + 1)/(1),
(-x3^2*z17 + 14*x3*z17 - x4^2*z17 - 49*z17 + 1)/(1);
poly p=imap(R,p);
matrix A;
int jj;
if(powm>0){
print("EVENT power_certificate begin");
clock0=rtimer;
A=lift(K,ideal(p^powm));
print("BLOCK POWER_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK POWER_COEFF END");
print("METRIC power_certificate_ms "+string(rtimer-clock0));
print("EVENT power_certificate end");
}
if(rabok){
print("EVENT rab_certificate begin");
clock0=rtimer;
ideal L=K,1-yy*p;
A=lift(L,ideal(1));
print("BLOCK RAB_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK RAB_COEFF END");
print("METRIC rab_certificate_ms "+string(rtimer-clock0));
print("EVENT rab_certificate end");
}
}
print("EVENT finished end");
quit;
