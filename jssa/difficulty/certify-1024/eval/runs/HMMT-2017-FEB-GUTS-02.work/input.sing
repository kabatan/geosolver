LIB "elim.lib";
option(redSB);
system("--ticks-per-sec",1000);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21),dp;
short=0;
ideal F=(x14^2 - x2^2 - x3^2)/(1),
(x14*x7 + 2*x2)/(1),
(x14*x8 + 2*x3)/(1),
(-x14*x2 + x14*x9 - 16*x2)/(1),
(x10*x14 - x14*x3 - 16*x3)/(1),
(-x1^2 + 2*x1*x2 - x2^2 + x20^2 - x3^2)/(1),
(-x1*x20 - 4*x1 + x11*x20 + 4*x2)/(1),
(x12*x20 + 4*x3)/(1),
(12*x1 + x13*x20 - x2*x20 - 12*x2)/(1),
(-x20*x3 + x20*x4 - 12*x3)/(1),
(x11^2*x8 - 2*x11*x5*x8 + x12^2*x8 + 2*x12*x5*x7 + 6*x12*x5 - x12*x7^2 - x12*x8^2 + 9*x12 - 6*x5*x8 - 9*x8)/(2),
(-x11^2*x7 - 3*x11^2 - 2*x11*x6*x8 + x11*x7^2 + x11*x8^2 - 9*x11 - x12^2*x7 - 3*x12^2 + 2*x12*x6*x7 + 6*x12*x6 - 6*x6*x8 + 3*x7^2 + 9*x7 + 3*x8^2)/(2),
(x1^2 - 2*x1*x5 + 20*x1 - x15^2 + x5^2 - 20*x5 + x6^2 + 100)/(1),
(-x16^2 + x5^2 + 6*x5 + x6^2 + 9)/(1),
(x15 - x16)/(1),
(x10^2 - 2*x10*x6 - x17^2 + x5^2 - 2*x5*x9 + x6^2 + x9^2)/(1),
(x16 - x17)/(1),
(x13^2 - 2*x13*x5 - x18^2 + x4^2 - 2*x4*x6 + x5^2 + x6^2)/(1),
(x16 - x18)/(1),
(-x1^2 + x19^2)/(1),
(x14 + x19 + x20 - x21)/(1);
ideal J=F;
int ii;
print("EVENT saturation begin");
int clock0=rtimer;
J=sat(J,ideal((x14)/(1)));
print("EVENT saturation factor 1");
J=sat(J,ideal((x20)/(1)));
print("EVENT saturation factor 2");
J=sat(J,ideal((x1)/(1)));
print("EVENT saturation factor 3");
J=sat(J,ideal((x1 + 13)/(1)));
print("EVENT saturation factor 4");
J=sat(J,ideal((x3)/(1)));
print("EVENT saturation factor 5");
J=sat(J,ideal((x13^2 + 6*x13 + x4^2 + 9)/(1)));
print("EVENT saturation factor 6");
J=sat(J,ideal((x1^2 - 2*x1*x13 + 20*x1 + x13^2 - 20*x13 + x4^2 + 100)/(1)));
print("EVENT saturation factor 7");
J=sat(J,ideal((x13^2 - 2*x13*x7 + x4^2 - 2*x4*x8 + x7^2 + x8^2)/(1)));
print("EVENT saturation factor 8");
J=sat(J,ideal((x10^2 - 2*x10*x4 + x13^2 - 2*x13*x9 + x4^2 + x9^2)/(1)));
print("EVENT saturation factor 9");
J=sat(J,ideal((x11^2 - 2*x11*x13 + x12^2 - 2*x12*x4 + x13^2 + x4^2)/(1)));
print("EVENT saturation factor 10");
J=sat(J,ideal((-x13*x8 + x4*x7 + 3*x4 - 3*x8)/(1)));
print("EVENT saturation factor 11");
J=sat(J,ideal((-x10*x13 - 3*x10 + x4*x9 + 3*x4)/(1)));
print("EVENT saturation factor 12");
J=sat(J,ideal((x1*x10 - x1*x4 - x10*x13 + 10*x10 + x4*x9 - 10*x4)/(1)));
print("EVENT saturation factor 13");
J=sat(J,ideal((x5^2 + 6*x5 + x6^2 + 9)/(1)));
print("EVENT saturation factor 14");
J=sat(J,ideal((x7^2 + 6*x7 + x8^2 + 9)/(1)));
print("EVENT saturation factor 15");
J=sat(J,ideal((x10^2 - 2*x10*x8 + x7^2 - 2*x7*x9 + x8^2 + x9^2)/(1)));
print("EVENT saturation factor 16");
J=sat(J,ideal((x11^2 - 2*x11*x7 + x12^2 - 2*x12*x8 + x7^2 + x8^2)/(1)));
print("EVENT saturation factor 17");
J=sat(J,ideal((x1^2 - 2*x1*x7 + 20*x1 + x7^2 - 20*x7 + x8^2 + 100)/(1)));
print("EVENT saturation factor 18");
J=sat(J,ideal((-x1*x12 + x1*x8 - x11*x8 + x12*x7 - 10*x12 + 10*x8)/(1)));
print("EVENT saturation factor 19");
J=sat(J,ideal((-x11*x8 + x12*x7 + 3*x12 - 3*x8)/(1)));
print("EVENT saturation factor 20");
J=sat(J,ideal((x10^2 + x9^2 + 6*x9 + 9)/(1)));
print("EVENT saturation factor 21");
J=sat(J,ideal((x10^2 - 2*x10*x12 + x11^2 - 2*x11*x9 + x12^2 + x9^2)/(1)));
print("EVENT saturation factor 22");
J=sat(J,ideal((x1^2 - 2*x1*x9 + 20*x1 + x10^2 + x9^2 - 20*x9 + 100)/(1)));
print("EVENT saturation factor 23");
J=sat(J,ideal((x1*x10 - x1*x12 - x10*x11 + 10*x10 + x12*x9 - 10*x12)/(1)));
print("EVENT saturation factor 24");
J=sat(J,ideal((x11^2 + 6*x11 + x12^2 + 9)/(1)));
print("EVENT saturation factor 25");
J=sat(J,ideal((x1^2 - 2*x1*x11 + 20*x1 + x11^2 - 20*x11 + x12^2 + 100)/(1)));
print("EVENT saturation factor 26");
print("METRIC saturation_ms "+string(rtimer-clock0));
print("EVENT saturation end");
print("BLOCK J BEGIN");
for(ii=1;ii<=size(J);ii++){print(J[ii]);}
print("BLOCK J END");
print("EVENT power begin");
clock0=rtimer;
ideal G=std(J);
print("METRIC power_basis_ms "+string(rtimer-clock0));
print("METRIC power_basis_size "+string(size(G)));
poly unitnf=reduce(1,G);
print("METRIC unit_ideal "+string(unitnf==0));
print("BLOCK G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK G END");
poly p=(6*x21 - 77)/(1);
int firstm=0;
poly rem;
int mm;
clock0=rtimer;
rem=reduce(p^1,G);
print("METRIC nf_1_zero "+string(rem==0));
print("BLOCK NF1 BEGIN");
print(rem);
print("BLOCK NF1 END");
if(rem==0 && firstm==0){firstm=1;}
rem=reduce(p^2,G);
print("METRIC nf_2_zero "+string(rem==0));
print("BLOCK NF2 BEGIN");
print(rem);
print("BLOCK NF2 END");
if(rem==0 && firstm==0){firstm=2;}
rem=reduce(p^3,G);
print("METRIC nf_3_zero "+string(rem==0));
print("BLOCK NF3 BEGIN");
print(rem);
print("BLOCK NF3 END");
if(rem==0 && firstm==0){firstm=3;}
rem=reduce(p^4,G);
print("METRIC nf_4_zero "+string(rem==0));
print("BLOCK NF4 BEGIN");
print(rem);
print("BLOCK NF4 END");
if(rem==0 && firstm==0){firstm=4;}
print("METRIC power_nf_ms "+string(rtimer-clock0));
print("EVENT power end");
ring S=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,yy),dp;
short=0;
ideal J=imap(R,J);
poly p=imap(R,p);
ideal I=J,1-yy*p;
print("EVENT rabinowitsch begin");
clock0=rtimer;
ideal G=std(I);
print("METRIC rab_basis_ms "+string(rtimer-clock0));
print("METRIC rab_basis_size "+string(size(G)));
clock0=rtimer;
poly rem=reduce(1,G);
int rb=(rem==0);
print("METRIC rab_unit "+string(rb));
print("METRIC rab_nf_ms "+string(rtimer-clock0));
print("BLOCK RAB_G BEGIN");
for(ii=1;ii<=size(G);ii++){print(G[ii]);}
print("BLOCK RAB_G END");
print("BLOCK RAB_NF BEGIN");
print(rem);
print("BLOCK RAB_NF END");
print("EVENT rabinowitsch end");
setring R;
int powm=firstm;
setring S;
int rabok=rb;
if(powm>0 || rabok){
ring C=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12,x13,x14,x15,x16,x17,x18,x19,x20,x21,z1,z2,z3,z4,z5,z6,z7,z8,z9,z10,z11,z12,z13,z14,z15,z16,z17,z18,z19,z20,z21,z22,z23,z24,z25,z26,yy),dp;
short=0;
ideal K=(x14^2 - x2^2 - x3^2)/(1),
(x14*x7 + 2*x2)/(1),
(x14*x8 + 2*x3)/(1),
(-x14*x2 + x14*x9 - 16*x2)/(1),
(x10*x14 - x14*x3 - 16*x3)/(1),
(-x1^2 + 2*x1*x2 - x2^2 + x20^2 - x3^2)/(1),
(-x1*x20 - 4*x1 + x11*x20 + 4*x2)/(1),
(x12*x20 + 4*x3)/(1),
(12*x1 + x13*x20 - x2*x20 - 12*x2)/(1),
(-x20*x3 + x20*x4 - 12*x3)/(1),
(x11^2*x8 - 2*x11*x5*x8 + x12^2*x8 + 2*x12*x5*x7 + 6*x12*x5 - x12*x7^2 - x12*x8^2 + 9*x12 - 6*x5*x8 - 9*x8)/(2),
(-x11^2*x7 - 3*x11^2 - 2*x11*x6*x8 + x11*x7^2 + x11*x8^2 - 9*x11 - x12^2*x7 - 3*x12^2 + 2*x12*x6*x7 + 6*x12*x6 - 6*x6*x8 + 3*x7^2 + 9*x7 + 3*x8^2)/(2),
(x1^2 - 2*x1*x5 + 20*x1 - x15^2 + x5^2 - 20*x5 + x6^2 + 100)/(1),
(-x16^2 + x5^2 + 6*x5 + x6^2 + 9)/(1),
(x15 - x16)/(1),
(x10^2 - 2*x10*x6 - x17^2 + x5^2 - 2*x5*x9 + x6^2 + x9^2)/(1),
(x16 - x17)/(1),
(x13^2 - 2*x13*x5 - x18^2 + x4^2 - 2*x4*x6 + x5^2 + x6^2)/(1),
(x16 - x18)/(1),
(-x1^2 + x19^2)/(1),
(x14 + x19 + x20 - x21)/(1),
(-x14*z1 + 1)/(1),
(-x20*z2 + 1)/(1),
(-x1*z3 + 1)/(1),
(-x1*z4 - 13*z4 + 1)/(1),
(-x3*z5 + 1)/(1),
(-x13^2*z6 - 6*x13*z6 - x4^2*z6 - 9*z6 + 1)/(1),
(-x1^2*z7 + 2*x1*x13*z7 - 20*x1*z7 - x13^2*z7 + 20*x13*z7 - x4^2*z7 - 100*z7 + 1)/(1),
(-x13^2*z8 + 2*x13*x7*z8 - x4^2*z8 + 2*x4*x8*z8 - x7^2*z8 - x8^2*z8 + 1)/(1),
(-x10^2*z9 + 2*x10*x4*z9 - x13^2*z9 + 2*x13*x9*z9 - x4^2*z9 - x9^2*z9 + 1)/(1),
(-x11^2*z10 + 2*x11*x13*z10 - x12^2*z10 + 2*x12*x4*z10 - x13^2*z10 - x4^2*z10 + 1)/(1),
(x13*x8*z11 - x4*x7*z11 - 3*x4*z11 + 3*x8*z11 + 1)/(1),
(x10*x13*z12 + 3*x10*z12 - x4*x9*z12 - 3*x4*z12 + 1)/(1),
(-x1*x10*z13 + x1*x4*z13 + x10*x13*z13 - 10*x10*z13 - x4*x9*z13 + 10*x4*z13 + 1)/(1),
(-x5^2*z14 - 6*x5*z14 - x6^2*z14 - 9*z14 + 1)/(1),
(-x7^2*z15 - 6*x7*z15 - x8^2*z15 - 9*z15 + 1)/(1),
(-x10^2*z16 + 2*x10*x8*z16 - x7^2*z16 + 2*x7*x9*z16 - x8^2*z16 - x9^2*z16 + 1)/(1),
(-x11^2*z17 + 2*x11*x7*z17 - x12^2*z17 + 2*x12*x8*z17 - x7^2*z17 - x8^2*z17 + 1)/(1),
(-x1^2*z18 + 2*x1*x7*z18 - 20*x1*z18 - x7^2*z18 + 20*x7*z18 - x8^2*z18 - 100*z18 + 1)/(1),
(x1*x12*z19 - x1*x8*z19 + x11*x8*z19 - x12*x7*z19 + 10*x12*z19 - 10*x8*z19 + 1)/(1),
(x11*x8*z20 - x12*x7*z20 - 3*x12*z20 + 3*x8*z20 + 1)/(1),
(-x10^2*z21 - x9^2*z21 - 6*x9*z21 - 9*z21 + 1)/(1),
(-x10^2*z22 + 2*x10*x12*z22 - x11^2*z22 + 2*x11*x9*z22 - x12^2*z22 - x9^2*z22 + 1)/(1),
(-x1^2*z23 + 2*x1*x9*z23 - 20*x1*z23 - x10^2*z23 - x9^2*z23 + 20*x9*z23 - 100*z23 + 1)/(1),
(-x1*x10*z24 + x1*x12*z24 + x10*x11*z24 - 10*x10*z24 - x12*x9*z24 + 10*x12*z24 + 1)/(1),
(-x11^2*z25 - 6*x11*z25 - x12^2*z25 - 9*z25 + 1)/(1),
(-x1^2*z26 + 2*x1*x11*z26 - 20*x1*z26 - x11^2*z26 + 20*x11*z26 - x12^2*z26 - 100*z26 + 1)/(1);
poly p=imap(R,p);
matrix A;
int jj;
if(powm>0){
print("EVENT power_certificate begin");
clock0=rtimer;
A=lift(K,ideal(p^powm));
print("BLOCK POWER_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK POWER_COEFF END");
print("METRIC power_certificate_ms "+string(rtimer-clock0));
print("EVENT power_certificate end");
}
if(rabok){
print("EVENT rab_certificate begin");
clock0=rtimer;
ideal L=K,1-yy*p;
A=lift(L,ideal(1));
print("BLOCK RAB_COEFF BEGIN");
for(jj=1;jj<=nrows(A);jj++){print(A[jj,1]);}
print("BLOCK RAB_COEFF END");
print("METRIC rab_certificate_ms "+string(rtimer-clock0));
print("EVENT rab_certificate end");
}
}
print("EVENT finished end");
quit;
