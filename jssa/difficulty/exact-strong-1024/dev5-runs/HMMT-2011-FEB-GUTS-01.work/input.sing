LIB "elim.lib";
option(redSB);
ring R=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),dp;
short=0;
ideal J=-x1^2*x3^2*x4 + x1^2*x3^2*x6 - 2*x1*x2^2*x3*x5^2 + 2*x1*x2*x3^2*x5^2 - 2*x1*x2*x3*x4^2 + 2*x1*x2*x3*x4*x6 + 2*x1*x3^2*x4^2 - 2*x1*x3^2*x4*x6 - x2^2*x4^3 + x2^2*x4^2*x6 - x2^2*x4*x5^2 + x2^2*x5^2*x6 + 2*x2*x3*x4^3 - 2*x2*x3*x4^2*x6 + 2*x2*x3*x4*x5^2 - 2*x2*x3*x5^2*x6 - x3^2*x4^3 + x3^2*x4^2*x6 - x3^2*x4*x5^2 + x3^2*x5^2*x6,
2*x1^2*x2*x3^2*x5 - x1^2*x3^2*x5 + x1^2*x3^2*x7 + 2*x1*x2^2*x3*x4*x5 - 2*x1*x2*x3^2*x4*x5 - 2*x1*x2*x3*x4*x5 + 2*x1*x2*x3*x4*x7 + 2*x1*x3^2*x4*x5 - 2*x1*x3^2*x4*x7 - x2^2*x4^2*x5 + x2^2*x4^2*x7 - x2^2*x5^3 + x2^2*x5^2*x7 + 2*x2*x3*x4^2*x5 - 2*x2*x3*x4^2*x7 + 2*x2*x3*x5^3 - 2*x2*x3*x5^2*x7 - x3^2*x4^2*x5 + x3^2*x4^2*x7 - x3^2*x5^3 + x3^2*x5^2*x7,
-x1^2*x5^2 + 4*x8^2,
x8 - 1,
x1*x2*x5 - x1*x3*x5,
-x1^2*x3^2 - 2*x1*x2*x3*x4 + 2*x1*x3^2*x4 - x2^2*x4^2 - x2^2*x5^2 + 2*x2*x3*x4^2 + 2*x2*x3*x5^2 - x3^2*x4^2 - x3^2*x5^2 + x9^2,
-x1^2 + x10^2,
-x10 + 3*x9,
x1^2*x7^2 - 4*x11^2,
x11 - x12;
print("STRONG_SAT_BEGIN");
J=sat(J,ideal(x10));
print("STRONG_SAT_FACTOR_1");
J=sat(J,ideal(x1));
print("STRONG_SAT_FACTOR_2");
J=sat(J,ideal(x5));
print("STRONG_SAT_FACTOR_3");
J=sat(J,ideal(x1^2 - 2*x1*x4 + x4^2 + x5^2));
print("STRONG_SAT_FACTOR_4");
J=sat(J,ideal(x4^2 + x5^2));
print("STRONG_SAT_FACTOR_5");
J=sat(J,ideal(x1^2*x3^2 + 2*x1*x2*x3*x4 - 2*x1*x3^2*x4 + x2^2*x4^2 + x2^2*x5^2 - 2*x2*x3*x4^2 - 2*x2*x3*x5^2 + x3^2*x4^2 + x3^2*x5^2));
print("STRONG_SAT_FACTOR_6");
print("STRONG_SAT_DONE");
ideal E=eliminate(J,x1*x2*x3*x4*x5*x6*x7*x8*x9*x10*x11);
int i;
print("STRONG_ELIM_BEGIN");
for(i=1;i<=size(E);i++){print(E[i]);}
print("STRONG_ELIM_END");
ring L=0,(x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11,x12),lp;
short=0;
ideal H=imap(R,J);
ideal G=std(H);
print("STRONG_LEX_BEGIN");
for(int j=1;j<=size(G);j++){print(G[j]);}
print("STRONG_LEX_END");
quit;
