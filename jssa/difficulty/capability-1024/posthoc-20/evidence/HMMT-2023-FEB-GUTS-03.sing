ring R=0,(x0,x1,x2,x3,x4,x5,x6,x7),dp;
ideal I=x5^2 - x5*x7 + x6^2,
4*x0^2 - 4*x5^2 + 4*x5*x7 - 4*x6^2 - x7^2,
x0 - 2,
4*x1^2 - 4*x4^2 - x7^2,
x1 - 3,
x2^2 - x4^2 - x7^2,
x2 - x3;
ideal J=I;
print("SAT_DONE");
ideal E=eliminate(J,x0*x1*x2*x4*x5*x6*x7);
print("ELIM_BEGIN");print(E);print("ELIM_END");
quit;
