option(redSB);
ring r=0,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
ideal I=x4^2 - 3,
x0*x4^2 + x0 - x4^2*x9 - 20,
x1*x4^2 + x1 - x4*x9 + 20*x4,
x2*x4^2 + x2 - x4^2*x9 + 11*x4^2 - 11,
x3*x4^2 + x3 - 11*x4^3 - x4*x9 + 11*x4,
121*x4^2 - x5^2 + 121,
x5 - 22,
x6^2 - x9^2,
x4^2*x9^2 - 4*x7^2 + x9^2,
x6 - x7,
x0^2 - 2*x0*x2 + x1^2 - 2*x1*x3 + x2^2 + x3^2 - x8^2,
-x11 + x8,
x10*x9^2 - 20*x10*x9 - 1;
int startTime=rtimer;
ideal E=eliminate(I,x0*x1*x2*x3*x4*x5*x6*x7*x8*x9*x10);
print("ELIM");print(E);
if (E[1]!=0) { matrix C=lift(I,E[1]); poly chk=E[1]; int i; for(i=1;i<=size(I);i++){chk=chk-C[i,1]*I[i];} print("CHECK");print(chk==0);print("COFACTORS");print(C); }
print("TICKS");print(rtimer-startTime);quit;
