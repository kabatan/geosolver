option(redSB);
ring r=0,(x0,x1,x2,x3,x4,x5,x6,x7),dp;
ideal I=x0^2 - 3,
x0^2*x5^4 - 4*x0*x4*x5^3 - 16*x1^2 + 4*x4^2*x5^2,
x1 - 20,
x2^2 - x4^2*x5^2,
x2 - 23,
9*x0^2*x5^4 - 4*x3^2,
x3 - x7,
x0^2*x4*x5^2*x6 - 2*x0*x4^2*x5*x6 - 1;
int startTime=rtimer;
ideal E=eliminate(I,x0*x1*x2*x3*x4*x5*x6);
print("ELIM");print(E);
if (E[1]!=0) { matrix C=lift(I,E[1]); poly chk=E[1]; int i; for(i=1;i<=size(I);i++){chk=chk-C[i,1]*I[i];} print("CHECK");print(chk==0);print("COFACTORS");print(C); }
print("TICKS");print(rtimer-startTime);quit;
