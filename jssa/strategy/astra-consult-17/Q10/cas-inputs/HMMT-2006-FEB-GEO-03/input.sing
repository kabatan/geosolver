option(redSB);
ring r=0,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10),dp;
ideal I=x0^2 + x1^2 - 1,
30*x0^2*x1 - 7*x0^2*x8 - 14*x0*x2*x8 + 30*x1^3 - 7*x1^2*x8 + 14*x1*x2*x7 + 54*x1*x2 - 49*x1*x7^2 - 378*x1*x7 - 49*x1*x8^2 - 729*x1,
30*x0^3 - 7*x0^2*x7 - 27*x0^2 + 30*x0*x1^2 + 14*x0*x3*x8 - 49*x0*x7^2 - 378*x0*x7 - 49*x0*x8^2 - 729*x0 - 7*x1^2*x7 - 27*x1^2 - 14*x1*x3*x7 - 54*x1*x3,
x7^2 + x8^2 - 1,
12*x0^2 + 4*x0*x2 + 12*x1^2 + 4*x1*x3 - 8*x2*x7 + 18*x2 - 8*x3*x8 - 48*x7^2 + 216*x7 - 48*x8^2 - 243,
36*x0^2 + 12*x0*x2 + 36*x1^2 + 12*x1*x3 + x2^2 + x3^2 - x4^2,
x3^2 - x5^2,
x4^2 - x5^2 - x6^2,
-x10 + 2*x6,
7*x0*x8^2*x9 - 7*x1*x7*x8*x9 - 27*x1*x8*x9 - 7;
int startTime=rtimer;
ideal E=eliminate(I,x0*x1*x2*x3*x4*x5*x6*x7*x8*x9);
print("ELIM");print(E);
if (E[1]!=0) { matrix C=lift(I,E[1]); poly chk=E[1]; int i; for(i=1;i<=size(I);i++){chk=chk-C[i,1]*I[i];} print("CHECK");print(chk==0);print("COFACTORS");print(C); }
print("TICKS");print(rtimer-startTime);quit;
