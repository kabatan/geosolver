option(redSB);
ring r=0,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,x11),dp;
ideal I=x0^2 + x1^2 - 1,
2*x0^2*x9 + 2*x1^2*x9 - 2*x2*x8 + x8^2,
2*x0^3*x9 - x0^2*x8*x9 - 2*x0^2*x8 + 2*x0*x1^2*x9 + x0*x8^2 - x1^2*x8*x9 - 2*x1^2*x8 + 2*x1*x3*x8,
x0^2*x9^2 - x0*x8*x9 - 9*x0*x9 + x1^2*x9^2 - 2*x1*x4*x9 + 9*x8,
4*x0^2 + 4*x1^2 - x5^2,
x5 - 2,
x2^2*x8^2 - 18*x2^2*x8 + 81*x2^2 - 2*x2*x8^3 + 36*x2*x8^2 - 162*x2*x8 + x8^4 - 18*x8^3 + 81*x8^2,
x0^2*x8^2*x9^2 - 4*x0^2*x8^2*x9 + 4*x0^2*x8^2 - 18*x0^2*x8*x9^2 + 72*x0^2*x8*x9 - 72*x0^2*x8 + 81*x0^2*x9^2 - 324*x0^2*x9 + 324*x0^2 + 4*x0*x1*x4*x8*x9^2 - 16*x0*x1*x4*x8*x9 + 16*x0*x1*x4*x8 + 36*x0*x1*x4*x9^2 - 144*x0*x1*x4*x9 + 144*x0*x1*x4 + 4*x1^2*x4^2*x9^2 - 16*x1^2*x4^2*x9 + 16*x1^2*x4^2 - 36*x1^2*x8*x9^2 + 144*x1^2*x8*x9 - 144*x1^2*x8,
x2^2 - 2*x2*x8 + x3^2 - x6^2 + x8^2,
4*x4^2 - 4*x7^2 + x8^2 - 18*x8 + 81,
-x11*x7 + x6,
x1*x10*x7*x8^2*x9^2 - 2*x1*x10*x7*x8^2*x9 - 9*x1*x10*x7*x8*x9^2 + 18*x1*x10*x7*x8*x9 - 1;
int startTime=rtimer;
ideal E=eliminate(I,x0*x1*x2*x3*x4*x5*x6*x7*x8*x9*x10);
print("ELIM");print(E);
if (E[1]!=0) { matrix C=lift(I,E[1]); poly chk=E[1]; int i; for(i=1;i<=size(I);i++){chk=chk-C[i,1]*I[i];} print("CHECK");print(chk==0);print("COFACTORS");print(C); }
print("TICKS");print(rtimer-startTime);quit;
