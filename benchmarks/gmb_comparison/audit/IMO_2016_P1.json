  "source_differences": [
    {
      "id": "gmb_runtime_distinctness",
      "kind": "runtime_acceptance_policy",
      "blocking": false,
      "description_ja": "GMBは全登録点の最小距離0.1とweighted soft lossで受理する。原文にない全点相異・最小距離0.1はGeoSolver条件に移さず、両者の出力を別の共通検査器で再検査する。"
    },
    {
      "id": "right_triangle_shape_fixed",
      "kind": "runtime_parameterization",
      "blocking": false,
      "description_ja": "GMB right-triではshape用のAxがtrainable=FalseでAyがそこから決まり、三角形の形が試行中固定される。GeoSolverは円周変数bを残し、相似以外の自由度を固定しない。"
    },
    {
      "id": "internal_bisector_semantics",
      "kind": "runtime_predicate",
      "blocking": false,
      "description_ja": "GMB i-bisectorのsin型残差は単体ではmod πの角二等分だが、本問は他の等長条件が内角・正向きrayを強制する。C=(0,0),F=(1,0),A=(a,0),a>1で0<B.x<1、DA=DCからD.x=a/2なのでAD,ABはAC方向への射影がともに正。さらにEA=EDから(E−A)·(D−A)=|D−A|²/2>0、(C−A)·(D−A)=a²/2>0。従って両角二等分線に外角・反対rayの枝は残らない。GeoSolverの正射影条件は新しい仮定ではない。"
    }
  ],
