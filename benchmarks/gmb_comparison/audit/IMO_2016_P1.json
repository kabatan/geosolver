      "id": "H01",
      "statement_ja": "三角形BCFはBが直角で非退化。",
      "gmbl": [
        "(param (B C F) (right-tri B))"
      ],
      "geosolver": [
        "B = PointOnCircle(Circle(M, 1/2), b)",
        "C = Point(0, 0)",
        "F = Point(1, 0)",
        "conditions[0]: Area(B, C, F) > 0"
      ],
      "condition_indices": [
        0
      ],
      "construction_names": [
        "B",
        "C",
        "F"
      ],
      "status": "matched"
    },
    {
      "id": "H02",
      "statement_ja": "AはCF上でFA=FB、FがAとCの間。",
      "gmbl": [
        "(define A point (inter-lc (line C F) (coa F B) (rs-opp-sides C (line F B))))"
      ],
      "geosolver": [
        "A = Point(1+Distance(F, B), 0)"
      ],
      "condition_indices": [],
      "construction_names": [
        "A"
      ],
      "status": "equivalent_construction"
    },
    {
      "id": "H03",
      "statement_ja": "DA=DC、ACの半直線はDABの内角二等分。",
      "gmbl": [
        "(param D point); (assert (cong D A D C)); (assert (i-bisector C D A B))"
      ],
      "geosolver": [
        "D = Point(dx, dy)",
        "bis_DAB = AngleBisector(D, A, B)",
        "conditions[1]: Distance(D, A) = Distance(D, C)",
        "conditions[2]: OnLine(C, bis_DAB) = 0",
        "conditions[3]: Dot(Vector(A, C), Vector(A, D)/Distance(A, D)+Vector(A, B)/Distance(A, B)) > 0"
      ],
      "condition_indices": [
        1,
        2,
        3
      ],
      "construction_names": [
        "D",
        "bis_DAB"
      ],
      "status": "matched"
    },
    {
      "id": "H04",
      "statement_ja": "EA=ED、ADの半直線はEACの内角二等分。",
      "gmbl": [
        "(param E point); (assert (cong E A E D)); (assert (i-bisector D E A C))"
      ],
      "geosolver": [
        "E = Point(ex, ey)",
        "bis_EAC = AngleBisector(E, A, C)",
        "conditions[4]: Distance(E, A) = Distance(E, D)",
        "conditions[5]: OnLine(D, bis_EAC) = 0",
        "conditions[6]: Dot(Vector(A, D), Vector(A, E)/Distance(A, E)+Vector(A, C)/Distance(A, C)) > 0"
      ],
      "condition_indices": [
        4,
        5,
        6
      ],
      "construction_names": [
        "E",
        "bis_EAC"
      ],
      "status": "matched"
    },
    {
      "id": "H05",
      "statement_ja": "MはCF中点。AMXEは非退化平行四辺形。",
      "gmbl": [
        "(define M point (midp C F)); (define X point (inter-ll (para-at E (line M A)) (para-at M (line A E))))"
