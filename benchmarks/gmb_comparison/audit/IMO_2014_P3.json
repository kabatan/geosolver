    "justification": "凸四角形の辺ABは非零であり、指定条件は直角・所属・角度差・接線で尺度不変。 平行移動2自由度・回転1自由度・正の一様拡大縮小1自由度のみを除く。残りの図形の形は固定しない。",
    "scale_invariant": true,
    "reflection_fixed": false
  },
  "clauses": [
    {
      "id": "H01",
      "statement_ja": "ABCDは非退化な凸四角形。鏡像の両向きを残す。",
      "gmbl": [
        "(param (A B C D) polygon)"
      ],
      "geosolver": [
        "A = Point(0, 0)",
        "B = Point(1, 0)",
        "C = Point(cx, cy)",
        "D = Point(dx, dy)",
        "conditions[0]: ((B.x-A.x)*(C.y-A.y)-(B.y-A.y)*(C.x-A.x)) != 0",
        "conditions[1]: ((B.x-A.x)*(C.y-A.y)-(B.y-A.y)*(C.x-A.x))*((C.x-B.x)*(D.y-B.y)-(C.y-B.y)*(D.x-B.x)) > 0",
        "conditions[2]: ((B.x-A.x)*(C.y-A.y)-(B.y-A.y)*(C.x-A.x))*((D.x-C.x)*(A.y-C.y)-(D.y-C.y)*(A.x-C.x)) > 0",
        "conditions[3]: ((B.x-A.x)*(C.y-A.y)-(B.y-A.y)*(C.x-A.x))*((A.x-D.x)*(B.y-D.y)-(A.y-D.y)*(B.x-D.x)) > 0"
      ],
      "condition_indices": [
        0,
        1,
        2,
        3
      ],
      "construction_names": [
        "A",
        "B",
        "C",
        "D"
      ],
      "status": "matched"
    },
    {
      "id": "H02",
      "statement_ja": "BとDの内角が直角。",
      "gmbl": [
        "(assert (right A B C)); (assert (right C D A))"
      ],
      "geosolver": [
        "conditions[4]: Dot(Vector(B, A), Vector(B, C)) = 0",
        "conditions[5]: Dot(Vector(D, C), Vector(D, A)) = 0"
      ],
      "condition_indices": [
        4,
        5
      ],
      "construction_names": [],
      "status": "matched"
    },
    {
      "id": "H03",
      "statement_ja": "HはAからBDへの垂足。",
      "gmbl": [
        "(define H point (foot A (line B D)))"
      ],
      "geosolver": [
        "H = FootOfPerpendicular(A, Line(B, D))"
      ],
      "condition_indices": [],
      "construction_names": [
        "H"
      ],
      "status": "matched"
    },
    {
      "id": "H04",
      "statement_ja": "SはAB、TはADの内部に置く。",
      "gmbl": [
        "(param S point (on-seg A B)); (param T point (on-seg A D))"
      ],
      "geosolver": [
        "S = PointOnSegment(A, B, s)",
        "T = PointOnSegment(A, D, t)",
        "conditions[6]: s > 0",
        "conditions[7]: s < 1",
        "conditions[8]: t > 0",
        "conditions[9]: t < 1"
      ],
      "condition_indices": [
        6,
        7,
        8,
        9
      ],
      "construction_names": [
        "S",
        "T"
      ],
      "status": "matched"
    },
    {
      "id": "H05",
      "statement_ja": "Hは三角形SCTの厳密内部。",
      "gmbl": [
        "(assert (in-poly H S C T))"
      ],
      "geosolver": [
        "conditions[10]: ((C.x-S.x)*(T.y-S.y)-(C.y-S.y)*(T.x-S.x))*((C.x-S.x)*(H.y-S.y)-(C.y-S.y)*(H.x-S.x)) > 0",
        "conditions[11]: ((C.x-S.x)*(T.y-S.y)-(C.y-S.y)*(T.x-S.x))*((T.x-C.x)*(H.y-C.y)-(T.y-C.y)*(H.x-C.x)) > 0",
        "conditions[12]: ((C.x-S.x)*(T.y-S.y)-(C.y-S.y)*(T.x-S.x))*((S.x-T.x)*(H.y-T.y)-(S.y-T.y)*(H.x-T.x)) > 0"
      ],
      "condition_indices": [
        10,
        11,
        12
      ],
