  "source_differences": [
    {
      "id": "gmb_runtime_distinctness",
      "kind": "runtime_acceptance_policy",
      "blocking": false,
      "description_ja": "GMBは全登録点の最小距離0.1とweighted soft lossで受理する。原文にない全点相異・最小距離0.1はGeoSolver条件に移さず、両者の出力を別の共通検査器で再検査する。"
    },
    {
      "id": "gmb_polygon_sampler",
      "kind": "runtime_parameterization",
      "blocking": false,
      "description_ja": "GMB polygonは角のtanh範囲（四角形は30°～150°）と基準辺の1/2～3/2の辺長範囲、弱い閉鎖lossを用いる。GeoSolverは凸性だけを数式で課し、原文にない角・辺長範囲は移さない。"
    },
    {
      "id": "in_poly_boundary",
      "kind": "runtime_relaxation",
      "blocking": false,
      "description_ja": "GMBのin-poly assertは符号の非負をsoft lossで検査し境界も零になり得る。原文insideは厳密内部として各辺の符号積>0を使う。"
    }
  ],
