      "status": "matched"
    },
    {
      "id": "H06",
      "statement_ja": "CHSとCSBの角度差はπ/2。",
      "gmbl": [
        "(assert (= (div pi 2) (sub (uangle C H S) (uangle C S B))))"
      ],
      "geosolver": [
        "conditions[13]: Angle(C, H, S)-Angle(C, S, B) = pi/2"
