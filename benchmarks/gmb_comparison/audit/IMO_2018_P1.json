      "id": "H01",
      "statement_ja": "ABCは鋭角三角形でΓは外接円。",
      "gmbl": [
        "(param (A B C) acute-tri); (define Gamma circle (circumcircle A B C))"
      ],
      "geosolver": [
        "A = Point(0, 0)",
        "B = Point(1, 0)",
        "C = Point(cx, cy)",
        "Gamma = Circumcircle(A, B, C)",
        "conditions[0]: Area(A, B, C) > 0",
        "conditions[1]: Dot(Vector(A, B), Vector(A, C)) > 0",
        "conditions[2]: Dot(Vector(B, A), Vector(B, C)) > 0",
        "conditions[3]: Dot(Vector(C, A), Vector(C, B)) > 0"
      ],
      "condition_indices": [
        0,
        1,
        2,
        3
      ],
      "construction_names": [
        "A",
        "B",
        "C",
        "Gamma"
      ],
      "status": "matched"
    },
    {
      "id": "H02",
      "statement_ja": "D∈AB、E∈ACかつAD=AE。D=BやE=Cでは垂直二等分線が未定義、D=E=Aでは結論の直線DEが未定義なので非退化内部を使う。",
      "gmbl": [
        "(param D point (on-seg A B)); (param E point (on-seg A C)); (assert (cong A D A E))"
      ],
      "geosolver": [
        "D = PointOnSegment(A, B, d)",
        "E = PointOnSegment(A, C, e)",
        "conditions[4]: d > 0",
        "conditions[5]: d < 1",
        "conditions[6]: e > 0",
        "conditions[7]: e < 1",
        "conditions[8]: Distance(A, D) = Distance(A, E)"
      ],
      "condition_indices": [
        4,
        5,
        6,
        7,
        8
      ],
      "construction_names": [
        "D",
        "E"
      ],
      "status": "matched"
    },
    {
      "id": "H03",
      "statement_ja": "FはBDの垂直二等分線とΓの短弧ABの交点。",
      "gmbl": [
        "(define F point (inter-lc (perp-bis B D) Gamma (rs-opp-sides C (line A B))))"
      ],
      "geosolver": [
        "F = PointOnCircle(Gamma, f)",
        "bis_BD = PerpendicularBisector(B, D)",
        "conditions[9]: OnLine(F, bis_BD) = 0",
        "conditions[11]: ((B.x-A.x)*(F.y-A.y)-(B.y-A.y)*(F.x-A.x))*((B.x-A.x)*(C.y-A.y)-(B.y-A.y)*(C.x-A.x)) < 0"
      ],
      "condition_indices": [
        9,
        11
      ],
      "construction_names": [
        "F",
        "bis_BD"
      ],
      "status": "equivalent_construction"
    },
    {
      "id": "H04",
      "statement_ja": "GはCEの垂直二等分線とΓの短弧ACの交点。",
      "gmbl": [
        "(define G point (inter-lc (perp-bis C E) Gamma (rs-opp-sides B (line A C))))"
