    },
    {
      "id": "chord-EF",
      "statement_ja": "EFの支持直線はAOの垂直二等分線、E,Fは円との異なる二交点。",
      "gmbl": [
        "(define E point (inter-lc (perp-bis A O) (coa O B) rs-arbitrary))",
        "(define F point (inter-lc (perp-bis A O) (coa O B) (rs-neq E)))"
      ],
      "geosolver": [
        "bisectorAO = PerpendicularBisector(A, O)",
        "E = PointOnLine(bisectorAO, te)",
        "OnCircle(E, omega) = 0",
        "H = FootOfPerpendicular(E, Line(A, O))",
        "F = Point(2*H.x - E.x, 2*H.y - E.y)",
        "Distance(E, F) > 0"
      ],
      "status": "matched"
    },
    {
      "id": "arc-midpoint",
      "statement_ja": "Dは短い弧ABの中点。",
      "gmbl": [
        "(define D point (amidp-opp A B C))"
      ],
      "geosolver": [
        "arcAB = Arc(omega, A, B, excluding=C)",
        "D = PointOnArc(arcAB, 1/2)"
      ],
      "status": "matched"
    },
    {
      "id": "parallel-intersection",
      "statement_ja": "Oを通りADに平行な直線とACの交点がJ。",
      "gmbl": [
        "(define J point (inter-ll (para-at O (line A D)) (line A C)))"
      ],
      "geosolver": [
        "J = Intersect(ParallelLine(Line(A, D), O), Line(A, C))"
      ],
      "status": "matched"
    }
