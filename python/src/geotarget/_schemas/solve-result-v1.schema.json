{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.geotarget.dev/solve-result-v1.schema.json",
  "title": "GeoTarget SolveResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exact_answers",
    "provisional_answers",
    "search_status",
    "target_image_status",
    "coverage",
    "environment_lock",
    "evidence_log"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.solve-result/v1"},
    "exact_answers": {"type": "array", "items": {"$ref": "#/$defs/exactAnswer"}},
    "provisional_answers": {"type": "array", "items": {"$ref": "#/$defs/provisionalAnswer"}},
    "search_status": {
      "enum": [
        "deadline_reached",
        "cancelled",
        "resource_exhausted",
        "finished_unknown",
        "complete_certified",
        "empty_certified"
      ]
    },
    "target_image_status": {
      "enum": [
        "unknown",
        "finite_observed",
        "likely_continuous",
        "complete_certified",
        "empty_certified"
      ]
    },
    "coverage": {"$ref": "#/$defs/coverage"},
    "environment_lock": {"$ref": "#/$defs/environmentLock"},
    "evidence_log": {"$ref": "#/$defs/evidenceLog"}
  },
  "allOf": [
    {
      "if": {"properties": {"search_status": {"const": "complete_certified"}}},
      "then": {
        "properties": {
          "target_image_status": {"enum": ["complete_certified", "empty_certified"]}
        }
      }
    },
    {
      "if": {"properties": {"search_status": {"const": "empty_certified"}}},
      "then": {"properties": {"target_image_status": {"const": "empty_certified"}}}
    }
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
    "pluginId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "numericValue": {
      "oneOf": [
        {"type": "number"},
        {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$",
          "maxLength": 4096
        }
      ]
    },
    "integerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "positiveIntegerString": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"$ref": "#/$defs/integerString"},
        "denominator": {"$ref": "#/$defs/positiveIntegerString"}
      }
    },
    "rationalInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/rational"},
        "upper": {"$ref": "#/$defs/rational"}
      }
    },
    "numericEnclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"$ref": "#/$defs/numericValue"},
        "upper": {"$ref": "#/$defs/numericValue"}
      }
    },
    "certificateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "media_type", "payload_base64", "digest"],
      "properties": {
        "scheme": {"$ref": "#/$defs/stableId"},
        "media_type": {"type": "string", "minLength": 1},
        "payload_base64": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "configurationCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_hash", "configuration_hash", "artifact"],
      "properties": {
        "problem_hash": {"$ref": "#/$defs/sha256"},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/certificateArtifact"}
      }
    },
    "targetCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_hash", "identity_hash", "artifact"],
      "properties": {
        "problem_hash": {"$ref": "#/$defs/sha256"},
        "identity_hash": {"$ref": "#/$defs/sha256"},
        "artifact": {"$ref": "#/$defs/certificateArtifact"}
      }
    },
    "algebraicIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coefficients", "isolating_interval", "real_root_index"],
      "properties": {
        "coefficients": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/integerString"}
        },
        "isolating_interval": {"$ref": "#/$defs/rationalInterval"},
        "real_root_index": {"type": "integer", "minimum": 1}
      }
    },
    "branchDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["choice_node", "key"],
      "properties": {
        "choice_node": {"$ref": "#/$defs/stableId"},
        "key": {"$ref": "#/$defs/stableId"}
      }
    },
    "exactAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "approximation",
        "branch_signature",
        "configuration_certificate",
        "target_certificate"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/algebraicIdentity"},
        "approximation": {"$ref": "#/$defs/numericValue"},
        "branch_signature": {
          "type": "array",
          "items": {"$ref": "#/$defs/branchDecision"}
        },
        "configuration_certificate": {"$ref": "#/$defs/configurationCertificate"},
        "target_certificate": {"$ref": "#/$defs/targetCertificate"}
      }
    },
    "validationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem_hash",
        "configuration_hash",
        "method",
        "precision_bits",
        "independent",
        "artifact"
      ],
      "properties": {
        "problem_hash": {"$ref": "#/$defs/sha256"},
        "configuration_hash": {"$ref": "#/$defs/sha256"},
        "method": {"$ref": "#/$defs/stableId"},
        "precision_bits": {"type": "integer", "minimum": 53},
        "independent": {"const": true},
        "artifact": {"$ref": "#/$defs/certificateArtifact"}
      }
    },
    "guardEnclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "enclosure", "strict"],
      "properties": {
        "node": {"$ref": "#/$defs/stableId"},
        "enclosure": {"$ref": "#/$defs/numericEnclosure"},
        "strict": {"type": "boolean"}
      }
    },
    "exactFailure": {
      "enum": [
        "capability_missing",
        "non_algebraic",
        "recognition_failed",
        "configuration_certificate_failed",
        "target_certificate_failed",
        "guard_not_separated",
        "singular",
        "budget_exhausted",
        "unsupported"
      ]
    },
    "provisionalAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "canonical_residual_bound",
        "branch_signature",
        "guard_enclosures",
        "validation",
        "exact_failure",
        "exact_failure_detail"
      ],
      "properties": {
        "target": {"$ref": "#/$defs/numericEnclosure"},
        "canonical_residual_bound": {"$ref": "#/$defs/numericValue"},
        "branch_signature": {
          "type": "array",
          "items": {"$ref": "#/$defs/branchDecision"}
        },
        "guard_enclosures": {
          "type": "array",
          "items": {"$ref": "#/$defs/guardEnclosure"}
        },
        "validation": {"$ref": "#/$defs/validationEvidence"},
        "exact_failure": {"$ref": "#/$defs/exactFailure"},
        "exact_failure_detail": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_waves",
        "proposed_tasks",
        "completed_tasks",
        "pending_tasks",
        "explored_shells",
        "last_new_target_seconds"
      ],
      "properties": {
        "independent_waves": {"type": "integer", "minimum": 0},
        "proposed_tasks": {"type": "integer", "minimum": 0},
        "completed_tasks": {"type": "integer", "minimum": 0},
        "pending_tasks": {"type": "integer", "minimum": 0},
        "explored_shells": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        },
        "last_new_target_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "pluginLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_id", "version", "core_abi", "content_hash"],
      "properties": {
        "plugin_id": {"$ref": "#/$defs/pluginId"},
        "version": {"$ref": "#/$defs/semver"},
        "core_abi": {"$ref": "#/$defs/semver"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "environmentLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_hash", "plugin_locks", "policy_hash", "environment_hash"],
      "properties": {
        "problem_hash": {"$ref": "#/$defs/sha256"},
        "plugin_locks": {"type": "array", "items": {"$ref": "#/$defs/pluginLock"}},
        "policy_hash": {"$ref": "#/$defs/sha256"},
        "environment_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidenceLog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "location"],
      "properties": {
        "content_hash": {"$ref": "#/$defs/sha256"},
        "location": {"type": "string", "pattern": ".*\\S.*"}
      }
    }
  }
}
