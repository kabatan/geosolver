+def test_underdetermined_closure_uses_a_local_rank_chart() -> None:
+    """A gauge freedom must not block closure of all source residuals."""
+
+    class _UnderdeterminedEvaluator:
+        def evaluate_hp_residual(self, values, *, precision: int):
+            _ = precision
+            residual = mp.mpf(values[0]) + mp.mpf(values[1]) - 3
+            return HPResidualEvaluation(
+                residual_vector=[residual],
+                residual_norm_hp=abs(residual),
+                evaluation_status=EvaluationStatus.OK,
+                is_finite=True,
+            )
+
+    result = _run_findroot_closure(
+        evaluator=_UnderdeterminedEvaluator(),
+        start_point=[mp.mpf("1"), mp.mpf("2.00000000000000000001")],
+        bounds=((mp.mpf("-10"), mp.mpf("10")),) * 2,
+        dps=100,
+        target_residual=mp.mpf("1e-70"),
+        max_steps=200,
+    )
+
+    assert result is not None
+    point, residual_norm = result
+    assert abs(point[0] + point[1] - 3) <= mp.mpf("1e-70")
+    assert residual_norm <= mp.mpf("1e-70")
