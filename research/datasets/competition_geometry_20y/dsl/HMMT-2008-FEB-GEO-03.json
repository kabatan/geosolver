    {"name": "O", "expr": "Point(r,r)"},
    {"name": "omega", "expr": "Circle(O,r)"},
    {"name": "X", "expr": "Point(r,0)"},
    {"name": "Y", "expr": "Point(0,r)"},
    {"name": "Xp", "expr": "Point(2*r,r)"},
    {"name": "Yp", "expr": "Point(r,2*r)"},
    {"name": "L2", "expr": "c*c+36"},
    {"name": "f", "expr": "r*(c+6)-6*c"},
    {"name": "hx", "expr": "r-f*c/L2"},
    {"name": "hy", "expr": "r-f*6/L2"},
    {"name": "h", "expr": "sqrt(r*r-f*f/L2)"},
    {"name": "U", "expr": "Point(hx-6*h/sqrt(L2),hy+c*h/sqrt(L2))"},
