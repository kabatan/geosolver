{
  "id": "HMMT-2008-FEB-GEO-03",
  "task": "solve",
  "source_statement": "[4] Let ABC be a triangle with ∠BAC = 90◦ . A circle is tangent to the sides AB and AC at X and Y respectively, such that the points on the circle diametrically opposite X and Y both lie on the side BC. Given that AB = 6, find the area of the portion of the circle that lies outside the triangle. C Y A X B",
  "clause_ledger": [
    {"source": "right triangle at A, AB=6", "dsl": "A=(0,0), B=(6,0), C=(0,c)", "kind": "construction/constraint"},
    {"source": "circle tangent to AB and AC at X,Y", "dsl": "O=(r,r), omega=Circle(O,r), X=(r,0), Y=(0,r)", "kind": "construction"},
    {"source": "diametrically opposite X,Y lie on BC", "dsl": "Xp=(2r,r), Yp=(r,2r) and both have zero oriented area with B,C", "kind": "constraint"},
    {"source": "portion of circle outside triangle", "dsl": "the circular cap cut off by BC: sector(UOV) minus triangle UOV, where U,V are the two BC/omega intersections", "kind": "answer-definition"},
    {"source": "area outside", "dsl": "r*r*Angle(U,O,V)/2 - Area(U,O,V)", "kind": "answer"}
  ],
  "variables": {"names": ["c", "r"]},
  "construction": [
    {"name": "A", "expr": "Point(0,0)"},
    {"name": "B", "expr": "Point(6,0)"},
