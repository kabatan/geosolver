    {"name": "Gamma", "expr": "Circumcircle(A,B,C)"},
    {"name": "D", "expr": "Intersect(Line(A,M),Gamma,exclude=A)"},
    {"name": "O", "expr": "Circumcenter(A,B,C)"}
  ],
  "constraints": [
    {"def": "Angle(B,A,C)", "value": "pi/4"},
    {"def": "Distance(A,M)", "value": "2*Distance(M,D)"}
  ],
  "guards": ["AssumeGt(s,0)", "AssumeGt(Ay,0)", "AssumeGt(Distance(A,M),0)"],
  "answer": "cos(Angle(A,O,D))",
  "post_process": ""
