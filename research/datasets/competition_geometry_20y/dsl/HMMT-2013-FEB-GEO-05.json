{
  "id": "HMMT-2013-FEB-GEO-05",
  "task": "solve",
  "source_statement": "In triangle ABC, ∠A = 45◦ and M is the midpoint of BC. AM intersects the circumcircle of ABC for the second time at D, and AM = 2M D. Find cos ∠AOD, where O is the circumcenter of ABC.",
  "clause_ledger": [
    {"source": "angle A=45 degrees", "dsl": "Angle(B,A,C)=pi/4", "kind": "constraint"},
    {"source": "M midpoint of BC", "dsl": "M=Midpoint(B,C)", "kind": "construction"},
    {"source": "D second intersection of AM and circumcircle", "dsl": "D=Intersect(Line(A,M),Gamma,exclude=A)", "kind": "construction"},
    {"source": "AM=2MD", "dsl": "direct distance equality", "kind": "constraint"},
    {"source": "cos angle AOD", "dsl": "cos(Angle(A,O,D))", "kind": "answer"}
  ],
  "variables": {"names": ["s", "Ax", "Ay"]},
  "construction": [
