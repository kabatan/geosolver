    {"source": "omega is the incircle", "dsl": "omega=Incircle(A,B,C)", "kind": "construction"},
    {"source": "M is tangency point on AC", "dsl": "M=IncircleContactPoint(A,B,C,side='CA')", "kind": "construction"},
    {"source": "BM meets omega again at L", "dsl": "L=Intersect(Line(B,M),omega,exclude=M)", "kind": "construction"},
    {"source": "BL", "dsl": "Distance(B,L)", "kind": "answer"}
  ],
  "variables": {"names": ["b", "c"]},
  "construction": [
