    {"name": "r2", "expr": "13/2"},
    {"name": "omega2", "expr": "Circle(O2,r2)"},
    {"name": "T", "expr": "FootOfPerpendicular(O2,Line(A,B))"},
    {"name": "E", "expr": "Intersect(Line(A,D),omega1,exclude=A)"}
