{
  "id": "HMMT-2012-FEB-GEO-04",
  "task": "solve",
  "source_statement": "There are circles ω1 and ω2 . They intersect in two points, one of which is the point A. B lies on ω1 such that AB is tangent to ω2 . The tangent to ω1 at B intersects ω2 at C and D, where D is the closer to B. AD intersects ω1 again at E. If BD = 3 and CD = 13, find EB/ED.",
  "clause_ledger": [
    {"source": "tangent to omega1 at B meets omega2 at C,D with BD=3, CD=13", "dsl": "B=(0,0), D=(3,0), C=(16,0), omega1 center on the vertical through B, and omega2 through C,D", "kind": "construction"},
    {"source": "AB tangent to omega2 at A and A on both circles", "dsl": "OnCircle(A,omega1), OnCircle(A,omega2), IsTangent(Line(A,B),omega2)=0", "kind": "constraint"},
    {"source": "AD meets omega1 again at E", "dsl": "E=Intersect(Line(A,D),omega1,exclude=A)", "kind": "construction"},
    {"source": "EB/ED", "dsl": "Distance(E,B)/Distance(E,D)", "kind": "answer"}
  ],
  "variables": {"names": []},
  "construction": [
