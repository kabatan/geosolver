      "kind": "construction/constraint/guard"
    },
    {
      "source": "P,Q,R,S are the four stated half-line intersections",
      "dsl": "direct line intersections; line carrier preserves the source incidence",
      "kind": "construction"
    },
    {
      "source": "four given angles",
      "dsl": "direct Angle constraints in radians",
      "kind": "constraint"
    },
    {
      "source": "T=BE∩CF and asks angle BTC",
