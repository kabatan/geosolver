{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/schemas/benchmark-manifest.schema.json",
  "title": "GeoTarget Benchmark Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "manifest_version",
    "status",
    "partition",
    "access_policy",
    "family_grouping_rule",
    "truth_policy",
    "tested_envelope_ref",
    "budgets_seconds",
    "seed_count",
    "metrics",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "benchmark_id": {"type": "string", "pattern": "^BENCH-[A-Z0-9._-]+$"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["development", "locked", "blind", "burned", "prospective"]},
    "partition": {"enum": ["D1", "D2", "V1", "F1", "X1", "P1", "FUZZ"]},
    "access_policy": {"type": "string", "minLength": 10},
    "family_grouping_rule": {"type": "string", "minLength": 10},
    "truth_policy": {"type": "string", "minLength": 10},
    "tested_envelope_ref": {"type": "string"},
    "budgets_seconds": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "minimum": 0}
    },
    "seed_count": {"type": "integer", "minimum": 1},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "family_id",
        "generator_id",
        "instance_id",
        "problem_sha256",
        "truth_level",
        "truth_artifact",
        "truth_sha256",
        "exact_eligible",
        "strata",
        "unknown_level"
      ],
      "properties": {
        "case_id": {"type": "string"},
        "family_id": {"type": "string"},
        "generator_id": {"type": "string"},
        "instance_id": {"type": "string"},
        "problem_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "truth_level": {"enum": ["analytic", "validated_interval", "restricted_exact", "independent_formulations", "reference_only"]},
        "truth_artifact": {"type": "string"},
        "truth_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exact_eligible": {"type": "boolean"},
        "strata": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^S[1-8]$"}
        },
        "unknown_level": {"enum": ["U1", "U2", "U3", "U4", "U5"]}
      }
    }
  }
}
