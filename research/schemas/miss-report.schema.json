{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/schemas/miss-report.schema.json",
  "title": "GeoTarget Miss Analyzer Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analyzer_version",
    "case_id",
    "run_id",
    "outcome",
    "failure_id",
    "checkpoint",
    "missing_validated_target_ids",
    "missing_exact_target_ids",
    "safety_violation_count",
    "evidence",
    "unclassified_reason_codes",
    "inputs"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.miss-report/v1"},
    "analyzer_version": {"const": "0.1.0"},
    "case_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["no_failure", "classified", "unknown"]},
    "failure_id": {
      "type": ["string", "null"],
      "pattern": "^F(?:[0-9]|1[0-8])$"
    },
    "checkpoint": {"type": ["string", "null"]},
    "missing_validated_target_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "missing_exact_target_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "safety_violation_count": {"type": "integer", "minimum": 0},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "signal_kind",
          "subject_kind",
          "subject_id",
          "source",
          "evidence_ref"
        ],
        "properties": {
          "signal_kind": {"type": "string", "minLength": 1},
          "subject_kind": {"enum": ["run", "target", "answer", "task"]},
          "subject_id": {"type": ["string", "null"]},
          "source": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "unclassified_reason_codes": {
      "type": "array",
      "items": {
        "enum": [
          "insufficient_causal_evidence",
          "missing_solver_trace",
          "missing_targets_unclassified",
          "exact_shortfall_unclassified",
          "noncausal_diagnostics_ignored",
          "unassociated_trace_diagnostics_ignored"
        ]
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_log", "checkpoint", "diagnostic_fact_count"],
      "properties": {
        "evidence_log": {"type": "boolean"},
        "checkpoint": {"type": "boolean"},
        "diagnostic_fact_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
