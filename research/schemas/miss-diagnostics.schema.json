{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/schemas/miss-diagnostics.schema.json",
  "title": "GeoTarget Miss Analyzer Diagnostic Facts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "facts"],
  "properties": {
    "schema_version": {"const": "geotarget.miss-diagnostics/v1"},
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_kind",
        "subject_id",
        "source",
        "evidence_ref",
        "causal"
      ],
      "properties": {
        "kind": {
          "enum": [
            "gold_truth_invalid",
            "reference_compiled_mismatch",
            "domain_invalid",
            "scaling_invalid",
            "capture_region_not_entered",
            "capture_region_entered",
            "local_solver_failed",
            "nonzero_stationary_point",
            "guard_invalid",
            "branch_invalid",
            "singular_or_manifold_inconclusive",
            "archive_witness_lost",
            "scheduler_starvation_or_duplicate_work",
            "refinement_failed",
            "configuration_certificate_failed",
            "target_identity_failed",
            "output_mismatch_or_false_complete",
            "adaptive_shell_not_covered",
            "nondeterministic_replay",
            "same_budget_overhead_gate_failed"
          ]
        },
        "subject_kind": {"enum": ["run", "target", "answer", "task"]},
        "subject_id": {"type": ["string", "null"]},
        "source": {
          "enum": [
            "independent_truth_audit",
            "reference_differential",
            "instrumented_capture",
            "counterfactual_replay",
            "canonical_validation",
            "archive_audit",
            "scheduler_audit",
            "output_audit",
            "determinism_audit",
            "performance_comparison"
          ]
        },
        "evidence_ref": {"type": "string", "minLength": 1},
        "causal": {"type": "boolean"}
      }
    }
  }
}
