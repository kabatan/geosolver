{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/schemas/run-manifest.schema.json",
  "title": "GeoTarget Research Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "experiment_id",
    "variant_id",
    "started_at",
    "repository",
    "environment",
    "problem",
    "policy",
    "randomness",
    "budget",
    "artifacts",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9._-]+$"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z]+-[0-9]{3}$"},
    "variant_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
    "finished_at": {"type": ["string", "null"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "branch"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "branch": {"type": "string"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "julia_version",
        "python_version",
        "manifest_sha256",
        "os",
        "architecture",
        "cpu",
        "julia_threads",
        "blas_threads"
      ],
      "properties": {
        "julia_version": {"type": "string"},
        "python_version": {"type": "string"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "os": {"type": "string"},
        "architecture": {"type": "string"},
        "cpu": {"type": "string"},
        "julia_threads": {"type": "integer", "minimum": 1},
        "blas_threads": {"type": "integer", "minimum": 1}
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["benchmark_manifest", "case_id", "family_id", "problem_sha256", "plugin_lock_sha256"],
      "properties": {
        "benchmark_manifest": {"type": "string"},
        "case_id": {"type": "string"},
        "family_id": {"type": "string"},
        "problem_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plugin_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_id", "policy_id", "policy_sha256", "card_sha256"],
      "properties": {
        "baseline_id": {"type": "string"},
        "policy_id": {"type": "string"},
        "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "generator", "proposal_artifact", "proposal_sha256"],
      "properties": {
        "seed": {"type": "integer"},
        "generator": {"type": "string"},
        "proposal_artifact": {"type": "string"},
        "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "launch_limit", "local_maxiters", "includes_compile", "includes_screening"],
      "properties": {
        "wall_seconds": {"type": "number", "minimum": 0},
        "launch_limit": {"type": ["integer", "null"], "minimum": 1},
        "local_maxiters": {"type": "integer", "minimum": 1},
        "includes_compile": {"type": "boolean"},
        "includes_screening": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_log", "summary", "stdout", "stderr"],
      "properties": {
        "evidence_log": {"type": "string"},
        "summary": {"type": "string"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"}
      }
    },
    "status": {
      "enum": ["planned", "running", "completed", "cancelled", "budget_exhausted", "failed_infrastructure"]
    }
  }
}
