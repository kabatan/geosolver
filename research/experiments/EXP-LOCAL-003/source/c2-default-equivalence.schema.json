{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/c2-default-equivalence.schema.json",
  "title": "EXP-LOCAL-003 independent AppContainer L0 equivalence and isolated-test evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "card_sha256",
    "stage",
    "stage_input_anchor_commit",
    "stage_input_anchor_sha256",
    "preimplementation_lock_sha256",
    "local_options_sha256",
    "claim_reference",
    "baseline_variant",
    "candidate_mechanism_enabled",
    "runtime_sources",
    "test_sources",
    "fixture_sources",
    "golden_sources",
    "c0_reference_authority",
    "source_manifest_sha256",
    "comparisons",
    "comparison_manifest_sha256",
    "isolated_test_execution",
    "isolated_test_execution_manifest_sha256",
    "passed"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.c2-default-equivalence/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"const": "development"},
    "stage_input_anchor_commit": {"$ref": "#/$defs/git_oid"},
    "stage_input_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "preimplementation_lock_sha256": {"$ref": "#/$defs/sha256"},
    "local_options_sha256": {"$ref": "#/$defs/sha256"},
    "claim_reference": {"$ref": "#/$defs/content_sha256"},
    "baseline_variant": {"const": "L0-SEMANTIC"},
    "candidate_mechanism_enabled": {"const": false},
    "runtime_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "test_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "fixture_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "golden_sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "c0_reference_authority": {"$ref": "#/$defs/reference_authority"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "comparisons": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/comparison"},
            {"properties": {"fixture_id": {"const": "JULIA-CORE-DEFAULT"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/comparison"},
            {"properties": {"fixture_id": {"const": "OPAQUE-PLUGIN-DEFAULT"}}}
          ]
        }
      ],
      "items": false
    },
    "comparison_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "isolated_test_execution": {"$ref": "#/$defs/isolated_test_execution"},
    "isolated_test_execution_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "passed": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\/$).+$"
    },
    "absolute_path": {"type": "string", "minLength": 3, "pattern": "^(?:[A-Za-z]:\\\\|/).+"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "environment_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "pattern": "^[^=\\u0000]+$"},
        "value": {"type": "string", "pattern": "^[^\\u0000]*$"}
      }
    },
    "environment": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/environment_entry"}
    },
    "access_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "expected", "observed", "winerror"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "expected": {"enum": ["allowed", "denied"]},
        "observed": {"enum": ["allowed", "denied"]},
        "winerror": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "claim_reference",
        "profile_name",
        "package_sid",
        "profile_storage_path",
        "capabilities",
        "allowed_read_paths",
        "read_identity_manifest_entry_count",
        "read_identity_manifest_sha256",
        "scratch_directory",
        "environment",
        "inherited_handle_roles",
        "process_id",
        "token_is_appcontainer",
        "token_appcontainer_sid_verified",
        "token_integrity_rid",
        "token_elevated",
        "token_capability_count",
        "access_probes",
        "denied_probe_entry_count",
        "denied_probe_manifest_sha256",
        "read_only_probe_entry_count",
        "read_only_probe_manifest_sha256",
        "scratch_access_probe_manifest_sha256",
        "max_processes",
        "child_process_restricted",
        "job_assigned_at_creation",
        "job_membership_verified",
        "job_limit_flags",
        "breakaway_allowed",
        "kill_on_job_close",
        "job_empty",
        "acl_entry_count",
        "original_acl_manifest_sha256",
        "restored_acl_manifest_sha256",
        "acl_exactly_restored",
        "scratch_emptied",
        "profile_deleted",
        "profile_storage_deleted"
      ],
      "properties": {
        "schema_version": {"const": "geotarget.exp-local-003.appcontainer-attestation/v2"},
        "claim_reference": {"$ref": "#/$defs/content_sha256"},
        "profile_name": {"type": "string", "pattern": "^GeoTarget\\.EXPLOCAL003\\.[A-Za-z0-9.-]+$"},
        "package_sid": {"type": "string", "pattern": "^S-[0-9-]+$"},
        "profile_storage_path": {"$ref": "#/$defs/absolute_path"},
        "capabilities": {"type": "array", "maxItems": 0},
        "allowed_read_paths": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/absolute_path"}
        },
        "read_identity_manifest_entry_count": {"type": "integer", "minimum": 1},
        "read_identity_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "scratch_directory": {"$ref": "#/$defs/absolute_path"},
        "environment": {"$ref": "#/$defs/environment"},
        "inherited_handle_roles": {"const": ["stdin", "stdout", "stderr"]},
        "process_id": {"type": "integer", "minimum": 1},
        "token_is_appcontainer": {"const": true},
        "token_appcontainer_sid_verified": {"const": true},
        "token_integrity_rid": {"type": "integer", "minimum": 0, "maximum": 4096},
        "token_elevated": {"const": false},
        "token_capability_count": {"const": 0},
        "access_probes": {
          "type": "array",
          "minItems": 13,
          "maxItems": 14,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/access_probe"}
        },
        "denied_probe_entry_count": {"type": "integer", "minimum": 1},
        "denied_probe_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "read_only_probe_entry_count": {"type": "integer", "minimum": 1},
        "read_only_probe_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "scratch_access_probe_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "max_processes": {"const": 1},
        "child_process_restricted": {"const": true},
        "job_assigned_at_creation": {"const": true},
        "job_membership_verified": {"const": true},
        "job_limit_flags": {"type": "integer", "minimum": 1},
        "breakaway_allowed": {"const": false},
        "kill_on_job_close": {"const": true},
        "job_empty": {"const": true},
        "acl_entry_count": {"type": "integer", "minimum": 1},
        "original_acl_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "restored_acl_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "acl_exactly_restored": {"const": true},
        "scratch_emptied": {"const": true},
        "profile_deleted": {"const": true},
        "profile_storage_deleted": {"const": true}
      }
    },
    "io_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read_operation_count",
        "write_operation_count",
        "other_operation_count",
        "read_transfer_count",
        "write_transfer_count",
        "other_transfer_count"
      ],
      "properties": {
        "read_operation_count": {"$ref": "#/$defs/nonnegative"},
        "write_operation_count": {"$ref": "#/$defs/nonnegative"},
        "other_operation_count": {"$ref": "#/$defs/nonnegative"},
        "read_transfer_count": {"$ref": "#/$defs/nonnegative"},
        "write_transfer_count": {"$ref": "#/$defs/nonnegative"},
        "other_transfer_count": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "mechanism_source_granted",
        "command",
        "environment",
        "return_code",
        "termination_reason",
        "stdout",
        "stderr",
        "wall_time_nanoseconds",
        "total_user_time_100ns",
        "total_kernel_time_100ns",
        "total_processes",
        "terminated_processes",
        "io_accounting",
        "sandbox"
      ],
      "properties": {
        "mode": {"enum": ["reference", "mechanism-disabled"]},
        "mechanism_source_granted": {"type": "boolean"},
        "command": {
          "type": "array",
          "minItems": 10,
          "maxItems": 11,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {"$ref": "#/$defs/environment"},
        "return_code": {"const": 0},
        "termination_reason": {"const": "completed"},
        "stdout": {
          "allOf": [
            {"$ref": "#/$defs/stream"},
            {"properties": {"byte_length": {"minimum": 1}}}
          ]
        },
        "stderr": {
          "allOf": [
            {"$ref": "#/$defs/stream"},
            {
              "properties": {
                "sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
                "byte_length": {"const": 0}
              }
            }
          ]
        },
        "wall_time_nanoseconds": {"type": "integer", "minimum": 1},
        "total_user_time_100ns": {"$ref": "#/$defs/nonnegative"},
        "total_kernel_time_100ns": {"$ref": "#/$defs/nonnegative"},
        "total_processes": {"const": 1},
        "terminated_processes": {"const": 0},
        "io_accounting": {"$ref": "#/$defs/io_accounting"},
        "sandbox": {"$ref": "#/$defs/sandbox"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "reference"}}},
          "then": {
            "properties": {
              "mechanism_source_granted": {"const": false},
              "command": {"maxItems": 10}
            }
          },
          "else": {
            "properties": {
              "mechanism_source_granted": {"const": true},
              "command": {"minItems": 11}
            }
          }
        }
      ]
    },
    "read_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "recursive"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute_path"},
        "recursive": {"type": "boolean"}
      }
    },
    "isolated_test_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "mechanism_source_granted",
        "command",
        "environment",
        "read_grants",
        "return_code",
        "termination_reason",
        "stdout",
        "stderr",
        "wall_time_nanoseconds",
        "total_user_time_100ns",
        "total_kernel_time_100ns",
        "total_processes",
        "terminated_processes",
        "io_accounting",
        "sandbox"
      ],
      "properties": {
        "mode": {"const": "isolated-test"},
        "mechanism_source_granted": {"const": true},
        "command": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {"type": "string", "minLength": 1}
        },
        "environment": {"$ref": "#/$defs/environment"},
        "read_grants": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/read_grant"}
        },
        "return_code": {"const": 0},
        "termination_reason": {"const": "completed"},
        "stdout": {"$ref": "#/$defs/stream"},
        "stderr": {
          "allOf": [
            {"$ref": "#/$defs/stream"},
            {
              "properties": {
                "sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
                "byte_length": {"const": 0}
              }
            }
          ]
        },
        "wall_time_nanoseconds": {"type": "integer", "minimum": 1},
        "total_user_time_100ns": {"$ref": "#/$defs/nonnegative"},
        "total_kernel_time_100ns": {"$ref": "#/$defs/nonnegative"},
        "total_processes": {"const": 1},
        "terminated_processes": {"const": 0},
        "io_accounting": {"$ref": "#/$defs/io_accounting"},
        "sandbox": {"$ref": "#/$defs/sandbox"}
      }
    },
    "reference_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_lock_commit",
        "c0_source_commit",
        "c0_source_tree",
        "environment_lock_sha256",
        "capsule_origin",
        "capsule_files",
        "capsule_manifest_sha256",
        "protocol_sources",
        "protocol_manifest_sha256",
        "reference_child_c2_source_access"
      ],
      "properties": {
        "source_lock_commit": {"$ref": "#/$defs/git_oid"},
        "c0_source_commit": {"$ref": "#/$defs/git_oid"},
        "c0_source_tree": {"$ref": "#/$defs/git_oid"},
        "environment_lock_sha256": {"$ref": "#/$defs/sha256"},
        "capsule_origin": {"const": "immutable-main-git-c0-source-tree"},
        "capsule_files": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/file"}
        },
        "capsule_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_sources": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/file"}
        },
        "protocol_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "reference_child_c2_source_access": {"const": "kernel-denied"}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "fixture",
        "golden",
        "reference_execution",
        "mechanism_disabled_execution",
        "golden_output_sha256",
        "reference_output_sha256",
        "mechanism_disabled_output_sha256",
        "output_byte_length",
        "reference_matches_golden",
        "mechanism_disabled_matches_golden",
        "byte_identical"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"},
        "fixture": {"$ref": "#/$defs/file"},
        "golden": {"$ref": "#/$defs/file"},
        "reference_execution": {
          "allOf": [
            {"$ref": "#/$defs/execution"},
            {"properties": {"mode": {"const": "reference"}}}
          ]
        },
        "mechanism_disabled_execution": {
          "allOf": [
            {"$ref": "#/$defs/execution"},
            {"properties": {"mode": {"const": "mechanism-disabled"}}}
          ]
        },
        "golden_output_sha256": {"$ref": "#/$defs/sha256"},
        "reference_output_sha256": {"$ref": "#/$defs/sha256"},
        "mechanism_disabled_output_sha256": {"$ref": "#/$defs/sha256"},
        "output_byte_length": {"type": "integer", "minimum": 1},
        "reference_matches_golden": {"const": true},
        "mechanism_disabled_matches_golden": {"const": true},
        "byte_identical": {"const": true}
      }
    }
  }
}
