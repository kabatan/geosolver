{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/final-connection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "card_sha256",
    "development_assessment_sha256",
    "development_decision_record_sha256",
    "locked_assessment_sha256",
    "selected_variant",
    "selected_path",
    "development_safety16_clear",
    "locked_stage_passed",
    "product_connection_allowed"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.final-connection/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "development_assessment_sha256": {"$ref": "#/$defs/sha256"},
    "development_decision_record_sha256": {"$ref": "#/$defs/sha256"},
    "locked_assessment_sha256": {"$ref": "#/$defs/sha256"},
    "selected_variant": {"enum": ["LX-BOUNDS", "LR-MODEL", "LXR-BOUNDS-MODEL"]},
    "selected_path": {"enum": ["recall", "efficiency"]},
    "development_safety16_clear": {"type": "boolean"},
    "locked_stage_passed": {"type": "boolean"},
    "product_connection_allowed": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
