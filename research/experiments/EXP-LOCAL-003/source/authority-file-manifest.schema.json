{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/authority-file-manifest.schema.json",
  "title": "EXP-LOCAL-003 closed immutable-vault file manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "card_sha256", "stage", "kind", "files"],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.authority-file-manifest/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "kind": {"enum": ["candidate-run", "assessor-stage"]},
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "candidate-run"}}},
      "then": {
        "properties": {
          "files": {
            "prefixItems": [
              {"$ref": "#/$defs/raw_output"},
              {"$ref": "#/$defs/preexit_seal"},
              {"$ref": "#/$defs/process_exit"}
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "prefixItems": [
              {"$ref": "#/$defs/assessor_truth"},
              {"$ref": "#/$defs/bootstrap_indices"}
            ],
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\/$).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 0}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "file", "media_type", "content_encoding"],
      "properties": {
        "role": {"enum": ["raw_output", "preexit_seal", "process_exit", "assessor_truth", "bootstrap_indices"]},
        "file": {"$ref": "#/$defs/file"},
        "media_type": {"enum": ["application/json", "application/octet-stream"]},
        "content_encoding": {"enum": ["identity", "deterministic-gzip"]}
      }
    },
    "raw_output": {
      "allOf": [
        {"$ref": "#/$defs/entry"},
        {"properties": {"role": {"const": "raw_output"}, "media_type": {"const": "application/json"}, "content_encoding": {"const": "deterministic-gzip"}}}
      ]
    },
    "preexit_seal": {
      "allOf": [
        {"$ref": "#/$defs/entry"},
        {"properties": {"role": {"const": "preexit_seal"}, "media_type": {"const": "application/json"}, "content_encoding": {"const": "identity"}}}
      ]
    },
    "process_exit": {
      "allOf": [
        {"$ref": "#/$defs/entry"},
        {"properties": {"role": {"const": "process_exit"}, "media_type": {"const": "application/json"}, "content_encoding": {"const": "identity"}}}
      ]
    },
    "assessor_truth": {
      "allOf": [
        {"$ref": "#/$defs/entry"},
        {"properties": {"role": {"const": "assessor_truth"}, "media_type": {"const": "application/json"}, "content_encoding": {"const": "deterministic-gzip"}}}
      ]
    },
    "bootstrap_indices": {
      "allOf": [
        {"$ref": "#/$defs/entry"},
        {"properties": {"role": {"const": "bootstrap_indices"}, "media_type": {"const": "application/octet-stream"}, "content_encoding": {"const": "identity"}}}
      ]
    }
  }
}
