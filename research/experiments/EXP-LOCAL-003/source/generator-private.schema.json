{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/research/exp-local-003-generator-private-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_sha256",
    "master_secret_hex",
    "entropy_contract",
    "counter_contract",
    "groups",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "enum": ["exp-local-003-generator-private/v1", "exp-local-003-locked-generator-private/v1"]
    },
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "master_secret_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entropy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "master_secret_bytes",
        "mode",
        "opaque_case_domain_hex",
        "calibration_key_domain_hex",
        "start_key_domain_hex",
        "group_identity_domain_hex",
        "parameter_key_domain_hex",
        "representation_key_domain_hex",
        "gold_key_domain_hex",
        "context_encoding",
        "vault_boundary"
      ],
      "properties": {
        "algorithm": {"const": "HMAC-SHA-256"},
        "master_secret_bytes": {"const": 32},
        "mode": {
          "type": "string",
          "pattern": "^(formal-c1-caller-secret|formal-locked-caller-secret|test-only-deterministic:(default|alternate))$"
        },
        "opaque_case_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "calibration_key_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "start_key_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "group_identity_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "parameter_key_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "representation_key_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "gold_key_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "context_encoding": {"const": "zero-based-uint32be"},
        "vault_boundary": {"const": "generator-private-only"}
      }
    },
    "counter_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_domain_hex",
        "calibration_seed_hex",
        "start_domain_hex",
        "start_seed_hex",
        "binary64_fma"
      ],
      "properties": {
        "calibration_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "calibration_seed_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "start_domain_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
        "start_seed_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary64_fma": {"const": "exact-rational-then-roundTiesToEven"}
      }
    },
    "locked_decision": {"$ref": "#/$defs/lockedAuthorization"},
    "locked_decision_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "groups": {
      "type": "array",
      "minItems": 16,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "latent_group_key",
          "family_id",
          "family_ordinal",
          "latent_group",
          "calibration_key_hex",
          "start_key_hex",
          "parameter_key_hex",
          "gold_key_hex",
          "descriptor_sha256"
        ],
        "properties": {
          "latent_group_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "family_id": {"type": "string"},
          "family_ordinal": {"type": "integer", "minimum": 0, "maximum": 7},
          "latent_group": {"type": "integer", "minimum": 0, "maximum": 5},
          "calibration_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "start_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "parameter_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "gold_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "descriptor_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 64,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opaque_case_key",
          "source_ordinal",
          "latent_group_key",
          "representation",
          "representation_key_hex"
        ],
        "properties": {
          "opaque_case_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_ordinal": {"type": "integer", "minimum": 0, "maximum": 95},
          "latent_group_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "representation": {
            "enum": ["base", "signed-permutation", "semantic-equivalent-row-rescaling", "orthogonal-safety"]
          },
          "representation_key_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  },
  "$defs": {
    "lockedAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "experiment_id",
        "card_sha256",
        "development_gate_passed",
        "selected_variant",
        "selected_path",
        "safety16_disagreement_count",
        "candidate_input_sha256",
        "development_assessment_sha256",
        "decision_commit"
      ],
      "properties": {
        "schema_version": {"const": "geotarget.exp-local-003.development-decision-record/v1"},
        "experiment_id": {"const": "EXP-LOCAL-003"},
        "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
        "development_gate_passed": {"const": true},
        "selected_variant": {"enum": ["LX-BOUNDS", "LR-MODEL", "LXR-BOUNDS-MODEL"]},
        "selected_path": {"enum": ["recall", "efficiency"]},
        "safety16_disagreement_count": {"type": "integer", "minimum": 0},
        "candidate_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "development_assessment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "exp-local-003-generator-private/v1"}}},
      "then": {
        "properties": {
          "entropy_contract": {
            "properties": {
              "mode": {
                "enum": ["formal-c1-caller-secret", "test-only-deterministic:default", "test-only-deterministic:alternate"]
              }
            }
          },
          "locked_decision": false,
          "locked_decision_sha256": false,
          "groups": {
            "minItems": 16,
            "maxItems": 16,
            "items": {"properties": {"latent_group": {"minimum": 0, "maximum": 1}}}
          },
          "cases": {"minItems": 64, "maxItems": 64}
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "exp-local-003-locked-generator-private/v1"}
        }
      },
      "then": {
        "required": ["locked_decision", "locked_decision_sha256"],
        "properties": {
          "entropy_contract": {
            "properties": {"mode": {"const": "formal-locked-caller-secret"}}
          },
          "groups": {
            "minItems": 32,
            "maxItems": 32,
            "items": {"properties": {"latent_group": {"minimum": 2, "maximum": 5}}}
          },
          "cases": {
            "minItems": 96,
            "maxItems": 96,
            "items": {
              "properties": {
                "representation": {
                  "enum": ["base", "signed-permutation", "semantic-equivalent-row-rescaling"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
