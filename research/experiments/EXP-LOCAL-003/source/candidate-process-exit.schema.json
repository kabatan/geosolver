      "properties": {"wall_time_nanoseconds_decimal": {"$ref": "#/$defs/decimal"}, "total_user_time_100ns_decimal": {"$ref": "#/$defs/decimal"}, "total_kernel_time_100ns_decimal": {"$ref": "#/$defs/decimal"}, "total_processes": {"const": 1}, "terminated_processes": {"const": 0}, "read_operation_count_decimal": {"$ref": "#/$defs/decimal"}, "write_operation_count_decimal": {"$ref": "#/$defs/decimal"}, "other_operation_count_decimal": {"$ref": "#/$defs/decimal"}, "read_transfer_count_decimal": {"$ref": "#/$defs/decimal"}, "write_transfer_count_decimal": {"$ref": "#/$defs/decimal"}, "other_transfer_count_decimal": {"$ref": "#/$defs/decimal"}}
