        "capabilities": {"const": []}, "allowed_read_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "read_identity_manifest_entry_count": {"type": "integer", "minimum": 1}, "read_identity_manifest_sha256": {"$ref": "#/$defs/sha256"}, "scratch_directory": {"type": "string", "minLength": 1},
        "environment": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name_value"}}, "inherited_handle_roles": {"const": ["stdin", "stdout", "stderr"]},
        "process_id": {"type": "integer", "minimum": 1}, "token_is_appcontainer": {"const": true}, "token_appcontainer_sid_verified": {"const": true}, "token_integrity_rid": {"const": 4096}, "token_elevated": {"const": false}, "token_capability_count": {"const": 0},
