{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/research/exp-local-003-candidate-inputs-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "card_sha256", "cases"],
  "properties": {
    "schema_version": {
      "enum": ["exp-local-003-candidate-inputs/v1", "exp-local-003-locked-candidate-inputs/v1"]
    },
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "cases": {
      "type": "array",
      "minItems": 64,
      "maxItems": 96,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "exp-local-003-candidate-inputs/v1"}}},
      "then": {"properties": {"cases": {"minItems": 64, "maxItems": 64}}}
    },
    {
      "if": {"properties": {"schema_version": {"const": "exp-local-003-locked-candidate-inputs/v1"}}},
      "then": {"properties": {"cases": {"minItems": 96, "maxItems": 96}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vector": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "number"}},
    "matrix": {"type": "array", "items": {"$ref": "#/$defs/vector"}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_case_key",
        "problem_document",
        "problem_sha256",
        "calibration_points",
        "calibration_points_sha256",
        "starts",
        "starts_sha256",
        "public_numeric_metadata",
        "budget"
      ],
      "properties": {
        "opaque_case_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "problem_document": {"type": "object"},
        "problem_sha256": {"$ref": "#/$defs/digest"},
        "calibration_points": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/vector"}
        },
        "calibration_points_sha256": {"$ref": "#/$defs/digest"},
        "starts": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/vector"}
        },
        "starts_sha256": {"$ref": "#/$defs/digest"},
        "public_numeric_metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimension",
            "relation_count",
            "bounds",
            "origins",
            "variable_scales",
            "relation_scales",
            "logical_capability"
          ],
          "properties": {
            "dimension": {"type": "integer", "minimum": 1, "maximum": 16},
            "relation_count": {"type": "integer", "minimum": 1, "maximum": 64},
            "bounds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "array",
                "prefixItems": [{"type": "number"}, {"type": "number"}],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "origins": {"$ref": "#/$defs/vector"},
            "variable_scales": {"$ref": "#/$defs/vector"},
            "relation_scales": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {"type": "number", "exclusiveMinimum": 0}
            },
            "logical_capability": {"const": "C0"}
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["local_max_iterations", "local_max_evaluations", "launch_prefixes"],
          "properties": {
            "local_max_iterations": {"const": 250},
            "local_max_evaluations": {"const": 2000},
            "launch_prefixes": {
              "type": "array",
              "prefixItems": [{"const": 8}, {"const": 16}, {"const": 32}],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    }
  }
}
