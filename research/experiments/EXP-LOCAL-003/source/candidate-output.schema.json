{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/candidate-output.schema.json",
  "title": "EXP-LOCAL-003 sealed candidate output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "candidate_input_sha256",
    "candidate_process",
    "cases",
    "report_only_times"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.candidate-output/v1"},
    "stage": {"enum": ["development", "locked"]},
    "candidate_input_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_process": {"$ref": "#/$defs/candidate_process"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "report_only_times": {"$ref": "#/$defs/report_only_times"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finite_hex": {
      "type": "string",
      "pattern": "^-?(?:0x0\\.0p\\+0|0x[01]\\.[0-9a-f]{13}p[+-][0-9]+)$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\/](?:[^\\\\]*[^\\\\/])?$"
    },
    "candidate_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaded_source_paths", "opened_artifact_paths"],
      "properties": {
        "loaded_source_paths": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/path"}
        },
        "opened_artifact_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^candidate/(?:[^\\\\]+/?)+$"
          }
        }
      }
    },
    "report_only_times": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_cpu_seconds",
        "end_to_end_cpu_seconds",
        "formal_wall_seconds",
        "host_exclusion_passed"
      ],
      "properties": {
        "process_cpu_seconds": {"type": "number", "minimum": 0},
        "end_to_end_cpu_seconds": {"type": "number", "minimum": 0},
        "formal_wall_seconds": {
          "oneOf": [
            {"type": "number", "minimum": 0},
            {"type": "null"}
          ]
        },
        "host_exclusion_passed": {"type": "boolean"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_case_key",
        "variable_count",
        "residual_count",
        "logical_evaluation_cost",
        "variants"
      ],
      "properties": {
        "opaque_case_key": {"$ref": "#/$defs/sha256"},
        "variable_count": {"type": "integer", "minimum": 1},
        "residual_count": {"type": "integer", "minimum": 1},
        "logical_evaluation_cost": {"type": "integer", "minimum": 1},
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/variant"}
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variant_id",
        "calibration",
        "attempts",
        "semantic_or_wire_drift_count",
        "identity_access_count"
      ],
      "properties": {
        "variant_id": {
          "enum": ["L0-SEMANTIC", "LX-BOUNDS", "LR-MODEL", "LXR-BOUNDS-MODEL"]
        },
        "calibration": {
          "oneOf": [
            {"$ref": "#/$defs/calibration"},
            {"type": "null"}
          ]
        },
        "attempts": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "semantic_or_wire_drift_count": {"$ref": "#/$defs/nonnegative_integer"},
        "identity_access_count": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_index",
        "iterations",
        "accepted",
        "local_observation_evaluation_costs",
        "canonical_replay"
      ],
      "properties": {
        "start_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "iterations": {"$ref": "#/$defs/nonnegative_integer"},
        "accepted": {"type": "boolean"},
        "local_observation_evaluation_costs": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "canonical_replay": {"$ref": "#/$defs/canonical_replay"}
      }
    },
    "canonical_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "configuration_hex",
        "target_hex",
        "branch_label",
        "evaluation_cost"
      ],
      "properties": {
        "valid": {"type": "boolean"},
        "configuration_hex": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/finite_hex"}
            },
            {"type": "null"}
          ]
        },
        "target_hex": {
          "oneOf": [
            {"$ref": "#/$defs/finite_hex"},
            {"type": "null"}
          ]
        },
        "branch_label": {
          "oneOf": [{"type": "string"}, {"type": "null"}]
        },
        "evaluation_cost": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_evaluation_costs",
        "valid_vector_count",
        "nearest_rank_hex",
        "model_scale_hex",
        "model_scale_sha256",
        "joint_fallback_reason",
        "clamp_reasons",
        "nonfinite_q_count",
        "nonfinite_q_misclassification_count"
      ],
      "properties": {
        "observation_evaluation_costs": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "valid_vector_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "nearest_rank_hex": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finite_hex"}
        },
        "model_scale_hex": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finite_hex"}
        },
        "model_scale_sha256": {"$ref": "#/$defs/sha256"},
        "joint_fallback_reason": {
          "oneOf": [
            {
              "enum": [
                "insufficient-valid-vectors",
                "nonfinite-nearest-rank",
                "nonpositive-nearest-rank"
              ]
            },
            {"type": "null"}
          ]
        },
        "clamp_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/clamp_reason"}
        },
        "nonfinite_q_count": {"$ref": "#/$defs/nonnegative_integer"},
        "nonfinite_q_misclassification_count": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "clamp_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"type": "boolean"},
        "upper": {"type": "boolean"}
      }
    }
  }
}
