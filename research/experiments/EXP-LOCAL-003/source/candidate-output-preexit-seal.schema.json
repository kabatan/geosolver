{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/candidate-output-preexit-seal.schema.json",
  "title": "EXP-LOCAL-003 C0 candidate-output pre-exit seal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "card_sha256", "stage", "process_instance_id", "candidate_input_sha256", "launcher_claim", "observer_authority", "sandbox_request_sha256", "preexit_observation", "event", "raw_output", "changed_paths", "ack"],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.candidate-output-preexit-seal/v2"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "process_instance_id": {"$ref": "#/$defs/sha256"},
    "candidate_input_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_claim": {"$ref": "#/$defs/launcher_claim"},
    "observer_authority": {"$ref": "#/$defs/external_file"},
    "sandbox_request_sha256": {"$ref": "#/$defs/sha256"},
    "preexit_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["process_id", "active_processes", "root_process_still_active", "payload_sha256", "payload_byte_length", "observer_elapsed_nanoseconds_decimal", "runner_evaluated_by_observer", "raw_output_stream_closed_before_ack", "ack_pending", "assessor_started", "assessor_vault_opened", "generator_private_vault_opened"],
      "properties": {
        "process_id": {"type": "integer", "minimum": 1},
        "active_processes": {"const": 1},
        "root_process_still_active": {"const": true},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "payload_byte_length": {"type": "integer", "minimum": 1},
        "observer_elapsed_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "runner_evaluated_by_observer": {"const": false},
        "raw_output_stream_closed_before_ack": {"const": true},
        "ack_pending": {"const": true},
        "assessor_started": {"const": false},
        "assessor_vault_opened": {"const": false},
        "generator_private_vault_opened": {"const": false}
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ordinal", "parent"],
      "properties": {
        "kind": {"const": "candidate-output-preexit-seal"},
        "ordinal": {"const": 2},
        "parent": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256"], "properties": {"kind": {"const": "candidate-raw-output"}, "sha256": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "raw_output": {"$ref": "#/$defs/file"},
    "changed_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "candidate-output.json.gz"}},
    "ack": {
      "type": "object", "additionalProperties": false,
      "required": ["token_sha256", "raw_closed_ordinal", "seal_persisted_ordinal", "ack_released_ordinal"],
      "properties": {"token_sha256": {"$ref": "#/$defs/sha256"}, "raw_closed_ordinal": {"const": 1}, "seal_persisted_ordinal": {"const": 2}, "ack_released_ordinal": {"const": 3}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\/$).+$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_length"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"type": "integer", "minimum": 0}}},
    "external_file": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "file"], "properties": {"commit": {"$ref": "#/$defs/git_oid"}, "tree": {"$ref": "#/$defs/git_oid"}, "file": {"$ref": "#/$defs/file"}}},
    "launcher_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "nonce_sha256", "filesystem_identity"],
      "properties": {
        "file": {"$ref": "#/$defs/file"}, "nonce_sha256": {"$ref": "#/$defs/sha256"},
        "filesystem_identity": {"type": "object", "additionalProperties": false, "required": ["device_decimal", "inode_decimal", "empty_claim_ctime_nanoseconds_decimal", "link_count"], "properties": {"device_decimal": {"$ref": "#/$defs/decimal"}, "inode_decimal": {"$ref": "#/$defs/decimal"}, "empty_claim_ctime_nanoseconds_decimal": {"$ref": "#/$defs/decimal"}, "link_count": {"const": 1}}}
      }
    }
  }
}
