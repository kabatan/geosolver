{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/candidate-execution-lock.schema.json",
  "title": "EXP-LOCAL-003 independently frozen candidate execution boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_sha256",
    "stage",
    "candidate_input_sha256",
    "local_options_sha256",
    "stage_input_anchor_sha256",
    "stage_input_anchor_commit",
    "runner_source_path",
    "runner_source_sha256",
    "source_manifest_sha256",
    "allowed_sources",
    "allowed_candidate_artifacts"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.candidate-execution-lock/v1"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "candidate_input_sha256": {"$ref": "#/$defs/sha256"},
    "local_options_sha256": {"$ref": "#/$defs/sha256"},
    "stage_input_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "stage_input_anchor_commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "runner_source_path": {"$ref": "#/$defs/path"},
    "runner_source_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "allowed_sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/file_record"}
    },
    "allowed_candidate_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate_artifact"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\/](?:[^\\\\]*[^\\\\/])?$"
    },
    "file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^candidate/(?:[^\\\\]+/?)+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
