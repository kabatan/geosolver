{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/final-connection-anchor.schema.json",
  "title": "EXP-LOCAL-003 post-C6 final-connection anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "card_sha256", "stage",
    "development_authorization", "locked_stage_input", "locked_execution_lock",
    "candidate_evidence", "assessor_output", "rerun_permitted"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.final-connection-anchor/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"const": "locked"},
    "development_authorization": {"$ref": "#/$defs/external_file"},
    "locked_stage_input": {"$ref": "#/$defs/external_file"},
    "locked_execution_lock": {"$ref": "#/$defs/external_file"},
    "candidate_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "authority"],
      "properties": {
        "commit": {"$ref": "#/$defs/git_oid"},
        "tree": {"$ref": "#/$defs/git_oid"},
        "authority": {"$ref": "#/$defs/file"}
      }
    },
    "assessor_output": {
      "type": "object", "additionalProperties": false,
      "required": [
        "assessment_commit", "assessment_tree", "assessment_file", "authority_file",
        "final_connection_commit", "final_connection_tree", "final_connection_file"
      ],
      "properties": {
        "assessment_commit": {"$ref": "#/$defs/git_oid"},
        "assessment_tree": {"$ref": "#/$defs/git_oid"},
        "assessment_file": {"$ref": "#/$defs/file"},
        "authority_file": {"$ref": "#/$defs/file"},
        "final_connection_commit": {"$ref": "#/$defs/git_oid"},
        "final_connection_tree": {"$ref": "#/$defs/git_oid"},
        "final_connection_file": {"$ref": "#/$defs/final_file"}
      }
    },
    "rerun_permitted": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\/$).+$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "byte_length"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1}
      }
    },
    "final_file": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {"properties": {"path": {"const": "final-connection.json"}}}
      ]
    },
    "external_file": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "file"],
      "properties": {
        "commit": {"$ref": "#/$defs/git_oid"},
        "tree": {"$ref": "#/$defs/git_oid"},
        "file": {"$ref": "#/$defs/file"}
      }
    }
  }
}
