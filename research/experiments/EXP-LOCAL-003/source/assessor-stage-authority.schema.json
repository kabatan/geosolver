{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/assessor-stage-authority.schema.json",
  "title": "EXP-LOCAL-003 formal assessment and exactly-once accounting authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "card_sha256", "stage",
    "stage_input_anchor_sha256", "candidate_run_authority_sha256",
    "candidate_execution_lock_sha256", "candidate_raw_output_sha256",
    "assessor_truth_sha256", "bootstrap_sha256", "assessment_sha256", "accounting"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.assessor-stage-authority/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "stage_input_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_run_authority_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_execution_lock_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_raw_output_sha256": {"$ref": "#/$defs/sha256"},
    "assessor_truth_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "assessment_sha256": {"$ref": "#/$defs/sha256"},
    "accounting": {
      "type": "object", "additionalProperties": false,
      "required": [
        "c1_cpu_nanoseconds_decimal", "candidate_cpu_nanoseconds_decimal",
        "assessor_cpu_nanoseconds_decimal", "end_to_end_cpu_nanoseconds_decimal",
        "c1_wall_nanoseconds_decimal", "candidate_wall_nanoseconds_decimal",
        "assessor_wall_nanoseconds_decimal", "end_to_end_wall_nanoseconds_decimal",
        "formal_wall_host_exclusion_passed", "formal_wall_nanoseconds_decimal", "exactly_once_components"
      ],
      "properties": {
        "c1_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "candidate_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "assessor_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "end_to_end_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "c1_wall_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "candidate_wall_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "assessor_wall_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "end_to_end_wall_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "formal_wall_host_exclusion_passed": {"const": false},
        "formal_wall_nanoseconds_decimal": {"type": "null"},
        "exactly_once_components": {
          "type": "array", "prefixItems": [{"const": "c1"}, {"const": "candidate"}, {"const": "assessor"}], "minItems": 3, "maxItems": 3
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"}
  }
}
