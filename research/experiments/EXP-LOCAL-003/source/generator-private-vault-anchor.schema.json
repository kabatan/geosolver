{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/generator-private-vault-anchor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "card_sha256", "stage",
    "source_lock_commit", "materialization_attempt_claim_sha256",
    "stage_vault_anchor_sha256", "generator_private_vault_git_commit",
    "generator_private_vault_git_tree", "generator_private_vault_manifest_sha256",
    "generator_private_vault_completion_sha256", "generator_private_manifest_sha256",
    "candidate_manifest_sha256", "candidate_visible", "formal_assessor_input",
    "rerun_permitted"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.generator-private-vault-anchor/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "source_lock_commit": {"$ref": "#/$defs/commit"},
    "materialization_attempt_claim_sha256": {"$ref": "#/$defs/sha256"},
    "stage_vault_anchor_sha256": {"$ref": "#/$defs/sha256"},
    "generator_private_vault_git_commit": {"$ref": "#/$defs/commit"},
    "generator_private_vault_git_tree": {"$ref": "#/$defs/commit"},
    "generator_private_vault_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "generator_private_vault_completion_sha256": {"$ref": "#/$defs/sha256"},
    "generator_private_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_visible": {"const": false},
    "formal_assessor_input": {"const": false},
    "rerun_permitted": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
  }
}
