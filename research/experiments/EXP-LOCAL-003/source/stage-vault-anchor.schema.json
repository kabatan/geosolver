{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/stage-vault-anchor.schema.json",
  "title": "EXP-LOCAL-003 pre-outcome formal stage input anchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "card_sha256", "stage",
    "source_lock_commit", "preimplementation_lock_sha256",
    "materialization_attempt_claim_sha256", "assessor_vault_git_commit",
    "assessor_vault_git_tree", "assessor_vault_manifest_sha256",
    "assessor_vault_completion_sha256", "assessor_manifest_sha256",
    "candidate_manifest_sha256", "candidate_completion_sha256",
    "candidate_publication_tree", "c1_phase_accounting",
    "candidate_visible", "rerun_permitted"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.stage-vault-anchor/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "source_lock_commit": {"$ref": "#/$defs/git_oid"},
    "preimplementation_lock_sha256": {"$ref": "#/$defs/sha256"},
    "materialization_attempt_claim_sha256": {"$ref": "#/$defs/sha256"},
    "assessor_vault_git_commit": {"$ref": "#/$defs/git_oid"},
    "assessor_vault_git_tree": {"$ref": "#/$defs/git_oid"},
    "assessor_vault_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "assessor_vault_completion_sha256": {"$ref": "#/$defs/sha256"},
    "assessor_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_completion_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_publication_tree": {"$ref": "#/$defs/tree"},
    "c1_phase_accounting": {"$ref": "#/$defs/c1_accounting"},
    "development_authority": {"$ref": "#/$defs/development_authority"},
    "candidate_visible": {"const": false},
    "rerun_permitted": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "locked"}}}, "then": {"required": ["development_authority"]}, "else": {"not": {"required": ["development_authority"]}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "decimal": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)$"},
    "tree": {
      "type": "object", "additionalProperties": false,
      "required": ["file_count", "total_bytes", "sha256"],
      "properties": {
        "file_count": {"type": "integer", "minimum": 4, "maximum": 5},
        "total_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "c1_accounting": {
      "type": "object", "additionalProperties": false,
      "required": [
        "parent_process_cpu_nanoseconds_decimal", "validation_child_cpu_nanoseconds_decimal", "julia_capture_cpu_nanoseconds_decimal",
        "total_process_cpu_nanoseconds_decimal", "monotonic_elapsed_nanoseconds_decimal",
        "epoch_started_nanoseconds_decimal", "epoch_ended_nanoseconds_decimal",
        "host_exclusion_observed", "primary_oracle_work_included",
        "count_in_end_to_end_exactly_once"
      ],
      "properties": {
        "parent_process_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "validation_child_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "julia_capture_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "total_process_cpu_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "monotonic_elapsed_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "epoch_started_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "epoch_ended_nanoseconds_decimal": {"$ref": "#/$defs/decimal"},
        "host_exclusion_observed": {"const": false},
        "primary_oracle_work_included": {"const": false},
        "count_in_end_to_end_exactly_once": {"const": true}
      }
    },
    "development_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["development_authorization_anchor_commit", "development_authorization_anchor_sha256", "development_stage_input_anchor_sha256", "development_candidate_run_authority_sha256", "development_assessor_stage_authority_sha256", "development_assessment_commit", "development_assessment_sha256", "development_decision_commit", "development_decision_record_sha256", "selected_variant", "selected_path"],
      "properties": {
        "development_authorization_anchor_commit": {"$ref": "#/$defs/git_oid"},
        "development_authorization_anchor_sha256": {"$ref": "#/$defs/sha256"},
        "development_stage_input_anchor_sha256": {"$ref": "#/$defs/sha256"},
        "development_candidate_run_authority_sha256": {"$ref": "#/$defs/sha256"},
        "development_assessor_stage_authority_sha256": {"$ref": "#/$defs/sha256"},
        "development_assessment_commit": {"$ref": "#/$defs/git_oid"},
        "development_assessment_sha256": {"$ref": "#/$defs/sha256"},
        "development_decision_commit": {"$ref": "#/$defs/git_oid"},
        "development_decision_record_sha256": {"$ref": "#/$defs/sha256"},
        "selected_variant": {"enum": ["LX-BOUNDS", "LR-MODEL", "LXR-BOUNDS-MODEL"]},
        "selected_path": {"enum": ["recall", "efficiency"]}
      }
    }
  }
}
