{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.local/research/exp-local-003-generator-assessor-projection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "card_sha256", "cases"],
  "properties": {
    "schema_version": {
      "enum": [
        "exp-local-003-generator-assessor-projection/v1",
        "exp-local-003-locked-generator-assessor-projection/v1"
      ]
    },
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "cases": {
      "type": "array",
      "minItems": 64,
      "maxItems": 96,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {"const": "exp-local-003-generator-assessor-projection/v1"}
        }
      },
      "then": {
        "properties": {
          "cases": {
            "minItems": 64,
            "maxItems": 64,
            "items": {
              "properties": {
                "latent_group": {"minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {"const": "exp-local-003-locked-generator-assessor-projection/v1"}
        }
      },
      "then": {
        "properties": {
          "cases": {
            "minItems": 96,
            "maxItems": 96,
            "items": {
              "properties": {
                "latent_group": {"minimum": 2, "maximum": 5},
                "representation": {
                  "enum": ["base", "signed-permutation", "semantic-equivalent-row-rescaling"]
                },
                "expected_invariant": {"const": true}
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "vector": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "number"}},
    "matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vector"}},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_case_key",
        "family_id",
        "family_ordinal",
        "latent_group",
        "representation",
        "expected_invariant",
        "inverse_mapping",
        "gold",
        "tolerances"
      ],
      "properties": {
        "opaque_case_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "family_id": {"type": "string"},
        "family_ordinal": {"type": "integer", "minimum": 0, "maximum": 7},
        "latent_group": {"type": "integer", "minimum": 0, "maximum": 5},
        "representation": {
          "enum": ["base", "signed-permutation", "semantic-equivalent-row-rescaling", "orthogonal-safety"]
        },
        "expected_invariant": {"type": "boolean"},
        "inverse_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_from_candidate_permutation",
            "base_from_candidate_signs",
            "candidate_residual_from_base",
            "semantic_z_from_base"
          ],
          "properties": {
            "base_from_candidate_permutation": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {"type": "integer", "minimum": 0, "maximum": 15}
            },
            "base_from_candidate_signs": {"$ref": "#/$defs/vector"},
            "candidate_residual_from_base": {"$ref": "#/$defs/matrix"},
            "semantic_z_from_base": {"$ref": "#/$defs/matrix"}
          }
        },
        "gold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity_key", "configurations", "targets"],
          "properties": {
            "identity_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "configurations": {"$ref": "#/$defs/matrix"},
            "targets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["lower", "upper", "configuration_indexes"],
                "properties": {
                  "lower": {"type": "number"},
                  "upper": {"type": "number"},
                  "configuration_indexes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          }
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configuration_absolute", "target_absolute", "canonical_residual"],
          "properties": {
            "configuration_absolute": {"type": "number", "exclusiveMinimum": 0},
            "target_absolute": {"type": "number", "exclusiveMinimum": 0},
            "canonical_residual": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"representation": {"const": "orthogonal-safety"}}},
          "then": {"properties": {"expected_invariant": {"const": false}}},
          "else": {"properties": {"expected_invariant": {"const": true}}}
        }
      ]
    }
  }
}
