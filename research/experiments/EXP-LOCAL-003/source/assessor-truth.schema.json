{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/assessor-truth.schema.json",
  "title": "EXP-LOCAL-003 assessor-only Gold truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "candidate_input_sha256",
    "bootstrap_sha256",
    "locked_decision",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.assessor-truth/v1"},
    "stage": {"enum": ["development", "locked"]},
    "candidate_input_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_sha256": {"$ref": "#/$defs/sha256"},
    "locked_decision": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/locked_decision"}
      ]
    },
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finite_hex": {
      "type": "string",
      "pattern": "^-?(?:0x0\\.0p\\+0|0x[01]\\.[0-9a-f]{13}p[+-][0-9]+)$"
    },
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "locked_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "development_path"],
      "properties": {
        "candidate_id": {
          "enum": ["LX-BOUNDS", "LR-MODEL", "LXR-BOUNDS-MODEL"]
        },
        "development_path": {"enum": ["recall", "efficiency"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_case_key",
        "family_id",
        "family_ordinal",
        "latent_group_index",
        "latent_group_key",
        "representation",
        "expected_invariant",
        "scale_from_base",
        "variable_count",
        "residual_count",
        "logical_evaluation_cost",
        "gold_solutions",
        "expected_calibration"
      ],
      "properties": {
        "opaque_case_key": {"$ref": "#/$defs/sha256"},
        "family_id": {
          "enum": [
            "SCALE-LADDER",
            "CURVED-CHAIN",
            "NEAR-RANK-DEFICIENT",
            "REDUNDANT-OVERDETERMINED",
            "TANGENT-CIRCLE-LINE",
            "MULTIROOT-WARPED",
            "STRICT-GUARD-BOUNDARY",
            "OPAQUE-TRANSCENDENTAL-C0"
          ]
        },
        "family_ordinal": {"type": "integer", "minimum": 0, "maximum": 7},
        "latent_group_index": {"type": "integer", "minimum": 0, "maximum": 3},
        "latent_group_key": {"$ref": "#/$defs/sha256"},
        "representation": {
          "enum": [
            "base",
            "signed-permutation",
            "semantic-equivalent-row-rescaling",
            "orthogonal-safety"
          ]
        },
        "expected_invariant": {"type": "boolean"},
        "scale_from_base": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/nonnegative_integer"}
            },
            {"type": "null"}
          ]
        },
        "variable_count": {"type": "integer", "minimum": 1},
        "residual_count": {"type": "integer", "minimum": 1},
        "logical_evaluation_cost": {"type": "integer", "minimum": 1},
        "gold_solutions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/gold_solution"}
        },
        "expected_calibration": {"$ref": "#/$defs/calibration"}
      }
    },
    "gold_solution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuration_hex",
        "target_hex",
        "configuration_abs_tolerance_hex",
        "target_abs_tolerance_hex",
        "branch_label"
      ],
      "properties": {
        "configuration_hex": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finite_hex"}
        },
        "target_hex": {"$ref": "#/$defs/finite_hex"},
        "configuration_abs_tolerance_hex": {"$ref": "#/$defs/finite_hex"},
        "target_abs_tolerance_hex": {"$ref": "#/$defs/finite_hex"},
        "branch_label": {
          "oneOf": [{"type": "string"}, {"type": "null"}]
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_evaluation_costs",
        "valid_vector_count",
        "nearest_rank_hex",
        "model_scale_hex",
        "model_scale_sha256",
        "joint_fallback_reason",
        "clamp_reasons",
        "nonfinite_q_count",
        "nonfinite_q_misclassification_count"
      ],
      "properties": {
        "observation_evaluation_costs": {
          "type": "array",
          "minItems": 64,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "valid_vector_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "nearest_rank_hex": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finite_hex"}
        },
        "model_scale_hex": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/finite_hex"}
        },
        "model_scale_sha256": {"$ref": "#/$defs/sha256"},
        "joint_fallback_reason": {
          "oneOf": [
            {
              "enum": [
                "insufficient-valid-vectors",
                "nonfinite-nearest-rank",
                "nonpositive-nearest-rank"
              ]
            },
            {"type": "null"}
          ]
        },
        "clamp_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/clamp_reason"}
        },
        "nonfinite_q_count": {"$ref": "#/$defs/nonnegative_integer"},
        "nonfinite_q_misclassification_count": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "clamp_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper"],
      "properties": {
        "lower": {"type": "boolean"},
        "upper": {"type": "boolean"}
      }
    }
  }
}
