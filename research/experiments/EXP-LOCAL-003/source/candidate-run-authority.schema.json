{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/candidate-run-authority.schema.json",
  "title": "EXP-LOCAL-003 closed candidate-run authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "card_sha256", "stage", "process_instance_id", "candidate_input_sha256", "stage_input_anchor", "candidate_execution_lock", "candidate_publication_tree_sha256", "launcher_claim_sha256", "observer_authority", "sandbox_broker_authority", "sandbox_result_sha256", "attempt_claim", "history", "event", "raw_output", "preexit_seal", "process_exit", "changed_paths", "manifest"],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.candidate-run-authority/v2"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"enum": ["development", "locked"]},
    "process_instance_id": {"$ref": "#/$defs/sha256"},
    "candidate_input_sha256": {"$ref": "#/$defs/sha256"},
    "stage_input_anchor": {"$ref": "#/$defs/external_file"},
    "candidate_execution_lock": {"$ref": "#/$defs/external_file"},
    "candidate_publication_tree_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_claim_sha256": {"$ref": "#/$defs/sha256"},
    "observer_authority": {"$ref": "#/$defs/external_file"},
    "sandbox_broker_authority": {"$ref": "#/$defs/external_file"},
    "sandbox_result_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_claim": {"$ref": "#/$defs/file"},
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_claim", "raw_output", "preexit_seal", "process_exit"],
      "properties": {
        "attempt_claim": {"$ref": "#/$defs/commit_tree"},
        "raw_output": {"$ref": "#/$defs/commit_tree"},
        "preexit_seal": {"$ref": "#/$defs/commit_tree"},
        "process_exit": {"$ref": "#/$defs/commit_tree"}
      }
    },
    "event": {"type": "object", "additionalProperties": false, "required": ["kind", "ordinal", "parent"], "properties": {"kind": {"const": "candidate-run-authority"}, "ordinal": {"const": 6}, "parent": {"type": "object", "additionalProperties": false, "required": ["kind", "sha256"], "properties": {"kind": {"const": "candidate-process-exit"}, "sha256": {"$ref": "#/$defs/sha256"}}}}},
    "raw_output": {"$ref": "#/$defs/file"},
    "preexit_seal": {"$ref": "#/$defs/file"},
    "process_exit": {"$ref": "#/$defs/file"},
    "changed_paths": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/path"}},
    "manifest": {"$ref": "#/$defs/file"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\/$).+$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_length"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "byte_length": {"type": "integer", "minimum": 0}}},
    "external_file": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "file"], "properties": {"commit": {"$ref": "#/$defs/git_oid"}, "tree": {"$ref": "#/$defs/git_oid"}, "file": {"$ref": "#/$defs/file"}}},
    "commit_tree": {"type": "object", "additionalProperties": false, "required": ["commit", "tree"], "properties": {"commit": {"$ref": "#/$defs/git_oid"}, "tree": {"$ref": "#/$defs/git_oid"}}}
  }
}
