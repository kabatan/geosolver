{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geotarget.invalid/research/EXP-LOCAL-003/locked-selection.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "card_sha256", "stage",
    "selected_variant", "candidate_input_sha256"
  ],
  "properties": {
    "schema_version": {"const": "geotarget.exp-local-003.locked-selection/v1"},
    "experiment_id": {"const": "EXP-LOCAL-003"},
    "card_sha256": {"const": "0caae294a032f6d920c718219836e60e57f20c76fe5d790a615e554a95c6ee3c"},
    "stage": {"const": "locked"},
    "selected_variant": {"enum": ["LX-BOUNDS", "LR-MODEL", "LXR-BOUNDS-MODEL"]},
    "candidate_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
