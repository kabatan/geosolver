 class CartesianPolynomials(ScalarGeometry):
+    def __init__(self, constructions, *, allow_opaque=False):
+        # A symbolic request describes one fixed construction DAG. Keep a
+        # private immutable snapshot so exact expressions can be reused across
+        # different constraint rows without stale dependency results.
+        super().__init__(MappingProxyType(dict(constructions)), allow_opaque=allow_opaque)
+        self._named_values = {kind: {} for kind in ("point", "line", "circle", "scalar")}
+        self._named_active = set()
+
+    def _named_value(self, kind, name):
+        self.visits += 1
+        if self.visits > 1000:
+            raise ValueError("Cartesian expression too large")
+        values = self._named_values[kind]
+        if name in values:
+            return values[name]
+        key = kind, name
+        if key in self._named_active:
+            raise ValueError("cyclic Cartesian construction")
+        self._named_active.add(key)
+        try:
+            value = getattr(self, kind)(self.parse(self.definitions[name]))
+        finally:
+            self._named_active.remove(key)
+        # SymPy scalars and coordinate tuples are immutable. A failed
+        # interpretation (e.g. trying a line as a point) never enters the cache.
+        values[name] = value
+        return value
