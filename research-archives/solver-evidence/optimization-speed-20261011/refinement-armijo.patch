+"""Damped Newton with the same bounded line-search policy as staged LM."""
+
+from mpmath import mp
+from mpmath.calculus.optimization import MDNewton
+
+from geosolver.runtime.deadline import check_deadline, count_event
+
+from .refiner_config import LINE_SEARCH_MAX_STEPS
+
+
+class LeastSquaresNewton(MDNewton):
+    """Accept Newton steps by sufficient decrease of the least-squares merit.
+
+    An overdetermined Newton step minimizes ||F + J s||_2. Its descent
+    property is for ||F||_2**2, rather than mpmath's default infinity norm.
+    Backtracking follows the existing LM limit; exhausting it terminates this
+    optional proposal so the caller can try its other refinement paths.
+    """
+
+    def __iter__(self):
+        ctx, function, point = self.ctx, self.f, self.x0
+        residual = ctx.matrix(function(*point))
+        norm = ctx.norm(residual, 2)
+        armijo = ctx.mpf("0.0001")
+        while True:
+            check_deadline()
+            jacobian = self.J(*point)
+            step = ctx.lu_solve(jacobian, -residual)
+            projected = jacobian * step
+            directional = ctx.fdot(residual, projected)
+            # J*s is the least-squares projection of -F. A nonnegative
+            # derivative cannot supply a descent certificate at this precision.
+            if not ctx.isfinite(directional) or directional >= 0:
+                count_event("newton_non_descent_directions")
+                return
+            squared = norm * norm
+            alpha = ctx.one
+            for _ in range(LINE_SEARCH_MAX_STEPS):
+                check_deadline()
+                trial = point + alpha * step
+                if trial == point:
+                    count_event("newton_stagnant_steps")
+                    return
+                values = ctx.matrix(function(*trial))
+                trial_norm = ctx.norm(values, 2)
+                if ctx.isfinite(trial_norm) and (
+                    trial_norm < norm
+                    and trial_norm * trial_norm <= squared + 2 * armijo * alpha * directional
+                ):
+                    point, residual, norm = trial, values, trial_norm
+                    yield point, norm
+                    break
+                count_event("newton_backtracks")
+                alpha /= 2
+            else:
+                count_event("newton_line_search_exhausted")
+                return
+
+
+def findroot_least_squares(function, initial, *, tol, maxsteps, J=None, **kwargs):
+    """Run bounded Newton with mpmath's working precision and stop checks.
+
+    mpmath.findroot unconditionally chooses MDNewton for vector functions,
+    even when passed a custom solver. Run its iteration protocol explicitly.
+    Full source certification is performed separately by the caller.
+    """
+    with mp.workprec(mp.prec + 20):
+        initial_values = initial if isinstance(initial, list | tuple | mp.matrix) else (initial,)
+        point = mp.matrix([mp.mpf(value) for value in initial_values])
+
+        def norm(values):
+            return mp.norm(values, 2)
+
+        values = mp.matrix(function(*point))
+        if norm(values) == 0:
+            return point
+        options = {"norm": norm, "verbose": False}
+        if J is not None:
+            options["J"] = J
+        iterations = LeastSquaresNewton(mp, function, point, **options)
+        completed = False
+        for index, (point, error) in enumerate(iterations, 1):
+            completed = True
+            if error < tol * max(1, norm(point)) or index >= int(maxsteps):
+                break
+        if not completed or norm(mp.matrix(function(*point))) ** 2 > tol:
+            raise ValueError("bounded Newton did not meet its residual tolerance")
+        return point
