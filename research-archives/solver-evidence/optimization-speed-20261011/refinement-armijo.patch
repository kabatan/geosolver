+"""Least-squares Newton proposals keep full residual and timeout contracts."""
+
+import pytest
+from mpmath import mp
+
+from geosolver.engine.standard.evaluation.ir_evaluator import build_ir_evaluator
+from geosolver.engine.standard.problem.load_problem_bundle import load_problem_bundle
+from geosolver.engine.standard.refinement import mpmath_refiner as implementation
+
+
+def make_evaluator(constraints):
+    return build_ir_evaluator(load_problem_bundle({
+        "task": "solve", "variables": {"names": ["u", "v"]},
+        "constraints": constraints, "answer": "u+v",
+    }))
+
+
+def run(evaluator, point, **kwargs):
+    with mp.workdps(120):
+        return implementation._run_findroot_closure(
+            evaluator=evaluator, start_point=[mp.mpf(x) for x in point],
+            bounds=((None, None), (None, None)), dps=120,
+            target_residual=mp.mpf("1e-80"), max_steps=240, **kwargs,
+        )
+
+
+@pytest.mark.parametrize("equation,dependent,point", [
+    ("u+v-3", "7*(u+v-3)", ["1", "1"]),
+    ("u*u+v*v-5", "(u*u+v*v-5)*3", ["1", "1.8"]),
+    ("u*v-2", "u*u*v*v-4", ["1.4", "1.4"]),
+    ("sqrt(u*u+v*v)-3", "u*u+v*v-9", ["1", "2.5"]),
+])
+def test_dependent_manifolds_close_using_full_source_residuals(equation, dependent, point):
+    evaluator = make_evaluator([equation, dependent])
+    result = run(evaluator, point)
+    assert result is not None
+    assert result[1] <= mp.mpf("1e-80")
+
+
+def test_chart_cannot_certify_an_omitted_inconsistent_residual(monkeypatch):
+    evaluator = make_evaluator(["u+v-3", "u+v-4"])
+    monkeypatch.setattr(implementation, "derivative_plan", lambda _: None)
+    result = run(evaluator, ["1", "1"])
+    assert result is None
+
+
+
+def test_global_timeout_during_newton_propagates(monkeypatch):
+    evaluator = make_evaluator(["u+v-3", "2*(u+v-3)"])
+    def timeout(*args, **kwargs):
+        raise TimeoutError("global deadline")
+    monkeypatch.setattr(implementation, "findroot_least_squares", timeout)
+    with pytest.raises(TimeoutError, match="global deadline"):
+        run(evaluator, ["1", "1"])
+
+
+def test_least_squares_descent_need_not_decrease_infinity_norm():
+    # Overdetermined scalar Jacobian: s=-(J.T J)^-1 J.T F.
+    # This linearized step descends in the norm that defines least squares.
+    with mp.workdps(80):
+        residual = mp.matrix([1, mp.mpf("0.9")])
+        jacobian = mp.matrix([[1], [-10]])
+        step = mp.lu_solve(jacobian, -residual)
+        trial = residual + jacobian * step
+        assert mp.norm(trial, 2) < mp.norm(residual, 2)
+        assert mp.norm(trial, mp.inf) > mp.norm(residual, mp.inf)
+
+
+
+def test_line_search_exhaustion_does_not_leak_an_unverified_answer(monkeypatch):
+    from geosolver.engine.standard.refinement.newton_line_search import findroot_least_squares
+    with mp.workdps(100), pytest.raises(ValueError):
+        findroot_least_squares(
+            lambda u, v: (mp.mpf(1), mp.mpf(1)), (mp.mpf(2), mp.mpf(3)),
+            tol=mp.mpf("1e-80"), maxsteps=80,
+            J=lambda *point: mp.eye(2),
+        )
+
+
+@pytest.mark.parametrize("power,start", [(3, "1.2"), (5, "0.7"), (9, "2")])
+def test_repeated_roots_retain_precision_budget(power, start):
+    evaluator = make_evaluator([f"(u-1)**{power}", "v*v-2"])
+    assert run(evaluator, [start, "1.4"]) is not None
+
+
+def test_ill_conditioned_but_full_rank_system_keeps_all_equations():
+    evaluator = make_evaluator(["u+v-3", "u+(1+1e-40)*v-3-2e-40"])
+    result = run(evaluator, ["1.1", "1.8"])
+    assert result is not None
+    with mp.workdps(120):
+        assert abs(result[0][0]-1) < mp.mpf("1e-70")
+        assert abs(result[0][1]-2) < mp.mpf("1e-70")
+
+
+def test_overdetermined_scalar_accepts_scalar_initial_point():
+    from geosolver.engine.standard.refinement.newton_line_search import findroot_least_squares
+    with mp.workdps(100):
+        root = findroot_least_squares(
+            lambda u: (u*u-2, 3*(u*u-2)), mp.mpf("1.4"),
+            tol=mp.mpf("1e-80"), maxsteps=80,
+        )
+        assert abs(root[0]-mp.sqrt(2)) < mp.mpf("1e-80")
