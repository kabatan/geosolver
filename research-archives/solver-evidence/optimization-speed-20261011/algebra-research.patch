+"""Exact target upper bounds; no numerical geometry witness is fabricated."""
+
+import pytest
+import sympy as sp
+
+from geosolver.engine.standard.search.finite_target_image import (
+    exact_algebraic_identity,
+    finite_original_target_image,
+    finite_target_image,
+)
+
+
+def keys(image):
+    return {
+        (tuple(value["minimal_polynomial"]), value["real_root_index"])
+        for value in image["values"]
+    }
+
+
+@pytest.mark.parametrize("name,scale,shift", [("x", 1, 0), ("renamed", 7, -3), ("z", -5, 11)])
+def test_target_image_covers_all_branches_and_deduplicates_exactly(name, scale, shift):
+    x = sp.Symbol(name, real=True)
+    roots = [[sp.Integer(shift + scale * s)] for s in (-1, 1)]
+    target = ((x - shift) / scale) ** 2
+    image = finite_target_image(target, (x,), roots)
+    assert keys(image) == {(("1", "-1"), 0)}
+    assert image["root_image_indices"] == [0, 0]
+    signed = finite_target_image((x - shift) / scale, (x,), roots)
+    assert keys(signed) == {(("1", "1"), 0), (("1", "-1"), 0)}
+
+
+def test_same_minimal_polynomial_different_real_roots_are_distinct():
+    x = sp.Symbol("x", real=True)
+    image = finite_target_image(x, (x,), [[-sp.sqrt(2)], [sp.sqrt(2)]])
+    assert keys(image) == {(("1", "0", "-2"), 0), (("1", "0", "-2"), 1)}
+
+
+def test_equivalent_algebraic_expressions_have_same_canonical_identity():
+    t = sp.Symbol("t")
+    root = sp.CRootOf(t**3 - 2, 0)
+    assert exact_algebraic_identity(root)["minimal_polynomial"] == ["1", "0", "0", "-2"]
+    first = exact_algebraic_identity(sp.sqrt(2) + sp.sqrt(8))
+    second = exact_algebraic_identity(3 * sp.sqrt(2))
+    assert first["minimal_polynomial"] == second["minimal_polynomial"] == ["1", "0", "-18"]
+    assert first["real_root_index"] == second["real_root_index"] == 1
+
+
+def test_cartesian_product_is_not_silently_projected_or_truncated():
+    x, y = sp.symbols("x y", real=True)
+    roots = [[sp.Integer(a), sp.Integer(b)] for a in (-1, 1) for b in (-2, 2)]
+    image = finite_target_image(x * y, (x, y), roots)
+    assert keys(image) == {(("1", "-2"), 0), (("1", "2"), 0)}
+    assert len(image["root_image_indices"]) == 4
+    assert finite_target_image(x, (x, y), [[sp.S.One]]) is None
+    assert finite_target_image(x, (x,), []) is None
+    assert finite_target_image(x, (x,), [[sp.Integer(i)] for i in range(17)]) is None
+
+
+@pytest.mark.parametrize("target,roots", [
+    (lambda x: 1 / x, [0, 1]),
+    (lambda x: sp.sqrt(x), [-1, 1]),
+    (lambda x: sp.pi * x, [1, 2]),
+    (lambda x: sp.acos(x), [sp.Rational(1, 2)]),
+    (lambda x: x + sp.Symbol("free", real=True), [1]),
+])
+def test_any_undefined_nonreal_transcendental_or_free_image_declines(target, roots):
+    x = sp.Symbol("x", real=True)
+    assert finite_target_image(target(x), (x,), [[sp.sympify(r)] for r in roots]) is None
+
+
+def test_root_identity_never_uses_decimal_proximity(monkeypatch):
+    def forbidden(*args, **kwargs):
+        raise AssertionError("decimal approximation is not an equality proof")
+    monkeypatch.setattr(sp, "N", forbidden)
+    value = exact_algebraic_identity(sp.sqrt(3) / 7)
+    assert value["minimal_polynomial"] == ["49", "0", "-3"]
+    assert value["real_root_index"] == 1
+
+
+def test_exact_interval_failure_leaves_identity_unresolved(monkeypatch):
+    from geosolver.engine.standard.search import algebraic_branch_boxes as boxes
+    monkeypatch.setattr(
+        boxes, "exact_algebraic_interval_evaluator", lambda width: lambda value: (-10, 10)
+    )
+    assert exact_algebraic_identity(sp.sqrt(2)) is None
+
+
+@pytest.mark.parametrize("source,root", [
+    ("0*(1/x)", 0),
+    ("(x-1)/(x-1)", 1),
+    ("sqrt(x)**2", -1),
+    ("Center(Circle(Point(0,0),x)).x", -1),
+    ("PointOnSegment(Point(0,0),Point(1,0),x).x", 2),
+    ("Line(Point(0,0),Point(0,0)).a", 1),
+    ("Radius(Circle(Point(0,0),x))", 0),
+])
+def test_original_target_checks_every_intermediate_before_simplifying(source, root):
+    x = sp.Symbol("x", real=True)
+    assert finite_original_target_image(source, {}, (x,), [[sp.Integer(root)]]) is None
+
+
+def test_original_source_image_matches_two_radical_branches():
+    x = sp.Symbol("x", real=True)
+    constructions = {"A": "Point(x,0)", "B": "Point(0,0)", "d": "Distance(A,B)"}
+    image = finite_original_target_image("d", constructions, (x,), [[-sp.sqrt(2)], [sp.sqrt(2)]])
+    assert keys(image) == {(("1", "0", "-2"), 1)}
+    assert image["root_image_indices"] == [0, 0]
