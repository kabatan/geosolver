+"""Optional exact target-image receipts for a finite relaxation superset.
+
+If every original valid configuration occurs in S and f agrees with the
+original target on its valid domain, every valid answer is in f(S). Computing
+all exact identities in f(S) therefore gives a target coverage obligation.
+Undefined, unsupported, non-real or nonalgebraic images leave it unresolved.
+This module supplies no geometric admission or numerical stopping decision.
+"""
+
+
+def exact_algebraic_identity(value):
+    """Canonical minimal polynomial/root index, with exact interval evidence.
+
+    Root selection uses rational interval arithmetic on the exact expression;
+    decimal proximity, branch boxes and numerical candidate values are unused.
+    """
+    import sympy as sp
+
+    from .algebraic_branch_boxes import exact_algebraic_interval_evaluator
+
+    if value.is_real is not True or value.is_finite is not True or value.is_algebraic is not True:
+        return None
+    if sp.count_ops(value) > 250:
+        return None
+    generator = sp.Dummy("target_identity")
+    minimal = sp.Poly(sp.minimal_polynomial(value, generator), generator, domain=sp.QQ)
+    _, primitive = minimal.clear_denoms(convert=True)
+    primitive = primitive.primitive()[1]
+    if primitive.LC() < 0:
+        primitive = -primitive
+    if not 1 <= primitive.degree() <= 16:
+        return None
+    if any(abs(int(c)).bit_length() > 4096 for c in primitive.all_coeffs()):
+        return None
+    isolated = primitive.intervals(eps=sp.Rational(1, 2**128))
+    if not isolated:
+        return None
+    lower, upper = exact_algebraic_interval_evaluator(sp.Rational(1, 2**512))(value)
+    matches = [
+        index
+        for index, ((left, right), multiplicity) in enumerate(isolated)
+        if multiplicity == 1 and left <= lower <= upper <= right
+    ]
+    if len(matches) != 1:
+        return None
+    return {
+        "minimal_polynomial": [str(c) for c in primitive.all_coeffs()],
+        "real_root_index": matches[0],
+        "exact_enclosure": [str(lower), str(upper)],
+    }
+
+
+def finite_target_image(target, variables, solutions):
+    """Return every exact target identity, or None if any image is unresolved.
+
+    The caller must separately establish that solutions is the entire real
+    relaxation superset. Empty or truncated inputs never establish coverage.
+    No exceptional root is discarded, and equal images use canonical exact
+    algebraic identities rather than numerical tolerances.
+    """
+    import sympy as sp
+
+    if not solutions or len(solutions) > 16 or not target.free_symbols <= set(variables):
+        return None
+    values, root_image_indices = [], []
+    identities = {}
+    try:
+        for solution in solutions:
+            if len(solution) != len(variables):
+                return None
+            value = target.xreplace(dict(zip(variables, solution, strict=True)))
+            receipt = exact_algebraic_identity(value)
+            if receipt is None:
+                return None
+            key = tuple(receipt["minimal_polynomial"]), receipt["real_root_index"]
+            if key not in identities:
+                identities[key] = len(values)
+                values.append(receipt)
+            root_image_indices.append(identities[key])
+    except (ValueError, TypeError, ArithmeticError, NotImplementedError, sp.PolynomialError):
+        return None
+    return {"values": values, "root_image_indices": root_image_indices}
+
+
+def finite_original_target_image(source, constructions, variables, solutions):
+    """Interpret the original target at each root before any cancellation.
+
+    This deliberately supports only finite real algebraic intermediate
+    scalars. Unsupported/unknown domains at even one root decline the entire
+    proof. In particular, a canceled pole or unused invalid circle radius may
+    not be hidden by a symbolically simplified target formula.
+    """
+    import ast
+
+    import sympy as sp
+
+    from .cartesian_polynomials import CartesianPolynomials, squared_distance
+
+    def checked(value):
+        if (
+            value.is_real is not True
+            or value.is_finite is not True
+            or value.is_algebraic is not True
+        ):
+            raise ValueError("unresolved exact original target domain")
+        return value
+
+    class ExactTargetGeometry(CartesianPolynomials):
+        def __init__(self, substitutions):
+            super().__init__(dict(constructions))
+            self.substitutions = substitutions
+
+        def scalar(self, node):
+            if isinstance(node, ast.Name) and node.id in self.substitutions:
+                return checked(self.substitutions[node.id])
+            return checked(super().scalar(node))
+
+        def point(self, node):
+            resolved = self.resolve(node)
+            if (
+                isinstance(resolved, ast.Call)
+                and isinstance(resolved.func, ast.Name)
+                and resolved.func.id == "PointOnSegment"
+                and len(resolved.args) == 3
+            ):
+                first, second = (self.point(arg) for arg in resolved.args[:2])
+                parameter = self.scalar(resolved.args[2])
+                if (
+                    squared_distance(first, second).is_positive is not True
+                    or parameter.is_nonnegative is not True
+                    or (1 - parameter).is_nonnegative is not True
+                ):
+                    raise ValueError("unresolved original segment domain")
+            return tuple(checked(value) for value in super().point(node))
+
+        def line(self, node):
+            values = tuple(checked(value) for value in super().line(node))
+            if (values[0] ** 2 + values[1] ** 2).is_positive is not True:
+                raise ValueError("unresolved original line domain")
+            return values
+
+        def circle(self, node):
+            resolved = self.resolve(node)
+            if (
+                isinstance(resolved, ast.Call)
+                and isinstance(resolved.func, ast.Name)
+                and resolved.func.id == "Circle"
+                and len(resolved.args) == 2
+                and self.scalar(resolved.args[1]).is_positive is not True
+            ):
+                raise ValueError("unresolved original circle radius domain")
+            center, square = super().circle(node)
+            center = tuple(checked(value) for value in center)
+            square = checked(square)
+            if square.is_positive is not True:
+                raise ValueError("unresolved original circle domain")
+            return center, square
+
+    if not solutions or len(solutions) > 16:
+        return None
+    values, indices, identities = [], [], {}
+    try:
+        for solution in solutions:
+            if len(solution) != len(variables):
+                return None
+            substitutions = {str(v): value for v, value in zip(variables, solution, strict=True)}
+            geometry = ExactTargetGeometry(substitutions)
+            value = geometry.scalar(geometry.parse(source))
+            receipt = exact_algebraic_identity(value)
+            if receipt is None:
+                return None
+            key = tuple(receipt["minimal_polynomial"]), receipt["real_root_index"]
+            if key not in identities:
+                identities[key] = len(values)
+                values.append(receipt)
+            indices.append(identities[key])
+    except (ValueError, TypeError, ArithmeticError, NotImplementedError, sp.PolynomialError):
+        return None
+    return {"values": values, "root_image_indices": indices}
