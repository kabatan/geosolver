+"""Conditional ideal-projection proofs over structurally diverse systems."""
+
+import pytest
+import sympy as sp
+
+from geosolver.engine.standard.search.target_elimination import (
+    covered_by_verified_answers,
+    target_elimination_receipt,
+)
+
+
+def receipt(expressions, target, variables):
+    return target_elimination_receipt(
+        [sp.Poly(p, *variables, domain=sp.QQ) for p in expressions], target, variables
+    )
+
+
+def keys(result):
+    return {
+        (tuple(v["minimal_polynomial"]), v["real_root_index"])
+        for v in result["values"]
+    }
+
+
+@pytest.mark.parametrize("names,scale,offset", [(("x", "y"), 1, 0), (("a", "b"), 7, -3)])
+def test_positive_dimensional_affine_target_is_finite(names, scale, offset):
+    x, y = sp.symbols(" ".join(names), real=True)
+    target = (x + y - offset) / scale
+    result = receipt([x + y - offset - 2 * scale], target, (x, y))
+    assert keys(result) == {(("1", "-2"), 0)}
+    assert result["zero_dimensional_configuration_ideal"] is False
+
+
+def test_all_finite_target_branches_are_retained_on_free_configuration_fibers():
+    x, y = sp.symbols("x y", real=True)
+    result = receipt([(x + y) ** 2 - 2], x + y, (x, y))
+    assert keys(result) == {(("1", "0", "-2"), 0), (("1", "0", "-2"), 1)}
+    assert result["zero_dimensional_configuration_ideal"] is False
+
+
+def test_radical_norm_target_on_positive_dimensional_circle():
+    x, y = sp.symbols("x y", real=True)
+    result = receipt([x*x + y*y - 25], sp.sqrt(x*x + y*y), (x, y))
+    assert keys(result) == {(("1", "-5"), 0)}
+    assert result["zero_dimensional_configuration_ideal"] is False
+    assert len(result["proved_negative_root_exclusions"]) == 1
+
+
+def test_nested_radicals_keep_all_norm_sign_relaxations():
+    x, y = sp.symbols("x y", real=True)
+    result = receipt([x - 3, y - 4], sp.sqrt(x + sp.sqrt(y)), (x, y))
+    assert keys(result) == {
+        (("1", "-1"), 0), (("1", "1"), 0),
+        (("1", "0", "-5"), 0), (("1", "0", "-5"), 1),
+    }
+
+
+def test_rational_target_keeps_denominator_zero_relaxation_branch_unresolved():
+    x, y = sp.symbols("x y", real=True)
+    # Original x/y=1 wherever y!=0, but clearing denominators also leaves
+    # x=y=0 with arbitrary target. Without a denominator-domain proof the
+    # unsaturated necessary ideal must not return the desired singleton.
+    assert receipt([x - y], x / y, (x, y)) is None
+
+
+def test_proved_nonnegative_target_can_exclude_strictly_negative_roots():
+    x = sp.Symbol("x", real=True)
+    result = receipt([x**2 - 2], sp.Abs(x), (x,))
+    assert keys(result) == {(("1", "0", "-2"), 1)}
+    assert len(result["proved_negative_root_exclusions"]) == 1
+
+
+def test_unknown_target_sign_retains_extraneous_radical_sign_branch():
+    x = sp.Symbol("x", real=True)
+    result = receipt([x**2 - 1], sp.sqrt(x), (x,))
+    assert keys(result) == {(("1", "-1"), 0), (("1", "1"), 0)}
+    assert result["nonnegative_target"] is False
+
+
+def test_repeated_roots_and_reducible_polynomial_are_canonicalized():
+    x, y = sp.symbols("x y", real=True)
+    result = receipt([(x - 1)**2 * (x + 2)**2], x, (x, y))
+    assert keys(result) == {(("1", "-1"), 0), (("1", "2"), 0)}
+
+
+@pytest.mark.parametrize("target", [lambda x: sp.acos(x), lambda x: sp.sin(x), lambda x: sp.pi*x])
+def test_angle_and_transcendental_targets_decline(target):
+    x = sp.Symbol("x", real=True)
+    assert receipt([x**2 - 1], target(x), (x,)) is None
+
+
+def test_free_target_no_polynomial_cannot_claim_coverage():
+    x, y = sp.symbols("x y", real=True)
+    assert receipt([x**2 - 1], y, (x, y)) is None
+
+
+def test_same_polynomial_different_root_indices_remain_obligations():
+    x = sp.Symbol("x", real=True)
+    result = receipt([x**3 - 3*x + 1], x, (x,))
+    assert keys(result) == {(("1", "0", "-3", "1"), i) for i in range(3)}
+
+
+def test_coverage_requires_every_exact_identity_after_independent_verification():
+    from geosolver.exact.descriptors import describe_exact
+    x = sp.Symbol("x", real=True)
+    result = receipt([x**2 - 2], x, (x,))
+    negative, positive = describe_exact(-sp.sqrt(2)), describe_exact(sp.sqrt(2))
+    assert not covered_by_verified_answers(result, [positive])
+    assert covered_by_verified_answers(result, [positive, negative])
+    assert covered_by_verified_answers(result, [negative, positive, positive])
+    assert not covered_by_verified_answers(result, [negative, positive, describe_exact(7)])
+    assert not covered_by_verified_answers(result, [])
+    assert not covered_by_verified_answers(None, [positive])
+    assert not covered_by_verified_answers(result, [positive.model_dump(), negative.model_dump()])
+
+
+def test_coverage_does_not_consult_decimal_proximity():
+    from geosolver.exact.descriptors import describe_exact
