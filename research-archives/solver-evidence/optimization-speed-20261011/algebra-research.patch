+"""Research-only finite target upper bounds from necessary polynomial ideals.
+
+For every original valid configuration x, the necessary rows vanish and the
+target lift vanishes at u=target(x). A nonzero univariate member P(u) of this
+ideal therefore vanishes at every valid answer, even if x has free dimensions.
+Denominators are only cleared; no variable division or localization occurs.
+All candidate answers still require independent original verification.
+"""
+
+
+def necessary_target_polynomial(target, variables, parameter):
+    """Conservative rational norm elimination; unsupported means None.
+
+    Angles/transcendental target expressions are not converted through the
+    condition-only angle identities. Every norm is merely an implication,
+    retaining both signs and every denominator-zero relaxation branch.
+    """
+    import sympy as sp
+
+    expression = target - parameter
+    if expression.has(sp.acos, sp.sin, sp.cos, sp.tan):
+        return None
+    for step in range(4):
+        numerator = sp.together(expression).as_numer_denom()[0]
+        try:
+            result = sp.Poly(numerator, *variables, parameter, domain=sp.QQ)
+            if result.total_degree() > 8 or len(result.terms()) > 60:
+                return None
+            return result
+        except sp.polys.polyerrors.BasePolynomialError:
+            if step == 3 or sp.count_ops(numerator) > 250:
+                return None
+            atoms = [
+                atom for atom in numerator.atoms(sp.Pow)
+                if atom.exp == sp.Rational(1, 2) and atom.has(*variables, parameter)
+            ] + [atom for atom in numerator.atoms(sp.Abs) if atom.has(*variables, parameter)]
+            if not atoms:
+                return None
+            radical = max(atoms, key=lambda atom: (sp.count_ops(atom), sp.default_sort_key(atom)))
+            temporary = sp.Dummy("target_radical")
+            lifted = sp.Poly(numerator.xreplace({radical: temporary}), temporary)
+            if lifted.degree() > 4:
+                return None
+            radicand = radical.args[0] ** 2 if isinstance(radical, sp.Abs) else radical.base
+            lifted = lifted.rem(sp.Poly(temporary**2 - radicand, temporary))
+            a, b = lifted.nth(0), lifted.nth(1)
+            expression = sp.expand(a * a - b * b * radicand)
+            if sp.count_ops(expression) > 250:
+                return None
+    return None
+
+
+def target_elimination_receipt(equations, target, variables):
+    """Compute a bounded exact root superset; caller supplies its CPU budget.
+
+    Equations must already be sound necessary equalities on every original
+    valid configuration. This helper itself does not certify their provenance
+    or authorize stopping. Rational-only arithmetic is deliberate here.
+    """
+    import sympy as sp
+
+    if not 1 <= len(variables) <= 7 or not 1 <= len(equations) <= 32:
+        return None
+    if not target.free_symbols <= set(variables) or sp.count_ops(target) > 250:
+        return None
+    if any(
+        not p.domain.is_QQ or p.total_degree() > 4 or len(p.terms()) > 60
+        for p in equations
+    ):
+        return None
+    parameter = sp.Dummy("target", real=True)
+    relation = necessary_target_polynomial(target, variables, parameter)
+    if relation is None:
+        return None
+    basis = sp.groebner(
+        [*(p.as_expr() for p in equations), relation.as_expr()],
+        *variables, parameter, order="lex", domain=sp.QQ,
+    )
+    scalar_rows = [
+        sp.Poly(p.as_expr(), parameter, domain=sp.QQ)
+        for p in basis.polys if p.as_expr().free_symbols <= {parameter}
+    ]
+    if not scalar_rows:
+        return None
+    scalar = scalar_rows[0]
+    for row in scalar_rows[1:]:
+        scalar = sp.gcd(scalar, row)
+    scalar = scalar.sqf_part()
+    if not 1 <= scalar.degree() <= 16:
+        return None
+    if any(
+        max(abs(int(c.p)).bit_length(), int(c.q).bit_length()) > 4096
+        for c in scalar.all_coeffs()
+    ):
+        return None
+    identities, exclusions = [], []
+    # On the original valid real domain, a symbolically proved nonnegative
+    # target cannot equal a strictly negative isolated real root. Unknown
+    # signs retain their entire root obligation.
+    nonnegative = target.is_nonnegative is True
+    for factor, _multiplicity in sp.factor_list(scalar)[1]:
+        _, primitive = factor.clear_denoms(convert=True)
+        primitive = primitive.primitive()[1]
+        if primitive.LC() < 0:
+            primitive = -primitive
+        for root_index, ((left, right), _root_multiplicity) in enumerate(
+            primitive.intervals(eps=sp.Rational(1, 2**128))
+        ):
+            value = {
+                "minimal_polynomial": [str(c) for c in primitive.all_coeffs()],
+                "real_root_index": root_index,
+                "isolating_interval": [str(left), str(right)],
+            }
+            if nonnegative and right < 0:
+                exclusions.append(value)
+            else:
+                identities.append(value)
+    if not identities:
+        return None
+    return {
+        "target_lift": str(relation.as_expr()),
+        "elimination_polynomial": str(scalar.as_expr()),
+        "values": identities,
+        "nonnegative_target": nonnegative,
+        "proved_negative_root_exclusions": exclusions,
+        "zero_dimensional_configuration_ideal": basis.is_zero_dimensional,
+    }
+
+
+def covered_by_verified_answers(receipt, accepted_answers):
+    """Compare exact identities supplied by independent original verification.
+
+    This checks only coverage, never candidate validity or receipt provenance.
+    Callers must pass final accepted ExactAnswer records, not reconstruction
+    guesses. Missing roots, unknown answer kinds and contradictory extra
+    algebraic identities leave the coverage obligation unresolved.
+    """
+    from geosolver.problem.models import AlgebraicAnswer
+
+    if receipt is None or not receipt.get("values") or not accepted_answers:
+        return False
+    try:
+        required = {
+            (tuple(value["minimal_polynomial"]), value["real_root_index"])
+            for value in receipt["values"]
+        }
+        if any(not isinstance(answer, AlgebraicAnswer) for answer in accepted_answers):
+            return False
+        accepted = {answer.value.canonical_key() for answer in accepted_answers}
+    except (AttributeError, TypeError, KeyError):
+        return False
+    return required == accepted
