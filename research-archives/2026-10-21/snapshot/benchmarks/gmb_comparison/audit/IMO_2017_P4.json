    ],
    "fixed_coordinates": {
      "R": [
        "0",
        "0"
      ],
      "S": [
        "1",
        "0"
      ]
    },
    "removed_continuous_dof": 4,
    "justification": "原文でR,Sは相異なる。RSを単位長さにすると円中心は(1/2,oy)、半径はOR。oy≠0が非直径条件。 平行移動2自由度・回転1自由度・正の一様拡大縮小1自由度のみを除く。残りの図形の形は固定しない。",
    "scale_invariant": true,
    "reflection_fixed": false
  },
  "clauses": [
    {
      "id": "H01",
      "statement_ja": "Ω上のR,Sは異なり、RSは直径でない。",
      "gmbl": [
        "(param Omega circle); (param R point (on-circ Omega)); (param S point (on-circ Omega)); (assert (not (coll R S (origin Omega))))"
      ],
      "geosolver": [
        "R = Point(0, 0)",
        "S = Point(1, 0)",
        "O = Point(1/2, oy)",
        "Omega = Circle(O, Distance(O, R))",
        "conditions[0]: oy != 0"
      ],
      "condition_indices": [
        0
      ],
      "construction_names": [
        "R",
        "S",
        "O",
        "Omega"
      ],
      "status": "matched"
    },
    {
      "id": "H02",
      "statement_ja": "lはRの接線、SはRTの中点。",
      "gmbl": [
        "(define l line (perp-at R (line (origin Omega) R))); (define T point (midp-from S R))"
      ],
      "geosolver": [
        "l = PerpendicularLine(Line(O, R), R)",
        "T = Point(2, 0)"
      ],
      "condition_indices": [],
      "construction_names": [
        "l",
        "T"
      ],
      "status": "matched"
    },
    {
      "id": "H03",
      "statement_ja": "JはΩの短い弧RSの内部。",
      "gmbl": [
        "(param J point (on-minor-arc Omega R S))"
      ],
      "geosolver": [
        "J = PointOnCircle(Omega, j)",
        "conditions[1]: J.y*oy < 0"
      ],
      "condition_indices": [
        1
      ],
      "construction_names": [
        "J"
      ],
      "status": "matched"
    },
    {
      "id": "H04",
      "statement_ja": "ΓはJST外接円でlと異なる2点で交わり、AはRに近い方。",
      "gmbl": [
        "(define Gamma circle (circumcircle J S T)); (define A point (inter-lc l Gamma (rs-closer-to-p R))); (assert (not (eq A (inter-lc l Gamma (rs-neq A)))))"
      ],
      "geosolver": [
        "Gamma = Circumcircle(J, S, T)",
        "A = Intersect(l, Gamma, near=R)",
        "A_other = Intersect(l, Gamma, exclude=A)",
        "conditions[2]: Distance(A, A_other) > 0",
        "conditions[3]: Distance(A, R) < Distance(A_other, R)"
      ],
      "condition_indices": [
        2,
        3
      ],
      "construction_names": [
        "Gamma",
        "A",
        "A_other"
      ],
      "status": "matched"
    },
    {
      "id": "H05",
      "statement_ja": "KはAJとΩのJと異なる交点。",
      "gmbl": [
        "(define K point (inter-lc (line A J) Omega (rs-neq J)))"
      ],
      "geosolver": [
        "K = Intersect(Line(A, J), Omega, exclude=J)"
      ],
      "condition_indices": [],
      "construction_names": [
        "K"
      ],
      "status": "matched"
    }
  ],
  "goal": {
    "statement_ja": "直線KTがΓに接する。",
    "gmbl": [
      "(eval (tangent-lc (line K T) Gamma))"
    ],
    "included_in_solver_conditions": false,
    "solver_target": "0",
    "assessment_only": true
  },
  "source_differences": [
    {
      "id": "gmb_runtime_distinctness",
      "kind": "runtime_acceptance_policy",
      "blocking": false,
      "description_ja": "GMBは全登録点の最小距離0.1とweighted soft lossで受理する。原文にない全点相異・最小距離0.1はGeoSolver条件に移さず、両者の出力を別の共通検査器で再検査する。"
    },
    {
      "id": "gmb_numeric_root_selector",
      "kind": "runtime_selector",
      "blocking": false,
      "description_ja": "GMBのrs-neqは数値距離1e-6で候補を分ける。GeoSolverのexcludeは指定点が共通交点である通常の非退化幾何を使い、唯一の異なる交点を要求する。接点重複や不明な枝を勝手に選ばない。"
    },
    {
      "id": "minor_arc_unbounded_parameter",
      "kind": "runtime_parameterization_defect",
      "blocking": false,
      "description_ja": "GMB parameterize_on_minor_arcのzは初期0.1〜0.9だが、tf_optimizer.mkvarは学習中の区間拘束を設定していない。弧外の配置を返し得る実装上の危険として、共通検査器で短弧所属を再検査する。数学入力は短弧のまま変更しない。"
    }
  ],
