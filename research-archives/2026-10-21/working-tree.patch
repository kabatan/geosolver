+const DATA={"cards": [{"id": "H01", "decision": "main", "title_ja": "中線への垂足と中線の残りの長さ", "diagnosis_ja": "三辺から二つの距離の二乗を求めるv1では、垂心と射影点の座標処理を誘発していた。", "change_ja": "底辺と中線の長さを与え、頂点から垂足までの長さに変更する。点の同定の後に方べきと差を使う。", "problem_ja": "鋭角不等辺三角形ABCの垂心をH、BCの中点をMとする。Hから直線AMに下ろした垂線の足をPとする。BC=12、AM=10のとき、APを求めよ。", "givens": [{"name": "BC", "value": "12", "meaning_ja": "底辺"}, {"name": "AM", "value": "10", "meaning_ja": "中線"}], "query": {"expression": "AP", "meaning_ja": "頂点から垂足までの長さ"}, "answer_exact": "32/5", "geometry_solution_ja": ["Mを中心としてAを点対称に移した点をA*とする。A*B∥AC、A*C∥ABなので、B,C,Hは直径A*Hの円上にある。HP⊥AA*よりPもこの円上にある。", "Mからの方べきによりMA*·MP=MB²。鋭角三角形ではA,P,Mの順なので、MP=6²/10=18/5。", "AP=AM−MP=10−18/5=32/5。"], "arithmetic_ja": ["12÷2=6", "6²÷10=18/5", "10−18/5=32/5"], "why_geometry_helps_ja": "垂心Hの二本の高さの交点計算と、HのAMへの射影座標を求めずに済む。", "shortcut_risk_ja": "基礎問題としては短い。ただし与えた等式の左右を置き換えるだけではなく、補助点A*、共円性、方べきを発見する必要がある。", "parameter_family_ja": "BC=2m、AM=t、0\u003cm\u003ct。鋭角になる非対称なAの位置を動かしてもAP=t−m²/t。三角形全体を一意には決めないが求値は一意。", "feasibility": {"status": "verified", "method_ja": "verify_h_revision.py が元の直線・円・鏡映・射影の定義から厳密座標で構成し、全与条件と答えを照合。短縮用の性質は交点の生成には使わず、生成後に検査する。", "witness": {"points": {"A": ["14/5", "48/5"], "B": ["-6", "0"], "C": ["6", "0"], "M": ["0", "0"], "H": ["14/5", "44/15"], "P": ["126/125", "432/125"]}, "given_values": {"AM": "10", "BC": "12"}, "answer": "32/5"}, "script": "verify_h_revision.py", "solution_status": "proved_here"}, "review_notes_ja": ["一般の射影点の同定・共円性はv1 verify_humpty.pyのsymbolic_core_checkでも証明済み。"], "source": [{"title": "Evan Chen, Lemmas in AoPS Geometry", "url": "https://web.evanchen.cc/handouts/GeoSlang/GeoSlang.pdf", "locator": "§3.1, PDF p.9"}], "legacy_structural_group": "humpty_core_views", "previous": {"title_ja": "中線への垂足と頂点までの距離", "split_recommendation": "train", "problem_template_ja": "相異なる辺長BC=a, CA=b, AB=cを持つ鋭角三角形ABCを考える。Hを垂心、MをBCの中点、PをHから直線AMへの垂足とする。BP²を求めよ。", "numeric_queries": [{"id": "q1", "expression": "BP^2", "meaning_ja": "BPの長さの平方", "why_nontrivial_ja": "Hと中線の射影から、も