review_notes_ja": ["J∈ALはv1 verify_humpty_extensions.pyの一般恒等式。Q∈円CEPはSarkarのDumpty同定。v2は元の二円からJを構成して両者を厳密照合。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "記号はPDF p.2、Characterization 6はp.4、Lemma 9はp.8"}], "legacy_structural_group": "dumpty_midpoint_altitude_second_circle_intersection", "previous": {"title_ja": "二つの中点と弦端点から作る二円の第二交点", "split_recommendation": "train", "problem_template_ja": "BC=a, CA=b, AB=cの鋭角不等辺三角形ABCを取る。D,EをBC,CAの中点、PをAからBCへの垂足とする。円ABCのB,Cでの接線の交点をX、直線AXと円ABCのA以外の交点をLとする。円CEPと円CDLのC以外の共通点をJとする。AJ²を求めよ。", "numeric_queries": [{"id": "q1", "expression": "AJ^2", "meaning_ja": "AJの長さの平方", "why_nontrivial_ja": "二円の追加交点Jを求める必要があり、Jの隠れた直線所属が分かると第二の円と既知の直線の交点へ還元できる。"}, {"id": "q2", "expression": "PJ^2", "meaning_ja": "垂足Pと第二交点Jの距離平方", "why_nontrivial_ja": "円CEPを作る垂足と、2円を組み合わせたJとの距離。追加した円CDLを無視してはJは定まらない。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "BC,CA,ABの辺長", "domain_ja": "相異なる正数で三角不等式を満たし、ABCは鋭角。定義に現れる円・交点の非退化条件を満たす。"}]}, "authoring_file": "authoring/h_revision.json"}, {"id": "DA01", "decision": "main", "title_ja": "二接円の交点を、長さ7の中線へ結び付ける", "diagnosis_ja": "一般の三辺から未知の二円の交点や外心との距離を計算すると、二次式が多く残った。", "change_ja": "AB=7,BC=8,CA=9 に選び直し、ATだけを問う。中線の長さが7となり、弦の中点表示から短く計算できる。", "problem_ja": "三角形ABCは AB=7, BC=8, CA=9 を満たす。Bを通り直線ACにAで接する円と、Cを通り直線ABにAで接する円の、Aでない交点をTとする。ATの長さを求めよ。", "givens": [{"name": "AB", "value": "7", "meaning_ja": "辺AB"}, {"name": "BC", "value": "8", "meaning_ja": "辺BC"}, {"name": "CA", "value": "9", "meaning_ja": "辺CA"}], "query": {"expression": "AT", "meaning_ja": "二接円の第2交点までの距離"}, "answer_exact": "9/2", "geometry_solution_ja": ["BCの中点をM、直線ATと外接円のAでない交点をLとする。二接円の表示からTはALの中点で、ALはA-symmedianとなる。", "この弦には AL=AB·AC/AM が成り立つ。根拠は、BL:LC=AB:ACと調和四角形ABLCへのPtolemy。AをMに関して反転したA′を補えば、△BLCと△ABA′の相似から必要な辺比が出る。", "中線の公式で AM²=(2·7²+2·9²−8²)/4=49。よって AT=AL/2=7·9/(2·7)=9/2。"], "arithmetic_ja": ["(98+162−64)/4=49、AM=7。", "63/14=9/2。"], "why_geometry_helps_ja": "二円の中心や交点座標を求めず、中線と外接円の弦という既知の長さへ移せる。", "shortcut_risk_ja": "最終的な一般公式だけ暗記しても解ける基礎課題。同じ公式を別ラベルで大量に水増ししない。", "parameter_family_ja": "三辺b,c,aに対して2b²+2c²−a²を小さい平方数にする。b/cやa/cも変える。7,8,9の相似拡大だけを別構造として数えない。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。 verify_additional_relations.pyで元の二接円から交点Tを一般形で構成し、AT·AM=AB·AC/2を恒等的に確認。", "witness": {"points": {"A": [2.0, 6.708203932499369], "B": [0.0, 0.0], "C": [8.0, 0.0], "T": [2.673469387755102, 2.2588849976783605]}, "given_values": {"AB": 7.0, "BC": 8.0, "CA": 9.0}, "answer": 4.499999999999999}, "script": "verify_da_revision.py", "solution_status": "proved_here", "general_relation_script": "verify_additional_relations.py"}, "review_notes_ja": ["これは元のAIME 2019 II/11に近い自然な数値化。v1のOT²という追加queryは削除した。", "rootのverify_additional_relations.pyにも、元の円の方程式からの一般恒等式による独立確認がある（本ファイルの作者は編集していない）。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problems 1–3, PDF p.5; Characterizations 1–5, PDF pp.2–3"}], "legacy_structural_group": "vertex_tangent_pair", "previous": {"title_ja": "一頂点で隣辺に接する二円の第2交点", "split_recommendation": "train", "problem_template_ja": "三角形 ABC の辺長は BC={a}, CA={b}, AB={c} とする。鋭角不等辺三角形 ABC をとり、O をその外心とする。 円 ω1 は B を通り、直線 AC に A で接する円とする。円 ω2 は C を通り、直線 AB に A で接する円とする。 T を ω1 と ω2 の A でない交点とする。 AT^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "AT^2", "meaning_ja": "A から二円の第2交点までの距離の二乗", "why_nontrivial_ja": "二円の中心を直接解くことも、弦の中点や相似を見出して短く求めることもできる。"}, {"id": "q2", "expression": "OT^2", "meaning_ja": "外心から同じ交点までの距離の二乗", "why_nontrivial_ja": "外心と第2交点の関係を利用できる量であり、与えた辺長そのものではない。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "順に辺 BC, CA, AB の長さ", "domain_ja": "三角不等式を満たす鋭角不等辺三角形。各カードの追加条件も満たす。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA02", "decision": "main", "title_ja": "120度の点と重心の割線の長さ", "diagnosis_ja": "TG², TK²だけを小数で示すと、角条件で決まる内部点の計算を解く必要があり、何が簡約するのか見えにくかった。", "change_ja": "AB=10,AC=8,∠A=60°の形を残し、TKを問う。60度の場合の重心との距離と割線比を組み合わせる。", "problem_ja": "∠BAC=60°、AB=10、AC=8の三角形ABCの内部に、∠ATB=∠BTC=∠CTA=120°を満たす点Tを取る。GをABCの重心とし、直線TGと円BTCのTでない交点をKとする。TKの長さを求めよ。", "givens": [{"name": "AB", "value": "10", "meaning_ja": "辺AB"}, {"name": "AC", "value": "8", "meaning_ja": "辺AC"}, {"name": "angle_BAC", "value": "60", "meaning_ja": "角BAC、度"}], "query": {"expression": "TK", "meaning_ja": "割線上の二円周点間の距離"}, "answer_exact": "2", "geometry_solution_ja": ["∠A=60°ではTはA-Dumpty点にもなる。この特殊化では TG=|AB−AC|/3。", "円BTCとの割線についてGはT,Kの間にあり、GK=2TG（原題Russian Grade 9 2021/6の比）。したがってTK=3TG。", "TG=(10−8)/3=2/3なので、TK=3·(2/3)=2。"], "arithmetic_ja": ["10−8=2。", "TG=2/3、TK=3·2/3=2。"], "why_geometry_helps_ja": "Tを120度条件の二次方程式から決めず、重心への距離と円の割線比に分けられる。", "shortcut_risk_ja": "固定比だけを与えてTKを問う穴埋めにはしない。ここでは辺長差からTGも導出する。短い主解に使う二つの補題の理解確認は別途必要。", "parameter_family_ja": "∠A=60°、AB=c,AC=bでb≠c、残る角が120°未満の範囲を使う。TK=|b−c|。b/cを変えて非相似な形状を作れる。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [0.0, 0.0], "B": [10.0, 0.0], "C": [4.0, 6.928203230275509], "T": [4.2622950819672, 2.8394275533915243], "G": [4.666666666666667, 2.309401076758503], "K": [5.475409836066184, 1.2493481234916957]}, "given_values": {"AB": 10.0, "AC": 8.0, "angle_BAC": 60.00000000000001}, "answer": 2.0000000000008007}, "script": "verify_da_revision.py", "solution_status": "proved_here"}, "review_notes_ja": ["TGの補題の確認：x=AT,y=BT,z=CTとおくとx²=yz。面積分割からbc=x(y+z)+yz。余弦定理と重心の平方距離恒等式を合わせると9TG²=(b−c)²になる。", "割線比も点の冪で確認できる。円BTCに対するAの冪はbcで、Gの冪は[3bc−(a²+b²+c²)]/9=−2TG²。従ってGT·GK=2GT²。与条件へこの比は入れていない。", "Aの冪bcの確認：∠A=60°と∠BTC=120°から円BTCの半径は円ABCと同じで、両円はBCについて対称。