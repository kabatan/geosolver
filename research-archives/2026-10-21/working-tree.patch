−4²)=3。"], "arithmetic_ja": ["25−16=9、√9=3。"], "why_geometry_helps_ja": "Eの位置を解かず、反射でODに置き換えて既知の直角三角形を使う。", "shortcut_risk_ja": "OE=ODだけを使う穴埋めにしないためODは与えない。ADと外接半径から三平方を一段挟む。ただし反射補題そのものの定着を強く測る配置である。", "parameter_family_ja": "AO=R,AD=xを選び、R²−x²を平方数にする。同じ円と弦ALに対し、適切なBCを変えるとAO,ADを固定した非相似な三角形を作れる。AB>ACと鋭角性は生成時検査。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [0.0, 5.0], "B": [-3.0, -4.0], "C": [4.203821656050955, 2.707006369426751], "O": [0.0, 0.0], "M": [0.6019108280254777, -0.6464968152866244], "D": [2.3999999999999995, 1.8000000000000007], "E": [0.21401273885350316, 2.992356687898089]}, "given_values": {"AO": 5.0, "AD": 3.999999999999999}, "answer": 3.0}, "script": "verify_da_revision.py", "solution_status": "source_proof_checked"}, "review_notes_ja": [], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problem 9, PDF p.9; Lemma 17, PDF p.11"}], "legacy_structural_group": "vertex_tangent_pair", "previous": {"title_ja": "中線と接円の第2交点を用いる外心配置", "split_recommendation": "train", "problem_template_ja": "AB>AC の鋭角不等辺三角形 ABC は BC={a}, CA={b}, AB={c} を満たし、O は外心、M は BC の中点である。A,B を通り直線 AC に A で接する円を ω1、A,C を通り直線 AB に A で接する円を ω2 とする。二円の A でない交点を D、直線 AM と ω2 の A でない交点を E とする。DE^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "OE^2", "meaning_ja": "外心と中線上の円交点との距離の二乗", "why_nontrivial_ja": "接円と中線の交点が主対象であり、外心との位置関係を使える。"}, {"id": "q2", "expression": "DE^2", "meaning_ja": "二円の交点と中線上の交点との距離の二乗", "why_nontrivial_ja": "同じ二円から得られる二種類の交点を結び付ける。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "BC, CA, AB の長さ", "domain_ja": "鋭角不等辺三角形をなし c>b。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA07", "decision": "main", "title_ja": "二組の円から現れる平行線で18を求める", "diagnosis_ja": "MN²とXY²を三辺から計算すると、四つの交点の求値が残り、平行性が数値的に役立ちにくかった。", "change_ja": "AM=4,MX=23,MN=8/3を与えてXYを問う。A–M–Xの順だけを分岐条件として与える。", "problem_ja": "鋭角不等辺三角形ABCの外心をO、垂心をHとする。円BOCと直径AOの円のOでない交点をM、円BHCと直径AHの円のHでない交点をNとする。直線AMと円BOCのMでない交点をX、直線ANと円BHCのNでない交点をYとする。A,M,Xはこの順に並び、AM=4、MX=23、MN=8/3である。XYの長さを求めよ。", "givens": [{"name": "AM", "value": "4", "meaning_ja": "頂点と一方の円交点の距離"}, {"name": "MX", "value": "23", "meaning_ja": "同じ割線の残り"}, {"name": "MN", "value": "8/3", "meaning_ja": "二つの最初の円交点の距離"}], "query": {"expression": "XY", "meaning_ja": "二つの延長交点の距離"}, "answer_exact": "18", "geometry_solution_ja": ["MはA-Dumpty点、NはA-Humpty点に当たり、この配置ではMN∥XY（ELMO2014/5、Sarkar Lemma7）。", "A,M,XとA,N,Yがそれぞれ一直線上にあるため、△AMNと△AXYは相似。AX=4+23=27。", "XY=(AX/AM)·MN=(27/4)·(8/3)=18。"], "arithmetic_ja": ["4+23=27。", "(27/4)·(8/3)=18。"], "why_geometry_helps_ja": "四つの円交点の座標を求めず、二つの線分を対応する相似辺として扱う。", "shortcut_risk_ja": "MN∥XYは与えない。単なるXY=MN型の等長問題にしないため、倍率を割線の二部分から作る。", "parameter_family_ja": "AM=x,MX=t,MN=sならXY=(x+t)s/x。三辺から元作図を行い、x,t,sが小さい値になる実在例を選ぶ。三つの測定値が任意独立とは主張しない。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [0.7382809323313221, 4.616902584383194], "B": [0.0, 0.0], "C": [11.324751652906125, 0.0], "O": [5.662375826453063, 1.4620191517213454], "H": [0.7382809323313211, 1.692864280940503], "M": [1.4677764722012112, 0.6839855680567686], "N": [2.197272012071097, 3.248931448269656], "X": [5.662375826453069, -21.93028727582015], "Y": [10.586470720574805, -4.616902584383189]}, "given_values": {"AM": 4.000000000000002, "MX": 22.999999999999982, "MN": 2.6666666666666683}, "answer": 17.999999999999982}, "script": "verify_da_revision.py", "solution_status": "source_proof_checked"}, "review_notes_ja": ["代表例は辺BC=3√57/2、CA=(9√13+3√21)/4、AB=(9√13−3√21)/4。これらの複雑な値は問題文には出さない。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problem 10, PDF p.9"}], "legacy_structural_group": "paired_diameter_circles", "previous": {"title_ja": "外心側と垂心側で対応する二組の直径円", "split_recommendation": "train", "problem_template_ja": "三角形 ABC の辺長は BC={a}, CA={b}, AB={c} とする。鋭角不等辺三角形 ABC の外心を O、垂心を H とする。 γ1 を B,O,C を通る円、γ2 を B,H,C を通る円とする。 M を直径 AO の円と γ1 の O でない交点、N を直径 AH の円と γ2 の H でない交点とする。 X を直線 AM と γ1 の M でない交点、Y を直線 AN と γ2 の N でない交点とする。 MN^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "MN^2", "meaning_ja": "二つの直径円から得られた交点間の距離の二乗", "why_nontrivial_ja": "外心側と垂心側で別々に定義された点の関係が対象。"}, {"id": "q2", "expression": "XY^2", "meaning_ja": "両方の割線の第2交点間の距離の二乗", "why_nontrivial_ja": "直径円で得た点の先まで延長する二段階の依存を使う。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "順に辺 BC, CA, AB の長さ", "domain_ja": "三角不等式を満たす鋭角不等辺三角形。各カードの追加条件も満たす。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA08", "decision": "main", "title_ja": "平行四辺形の交点を直径の円に戻す", "diagnosis_ja": "AT²やTM²は平行四辺形の頂点まで数値計算する必要があり、共点性の結論を使っても長い計算が残った。", "change_ja": "OQ=25,QT=24を与え、OTを問う。Tが円BOC上にあることは与えない。", "problem_ja": "鋭角不等辺三角形ABCの外心をOとし、円BOC上でOの対蹠点をQとする。Mは直線CQとAを通りBCに平行な直線との交点とし、NをANCMがこの順で平行四辺形となる点とする。Tを直線AQと直線MNの交点とする。OQ=25、QT=24のとき、OTの長さを求めよ。", "givens": [{"name": "OQ", "value": "25", "meaning_ja": "円BOCの直径"}, {"name": "QT", "value": "24", "meaning_ja": "対蹠点と平行四辺形からの交点の距離"}], "query": {"expression": "OT", "meaning_ja": "元の外心と最後の交点の距離"}, "answer_exact": "7", "geometry_solution_ja": ["この平行四辺形の配置ではTも円BOC上にある（Sarkar Problem12）。", "OQはその円の直径なので∠OTQ=90°。", "OT=√(OQ²−QT²)=√(25²−24²)=7。"], "arithmetic_ja": ["25²−24²=(25−24)(25+24)=49。", "√49=7。"], "why_geometry_helps_ja": "Q,M,N,Tの座標を求める必要がなく、Tの円への所属を認識すると既知の直径の直角三角形へ帰着する。", "shortcut_risk_ja": "T∈(BOC)やOT⊥TQは入力しない。OQとQTは答えそのものではなく、隠れた円所属とThalesが必要。", "parameter_family_ja": "OQ=d,QT=tでd²−t²が小さな平方数となる値を選ぶ。ただし鋭角三角形が実在する範囲は狭いため、任意の直角三角形の三辺を流用しない。25,24,7は元作図で確認済み。AをAQ上で局所的に動かす非相似族がある。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [8.68, 17.26], "B": [-9.090302525218839, 8.58], "C": [9.090302525218839, 8.58], "O": [5.551115123125783e-17, 12.500000000000002], "Q": [-1.8318679906315083e-15, -12.49999999999998], "M": [12.83336827089719, 17.260000000000005], "N": [4.936934254321649, 8.579999999999998], "T": [6.719999999999998, 10.540000000000003]}, "given_values": {"OQ": 24.999999999999982, "QT": 23.999999999999986}, "answer": 6.999999999999997}, "script": "verify_da_revision.py", "solution_status": "source_proof_checked"}, "review_notes_ja": ["13,12,5等を無条件で採用しない。与えた数値と鋭角条件が両立するかを実際の円・平行四辺形から確認した。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problem 12, PDF p.18"}], "legacy_structural_group": "antipode_parallel_grid_dumpty", "previous": {"title_ja": "円の直径と平行四辺形から作る交点", "split_recommendation": "train", "problem_template_ja": "三角形 ABC の辺長は BC={a}, CA={b}, AB={c} とする。鋭角不等辺三角形 ABC の外心を O とし、γ を B,O,C を通る円とする。 Q を γ 上で O の対蹠点とする。 M は直線 CQ と A を通り BC に平行な直線との交点とし、N は ANCM がこの順で平行四辺形となる点とする。 T を直線 AQ と直線 MN の交点とする。 AT^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "AT^2", "meaning_ja": "頂点から直線 AQ と対角線 MN の交点までの距離の二乗", "why_nontrivial_ja": "Q と平行四辺形の両方を経由して T を構成する。"}, {"id": "q2", "expression": "TM^2", "meaning_ja": "平行四辺形の頂点から同じ交点までの距離の二乗", "why_nontrivial_ja": "原題の共点・円周関係を見抜くと交点の求値を整理できる。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "順に辺 BC, CA, AB の長さ", "domain_ja": "三角不等式を満たす鋭角不等辺三角形。各カードの追加条件も満たす。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA09", "decision": "main", "title_ja": "平行線格子の交点と接線の方べき", "diagnosis_ja": "PをAPで固定してCT²/IT²を求めたため、内心の円と二つの平行線網の座標を処理する必要があった。", "change_ja": "AC=BC=12,AB=16,CP=6に変更し、CTを問う。CPを与えると再解釈した三角形の接線の方べきが使える。", "problem_ja": "AB=16、AC=BC=12の二等辺三角形ABCの内心をIとする。円AIB上で三角形ABCの内部にあり、CP=6かつPA\u003cPBを満たす点をPとする。Pを通りCA,CBに平行な直線とABの交点を順にD,Eとし、Pを通りABに平行な直線とCA,CBの交点を順にF,Gとする。T=DF∩EGとする。CTの長さを求めよ。", "givens": [{"name": "AB", "value": "16", "meaning_ja": "二等辺三角形の底辺"}, {"name": "AC", "value": "12", "meaning_ja": "等辺の一方"}, {"name": "BC", "value": "12", "meaning_ja": "等辺の他方"}, {"name": "CP", "value": "6", "meaning_ja": "頂点と内心の円上の点の距離"}], "query": {"expression": "CT", "meaning_ja": "頂点と平行線格子の交点の距離"}, "answer_exact": "15", "geometry_solution_ja": ["三角形PABへ見方を変えると、CA,CBは円PABの接線である。これは∠APB=∠AIB=90°+∠C/2と、ABCの等辺性から接弦定理で分かる。", "直線CPと円PABのPでない交点をUとする。平行線配置のTはP-Dumpty点、すなわちPUの中点になる（Sarkar Problem13）。", "Cの方べきからCP·CU=CA²=144。CP=6なのでCU=24。P,UはCから同じ向きにあり、CT=(CP+CU)/2=(6+24)/2=15。"], "arithmetic_ja": ["12²=144、144/6=24。", "(6+24)/2=15。"], "why_geometry_helps_ja": "内心や格子の交点の座標を求めず、同じ図をPABという別の三角形として認識して接線と中点を使う。", "shortcut_risk_ja": "Tの中点性やCからの接線性は問題に書かない。AB=16は形状・実在を定めるために必要だが、これらを認識した後の答えの式には現れない。", "parameter_family_ja": "AC=BC=s,CP=tならCT=(t+s²/t)/2。ABを変えて円AIBの内部弧がC中心半径tの円と交わる範囲を選べる。全図形が一意でなくてもCTは一意。鏡像の二候補はPA\u003cPBで固定する。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [-8.0, 0.0], "B": [8.0, 0.0], "C": [0.0, 8.94427190999916], "I": [0.0, 3.577708763999664], "P": [-2.179449471770343, 3.3541019662496847], "D": [-5.179449471770344, 0.0], "E": [0.8205505282296568, 0.0], "F": [-4.999999999999999, 3.3541019662496847], "G": [5.0, 3.3541019662496847], "T": [-5.448623679425861, -5.031152949374528]}, "given_values": {"AB": 16.0, "AC": 12.0, "BC": 12.0, "CP": 6.000000000000003}, "answer": 15.000000000000009}, "script": "verify_da_revision.py", "solution_status": "source_proof_checked"}, "review_notes_ja": ["代表例A=(-8,0),B=(8,0),C=(0,4√5),P=(-√19/2,3√5/2)。元の内心の円との交点からPを再計算する。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problem 13, PDF p.19"}], "legacy_structural_group": "antipode_parallel_grid_dumpty", "previous": {"title_ja": "内心の円上の点を通る平行線格子", "split_recommendation": "train", "problem_template_ja": "AB={a}, AC=BC={b} の二等辺三角形 ABC の内心を I とする。円 AIB 上で三角形 ABC の内部にあり AP={p} を満たす唯一の点を P とする。P を通り CA,CB に平行な直線と AB の交点を順に D,E とする。P を通り AB に平行な直線と CA,CB の交点を順に F,G とする。直線 DF と EG の交点を T とする。CT^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "CT^2", "meaning_ja": "二等辺三角形の頂点から格子の交点までの距離の二乗", "why_nontrivial_ja": "P から作る四つの平行線交点と、その先の交点 T を使う。"}, {"id": "q2", "expression": "IT^2", "meaning_ja": "内心から格子の交点までの距離の二乗", "why_nontrivial_ja": "P を決める円の内心と最後の交点を結び付ける量。"}], "free_parameters": [{"name": "a,b,p", "meaning_ja": "AB、等しい辺 AC=BC、AP", "domain_ja": "0\u003ca\u003c2b。円 AIB と中心 A 半径 p の円の交点のうち ABC 内部のものがちょうど一つ。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA11", "decision": "main", "title_ja": "中点で接する二円から第三の円の半径へ", "diagnosis_ja": "AK′²とKK′²を三辺から出す設定では、二つの接円の交点の数値計算が中心になった。", "change_ja": "元の外接半径5、AB=7、BC=8を与え、A,Bと二円の第2交点Tを通る円の半径を問う。", "problem_ja": "鋭角不等辺三角形ABCはAB=7、BC=8を満たし、外接円の半径は5である。I,JをそれぞれAB,ACの中点、KをIJの中点とする。Kを通りABにIで接する円と、Kを通りACにJで接する円のKでない交点をTとする。円ABTの半径を求めよ。", "givens": [{"name": "AB", "value": "7", "meaning_ja": "辺AB"}, {"name": "BC", "value": "8", "meaning_ja": "辺BC"}, {"name": "R", "value": "5", "meaning_ja": "ABCの外接半径"}], "query": {"expression": "radius(ABT)", "meaning_ja": "派生した三点円の半径"}, "answer_exact": "35/8", "geometry_solution_ja": ["TはA-Dumpty点である。実際、中心A・倍率2の相似で二接円を移すと、その共通点はBCの中点とsymmedian弦端点になり、Tは弦の中点と分かる。", "Dumptyの角関係から∠ATB=180°−∠BAC。円ABTの半径をrとすると、AB=2r sin∠A。", "元の円ではBC=2·5 sin∠Aだから、r=5·AB/BC=5·7/8=35/8。"], "arithmetic_ja": ["r/5=7/8。", "5·7/8=35/8。"], "why_geometry_helps_ja": "Tの位置と新しい外心の位置を求めず、二円の同じ正弦に対する弦の比で半径を運ぶ。", "shortcut_risk_ja": "新しい円はqueryに必要な追加物。単に同じDumpty距離の公式を使う問題の改名にしない。半径比は入力せず、角の対応を発見する必要がある。", "parameter_family_ja": "外接半径R,AB=c,BC=aに対して新半径Rc/a。三角形が鋭角・不等辺となる両角の範囲で、c/aもa/Rも変える。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [0.9206000600120029, 6.939199919983996], "B": [0.0, 0.0], "C": [8.0, 0.0], "O": [4.0, 3.0], "I": [0.46030003000600145, 3.469599959991998], "J": [4.460300030006001, 3.469599959991998], "K": [2.4603000300060014, 3.469599959991998], "T": [2.0328667995303027, 2.5064108008965973], "Z": [-2.141899939987998, 3.814824982496499]}, "given_values": {"AB": 7.0, "BC": 8.0, "R": 5.0}, "answer": 4.375000000000001}, "script": "verify_da_revision.py", "solution_status": "source_proof_checked"}, "review_notes_ja": ["円ABTを追加したのは求値対象を作るため。T自体やその円の中心の座標を教師入力には含めない。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problem 16, PDF p.21"}], "legacy_structural_group": "derived_triangle_foot_midpoints_humpty", "previous": {"title_ja": "中点連結線上の点を通る二つの接円", "split_recommendation": "train", "problem_template_ja": "三角形 ABC の辺長は BC={a}, CA={b}, AB={c} とする。鋭角不等辺三角形 ABC をとる。 I,J をそれぞれ AB,AC の中点、K を IJ の中点とする。 ω1 を K を通り直線 AB に I で接する円、ω2 を K を通り直線 AC に J で接する円とする。 K′ を ω1 と ω2 の K でない交点とする。 AK′^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "AK′^2", "meaning_ja": "頂点から二円の新しい交点までの距離の二乗", "why_nontrivial_ja": "接点が頂点でない二円から、元の三角形に対する交点を求める。"}, {"id": "q2", "expression": "KK′^2", "meaning_ja": "二円の共通弦の長さの二乗", "why_nontrivial_ja": "K と K′ の両方を使うため、中点連結線の役割が消えない。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "順に辺 BC, CA, AB の長さ", "domain_ja": "三角不等式を満たす鋭角不等辺三角形。各カードの追加条件も満たす。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA13", "decision": "main", "title_ja": "二つの外心の共通な垂直二等分線を使う", "diagnosis_ja": "二円の半径から接線、二等分線、二つの外心まで座標で解く長い連鎖が残っていた。", "change_ja": "O1O2=6,O1P=24,O1Q=4を測定値として与え、P,Qが中心線の同じ側にある枝でPQを問う。", "problem_ja": "半径の異なる二円Γ1,Γ2の中心をO1,O2とし、各中心は他方の円の外部にあるとする。二円は異なる二点A,Bで交わる。Γ1のBでの接線とΓ2のBでない交点をC、Γ2のBでの接線とΓ1のBでない交点をDとする。∠DAB,∠CABの内角二等分線と、それぞれΓ1,Γ2のAでない交点をX,Yとする。三角形ACD,XAYの外心を順にP,Qとする。P,Qは直線O1O2の同じ側にあり、O1O2=6、O1P=24、O1Q=4を満たす。PQの長さを求めよ。", "givens": [{"name": "O1O2", "value": "6", "meaning_ja": "元の二円の中心間距離"}, {"name": "O1P", "value": "24", "meaning_ja": "一方の元の中心と派生外心Pの距離"}, {"name": "O1Q", "value": "4", "meaning_ja": "同じ元の中心と派生外心Qの距離"}], "query": {"expression": "PQ", "meaning_ja": "派生した二つの外心間距離"}, "answer_exact": "8*sqrt(7)", "geometry_solution_ja": ["この配置ではP,QはともにO1O2の垂直二等分線上にある（INMO2020/1）。二接円の見方ではAが三角形BCDのB-Dumpty点に当たる。", "O1O2の中点をMとするとMO1=3。三平方よりMP=√(24²−3²)=9√7、MQ=√(4²−3²)=√7。", "P,Qは中心線の同じ側でMP>MQだからPQ=MP−MQ=8√7。"], "arithmetic_ja": ["24²−3²=576−9=567=81·7。", "4²−3²=7。", "9√7−√7=8√7。"], "why_geometry_helps_ja": "二つの外心を構成し直すことなく、同じ垂直二等分線上の二つの直角三角形として距離を比較できる。", "shortcut_risk_ja": "PO1=PO2やQO1=QO2を入力しない。与えた二つの斜辺だけではP,Qの向きは決まらず、幾何的な同一直線への所属が不可欠。", "parameter_family_ja": "中心間距離2mとO1P=p,O1Q=qを与え、p²−m²とq²−m²が同じ平方因子を持つ例を元の二円から選ぶ。任意の三数がこの構成に実在するとは主張しない。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"O1": [0.0, 0.0], "O2": [6.0, 0.0], "A": [3.75, 3.307189138830738], "B": [3.75, -3.307189138830738], "C": [9.0, 2.6457513110645907], "D": [-4.453125, 2.273692532946132], "X": [-2.812500000000001, -4.133986423538422], "Y": [9.0, -2.6457513110645907], "P": [3.000000000000001, -23.811761799581312], "Q": [2.999999999999999, -2.6457513110645907]}, "given_values": {"O1O2": 6.0, "O1P": 23.999999999999996, "O1Q": 3.9999999999999996}, "answer": 21.166010488516722}, "script": "verify_da_revision.py", "solution_status": "source_claim_only"}, "review_notes_ja": ["代表例は元の二円の半径5,4、中心間距離6。P,Qの位置を元の接線・二等分線から再現して新しい全与条件を確認した。", "PQが垂直二等分線という一般命題は出典の主張に依存し、本稿では独立な一般証明を追加していない。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Problem 18, PDF p.21"}], "legacy_structural_group": "cross_tangent_bisector_extensions", "previous": {"title_ja": "交わる二円の接線と二等分線から作る二つの外心", "split_recommendation": "train", "problem_template_ja": "半径 {r1},{r2} の円 Γ1,Γ2 の中心を O1,O2 とし、O1O2={d} とする。各中心は他方の円外にあり、二円は A,B で交わる。O1 から O2 を見て左側を A とする。Γ1 の B における接線と Γ2 の B でない交点を C、Γ2 の B における接線と Γ1 の B でない交点を D とする。∠DAB の内角二等分線と Γ1 の A でない交点を X、∠CAB の内角二等分線と Γ2 の A でない交点を Y とする。三角形 ACD と XAY の外心を順に P,Q とする。PQ^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "PQ^2", "meaning_ja": "二つの派生三角形の外心間距離の二乗", "why_nontrivial_ja": "接線・角二等分線の四交点を経由した外心同士の関係を使う。"}, {"id": "q2", "expression": "PO1^2", "meaning_ja": "派生三角形の外心と元の円の中心との距離の二乗", "why_nontrivial_ja": "元の二円と派生三角形を結び付ける量。"}], "free_parameters": [{"name": "r1,r2,d", "meaning_ja": "元の二円の半径と中心間距離", "domain_ja": "r1,r2>0、r1≠r2、max(r1,r2)\u003cd\u003cr1+r2。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA15", "decision": "main", "title_ja": "垂直二等分線の交点から直径の円へ", "diagnosis_ja": "MF²やDF²は中線上の二点とFを両方数値化する必要があり、原題の共円性が短縮に結びつきにくかった。", "change_ja": "外接半径AO=13とAF=12を与えてOFを問う。原題の共円性を直径AOの円へ読み替える。", "problem_ja": "鋭角不等辺三角形ABCの外心をO、BCの中点をMとする。AB,ACの垂直二等分線と半直線AMの交点をそれぞれD,Eとする。F=BD∩CEは三角形ABCの内部にあるとする。AO=13、AF=12のとき、OFの長さを求めよ。", "givens": [{"name": "AO", "value": "13", "meaning_ja": "ABCの外接半径"}, {"name": "AF", "value": "12", "meaning_ja": "頂点と最後の交点の距離"}], "query": {"expression": "OF", "meaning_ja": "元の外心と交点Fの距離"}, "answer_exact": "5", "geometry_solution_ja": ["AB,ACの中点をU,Vとする。原配置の性質からA,U,F,Vは共円（USAMO2008/2、FはA-Dumpty点）。", "OU⊥AB、OV⊥ACなので、円AUVは直径AOの円。したがってAF⊥OF。", "OF=√(13²−12²)=5。"], "arithmetic_ja": ["13²−12²=(13−12)(13+12)=25。", "√25=5。"], "why_geometry_helps_ja": "Fや新しい円の中心を計算せず、二つの中点を補って直径AOの円だと認識するだけでよい。", "shortcut_risk_ja": "AF⊥OFは入力しない。DA06と最後の三平方は共通だが、その前に使う幾何は中点の円への所属であり、反射ではない。同じ三平方の数値替えを別構造と数えない。", "parameter_family_ja": "AO=R,AF=tでR²−t²を小さい平方数にする。同じ外接円・symmedian弦を持つBCの局所的な変更で非相似な図形を作れる。F内部とD,Eが半直線上であることを検査する。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。 verify_additional_relations.pyで中線と垂直二等分線の交点からFを一般形で構成し、Fが二接円の第2交点と一致し、直径AOの円上にあることを恒等的に確認。", "witness": {"points": {"A": [0.0, 13.0], "B": [-5.0, -12.0], "C": [12.993014508328859, 0.4261149919398193], "O": [0.0, 0.0], "M": [3.9965072541644293, -5.78694250403009], "D": [2.8883495145631084, -0.5776699029126231], "E": [2.267109569635095, 2.3426798886229268], "F": [4.615384615384617, 1.923076923076918]}, "given_values": {"AO": 13.0, "AF": 12.000000000000005}, "answer": 4.999999999999999}, "script": "verify_da_revision.py", "solution_status": "proved_here", "general_relation_script": "verify_additional_relations.py"}, "review_notes_ja": ["一般的な特殊点の同定・共点性は出典の問題とwalkthroughに依存する。ここでは省略された幾何の証明をすべて独立に補完したとはせず、source_claim_only と記録する。その関係を用いた後の求値は記載の通り導出し、元作図から全与条件と答えを検算した。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Example 20, PDF p.13"}], "legacy_structural_group": "median_bisector_intersections", "previous": {"title_ja": "中線と二本の垂直二等分線から作る交点", "split_recommendation": "train", "problem_template_ja": "三角形 ABC の辺長は BC={a}, CA={b}, AB={c} とする。鋭角不等辺三角形 ABC をとり、M を BC の中点とする。 D,E を、それぞれ AB,AC の垂直二等分線と半直線 AM の交点とする。 F を直線 BD と直線 CE の交点とする。F が三角形 ABC の内部にある場合を扱う。 MF^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "MF^2", "meaning_ja": "底辺中点から二直線の交点までの距離の二乗", "why_nontrivial_ja": "二本の垂直二等分線で中線上に作った点から、さらに異なる直線の交点へ進む。"}, {"id": "q2", "expression": "DF^2", "meaning_ja": "中線上の交点から最後の交点までの距離の二乗", "why_nontrivial_ja": "D を捨てた同じ点の別名ではなく、構成の中間点との距離を使う。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "順に辺 BC, CA, AB の長さ", "domain_ja": "三角不等式を満たす鋭角不等辺三角形。各カードの追加条件も満たす。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA16", "decision": "main", "title_ja": "共点性を見つけた後に二本の割線を比べる", "diagnosis_ja": "AT²やMT²を三辺から求めると、垂線と外円の四つの交点を全て数値計算する必要があった。", "change_ja": "外部点Tからの自然な距離TA=4,TP=9/2,TB=8を与えてTMを問う。共点性と弦の中点を方べきへつなぐ。", "problem_ja": "鋭角不等辺三角形ABCの外接円をΓとする。Bを通りACにAで接する円と、Cを通りABにAで接する円のAでない交点をMとする。Mを通りMBに垂直な直線と、Cを含まない小弧ABとの交点をP、Mを通りMCに垂直な直線と、Bを含まない小弧ACとの交点をQとする。T=BP∩CQはΓの外部にあり、TA=4、TP=9/2、TB=8を満たす。TMの長さを求めよ。", "givens": [{"name": "TA", "value": "4", "meaning_ja": "外部点と頂点の距離"}, {"name": "TP", "value": "9/2", "meaning_ja": "外部点と近い円周点の距離"}, {"name": "TB", "value": "8", "meaning_ja": "同じ割線上の遠い円周点の距離"}], "query": {"expression": "TM", "meaning_ja": "外部点と二接円の交点の距離"}, "answer_exact": "13/2", "geometry_solution_ja": ["原配置の共点性からT,A,Mは一直線上にある。MはA-Dumpty点なので、直線AMとΓのAでない交点をLとするとMはALの中点。", "外部点Tの方べきからTA·TL=TP·TB=(9/2)·8=36。よってTL=9。TA=4\u003cTLなのでAが近い交点である。", "Tから見てALの中点Mまでの距離はTM=(TA+TL)/2=(4+9)/2=13/2。"], "arithmetic_ja": ["(9/2)·8=36、36/4=9。", "(4+9)/2=13/2。"], "why_geometry_helps_ja": "P,Qを円と垂線の交点として数値化せず、Tからの二本の割線を同じ円の方べきで結び付けられる。", "shortcut_risk_ja": "T,A,Mの共線性は入力しない。Tが外部という枝は明示し、方べきの符号と中点のどちら側かを曖昧にしない。", "parameter_family_ja": "TA=a,TP=p,TB=bでpb>a²ならTM=(a+pb/a)/2。三数の実在は元の弧・垂線構成で確認する。任意の三数が鋭角ABCを作るとは主張しない。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [4.0, 0.0], "B": [7.704615384615384, 2.1538109887239245], "C": [7.736263736263736, -2.210397155915358], "O": [6.5, -0.03714346357170267], "M": [6.5, -4.440892098500626e-16], "P": [4.333846153846153, 1.2115186811572072], "Q": [4.302197802197803, -1.2292194411091801], "T": [0.0, -4.440892098500626e-16]}, "given_values": {"TA": 4.0, "TP": 4.499999999999999, "TB": 8.0}, "answer": 6.5}, "script": "verify_da_revision.py", "solution_status": "source_claim_only"}, "review_notes_ja": ["元の三辺は問題文に出さない。scriptは独立なΓとABCの厳密な種からM,P,Q,Tを再構成して、指定の三つの距離を確認する。", "一般的な特殊点の同定・共点性は出典の問題とwalkthroughに依存する。ここでは省略された幾何の証明をすべて独立に補完したとはせず、source_claim_only と記録する。その関係を用いた後の求値は記載の通り導出し、元作図から全与条件と答えを検算した。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Example 21, PDF p.13"}], "legacy_structural_group": "vertex_tangent_pair", "previous": {"title_ja": "二円の交点から垂直方向に取った弧上点", "split_recommendation": "train", "problem_template_ja": "三角形 ABC の辺長は BC={a}, CA={b}, AB={c} とする。鋭角不等辺三角形 ABC の外接円を Γ とする。 M を、B を通り AC に A で接する円と、C を通り AB に A で接する円の A でない交点とする。 P を M を通り MB に垂直な直線と、C を含まない小弧 AB との交点とする。Q を M を通り MC に垂直な直線と、B を含まない小弧 AC との交点とする。 T を直線 BP と直線 CQ の交点とする。 AT^2 の値を求めよ。", "numeric_queries": [{"id": "q1", "expression": "AT^2", "meaning_ja": "元の頂点から二本の弦直線の交点までの距離の二乗", "why_nontrivial_ja": "M に依存する二つの垂直線と弧上点から最後の交点を求める。"}, {"id": "q2", "expression": "MT^2", "meaning_ja": "二円の交点と二弦直線の交点との距離の二乗", "why_nontrivial_ja": "基礎交点と派生交点を結ぶため、追加した P,Q の役割が必要。"}], "free_parameters": [{"name": "a,b,c", "meaning_ja": "順に辺 BC, CA, AB の長さ", "domain_ja": "三角不等式を満たす鋭角不等辺三角形。各カードの追加条件も満たす。"}]}, "authoring_file": "authoring/da_revision.json"}, {"id": "DA17", "decision": "main", "title_ja": "二円の交点から補助三角形を選び直す", "diagnosis_ja": "元の半径と接点間距離から横断円を決める逆算は、学習問題として消去計算が重かった。", "change_ja": "原AIMEの向きへ戻し、XC=5,XD=20,XY=6からABを問う。", "problem_ja": "二円ω1,ω2は異なる二点X,Yで交わり、共通外接線ℓはそれぞれA,Bで接する。A,Bは相異なり、二円の中心はℓの同じ側にある。XはYよりℓに近いとする。A,Bを通る円ωとω1のAでない交点をD、ω2のBでない交点をCとする。Yは線分CDの内部にあり、XC=5、XD=20、XY=6である。ABの長さを求めよ。", "givens": [{"name": "XC", "value": "5", "meaning_ja": "近い円交点から横断円との交点Cまで"}, {"name": "XD", "value": "20", "meaning_ja": "近い円交点から横断円との交点Dまで"}, {"name": "XY", "value": "6", "meaning_ja": "元の二円の共通弦の長さ"}], "query": {"expression": "AB", "meaning_ja": "共通外接線の接点間距離"}, "answer_exact": "8", "geometry_solution_ja": ["F=AD∩BCを補う。出典Example22の配置ではF,X,Yは共線、四角形AFBYは平行四辺形となり、Xは三角形FCDのF-Dumpty点である。よってFX²=XC·XD。", "M=AB∩FYとすると、MはABとFYの共通中点。ℓはω1にAで接するので、Mの方べきはMX·MY=MA²。", "この枝ではF–M–X–Yの順なので、FX²−XY²=(MY+MX)²−(MY−MX)²=4MX·MY=AB²。", "従ってAB²=XC·XD−XY²=5·20−6²=64、AB=8。"], "arithmetic_ja": ["5·20=100、6²=36。", "100−36=64、√64=8。"], "why_geometry_helps_ja": "横断円の中心を未知数として解かず、FCDという補助三角形のDumptyの積を共通接線の方べきへ接続する。", "shortcut_risk_ja": "AB²=XC·XD−XY²という一般公式は問題文に入れない。二つの円の接点と交点を組み合わせてFを補うことが主な幾何。", "parameter_family_ja": "XC=p,XD=q,XY=tでpq−t²が正の小さい平方数となる実在例を選ぶ。p/qも変え、二円の半径比が固定の相似例だけにしない。Y∈CDと近遠の枝を検査する。", "feasibility": {"status": "verified", "method_ja": "verify_da_revision.py が元の円・接線・割線・角条件を使って点を作り直し、すべての数値与条件と答えを相対許容誤差1e-8で確認する。表示座標は近似値。正確な答えの根拠は幾何解法であり、この数値確認だけで一般命題を証明したとはしない。", "witness": {"points": {"A": [0.0, 0.0], "B": [8.0, 0.0], "O1": [0.0, 12.09486313629527], "O2": [8.0, 3.0237157840738176], "X": [5.4999999999999964, 1.3228756555322936], "Y": [10.000000000000002, 5.291502622129187], "C": [10.5, 1.3228756555322958], "D": [8.000000000000007, 21.166010488516715], "S": [4.0, 10.58300524425836]}, "given_values": {"XC": 5.0000000000000036, "XD": 19.999999999999993, "XY": 6.000000000000009}, "answer": 8.0}, "script": "verify_da_revision.py", "solution_status": "source_claim_only"}, "review_notes_ja": ["代表例はAB=8、元の半径32/√7と8/√7。横断円は元のC,Y,D共線条件から数値的に求める。", "解法で使う中点Mは入力点ではない。sourceのRemarkによるX=三角形YABのY-Humptyという接続も保持する。", "一般的な特殊点の同定・共点性は出典の問題とwalkthroughに依存する。ここでは省略された幾何の証明をすべて独立に補完したとはせず、source_claim_only と記録する。その関係を用いた後の求値は記載の通り導出し、元作図から全与条件と答えを検算した。"], "source": [{"title": "Srijon Sarkar, Midpoint of Symmedian Chord", "url": "https://www.awesomemath.org/wp-pdf-files/math-reflections/mr-2021-04/mr_4_2021_midpoint_of_symmedian_chord.pdf", "locator": "Example 22, PDF p.14"}], "legacy_structural_group": "two_circles_common_tangent_secant", "previous": {"title_ja": "共通外接線と三点を一直線にする横断円", "split_recommendation": "train", "problem_template_ja": "直線 ℓ 上の点 A